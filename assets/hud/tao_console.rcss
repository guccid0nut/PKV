/* ============================================================================
   ProjectKongor - TAO Developer Console & Agent Diagnostics (Full-Viewport)
   RmlUi LayoutEngine-Compliant Responsive Stylesheet (1080p / 1440p / 4K / 720p)
   Invariants:
     1. #tao-console-window is position: absolute + display: block; .tao-shell hosts flex.
     2. Every flex container contains strictly display: block children (flex -> block -> flex).
     3. Pure ASCII glyphs (32..127) and RmlUi-supported RCSS properties only.
   ============================================================================ */

body {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    pointer-events: none;
    font-family: Arial, sans-serif;
    font-size: 18px;
    color: #e2e8f0;
}

#tao-console-window {
    pointer-events: auto;
    position: absolute;
    top: 2.5%;
    left: 2.5%;
    width: 95%;
    height: 95%;
    display: block;
    box-sizing: border-box;
    background-color: #070c18;
    border-width: 2px;
    border-color: #0284c7;
    border-radius: 14px;
    padding: 20px 28px;
}

.tao-shell {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
}

.clear-fix {
    clear: both;
    display: none;
}

/* ============================================================================
   Header Bar + Back to Dev Cockpit Button
   ============================================================================ */
.header-slot {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    box-sizing: border-box;
}

.console-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    border-bottom-width: 2px;
    border-bottom-color: #1e293b;
    padding-bottom: 12px;
    margin-bottom: 12px;
    box-sizing: border-box;
}

.header-left {
    float: none;
    display: block;
    flex: 0 0 auto;
}

.btn-header-back {
    display: inline-block;
    vertical-align: middle;
    background-color: #0f172a;
    border-width: 2px;
    border-color: #38bdf8;
    color: #38bdf8;
    font-size: 18px;
    font-weight: bold;
    padding: 9px 20px;
    border-radius: 8px;
    margin-right: 18px;
    cursor: pointer;
}

.btn-header-back:hover {
    background-color: #0284c7;
    border-color: #7dd3fc;
    color: #ffffff;
}

.console-title {
    font-size: 26px;
    font-weight: bold;
    color: #38bdf8;
    display: inline-block;
    vertical-align: middle;
    margin-right: 14px;
}

.header-pill {
    font-size: 14px;
    background-color: #0369a1;
    color: #e0f2fe;
    padding: 6px 14px;
    border-radius: 6px;
    font-weight: bold;
    display: inline-block;
    vertical-align: middle;
}

.console-close {
    float: none;
    display: block;
    flex: 0 0 auto;
    text-align: center;
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
    cursor: pointer;
    padding: 10px 24px;
    border-radius: 8px;
    background-color: #dc2626;
    border-width: 1px;
    border-color: #f87171;
}

.console-close:hover {
    background-color: #b91c1c;
    border-color: #fca5a5;
}

/* ============================================================================
   Full-Width 5-Card Service Health Strip
   ============================================================================ */
.badges-slot {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    margin-bottom: 12px;
    box-sizing: border-box;
}

.service-badges {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    box-sizing: border-box;
}

.badge {
    display: block;
    flex: 1;
    background-color: #0f172a;
    border-width: 2px;
    border-color: #1e293b;
    border-radius: 10px;
    padding: 11px 14px;
    margin-right: 12px;
    text-align: center;
    box-sizing: border-box;
}

#badge-engine {
    margin-right: 0;
}

.badge-dot {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    vertical-align: middle;
    margin-right: 10px;
}

.dot-green {
    background-color: #4ade80;
}

.dot-amber {
    background-color: #fbbf24;
}

.dot-red {
    background-color: #f87171;
}

.badge-text {
    display: inline-block;
    color: #f8fafc;
    font-weight: bold;
    font-size: 16px;
    vertical-align: middle;
}

/* ============================================================================
   Full-Width 5-Button Navigation Tabs Bar
   ============================================================================ */
.tabs-slot {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    margin-bottom: 14px;
    box-sizing: border-box;
}

.nav-tabs {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    box-sizing: border-box;
}

.tab-btn {
    float: none;
    display: block;
    flex: 1;
    padding: 14px 12px;
    margin-right: 12px;
    background-color: #0f172a;
    border-width: 2px;
    border-color: #1e293b;
    border-radius: 10px;
    color: #94a3b8;
    font-size: 19px;
    font-weight: bold;
    text-align: center;
    cursor: pointer;
    box-sizing: border-box;
}

#tab-btn-console {
    margin-right: 0;
}

.tab-btn:hover {
    background-color: #1e293b;
    border-color: #38bdf8;
    color: #f8fafc;
}

.tab-btn.active {
    background-color: #0284c7;
    border-color: #7dd3fc;
    color: #ffffff;
}

/* ============================================================================
   Main Tab Stage & RmlUi-Compliant Flex/Block Containers
   ============================================================================ */
.tab-content {
    display: block;
    flex: 1;
    width: 100%;
    box-sizing: border-box;
}

.tab-pane {
    display: none;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
}

.tab-pane.active {
    display: block;
    width: 100%;
    height: 100%;
}

.pane-flex {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
}

.row-slot-fill {
    display: block;
    flex: 1;
    width: 100%;
    box-sizing: border-box;
}

.row-slot-top {
    display: block;
    flex: 3;
    width: 100%;
    margin-bottom: 14px;
    box-sizing: border-box;
}

.row-slot-bottom {
    display: block;
    flex: 2;
    width: 100%;
    box-sizing: border-box;
}

.split-row {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
}

.col-card {
    display: block;
    background-color: #0c1425;
    border-width: 2px;
    border-color: #1e293b;
    border-radius: 12px;
    padding: 18px 22px;
    box-sizing: border-box;
}

.col-left-overview {
    flex: 5;
    margin-right: 16px;
}

.col-right-overview {
    flex: 6;
    margin-right: 0;
    background-color: #070d1b;
}

.col-half-left {
    flex: 1;
    margin-right: 16px;
}

.col-half-right {
    flex: 1;
    margin-right: 0;
}

.action-deck-card {
    display: block;
    width: 100%;
    height: 100%;
    background-color: #0c1425;
    border-width: 2px;
    border-color: #1e293b;
    border-radius: 12px;
    padding: 16px 22px;
    box-sizing: border-box;
}

.card-flex-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
}

.section-header-slot {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    margin-bottom: 10px;
    box-sizing: border-box;
}

.panel-section-title {
    display: block;
    font-size: 19px;
    font-weight: bold;
    color: #38bdf8;
    text-transform: uppercase;
    border-bottom-width: 2px;
    border-bottom-color: #1e293b;
    padding-bottom: 8px;
}

/* ============================================================================
   Telemetry Rows (Large High-Contrast Key/Value Pairs)
   ============================================================================ */
.stat-row-slot {
    display: block;
    flex: 1;
    width: 100%;
    border-bottom-width: 1px;
    border-bottom-color: #162238;
    box-sizing: border-box;
}

.stat-row-last {
    border-bottom-width: 0;
}

.stat-row-flex {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 100%;
    padding: 4px 0;
    box-sizing: border-box;
}

.stat-label {
    float: none;
    display: block;
    color: #94a3b8;
    font-size: 18px;
    font-weight: bold;
}

.stat-val {
    float: none;
    display: block;
    color: #f8fafc;
    font-weight: bold;
    font-size: 19px;
    text-align: right;
}

.font-accent {
    color: #4ade80;
}

.font-blue {
    color: #38bdf8;
}

.font-warn {
    color: #fbbf24;
}

.font-danger {
    color: #f87171;
}

.font-mono {
    font-family: Courier, monospace;
}

/* ============================================================================
   Action Tiles Deck (Tabs 2, 3, 4)
   ============================================================================ */
.deck-tiles-slot {
    display: block;
    flex: 1;
    width: 100%;
    box-sizing: border-box;
}

.deck-tiles-row {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
}

.tile-btn {
    display: block;
    flex: 1;
    margin-right: 14px;
    padding: 16px 20px;
    border-radius: 10px;
    border-width: 2px;
    background-color: #0f1f38;
    border-color: #0284c7;
    cursor: pointer;
    box-sizing: border-box;
}

.tile-btn:hover {
    background-color: #0369a1;
    border-color: #7dd3fc;
}

.tile-amber {
    background-color: #271a07;
    border-color: #d97706;
}

.tile-amber:hover {
    background-color: #b45309;
    border-color: #fcd34d;
}

.tile-emerald {
    background-color: #07261d;
    border-color: #10b981;
}

.tile-emerald:hover {
    background-color: #047857;
    border-color: #6ee7b7;
}

.tile-last {
    margin-right: 0;
}

.tile-title {
    display: block;
    font-size: 21px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 6px;
}

.tile-sub {
    display: block;
    font-size: 15px;
    color: #cbd5e1;
}

/* ============================================================================
   Log Stream & Interactive Console Terminal (Tabs 1 & 5)
   ============================================================================ */
.terminal-fill-slot {
    display: block;
    flex: 1;
    width: 100%;
    box-sizing: border-box;
}

.terminal-console-slot {
    display: block;
    flex: 1;
    width: 100%;
    margin-bottom: 14px;
    box-sizing: border-box;
}

.log-terminal {
    display: block;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    background-color: #030712;
    border-width: 1px;
    border-color: #1e293b;
    border-radius: 10px;
    padding: 14px 18px;
    font-family: Courier, monospace;
    font-size: 16px;
    line-height: 25px;
    overflow-y: auto;
}

.console-terminal-large {
    display: block;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    background-color: #030712;
    border-width: 2px;
    border-color: #1e293b;
    border-radius: 12px;
    padding: 18px 22px;
    font-family: Courier, monospace;
    font-size: 17px;
    line-height: 26px;
    overflow-y: auto;
}

.log-line {
    display: block;
    margin-bottom: 6px;
    line-height: 24px;
}

.log-info {
    color: #cbd5e1;
}

.log-ok {
    color: #4ade80;
}

.log-warn {
    color: #fbbf24;
}

.log-error {
    color: #f87171;
}

.log-heal {
    color: #38bdf8;
    font-weight: bold;
}

.input-bar-slot {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    margin-bottom: 12px;
    box-sizing: border-box;
}

.console-input-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    background-color: #0c1425;
    border-width: 2px;
    border-color: #38bdf8;
    border-radius: 10px;
    padding: 10px 16px;
    box-sizing: border-box;
}

.console-prompt {
    float: none;
    display: block;
    flex: 0 0 auto;
    color: #38bdf8;
    font-weight: bold;
    font-size: 24px;
    margin-right: 14px;
    font-family: Courier, monospace;
}

.input-field-slot {
    display: block;
    flex: 1;
    margin-right: 14px;
    box-sizing: border-box;
}

.console-input {
    float: none;
    display: block;
    width: 100%;
    height: 46px;
    box-sizing: border-box;
    background-color: #050a14;
    border-width: 1px;
    border-color: #334155;
    border-radius: 8px;
    color: #38bdf8;
    font-size: 18px;
    font-weight: bold;
    font-family: Courier, monospace;
    padding: 8px 14px;
}

.btn-exec {
    float: none;
    display: block;
    flex: 0 0 auto;
    background-color: #16a34a;
    border-width: 1px;
    border-color: #4ade80;
    border-radius: 8px;
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
    padding: 12px 28px;
    cursor: pointer;
    text-align: center;
}

.btn-exec:hover {
    background-color: #15803d;
}

.chips-slot {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    box-sizing: border-box;
}

.chips-row {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    box-sizing: border-box;
}

.chip-btn {
    float: none;
    display: block;
    flex: 1;
    background-color: #131f35;
    color: #38bdf8;
    border-width: 1px;
    border-color: #334155;
    border-radius: 8px;
    padding: 12px 10px;
    margin-right: 10px;
    font-size: 15px;
    font-weight: bold;
    font-family: Courier, monospace;
    text-align: center;
    cursor: pointer;
    box-sizing: border-box;
}

.chip-btn:hover {
    background-color: #0284c7;
    border-color: #7dd3fc;
    color: #ffffff;
}

.chip-clear {
    background-color: #2a1215;
    color: #fca5a5;
    border-color: #b91c1c;
    margin-right: 0;
}

.chip-clear:hover {
    background-color: #dc2626;
    border-color: #fca5a5;
    color: #ffffff;
}

/* ============================================================================
   Footer Bar (Back to Cockpit + Diagnostics Actions + Close)
   ============================================================================ */
.footer-slot {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    margin-top: 14px;
    box-sizing: border-box;
}

.console-footer {
    position: static;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    border-top-width: 2px;
    border-top-color: #1e293b;
    padding-top: 14px;
    box-sizing: border-box;
}

.footer-actions {
    float: none;
    display: block;
    flex: 0 0 auto;
}

.footer-right {
    float: none;
    display: block;
    flex: 0 0 auto;
}

.btn {
    display: inline-block;
    padding: 12px 26px;
    border-radius: 10px;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    text-align: center;
    margin-right: 14px;
    vertical-align: middle;
    border-width: 2px;
    border-color: #38bdf8;
    background-color: #0284c7;
    color: #ffffff;
}

.btn-back {
    background-color: #0f172a;
    border-color: #38bdf8;
    color: #38bdf8;
}

.btn-back:hover {
    background-color: #0284c7;
    border-color: #7dd3fc;
    color: #ffffff;
}

.btn-action {
    background-color: #0284c7;
    border-color: #38bdf8;
    color: #ffffff;
}

.btn-action:hover {
    background-color: #0369a1;
    border-color: #7dd3fc;
}

.btn-warn {
    background-color: #d97706;
    border-color: #fbbf24;
    color: #ffffff;
}

.btn-warn:hover {
    background-color: #b45309;
}

.btn-danger {
    background-color: #dc2626;
    border-color: #f87171;
    color: #ffffff;
}

.btn-danger:hover {
    background-color: #b91c1c;
}

.btn-secondary {
    float: none;
    background-color: #1e293b;
    border-color: #475569;
    color: #f8fafc;
    margin-right: 0;
}

.btn-secondary:hover {
    background-color: #334155;
    border-color: #94a3b8;
}

/* ============================================================================
   Responsive Scaling: 1440p / QHD (min-width: 2200px)
   ============================================================================ */
@media (min-width: 2200px) {
    #tao-console-window {
        padding: 26px 36px;
    }

    .btn-header-back {
        font-size: 21px;
        padding: 11px 24px;
    }

    .console-title {
        font-size: 32px;
    }

    .header-pill {
        font-size: 16px;
        padding: 7px 16px;
    }

    .console-close {
        font-size: 21px;
        padding: 12px 28px;
    }

    .badge {
        padding: 14px 18px;
    }

    .badge-text {
        font-size: 19px;
    }

    .tab-btn {
        font-size: 23px;
        padding: 18px 16px;
    }

    .panel-section-title {
        font-size: 23px;
    }

    .stat-label {
        font-size: 21px;
    }

    .stat-val {
        font-size: 23px;
    }

    .tile-title {
        font-size: 25px;
    }

    .tile-sub {
        font-size: 18px;
    }

    .log-terminal {
        font-size: 19px;
        line-height: 29px;
    }

    .console-terminal-large {
        font-size: 20px;
        line-height: 30px;
    }

    .console-input {
        height: 54px;
        font-size: 21px;
    }

    .btn-exec {
        font-size: 21px;
        padding: 15px 34px;
    }

    .chip-btn {
        font-size: 18px;
        padding: 14px 12px;
    }

    .btn {
        font-size: 21px;
        padding: 15px 32px;
    }
}

/* ============================================================================
   Responsive Scaling: 4K UHD (min-width: 3200px)
   ============================================================================ */
@media (min-width: 3200px) {
    #tao-console-window {
        padding: 34px 48px;
        border-width: 3px;
    }

    .btn-header-back {
        font-size: 26px;
        padding: 14px 32px;
    }

    .console-title {
        font-size: 40px;
    }

    .header-pill {
        font-size: 20px;
        padding: 9px 22px;
    }

    .console-close {
        font-size: 26px;
        padding: 16px 36px;
    }

    .badge {
        padding: 18px 22px;
    }

    .badge-dot {
        width: 18px;
        height: 18px;
        border-radius: 9px;
    }

    .badge-text {
        font-size: 24px;
    }

    .tab-btn {
        font-size: 28px;
        padding: 22px 20px;
    }

    .panel-section-title {
        font-size: 28px;
    }

    .stat-label {
        font-size: 26px;
    }

    .stat-val {
        font-size: 28px;
    }

    .tile-title {
        font-size: 32px;
    }

    .tile-sub {
        font-size: 22px;
    }

    .log-terminal {
        font-size: 24px;
        line-height: 36px;
    }

    .console-terminal-large {
        font-size: 25px;
        line-height: 38px;
    }

    .console-input {
        height: 68px;
        font-size: 26px;
    }

    .btn-exec {
        font-size: 26px;
        padding: 18px 42px;
    }

    .chip-btn {
        font-size: 22px;
        padding: 18px 14px;
    }

    .btn {
        font-size: 26px;
        padding: 18px 40px;
    }
}

/* ============================================================================
   Responsive Scaling: Compact / 720p Windowed (max-height: 860px)
   ============================================================================ */
@media (max-height: 860px) {
    #tao-console-window {
        padding: 12px 18px;
    }

    .console-header {
        padding-bottom: 8px;
        margin-bottom: 8px;
    }

    .btn-header-back {
        font-size: 14px;
        padding: 6px 14px;
        margin-right: 12px;
    }

    .console-title {
        font-size: 20px;
    }

    .header-pill {
        font-size: 11px;
        padding: 4px 10px;
    }

    .console-close {
        font-size: 14px;
        padding: 6px 16px;
    }

    .badges-slot {
        margin-bottom: 8px;
    }

    .badge {
        padding: 6px 10px;
    }

    .badge-text {
        font-size: 13px;
    }

    .tabs-slot {
        margin-bottom: 8px;
    }

    .tab-btn {
        font-size: 15px;
        padding: 8px 10px;
    }

    .col-card, .action-deck-card {
        padding: 10px 14px;
    }

    .panel-section-title {
        font-size: 14px;
        padding-bottom: 4px;
    }

    .stat-label {
        font-size: 14px;
    }

    .stat-val {
        font-size: 15px;
    }

    .tile-btn {
        padding: 8px 12px;
    }

    .tile-title {
        font-size: 16px;
        margin-bottom: 2px;
    }

    .tile-sub {
        font-size: 12px;
    }

    .log-terminal, .console-terminal-large {
        font-size: 13px;
        line-height: 19px;
        padding: 10px 12px;
    }

    .console-input {
        height: 34px;
        font-size: 14px;
    }

    .btn-exec {
        font-size: 14px;
        padding: 8px 18px;
    }

    .chip-btn {
        font-size: 12px;
        padding: 7px 6px;
    }

    .footer-slot {
        margin-top: 8px;
    }

    .console-footer {
        padding-top: 8px;
    }

    .btn {
        font-size: 14px;
        padding: 7px 16px;
    }
}
