<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <BuildInParallel>true</BuildInParallel>
    <VSTestNoLogo>true</VSTestNoLogo>
    <!-- Suppress RS0030 (Banned Symbols) in test harnesses to permit sync xUnit wrappers & microbenchmarks -->
    <NoWarn>$(NoWarn);RS0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
    <Compile Include="$(MSBuildThisFileDirectory)shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <AssemblyAttribute Include="Xunit.TestFrameworkAttribute">
      <_Parameter1>ASPIRE.Tests.Infrastructure.WinnerTestFramework</_Parameter1>
      <_Parameter2>$(AssemblyName)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
