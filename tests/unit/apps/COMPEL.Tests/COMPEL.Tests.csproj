    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\apps\compel\COMPEL.csproj"/>
    <ProjectReference Include="..\..\..\..\src\libs\protocol-core\Kongor.Core.csproj"/>
  </ItemGroup>

</Project>
