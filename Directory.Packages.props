    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <!-- LICENSE CEILING: Keep FluentAssertions < 8.0.0 (7.x is last Apache-2.0 release before Xceed commercial license) -->
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <PackageVersion Include="CsCheck" Version="4.4.1" />
    <PackageVersion Include="Testcontainers" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.3.0" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="Verify.Xunit" Version="31.12.5" />
    <PackageVersion Include="Verify.ImageMagick" Version="3.11.0" />
    <!-- Security Transitive Pinning -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Magick.NET-Q16-AnyCPU" Version="14.17.2" />
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Common" Version="11.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0" />
  </ItemGroup>
</Project>
