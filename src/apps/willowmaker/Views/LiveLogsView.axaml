<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WILLOWMAKER.Core.ViewModels"
             xmlns:models="clr-namespace:WILLOWMAKER.Core.Services.Models"
             mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="680"
             x:Class="WILLOWMAKER.Core.Views.LiveLogsView"
             x:DataType="vm:LiveLogsViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="15">

        <!-- Controls & Filters Top Bar -->
        <Border Grid.Row="0" Background="#1A1D24" BorderBrush="#2A2F3D" BorderThickness="1" CornerRadius="8"
                Margin="0,0,0,10" Padding="12">
            <StackPanel Spacing="8">
                <!-- Search Box -->
                <TextBox Text="{Binding SearchText}" Watermark="🔍 Search log messages, categories, or keywords..."
                         Margin="0,0,0,4" Background="#111318" Foreground="#F1F5F9" BorderBrush="#334155" />

                <!-- Filters & Action Buttons Toolbar -->
                <WrapPanel Orientation="Horizontal">
                    <!-- Category Filter Dropdown -->
                    <ComboBox ItemsSource="{Binding AvailableCategoryFilters}"
                              SelectedItem="{Binding SelectedCategoryFilter}" Margin="0,0,8,8" Width="160"
                              Background="#111318" Foreground="#F1F5F9" />

                    <!-- Level Filter Dropdown -->
                    <ComboBox ItemsSource="{Binding AvailableLevelFilters}"
                              SelectedItem="{Binding SelectedLevelFilter}" Margin="0,0,8,8" Width="130"
                              Background="#111318" Foreground="#F1F5F9" />

                    <!-- Mask / Reveal Paths Button -->
                    <Button Command="{Binding ToggleGlobalPathMaskingCommand}" Margin="0,0,8,8"
                            Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1"
                            CornerRadius="6" Padding="10,6"
                            ToolTip.Tip="Toggle censoring of hardcoded filesystem user paths in view">
                        <TextBlock Text="{Binding MaskPathsButtonText}" FontSize="12" FontWeight="SemiBold" />
                    </Button>

                    <!-- Copy Logs Button -->
                    <Button Command="{Binding CopyLogsCommand}" Margin="0,0,8,8"
                            Background="#0284C7" Foreground="#FFFFFF" BorderBrush="#0369A1" BorderThickness="1"
                            CornerRadius="6" Padding="10,6"
                            ToolTip.Tip="Copy raw full logs (with all exact paths) to clipboard">
                        <TextBlock Text="📋 Copy Logs" FontSize="12" FontWeight="Bold" />
                    </Button>

                    <!-- Filter by Mods Category Shortcut -->
                    <Button Command="{Binding FilterByModsCategoryCommand}" Margin="0,0,8,8"
                            Background="#1E1B4B" Foreground="#A5B4FC" BorderBrush="#6366F1" BorderThickness="1"
                            CornerRadius="6" Padding="10,6"
                            ToolTip.Tip="Quick Filter: Show only Project KONGOR Mod Manager &amp; Avatar logs">
                        <TextBlock Text="🎮 Mods Filter" FontSize="12" FontWeight="Bold" />
                    </Button>

                    <!-- Export Bug / Diagnostic Zip Button -->
                    <Button Command="{Binding ExportBugZipCommand}" Margin="0,0,8,8"
                            Background="#4C1D95" Foreground="#E9D5FF" BorderBrush="#7C3AED" BorderThickness="1"
                            CornerRadius="6" Padding="10,6"
                            ToolTip.Tip="Export privacy-scrubbed Discord bug report zip (&lt;= 8 MB) or live freeze capture">
                        <TextBlock Text="📦 Export Bug Zip" FontSize="12" FontWeight="Bold" />
                    </Button>

                    <!-- Clear Logs Button -->
                    <Button Command="{Binding ClearLogsCommand}" Margin="0,0,8,8"
                            Background="#334155" Foreground="#CBD5E1" BorderBrush="#475569" BorderThickness="1"
                            CornerRadius="6" Padding="10,6">
                        <TextBlock Text="🗑 Clear" FontSize="12" />
                    </Button>

                    <!-- Log Counter Badge -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6"
                            Padding="10,6" Margin="0,0,8,8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LogCount, StringFormat='{}{0} lines'}" FontSize="12"
                                   Foreground="#38BDF8" FontWeight="Bold" />
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Copied Notification Toast -->
        <Border Grid.Row="1" IsVisible="{Binding IsCopyNotificationVisible}" Background="#064E3B" BorderBrush="#10B981"
                BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <TextBlock Text="{Binding CopyNotificationText}" Foreground="#34D399" FontWeight="Bold" FontSize="12"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- Status / Error Banner (Green "100% ERROR FREE" / Red "EACH ERROR IS ONE STEP CLOSER") -->
        <Border Grid.Row="2"
                Background="{Binding ErrorBannerBackground}"
                BorderBrush="{Binding ErrorBannerBorder}"
                BorderThickness="1.5"
                CornerRadius="8"
                Padding="14,8"
                Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorBannerText}"
                               Foreground="{Binding ErrorBannerForeground}"
                               FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                               FontWeight="Bold"
                               FontSize="13"
                               LetterSpacing="0.5" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#0A1120"
                        BorderBrush="{Binding ErrorBannerBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorCount, StringFormat='{}{0} Errors'}"
                               Foreground="{Binding ErrorBannerForeground}"
                               FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                               FontSize="11"
                               FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <!-- Live Terminal Output Area (Website Dark Slate Terminal) -->
        <Border Grid.Row="3" Background="#06090E" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1"
                Padding="12">
            <ListBox ItemsSource="{Binding FilteredLogs}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:WillowmakerLogMessage">
                        <Border Background="Transparent" Padding="4,2">
                            <SelectableTextBlock Text="{Binding MaskedDisplayText}"
                                                 FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                                                 FontSize="12"
                                                 LineHeight="18"
                                                 Foreground="#E2E8F0"
                                                 TextWrapping="Wrap" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="2,1" />
                        <Setter Property="MinHeight" Value="20" />
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Border>

    </Grid>
</UserControl>
