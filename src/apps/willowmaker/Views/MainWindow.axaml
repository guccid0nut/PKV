<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WILLOWMAKER.Core.Views"
        mc:Ignorable="d" d:DesignWidth="1280" Width="1280" d:DesignHeight="800" Height="800"
        MinWidth="1024" MinHeight="700"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        x:Class="WILLOWMAKER.Core.Views.MainWindow"
        Icon="/Assets/willowmaker.png"
        Title="WILLOWMAKER - Project KONGOR">

    <views:MainView />
</Window>
