<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WILLOWMAKER.Core.Views.LocationGuardDialog"
        Title="Dangerous Location"
        Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="#F2131418">

    <StackPanel Margin="25">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0, 0, 0, 15" />
        <Expander x:Name="DetailsExpander" Header="More Information" IsExpanded="False" Margin="0, 0, 0, 15"
                  HorizontalAlignment="Stretch">
            <StackPanel Spacing="10">
                <TextBlock x:Name="ReasonHeading" Text="Reason" FontWeight="SemiBold" />
                <TextBlock x:Name="ReasonText" TextWrapping="Wrap" />
                <TextBlock x:Name="ForeignEntriesHeading" Text="Foreign Entries" FontWeight="SemiBold"
                           Margin="0, 5, 0, 0" />
                <ScrollViewer x:Name="ForeignEntriesScroll" MaxHeight="180" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ForeignEntriesText" TextWrapping="Wrap"
                               FontFamily="Cascadia Mono, Consolas, Menlo, Monospace" />
                </ScrollViewer>
            </StackPanel>
        </Expander>
        <Border Background="#0D1524" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="6" Padding="10, 8"
                Margin="0, 0, 0, 12">
            <StackPanel Spacing="4">
                <TextBlock Text="Recommended Safe Folder (1-Click Self-Relocate)" FontSize="11" FontWeight="Bold"
                           Foreground="#38BDF8" />
                <TextBlock x:Name="RelocationTargetText" FontSize="10.5" Foreground="#CBD5E1" TextWrapping="Wrap"
                           FontFamily="Cascadia Mono, Consolas, Menlo, Monospace" />
                <TextBlock x:Name="RelocationStatusText" FontSize="10.5" Foreground="#34D399" TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="SelfRelocateButton" Content="Move to Safe Folder" Click="SelfRelocate_Click"
                    Background="#0284C7" Foreground="#FFFFFF" Cursor="Hand" Padding="14, 0" Height="32"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#0369A1" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                </Button.Styles>
            </Button>
            <Button x:Name="ExitButton" Content="Exit" Click="OK_Click" Background="#334155" Foreground="#E2E8F0"
                    Cursor="Hand" Width="90" Height="32"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#475569" />
                        <Setter Property="FontWeight" Value="Medium" />
                    </Style>
                </Button.Styles>
            </Button>
        </StackPanel>
    </StackPanel>

</Window>
