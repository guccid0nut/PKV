<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WILLOWMAKER.Core.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="650"
             x:Class="WILLOWMAKER.Core.Views.ReplayConverterView"
             x:DataType="vm:ReplayConverterViewModel">

    <Design.DataContext>
        <vm:ReplayConverterViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="20" Background="#131722">
        <!-- Section Header -->
        <TextBlock Grid.Row="0" Text="🎬 NEXUS REPLAY TO MP4 CONVERTER TOOL" FontSize="18" FontWeight="Bold"
                   Foreground="#38BDF8" Margin="0, 0, 0, 15"
                   FontFamily="Cascadia Mono, Consolas, Courier New, monospace" />

        <!-- Input Configuration Controls -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" Margin="0, 0, 0, 15">
            <!-- Replay File Input -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0, 0, 10, 10">
                <Label Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold">Replay File Path (.honreplay) [Protected &amp; Sanitized]</Label>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Text="{Binding ReplayFilePath}" Background="#1E293B" Foreground="#F8FAFC"
                             BorderBrush="#334155" Height="36" Padding="8, 6" Margin="0, 0, 8, 0"
                             Watermark="Select or browse for .honreplay file..." />
                    <Button Grid.Column="1" Command="{Binding BrowseReplayFileCommand}"
                            Background="#334155" Foreground="#38BDF8" Height="36" Padding="12, 0" CornerRadius="4" Cursor="Hand"
                            FontWeight="SemiBold" VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="📁" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Browse..." FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Output Folder Input -->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10, 0, 0, 10">
                <Label Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold">Output Destination Folder [Protected]</Label>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Text="{Binding OutputDirectoryPath}" Background="#1E293B" Foreground="#F8FAFC"
                             BorderBrush="#334155" Height="36" Padding="8, 6" Margin="0, 0, 8, 0"
                             Watermark="Select output destination directory..." />
                    <Button Grid.Column="1" Command="{Binding BrowseOutputDirectoryCommand}"
                            Background="#334155" Foreground="#38BDF8" Height="36" Padding="12, 0" CornerRadius="4" Cursor="Hand"
                            FontWeight="SemiBold" VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="📂" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Browse..." FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Quality Preset Selection -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0, 0, 10, 0">
                <Label Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold">Video Quality Preset</Label>
                <ComboBox SelectedItem="{Binding SelectedQualityPreset}" ItemsSource="{Binding QualityPresets}"
                          HorizontalAlignment="Stretch" Background="#1E293B" Foreground="#F8FAFC" Height="36"
                          Cursor="Hand" />
            </StackPanel>

            <!-- POV Camera Perspective -->
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10, 0, 0, 0">
                <Label Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold">Spectator Camera Perspective</Label>
                <ComboBox SelectedItem="{Binding SelectedPovCamera}" ItemsSource="{Binding PovCameraOptions}"
                          HorizontalAlignment="Stretch" Background="#1E293B" Foreground="#F8FAFC" Height="36"
                          Cursor="Hand" />
            </StackPanel>
        </Grid>

        <!-- Status & Progress Section -->
        <StackPanel Grid.Row="2" Margin="0, 0, 0, 15">
            <Grid ColumnDefinitions="*, Auto" Margin="0, 0, 0, 6">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#34D399" FontSize="12"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}"
                           Foreground="#38BDF8" FontSize="12" FontWeight="Bold" />
            </Grid>
            <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="10" Foreground="#0284C7"
                         Background="#1E293B" CornerRadius="4" />

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0, 15, 0, 0" HorizontalAlignment="Right">
                <Button Command="{Binding WatchInGameClientCommand}"
                        Background="#7C3AED" Foreground="White" Width="200" Height="40" CornerRadius="6" Cursor="Hand"
                        FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="Launch authentic native HoN game engine in 3D Replay mode">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🎮" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="Watch in Game Engine" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenInReplayStudioCommand}"
                        Background="#0284C7" Foreground="White" Width="200" Height="40" CornerRadius="6" Cursor="Hand"
                        FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="Open interactive 3D Vulkan Replay Studio">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🎥" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="Open in Replay Studio" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StartConversionCommand}" IsEnabled="{Binding !IsConverting}"
                        Background="#047857" Foreground="White" Width="180" Height="40" CornerRadius="6" Cursor="Hand"
                        FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="▶" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="Convert to MP4" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CancelConversionCommand}" IsEnabled="{Binding IsConverting}"
                        Background="#B91C1C" Foreground="White" Width="120" Height="40" CornerRadius="6" Cursor="Hand"
                        FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="Cancel" FontSize="13" />
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Live Service Terminal Log & Search Header -->
        <Grid Grid.Row="3" RowDefinitions="Auto, *">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="0, 0, 0, 6">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Label Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" VerticalAlignment="Center">Live Output Log</Label>
                </StackPanel>

                <!-- Log Search Bar -->
                <TextBox Grid.Column="1" Text="{Binding SearchQuery}" Watermark="🔍 Search log entries..." Width="220"
                         Height="30" Margin="0, 0, 8, 0" Background="#1E293B" Foreground="#F8FAFC"
                         BorderBrush="#334155" FontSize="11" Padding="6, 4" />

                <!-- Copy Logs Button -->
                <Button Grid.Column="2" Command="{Binding CopyLogsCommand}" Background="#334155" Foreground="#38BDF8"
                        Height="30" CornerRadius="4" Padding="10, 4" Cursor="Hand"
                        ToolTip.Tip="Copy all replay log output to system clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="📋 Copy Logs" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="#0A0D14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6"
                    Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding FilteredLogText}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas, Courier New, monospace" FontSize="11" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
