<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NEXUS.ControlPanel.GUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="850"
             x:Class="NEXUS.ControlPanel.GUI.Views.SecretsConfigView"
             x:DataType="vm:SecretsConfigViewModel">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="24">

                <!-- Header Toolbar -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="SECRETS &amp; CONFIGURATION VAULT" FontSize="18" FontWeight="Black"
                                   Foreground="#00F0FF" LetterSpacing="1" />
                        <TextBlock
                            Text="Manage credentials, network ports, local paths, COMPEL launcher, and telemetry securely across all solution User Secrets stores."
                            FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Classes="secondary" Command="{Binding ApplyRecommendedBaselineCommand}"
                                Margin="0,0,8,0">
                            <TextBlock Text="⚡ Reset to Defaults" FontSize="12" />
                        </Button>
                        <Button Classes="secondary" Command="{Binding DiscardChangesCommand}"
                                IsVisible="{Binding HasChanges}" Margin="0,0,8,0" BorderBrush="#EF4444">
                            <TextBlock Text="🗑️ Discard Changes" FontSize="12" Foreground="#EF4444" />
                        </Button>
                        <Button Classes="primary" Command="{Binding SaveSecretsCommand}"
                                IsVisible="{Binding HasChanges}">
                            <TextBlock Text="💾 Save All Changes" FontSize="12" FontWeight="Bold" Foreground="#0B0F17" />
                        </Button>
                    </WrapPanel>
                </Grid>

                <!-- Feedback Status Banner -->
                <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="12"
                        IsVisible="{Binding IsStatusBannerVisible}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding StatusBannerText}" Foreground="#A7F3D0"
                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="secondary" Padding="8,2"
                                Command="{Binding DismissStatusBannerCommand}">
                            <TextBlock Text="✕" FontSize="11" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Vault ⇄ .env ⇄ OS environment drift banner -->
                <Border Background="#451A03" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="12"
                        IsVisible="{Binding IsDriftBannerVisible}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="⚠️ Configuration drift detected" FontWeight="Bold" FontSize="13"
                                       Foreground="#FCD34D" />
                            <TextBlock Text="{Binding DriftBannerText}" Foreground="#FDE68A" FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Padding="10,4" Margin="8,0,0,0"
                                VerticalAlignment="Center" IsVisible="{Binding CanReconcileDrift}"
                                Command="{Binding ReconcileDriftCommand}"
                                ToolTip.Tip="Regenerate the repo-root .env from the user-secrets vault">
                            <TextBlock Text="🔁 Reconcile" FontSize="11" Foreground="#FCD34D" />
                        </Button>
                        <Button Grid.Column="2" Classes="secondary" Padding="8,2" Margin="6,0,0,0"
                                VerticalAlignment="Center" Command="{Binding DismissDriftBannerCommand}">
                            <TextBlock Text="✕" FontSize="11" />
                        </Button>
                    </Grid>
                </Border>

                <!-- First-run setup checklist -->
                <Border Background="#0C1A2E" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Padding="12"
                        IsVisible="{Binding HasSetupChecklist}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="🧭 Setup checklist: these still need values" FontWeight="Bold"
                                   FontSize="13" Foreground="#7DD3FC" />
                        <TextBlock Text="{Binding SetupChecklistText}" Foreground="#BAE6FD" FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 0. Master Server & Infrastructure Gateway Card -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="🌐 Master Server &amp; Infrastructure Gateway" FontWeight="Bold"
                                           FontSize="14" Foreground="#00F0FF" />
                                <TextBlock Text="— Primary authentication &amp; API gateway for HoN clients and COMPEL"
                                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Classes="primary" Padding="8,4" Command="{Binding SaveSecretsCommand}"
                                        IsVisible="{Binding HasMasterServerChanges}" Margin="0,0,6,0"
                                        ToolTip.Tip="Save Master Server Changes">
                                    <TextBlock Text="💾 Save Section" FontSize="11" FontWeight="Bold"
                                               Foreground="#0B0F17" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding CopyMasterServerAddressCommand}"
                                        ToolTip.Tip="Copy Master Server Address" Margin="0,0,6,0">
                                    <TextBlock Text="📋 Copy Address" FontSize="11" Foreground="#38BDF8" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding OpenMasterServerInBrowserCommand}"
                                        ToolTip.Tip="Open Master Server Swagger in Browser" Margin="0,0,6,0">
                                    <TextBlock Text="🌐 Swagger UI" FontSize="11" Foreground="#10B981" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4" Command="{Binding ShowDocCommand}"
                                        CommandParameter="masterserver"
                                        ToolTip.Tip="View Master Server Setup Documentation">
                                    <TextBlock Text="❓ Guide" FontSize="11" Foreground="#00F0FF" />
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock
                                    Text="Master Server Base URL / Address (e.g. http://localhost:55555 or https://api.kongor.net)"
                                    FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding MasterServerAddress}"
                                             PasswordChar="{Binding MasterServerAddressMask}"
                                             Watermark="http://localhost:55555" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="master-server-address" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Preset Quick Select Chips -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Quick Presets" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Classes="secondary" Padding="6,3" Margin="0,0,4,0"
                                            Command="{Binding SetPresetMasterServerAddressCommand}"
                                            CommandParameter="http://localhost:55555"
                                            ToolTip.Tip="Default Local Aspire (55555)">
                                        <TextBlock Text="Localhost" FontSize="10.5" />
                                    </Button>
                                    <Button Classes="secondary" Padding="6,3" Margin="0,0,4,0"
                                            Command="{Binding SetPresetMasterServerAddressCommand}"
                                            CommandParameter="http://127.0.0.1:55555" ToolTip.Tip="127.0.0.1 (55555)">
                                        <TextBlock Text="127.0.0.1" FontSize="10.5" />
                                    </Button>
                                    <Button Classes="secondary" Padding="6,3" Margin="0,0,4,0"
                                            Command="{Binding SetPresetMasterServerAddressCommand}"
                                            CommandParameter="https://api.kongor.net"
                                            ToolTip.Tip="KONGOR Master Server (https://api.kongor.net)">
                                        <TextBlock Text="KONGOR" FontSize="10.5" Foreground="#00F0FF" />
                                    </Button>
                                    <Button Classes="secondary" Padding="6,3"
                                            Command="{Binding SetPresetMasterServerAddressCommand}"
                                            CommandParameter="https://masterserver.newbs.io"
                                            ToolTip.Tip="NEWBS Master Server (https://masterserver.newbs.io)">
                                        <TextBlock Text="newbs" FontSize="10.5" Foreground="#F59E0B" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Infrastructure Gateway Hostname (Infrastructure:Gateway)" FontSize="11"
                                       FontWeight="Bold" Foreground="#94A3B8" />
                            <TextBox Text="{Binding InfrastructureGateway}" Watermark="masterserver.newbs.io" />
                            <TextBlock Text="🌐 Public hostname game clients and COMPEL use to reach the master server."
                                       FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 1. Discord Authentication Card -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="👾 Discord Authentication (Primary Login)" FontWeight="Bold"
                                           FontSize="14" Foreground="#A855F7" />
                                <TextBlock Text="— Required for Web Portal user login" FontSize="11"
                                           Foreground="#64748B" VerticalAlignment="Center" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Classes="primary" Padding="8,4" Command="{Binding SaveSecretsCommand}"
                                        IsVisible="{Binding HasOAuthChanges}" Margin="0,0,6,0"
                                        ToolTip.Tip="Save Discord OAuth2 Settings">
                                    <TextBlock Text="💾 Save Section" FontSize="11" FontWeight="Bold"
                                               Foreground="#0B0F17" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding OpenDiscordDeveloperPortalCommand}"
                                        ToolTip.Tip="Open Discord Developer Portal" Margin="0,0,6,0">
                                    <TextBlock Text="🌐 Dev Portal" FontSize="11" Foreground="#A855F7" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding CopyDiscordRedirectUriCommand}"
                                        ToolTip.Tip="Copy Redirect URI (https://localhost:5557/signin-discord)"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="📋 Copy Redirect URI" FontSize="11" Foreground="#38BDF8" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4" Command="{Binding ShowDocCommand}"
                                        CommandParameter="discord" ToolTip.Tip="View Discord Setup Documentation">
                                    <TextBlock Text="❓ Guide" FontSize="11" Foreground="#00F0FF" />
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <!-- Prompt Notice if Not Configured -->
                        <Border IsVisible="{Binding !IsDiscordConfigured}" Background="#451A03" BorderBrush="#F59E0B"
                                BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="Discord OAuth2 App Keys Required: Enter your Discord Client ID &amp; Secret below to enable Web Portal login."
                                           FontSize="11" Foreground="#FDE68A" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                            <!-- Client ID -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="Discord Application / Client ID (Numeric Snowflake — Web Portal Login &amp; WILLOWMAKER Rich Presence)"
                                           FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding DiscordClientId}"
                                             PasswordChar="{Binding DiscordClientIdMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="discord-client-id" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Client Secret -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="Discord Client Secret" FontSize="11" FontWeight="Bold"
                                           Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding DiscordClientSecret}"
                                             PasswordChar="{Binding DiscordClientSecretMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="discord-client-secret" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. COMPEL & Local Asset Paths Card -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="🎮 COMPEL Game Server &amp; WILLOWMAKER Game Client"
                                       FontWeight="Bold" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Classes="primary" Padding="8,4" Command="{Binding SaveSecretsCommand}"
                                        IsVisible="{Binding HasPathChanges}" Margin="0,0,6,0"
                                        ToolTip.Tip="Save Game &amp; COMPEL Path Settings">
                                    <TextBlock Text="💾 Save Section" FontSize="11" FontWeight="Bold"
                                               Foreground="#0B0F17" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding ShowDocCommand}" CommandParameter="compel"
                                        ToolTip.Tip="View COMPEL &amp; Paths Documentation">
                                    <TextBlock Text="❓ Guide" FontSize="11" Foreground="#00F0FF" />
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <!-- COMPEL Match Launcher Path -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="COMPEL Game Server Manager Directory / Executable Path" FontSize="11"
                                       FontWeight="Bold" Foreground="#94A3B8" />
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0" Text="{Binding CompelPath}"
                                         Watermark="Default relative: ../COMPEL or C:\Games\COMPEL"
                                         PasswordChar="{Binding CompelPathMask}" />
                                <Button Grid.Column="1" Classes="secondary" Command="{Binding BrowseCompelPathCommand}"
                                        Margin="4,0,0,0" Padding="12,6" ToolTip.Tip="Browse COMPEL directory">
                                    <TextBlock Text="📁 Browse..." FontSize="12" />
                                </Button>
                                <Button Grid.Column="2" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                        CommandParameter="compel-path" Margin="4,0,0,0" Padding="8,6">
                                    <TextBlock Text="👁" FontSize="12" />
                                </Button>
                            </Grid>
                            <TextBlock
                                Text="💡 Used by Aspire and the GUI to supervise and spawn dedicated game server instances."
                                FontSize="11" Foreground="#64748B" />
                        </StackPanel>

                        <!-- Host Account Credentials (Username & Password) -->
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Host Account Username (HOST_USERNAME)" FontSize="11"
                                           FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBox Text="{Binding HostAccountUserName}"
                                         Watermark="HOST" />
                                <TextBlock Text="👤 Master Server account name registered with ServerHost permissions."
                                           FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Host Account Password (HOST_PASSWORD)" FontSize="11"
                                           FontWeight="Bold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding HostAccountPassword}"
                                             Watermark="Enter host account password"
                                             PasswordChar="{Binding HostAccountPasswordMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="host-password" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                    <Button Grid.Column="2" Classes="secondary" Command="{Binding GenerateHostPasswordCommand}"
                                            Margin="4,0,0,0" Padding="10,6"
                                            ToolTip.Tip="Generate a random password. The HOST account password in the database must be updated to match.">
                                        <TextBlock Text="🎲 Generate" FontSize="11" />
                                    </Button>
                                </Grid>
                                <TextBlock
                                    Text="🔐 Password stored securely in User Secrets for SRP host authentication. If you change it, update the HOST account in the database too."
                                    FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- COMPEL Gateway & Instances -->
                        <Grid ColumnDefinitions="*,16,*,16,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="COMPEL Master Gateway (COMPEL_GATEWAY)" FontSize="11"
                                           FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBox Text="{Binding CompelGateway}"
                                         Watermark="localhost" />
                                <TextBlock
                                    Text="🌐 Entry point / hostname for COMPEL game servers."
                                    FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Server Instances Count (COMPEL_INSTANCES)" FontSize="11"
                                           FontWeight="Bold" Foreground="#94A3B8" />
                                <NumericUpDown Value="{Binding CompelInstances}" Minimum="1" Maximum="100" />
                                <TextBlock Text="⚡ Dedicated workers to spawn."
                                           FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="4">
                                <TextBlock Text="Process Priority (COMPEL_PRIORITY_MODE)" FontSize="11"
                                           FontWeight="Bold" Foreground="#94A3B8" />
                                <ComboBox ItemsSource="{Binding CompelPriorityModes}"
                                          SelectedItem="{Binding CompelPriorityMode}"
                                          HorizontalAlignment="Stretch" />
                                <TextBlock Text="🎚️ CPU priority for game server processes."
                                           FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </Grid>

                        <!-- COMPEL Authentication Token -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="COMPEL Remote Authentication Token (COMPEL_AUTHENTICATION_TOKEN)"
                                       FontSize="11"
                                       FontWeight="Bold" Foreground="#94A3B8" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBox Grid.Column="0" Text="{Binding CompelAuthenticationToken}"
                                         Watermark="Click Generate to create a strong token"
                                         PasswordChar="{Binding CompelAuthenticationTokenMask}" />
                                <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                        CommandParameter="compel-token" Margin="4,0,0,0" Padding="8,6">
                                    <TextBlock Text="👁" FontSize="12" />
                                </Button>
                                <Button Grid.Column="2" Classes="secondary" Command="{Binding GenerateCompelTokenCommand}"
                                        Margin="4,0,0,0" Padding="10,6" ToolTip.Tip="Generate a cryptographically random control-plane token (compel_ + 48 hex). Restart COMPEL after saving.">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="🎲" FontSize="11" />
                                        <TextBlock Text="Generate Token" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Classes="purple" Command="{Binding TestAuthenticationCommand}"
                                        IsEnabled="{Binding !IsTestingAuthentication}"
                                        Margin="4,0,0,0" Padding="10,6" ToolTip.Tip="Verify host account credentials and connection with Master Server to confirm hosting will succeed">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="🔑" FontSize="11" />
                                        <TextBlock Text="Test Authentication" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock
                                Text="🔐 Required by NEXUS and the Staff Portal to manage COMPEL hosts. Required in production containers."
                                FontSize="11" Foreground="#64748B" />

                            <!-- Authentication Test Live Result Banner -->
                            <Border Background="#090D16" BorderBrush="{Binding AuthenticationTestStatusBorderColor}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                                    IsVisible="{Binding AuthenticationTestFeedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="{Binding AuthenticationTestStatusIcon}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding AuthenticationTestFeedback}"
                                               Foreground="{Binding AuthenticationTestStatusColor}"
                                               FontSize="11" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- COMPEL advanced settings (formerly hand-edited in COMPEL.json) -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="⚙️ COMPEL Advanced (replaces hand-editing COMPEL.json; values here win over COMPEL.json)"
                                           FontSize="12" FontWeight="Bold" Foreground="#EC4899" TextWrapping="Wrap" />

                                <Grid ColumnDefinitions="2*,*">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                        <TextBlock Text="Game Server Name Prefix (Compel:ServerNamePrefix)" FontSize="11"
                                                   FontWeight="Bold" Foreground="#94A3B8" />
                                        <TextBox Text="{Binding CompelServerNamePrefix}" Watermark="KONGOR ARENA" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                        <TextBlock Text="Location / Region Code" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding CompelLocation}" Watermark="USE" />
                                        <TextBlock Text="Shared by Ranked &amp; Queue Arcade (USE, USW, EU, AU, BR, LAT, RU)" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="COMPEL Installation Directory (optional; defaults to the COMPEL path above)"
                                               FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding CompelInstallationDirectory}"
                                             Watermark="Leave empty to auto-detect" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*,*,*">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                        <TextBlock Text="Control Plane Port" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <NumericUpDown Value="{Binding CompelControlPlanePort}" Minimum="0"
                                                       Maximum="65535" FormatString="0" />
                                        <TextBlock Text="0 = default (11234 + offset)" FontSize="10"
                                                   Foreground="#64748B" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,6,0">
                                        <TextBlock Text="Port Range Offset" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <NumericUpDown Value="{Binding CompelPortRangeOffset}" Minimum="0"
                                                       Maximum="60000" FormatString="0" />
                                        <TextBlock Text="Shift all ports (multi-host on one machine)" FontSize="10"
                                                   Foreground="#64748B" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" Margin="6,0,6,0">
                                        <TextBlock Text="Use Proxy" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <ComboBox ItemsSource="{Binding TriStateOptions}"
                                                  SelectedItem="{Binding CompelUseProxy}"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBlock Text="blank = default (true)" FontSize="10" Foreground="#64748B" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="4" Margin="6,0,0,0">
                                        <TextBlock Text="CDN Synchronisation" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <ComboBox ItemsSource="{Binding TriStateOptions}"
                                                  SelectedItem="{Binding CompelCdnSynchronisation}"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBlock Text="blank = default (false)" FontSize="10" Foreground="#64748B" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Repository Root / Project Path (project-path; optional, auto-detected)"
                                               FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding ProjectPath}" Watermark="Leave empty to auto-detect" />

                                    <Border Background="#0B1324" BorderBrush="#14B8A6" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                                        <Grid ColumnDefinitions="2*,12,*">
                                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="🕹️ Queue Mini-Games (&quot;While You Wait&quot; Arcade)" FontSize="11"
                                                           FontWeight="Bold" Foreground="#2DD4BF" />
                                                <CheckBox IsChecked="{Binding QueueArcadeEnabled}"
                                                          Content="Enable Queue Arcade auto-join while players wait in matchmaking"
                                                          FontSize="11" Foreground="#E2E8F0" />
                                                <TextBlock Text="Auto-derives &lt;host&gt;_arc account (&lt;=15 chars) on PortOffset +250 (11484). Toggle live anytime on Dashboard."
                                                           FontSize="10" Foreground="#64748B" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Text="Queue Arcade Instances (QueueArcade:Instances)" FontSize="11"
                                                           FontWeight="Bold" Foreground="#94A3B8" />
                                                <NumericUpDown Value="{Binding QueueArcadeInstances}" Minimum="1"
                                                               Maximum="10" FormatString="0" />
                                                <TextBlock Text="#Q1 warm; #Q2+ wakes at &gt;= 80% fill" FontSize="10"
                                                           Foreground="#64748B" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- HoN / WILLOWMAKER Game Client Directory -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="WILLOWMAKER Game Client Directory (GameClient:Path / willowmaker-path)"
                                       FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0" Text="{Binding GameClientPath}"
                                         Watermark="e.g. C:\...\HoN Game Client v4.10.1 Windows Clean Installation"
                                         PasswordChar="{Binding GameClientPathMask}" />
                                <Button Grid.Column="1" Classes="secondary"
                                        Command="{Binding BrowseGameClientPathCommand}" Margin="4,0,0,0" Padding="12,6"
                                        ToolTip.Tip="Browse HoN / WILLOWMAKER client folder">
                                    <TextBlock Text="📁 Browse..." FontSize="12" />
                                </Button>
                                <Button Grid.Column="2" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                        CommandParameter="game-client-path" Margin="4,0,0,0" Padding="8,6">
                                    <TextBlock Text="👁" FontSize="12" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. Database Provider & Infrastructure Passwords Card -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="🗄️ Database Provider &amp; Infrastructure Passwords"
                                       FontWeight="Bold" FontSize="14" Foreground="#F59E0B" VerticalAlignment="Center" />
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Classes="primary" Padding="8,4" Command="{Binding SaveSecretsCommand}"
                                        IsVisible="{Binding HasDatabaseChanges}" Margin="0,0,6,0"
                                        ToolTip.Tip="Save Database &amp; Cache Passwords">
                                    <TextBlock Text="💾 Save Section" FontSize="11" FontWeight="Bold"
                                               Foreground="#0B0F17" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding ShowDocCommand}" CommandParameter="database"
                                        ToolTip.Tip="View Database Documentation">
                                    <TextBlock Text="❓ Guide" FontSize="11" Foreground="#00F0FF" />
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <!-- Provider Dropdown Selection -->
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="Active Database Provider" FontSize="11" FontWeight="Bold"
                                           Foreground="#94A3B8" />
                                <ComboBox ItemsSource="{Binding DatabaseProviders}"
                                          SelectedItem="{Binding DatabaseProvider}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock
                                    Text="💡 SQL Server uses local/container MSSQL; PostgreSQL/Supabase connects seamlessly to cloud or Docker Postgres."
                                    FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                            <!-- SQL Password -->
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="SQL Server Database Password (Local Container Only)" FontSize="11" FontWeight="Bold"
                                           Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding DatabasePassword}"
                                             PasswordChar="{Binding DatabasePasswordMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="database-password" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Redis Password -->
                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="Redis Distributed Cache Password" FontSize="11" FontWeight="Bold"
                                           Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding DistributedCachePassword}"
                                             PasswordChar="{Binding DistributedCachePasswordMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="distributed-cache-password" Margin="4,0,0,0"
                                            Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3.5 Supabase Cloud & PostgreSQL Integration Card -->
                <Border Classes="card" BorderBrush="#10B981" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="⚡ Supabase Cloud &amp; PostgreSQL Integration" FontWeight="Bold"
                                           FontSize="14" Foreground="#10B981" />
                                <TextBlock Text="— Managed Postgres database &amp; global CDN replay storage"
                                           FontSize="11" Foreground="#6EE7B7" VerticalAlignment="Center" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Classes="primary" Padding="8,4" Command="{Binding SaveSecretsCommand}"
                                        IsVisible="{Binding HasSupabaseChanges}" Margin="0,0,6,0"
                                        ToolTip.Tip="Save Supabase Settings">
                                    <TextBlock Text="💾 Save Section" FontSize="11" FontWeight="Bold"
                                               Foreground="#0B0F17" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding OpenSupabaseDashboardCommand}"
                                        ToolTip.Tip="Open Supabase Dashboard in Browser" Margin="0,0,6,0">
                                    <TextBlock Text="🌐 Dashboard" FontSize="11" Foreground="#10B981" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding TestSupabaseConnectionCommand}"
                                        ToolTip.Tip="Test Supabase API &amp; Storage Connectivity" Margin="0,0,6,0">
                                    <TextBlock Text="⚡ Test Connection" FontSize="11" Foreground="#38BDF8" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4" Command="{Binding OpenSupabaseDocsCommand}"
                                        ToolTip.Tip="View Supabase Setup Guide">
                                    <TextBlock Text="❓ Guide" FontSize="11" Foreground="#00F0FF" />
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <!-- Supabase Inline Status Banner -->
                        <Border Background="{Binding SupabaseStatusBackground}"
                                BorderBrush="{Binding SupabaseStatusBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10,8"
                                IsVisible="{Binding IsSupabaseStatusVisible}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SupabaseStatusText}"
                                           Foreground="{Binding SupabaseStatusForeground}"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Button Grid.Column="1" Classes="secondary" Padding="6,2"
                                        Command="{Binding DismissSupabaseStatusCommand}" Margin="8,0,0,0">
                                    <TextBlock Text="✕" FontSize="11" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Project URL -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Supabase Project URL (e.g. https://xyzcompany.supabase.co)"
                                       FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding SupabaseUrl}"
                                         Watermark="https://&lt;project-ref&gt;.supabase.co"
                                         PasswordChar="{Binding SupabaseUrlMask}" />
                                <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                        CommandParameter="supabase-url" Margin="4,0,0,0" Padding="8,6">
                                    <TextBlock Text="👁" FontSize="12" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Anon Public Key and Service Role Key -->
                        <Grid ColumnDefinitions="*,*">
                            <!-- Anon Key -->
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="Supabase Anon Key (Public / Client)"
                                           FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding SupabaseAnonKey}"
                                             Watermark="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                             PasswordChar="{Binding SupabaseAnonKeyMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="supabase-anon-key" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Service Role Key -->
                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="Supabase Service Role Key (Secret / Server Uploads)"
                                           FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding SupabaseServiceRoleKey}"
                                             Watermark="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                             PasswordChar="{Binding SupabaseServiceRoleKeyMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="supabase-service-role-key" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- PostgreSQL Database Password (auto-syncs into the Connection String URI below) -->
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Supabase / PostgreSQL Database Password (auto-updates &amp; URL-encodes Connection String below)"
                                FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding SupabaseDatabasePassword}"
                                         Watermark="Paste your Supabase database password (special characters are URL-encoded automatically)"
                                         PasswordChar="{Binding SupabaseDatabasePasswordMask}" />
                                <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                        CommandParameter="supabase-db-password" Margin="4,0,0,0" Padding="8,6">
                                    <TextBlock Text="👁" FontSize="12" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- PostgreSQL Database Connection String -->
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Supabase / PostgreSQL Database Connection String (Direct or Session/Transaction Pooler URI)"
                                FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding SupabaseDatabaseConnectionString}"
                                         Watermark="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
                                         PasswordChar="{Binding SupabaseDatabaseConnectionStringMask}" />
                                <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                        CommandParameter="supabase-db-connection-string" Margin="4,0,0,0" Padding="8,6">
                                    <TextBlock Text="👁" FontSize="12" />
                                </Button>
                            </Grid>
                            <TextBlock
                                Text="💡 Used when Database Provider is set to 'Supabase' or 'PostgreSQL'. Auto-maps to MERRICK EF Core DbContext."
                                FontSize="11" Foreground="#64748B" />
                        </StackPanel>

                        <!-- Supabase Storage / S3 (match analytics lakehouse + replays) -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="🪣 Supabase Storage (S3-compatible): Match Analytics Lakehouse &amp; Replays"
                                           FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                                <TextBlock
                                    Text="Create the keys in Supabase Dashboard → Project Settings → Storage → S3 Connection → New access key. The region is shown on the same page."
                                    FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />

                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                        <TextBlock Text="S3 Access Key ID (Supabase:S3AccessKey)" FontSize="11"
                                                   FontWeight="Bold" Foreground="#94A3B8" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding SupabaseS3AccessKey}"
                                                     Watermark="32-character hex access key id"
                                                     PasswordChar="{Binding SupabaseS3AccessKeyMask}" />
                                            <Button Grid.Column="1" Classes="secondary"
                                                    Command="{Binding ToggleRevealCommand}"
                                                    CommandParameter="supabase-s3-access-key" Margin="4,0,0,0"
                                                    Padding="8,6">
                                                <TextBlock Text="👁" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                        <TextBlock Text="S3 Secret Access Key (Supabase:S3SecretKey)" FontSize="11"
                                                   FontWeight="Bold" Foreground="#94A3B8" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding SupabaseS3SecretKey}"
                                                     Watermark="Shown once when the key is created"
                                                     PasswordChar="{Binding SupabaseS3SecretKeyMask}" />
                                            <Button Grid.Column="1" Classes="secondary"
                                                    Command="{Binding ToggleRevealCommand}"
                                                    CommandParameter="supabase-s3-secret-key" Margin="4,0,0,0"
                                                    Padding="8,6">
                                                <TextBlock Text="👁" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,2*">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                        <TextBlock Text="S3 Region (Supabase:S3Region)" FontSize="11"
                                                   FontWeight="Bold" Foreground="#94A3B8" />
                                        <TextBox Text="{Binding SupabaseS3Region}" Watermark="e.g. us-east-2" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                        <TextBlock Text="S3 Endpoint Override (optional; derived from the Project URL)"
                                                   FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                        <TextBox Text="{Binding SupabaseS3Endpoint}"
                                                 Watermark="{Binding SupabaseS3EndpointWatermark}" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                        <TextBlock Text="Lakehouse Bucket (Supabase:LakehouseBucket)" FontSize="11"
                                                   FontWeight="Bold" Foreground="#94A3B8" />
                                        <TextBox Text="{Binding LakehouseBucket}" Watermark="match-analytics" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                        <TextBlock Text="Replay Bucket (Supabase:StorageBucket)" FontSize="11"
                                                   FontWeight="Bold" Foreground="#94A3B8" />
                                        <TextBox Text="{Binding SupabaseStorageBucket}" Watermark="replays" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="purple" Command="{Binding TestS3ConnectionCommand}"
                                            IsEnabled="{Binding !IsTestingS3Connection}" Padding="10,6"
                                            ToolTip.Tip="Sends a SigV4-signed HEAD request for the lakehouse bucket (uses the values typed here; Save is not needed first)">
                                        <TextBlock Text="🔌 Test S3 Connection" FontSize="11" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding S3ConnectionFeedback}" FontSize="11" Foreground="#A7F3D0"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding S3ConnectionFeedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. Security & Inter-Service Keys Card -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="🛡️ Security &amp; Inter-Service Keys" FontWeight="Bold"
                                       FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Classes="primary" Padding="8,4" Command="{Binding SaveSecretsCommand}"
                                        IsVisible="{Binding HasSecurityChanges}" Margin="0,0,6,0"
                                        ToolTip.Tip="Save Security &amp; JWT Keys">
                                    <TextBlock Text="💾 Save Section" FontSize="11" FontWeight="Bold"
                                               Foreground="#0B0F17" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding ShowDocCommand}" CommandParameter="security"
                                        ToolTip.Tip="View Security Documentation">
                                    <TextBlock Text="❓ Guide" FontSize="11" Foreground="#00F0FF" />
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <!-- JWT Signing Key -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="JWT Signing Key (HMAC-SHA256, 32+ bytes)" FontSize="11" FontWeight="Bold"
                                       Foreground="#94A3B8" />
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0" Text="{Binding JwtSigningKey}"
                                         Watermark="Click Generate (leaving it empty uses the public development default)"
                                         PasswordChar="{Binding JwtSigningKeyMask}" />
                                <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                        CommandParameter="jwt-signing-key" Margin="4,0,0,0" Padding="8,6">
                                    <TextBlock Text="👁" FontSize="12" />
                                </Button>
                                <Button Grid.Column="2" Classes="secondary" Command="{Binding GenerateJwtSigningKeyCommand}"
                                        Margin="4,0,0,0" Padding="10,6"
                                        ToolTip.Tip="Generate a new 48-byte random key. Existing logins will have to sign in again.">
                                    <TextBlock Text="🎲 Generate" FontSize="11" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Internal Service Key -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Internal Service Key (InternalServiceKey / X-Internal-Service-Key header)"
                                       FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0" Text="{Binding InternalServiceKey}"
                                         Watermark="Click Generate (leaving it empty uses the public development default)"
                                         PasswordChar="{Binding InternalServiceKeyMask}" />
                                <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                        CommandParameter="internal-service-key" Margin="4,0,0,0" Padding="8,6">
                                    <TextBlock Text="👁" FontSize="12" />
                                </Button>
                                <Button Grid.Column="2" Classes="secondary" Command="{Binding GenerateInternalServiceKeyCommand}"
                                        Margin="4,0,0,0" Padding="10,6" ToolTip.Tip="Generate a new 32-byte random key">
                                    <TextBlock Text="🎲 Generate" FontSize="11" />
                                </Button>
                            </Grid>
                            <TextBlock
                                Text="🔐 Shared by ZORGATH, the Staff Portal and the control panel for service-to-service calls."
                                FontSize="11" Foreground="#64748B" />
                        </StackPanel>

                        <!-- WILLOWMAKER IPC Auth Key -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="WILLOWMAKER IPC Auth Key (KONGOR_IPC_AUTH_KEY)" FontSize="11"
                                       FontWeight="Bold" Foreground="#94A3B8" />
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0" Text="{Binding IpcAuthKey}"
                                         Watermark="Optional: authenticates the game-client automation pipe"
                                         PasswordChar="{Binding IpcAuthKeyMask}" />
                                <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                        CommandParameter="ipc-auth-key" Margin="4,0,0,0" Padding="8,6">
                                    <TextBlock Text="👁" FontSize="12" />
                                </Button>
                                <Button Grid.Column="2" Classes="secondary" Command="{Binding GenerateIpcAuthKeyCommand}"
                                        Margin="4,0,0,0" Padding="10,6" ToolTip.Tip="Generate a new 32-byte random key">
                                    <TextBlock Text="🎲 Generate" FontSize="11" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- SendGrid API Key -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="SendGrid API Key (Optional / Legacy)" FontSize="11" FontWeight="Bold"
                                       Foreground="#94A3B8" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding SendGridApiKey}"
                                         Watermark="Optional (leave empty for development mock auth)"
                                         PasswordChar="{Binding SendGridApiKeyMask}" />
                                <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                        CommandParameter="sendgrid-api-key" Margin="4,0,0,0" Padding="8,6">
                                    <TextBlock Text="👁" FontSize="12" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Alert Webhook -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Alert Discord Webhook URL (Alerts:DiscordWebhookUrl)" FontSize="11"
                                       FontWeight="Bold" Foreground="#94A3B8" />
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0" Text="{Binding AlertWebhookUrl}"
                                         Watermark="https://discord.com/api/webhooks/... (optional; for circuit-breaker / outage alerts)"
                                         PasswordChar="{Binding AlertWebhookUrlMask}" />
                                <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                        CommandParameter="alert-webhook-url" Margin="4,0,0,0" Padding="8,6">
                                    <TextBlock Text="👁" FontSize="12" />
                                </Button>
                                <Button Grid.Column="2" Classes="secondary" Command="{Binding SendTestAlertCommand}"
                                        IsEnabled="{Binding !IsSendingTestAlert}" Margin="4,0,0,0" Padding="10,6">
                                    <TextBlock Text="📣 Send Test Alert" FontSize="11" />
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding AlertTestFeedback}" FontSize="11" Foreground="#A7F3D0"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding AlertTestFeedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 5. Replay Storage Card (Dropdown + Local Disk / Cloud Fields) -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="☁️ Replay Storage (Local Disk vs Cloud S3/R2/GCS)"
                                       FontWeight="Bold" FontSize="14" Foreground="#10B981" VerticalAlignment="Center" />
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Classes="primary" Padding="8,4" Command="{Binding SaveSecretsCommand}"
                                        IsVisible="{Binding HasReplayChanges}" Margin="0,0,6,0"
                                        ToolTip.Tip="Save Replay Storage Settings">
                                    <TextBlock Text="💾 Save Section" FontSize="11" FontWeight="Bold"
                                               Foreground="#0B0F17" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding ShowDocCommand}" CommandParameter="replay"
                                        ToolTip.Tip="View Replay Storage Documentation">
                                    <TextBlock Text="❓ Guide" FontSize="11" Foreground="#00F0FF" />
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <!-- Provider Dropdown Selection -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Storage Provider" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                            <ComboBox ItemsSource="{Binding ReplayStorageProviders}"
                                      SelectedItem="{Binding ReplayStorageProvider}" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Supabase Storage Notice (Visible ONLY when Supabase is selected) -->
                        <Border IsVisible="{Binding IsSupabaseStorage}" Background="#064E3B" BorderBrush="#10B981"
                                BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="⚡ Supabase Replay Storage Active" FontWeight="Bold" FontSize="12"
                                           Foreground="#34D399" />
                                <TextBlock
                                    Text="Replays (.honreplay) are automatically streamed to your Supabase Storage bucket and served via high-speed global CDN links."
                                    FontSize="11" Foreground="#A7F3D0" TextWrapping="Wrap" />
                                <TextBlock
                                    Text="Ensure your Supabase Project URL and Service Role Key are configured in the Supabase card above."
                                    FontSize="10" Foreground="#6EE7B7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Local Disk Specific Field (Visible ONLY when LocalDisk is selected) -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsLocalDiskStorage}">
                            <TextBlock Text="Local Replay Directory Path (Optional - defaults to workspace 'replays/')"
                                       FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0" Text="{Binding LocalReplayDirectory}"
                                         Watermark="Default workspace: replays/"
                                         PasswordChar="{Binding LocalReplayDirectoryMask}" />
                                <Button Grid.Column="1" Classes="secondary"
                                        Command="{Binding BrowseReplayDirectoryCommand}" Margin="4,0,0,0"
                                        Padding="12,6" ToolTip.Tip="Browse folder on your machine">
                                    <TextBlock Text="📁 Browse..." FontSize="12" />
                                </Button>
                                <Button Grid.Column="2" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                        CommandParameter="local-replay-directory" Margin="4,0,0,0" Padding="8,6">
                                    <TextBlock Text="👁" FontSize="12" />
                                </Button>
                            </Grid>
                            <TextBlock
                                Text="💡 Replays are saved directly as .honreplay files. Leave empty to use the default 'replays' folder."
                                FontSize="11" Foreground="#64748B" />
                        </StackPanel>

                        <!-- Cloud Specific Fields (Visible ONLY when Cloud is selected) -->
                        <StackPanel Spacing="12" IsVisible="{Binding IsCloudStorage}">

                            <Grid ColumnDefinitions="*,*">
                                <!-- Bucket Name -->
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                    <TextBlock Text="Cloud Bucket Name" FontSize="11" FontWeight="Bold"
                                               Foreground="#94A3B8" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding CloudBucketName}"
                                                 Watermark="e.g. nexus-match-replays"
                                                 PasswordChar="{Binding CloudBucketNameMask}" />
                                        <Button Grid.Column="1" Classes="secondary"
                                                Command="{Binding ToggleRevealCommand}"
                                                CommandParameter="cloud-bucket-name" Margin="4,0,0,0" Padding="8,6">
                                            <TextBlock Text="👁" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Region -->
                                <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                    <TextBlock Text="Region" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding CloudRegion}"
                                                 Watermark="e.g. us-east-1" PasswordChar="{Binding CloudRegionMask}" />
                                        <Button Grid.Column="1" Classes="secondary"
                                                Command="{Binding ToggleRevealCommand}" CommandParameter="cloud-region"
                                                Margin="4,0,0,0" Padding="8,6">
                                            <TextBlock Text="👁" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*">
                                <!-- Access Key -->
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                    <TextBlock Text="Access Key" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding CloudAccessKey}"
                                                 PasswordChar="{Binding CloudAccessKeyMask}" />
                                        <Button Grid.Column="1" Classes="secondary"
                                                Command="{Binding ToggleRevealCommand}"
                                                CommandParameter="cloud-access-key" Margin="4,0,0,0" Padding="8,6">
                                            <TextBlock Text="👁" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Secret Key -->
                                <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                    <TextBlock Text="Secret Key" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding CloudSecretKey}"
                                                 PasswordChar="{Binding CloudSecretKeyMask}" />
                                        <Button Grid.Column="1" Classes="secondary"
                                                Command="{Binding ToggleRevealCommand}"
                                                CommandParameter="cloud-secret-key" Margin="4,0,0,0" Padding="8,6">
                                            <TextBlock Text="👁" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Service URL -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Service URL (e.g. Cloudflare R2 / Google Cloud Storage Endpoint)"
                                           FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding CloudServiceUrl}"
                                             Watermark="https://&lt;ACCOUNT_ID&gt;.r2.cloudflarestorage.com"
                                             PasswordChar="{Binding CloudServiceUrlMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="cloud-service-url" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- 6. Grafana Cloud & Profiling Card (Optional) -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="📊 Grafana Cloud Observability &amp; Profiling (Optional)"
                                       FontWeight="Bold" FontSize="14" Foreground="#EC4899" VerticalAlignment="Center" />
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Classes="primary" Padding="8,4" Command="{Binding SaveSecretsCommand}"
                                        IsVisible="{Binding HasObservabilityChanges}" Margin="0,0,6,0"
                                        ToolTip.Tip="Save Observability &amp; Profiling Settings">
                                    <TextBlock Text="💾 Save Section" FontSize="11" FontWeight="Bold"
                                               Foreground="#0B0F17" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding ShowDocCommand}" CommandParameter="grafana"
                                        ToolTip.Tip="View Grafana Documentation">
                                    <TextBlock Text="❓ Guide" FontSize="11" Foreground="#00F0FF" />
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*">
                            <!-- OTLP Endpoint -->
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="Grafana OTLP Endpoint (GRAFANA_OTLP_ENDPOINT)" FontSize="11"
                                           FontWeight="Bold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding GrafanaOtlpEndpoint}"
                                             Watermark="https://otlp-gateway-prod-us-east-0.grafana.net/otlp"
                                             PasswordChar="{Binding GrafanaOtlpEndpointMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="grafana-otlp-endpoint" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- OTLP Headers -->
                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="Grafana OTLP Basic Auth Headers (GRAFANA_OTLP_HEADERS)" FontSize="11"
                                           FontWeight="Bold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding GrafanaOtlpHeaders}"
                                             Watermark="Authorization=Basic%20..."
                                             PasswordChar="{Binding GrafanaOtlpHeadersMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="grafana-otlp-headers" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*">
                            <!-- Pyroscope Server Address -->
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                <TextBlock Text="Pyroscope Address (Default: http://localhost:4040)" FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding PyroscopeServerAddress}"
                                             Watermark="http://localhost:4040"
                                             PasswordChar="{Binding PyroscopeServerAddressMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="pyroscope-server-address" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Pyroscope User -->
                            <StackPanel Grid.Column="1" Spacing="4" Margin="3,0,3,0">
                                <TextBlock Text="Pyroscope User ID (Cloud Only)" FontSize="11" FontWeight="Bold"
                                           Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding PyroscopeBasicAuthUser}"
                                             Watermark="Leave blank for local"
                                             PasswordChar="{Binding PyroscopeBasicAuthUserMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="pyroscope-basic-auth-user" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Pyroscope Password -->
                            <StackPanel Grid.Column="2" Spacing="4" Margin="6,0,0,0">
                                <TextBlock Text="Pyroscope Token (Cloud Only)" FontSize="11" FontWeight="Bold"
                                           Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding PyroscopeBasicAuthPassword}"
                                             Watermark="Leave blank for local"
                                             PasswordChar="{Binding PyroscopePasswordMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="pyroscope-password" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- 7. Twitch OAuth2 & Streamer Integration Card (Optional) -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="📺 Twitch Integration (Optional — Streamer Verification)"
                                           FontWeight="Bold"
                                           FontSize="14" Foreground="#9146FF" />
                                <TextBlock Text="— Required for Streamer verification &amp; homescreen broadcasting"
                                           FontSize="11"
                                           Foreground="#64748B" VerticalAlignment="Center" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Classes="primary" Padding="8,4" Command="{Binding SaveSecretsCommand}"
                                        IsVisible="{Binding HasOAuthChanges}" Margin="0,0,6,0"
                                        ToolTip.Tip="Save Twitch Integration Settings">
                                    <TextBlock Text="💾 Save Section" FontSize="11" FontWeight="Bold"
                                               Foreground="#0B0F17" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding OpenTwitchDeveloperConsoleCommand}"
                                        ToolTip.Tip="Open Twitch Developer Console" Margin="0,0,6,0">
                                    <TextBlock Text="🌐 Dev Console" FontSize="11" Foreground="#9146FF" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding CopyTwitchRedirectUriCommand}"
                                        ToolTip.Tip="Copy Redirect URI (https://localhost:5557/signin-twitch)"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="📋 Copy Redirect URI" FontSize="11" Foreground="#38BDF8" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4" Command="{Binding ShowDocCommand}"
                                        CommandParameter="twitch" ToolTip.Tip="View Twitch Setup Documentation">
                                    <TextBlock Text="❓ Guide" FontSize="11" Foreground="#00F0FF" />
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <!-- Prompt Notice if Not Configured -->
                        <Border IsVisible="{Binding !IsTwitchConfigured}" Background="#1E1B4B" BorderBrush="#818CF8"
                                BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="ℹ️" FontSize="14" VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="Twitch App Keys (Optional): Enter your Twitch Client ID &amp; Secret below to enable seamless Twitch account linking and streamer badges."
                                           FontSize="11" Foreground="#C7D2FE" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                            <!-- Client ID -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                <TextBlock Text="Twitch Client ID"
                                           FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding TwitchClientId}"
                                             PasswordChar="{Binding TwitchClientIdMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="twitch-client-id" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Client Secret -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                <TextBlock Text="Twitch Client Secret" FontSize="11" FontWeight="Bold"
                                           Foreground="#94A3B8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding TwitchClientSecret}"
                                             PasswordChar="{Binding TwitchClientSecretMask}" />
                                    <Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleRevealCommand}"
                                            CommandParameter="twitch-client-secret" Margin="4,0,0,0" Padding="8,6">
                                        <TextBlock Text="👁" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 8. Network Ports, Host Bindings & Matchmaking Card -->
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="🔌 Network Ports, Host Bindings &amp; Matchmaking" FontWeight="Bold"
                                           FontSize="14" Foreground="#38BDF8" />
                                <TextBlock Text="— Single-source-of-truth port configuration and matchmaking team size"
                                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Classes="primary" Padding="8,4" Command="{Binding SaveSecretsCommand}"
                                        IsVisible="{Binding HasNetworkChanges}" Margin="0,0,6,0"
                                        ToolTip.Tip="Save Network Ports &amp; Matchmaking Configuration">
                                    <TextBlock Text="💾 Save Section" FontSize="11" FontWeight="Bold"
                                               Foreground="#0B0F17" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding SetStandardHoNPortsCommand}"
                                        ToolTip.Tip="Reset all network ports to standard HoN defaults" Margin="0,0,6,0">
                                    <TextBlock Text="⚡ Standard Ports" FontSize="11" Foreground="#38BDF8" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding SetSoloDevMatchmakingCommand}"
                                        ToolTip.Tip="Set matchmaking to 1v1 for instant solo testing" Margin="0,0,6,0">
                                    <TextBlock Text="👤 1v1 Dev Matchmaking" FontSize="11" Foreground="#10B981" />
                                </Button>
                                <Button Classes="secondary" Padding="8,4"
                                        Command="{Binding SetStandard5v5MatchmakingCommand}"
                                        ToolTip.Tip="Set matchmaking to standard 5v5 team size" Margin="0,0,6,0">
                                    <TextBlock Text="👥 5v5 Standard" FontSize="11" Foreground="#A855F7" />
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <!-- Sub-Section A: Chat Server Ports (TRANSMUTANSTEIN) -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="💬 Chat &amp; Matchmaking Server (TRANSMUTANSTEIN)" FontSize="12"
                                           FontWeight="Bold" Foreground="#38BDF8" />
                                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,6,8">
                                        <TextBlock Text="Client Port (TCP)" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding ChatServerClientPort}" Watermark="11031" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="6,0,6,8">
                                        <TextBlock Text="Public Client Port" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding ChatServerPublicClientPort}" Watermark="11031" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" Margin="6,0,6,8">
                                        <TextBlock Text="Match Server Port" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding ChatServerMatchServerPort}" Watermark="11032" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="3" Spacing="4" Margin="6,0,0,8">
                                        <TextBlock Text="Manager Port" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding ChatServerMatchServerManagerPort}" Watermark="11033" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4"
                                                Margin="0,0,6,0">
                                        <TextBlock Text="Chat Server Local Host" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding ChatServerHost}" Watermark="127.0.0.1" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Spacing="4"
                                                Margin="6,0,0,0">
                                        <TextBlock Text="Chat Server Public Host" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding ChatServerPublicHost}" Watermark="127.0.0.1" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Sub-Section B: Web Portal, API & Master Server Ports -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="🌐 Web Portal, REST API &amp; Master Server (KONGOR / DAWNBRINGER / ZORGATH)"
                                    FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                                <Grid ColumnDefinitions="*,*,*,*,*,*" RowDefinitions="Auto">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                        <TextBlock Text="Master Server Port" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding MasterServerPort}" Watermark="55555" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,6,0">
                                        <TextBlock Text="Web Portal (HTTP)" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding WebPortalHttpPort}" Watermark="5266" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" Margin="6,0,6,0">
                                        <TextBlock Text="Web Portal (HTTPS)" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding WebPortalHttpsPort}" Watermark="5557" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="4" Margin="6,0,6,0">
                                        <TextBlock Text="REST API (HTTP)" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding WebPortalApiHttpPort}" Watermark="5200" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Spacing="4" Margin="6,0,6,0">
                                        <TextBlock Text="REST API (HTTPS)" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding WebPortalApiHttpsPort}" Watermark="5201" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="5" Spacing="4" Margin="6,0,0,0">
                                        <TextBlock Text="Database Context" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding DbContextPort}" Watermark="5553" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Sub-Section C: Cache & Observability Ports -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="📊 Distributed Cache &amp; Profiler (Redis / Pyroscope)" FontSize="12"
                                           FontWeight="Bold" Foreground="#F59E0B" />
                                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                        <TextBlock Text="Redis Primary Port" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding DistributedCachePort}" Watermark="28298" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,6,0">
                                        <TextBlock Text="Redis Secondary Port" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding DistributedCacheSecondaryPort}" Watermark="28299" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" Margin="6,0,6,0">
                                        <TextBlock Text="Redis Dashboard Port" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding DistributedCacheDashboardPort}" Watermark="28300" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="4" Margin="6,0,0,0">
                                        <TextBlock Text="Pyroscope Profiler Port" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding PyroscopePort}" Watermark="4040" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Sub-Section D: Matchmaking Engine & Game Server Fleet (COMPEL) -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="⚔️ Matchmaking Engine &amp; Fleet Settings (COMPEL)" FontSize="12"
                                           FontWeight="Bold" Foreground="#EC4899" />
                                <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                        <TextBlock Text="Players Per Team (1-5)" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding MatchmakingPlayersPerTeam}" Watermark="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,6,0">
                                        <TextBlock Text="Queue Tick (ms)" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding MatchmakingIntervalMs}" Watermark="5000" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" Margin="6,0,6,0">
                                        <TextBlock Text="COMPEL Ping Port (UDP)" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding CompelPingPort}" Watermark="11234" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="4" Margin="6,0,6,0">
                                        <TextBlock Text="Game Server Public IP" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding GameServerPublicIp}" Watermark="127.0.0.1" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Spacing="4" Margin="6,0,0,0">
                                        <TextBlock Text="Instance Ports" FontSize="11" FontWeight="Bold"
                                                   Foreground="#94A3B8" />
                                        <TextBox Text="{Binding GameServerInstancePorts}" Watermark="11235,11236,11237,11238" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- 9. Store & Progression Mode Card -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="🛍️ Store &amp; Item Progression Mode" FontWeight="Bold"
                                           FontSize="14" Foreground="#10B981" />
                                <TextBlock Text="— Toggle between Sandbox Mode (all items/avatars unlocked) and Progression Mode (inventory only)"
                                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Classes="primary" Padding="8,4" Command="{Binding SaveSecretsCommand}"
                                        IsVisible="{Binding HasStoreChanges}" Margin="0,0,6,0"
                                        ToolTip.Tip="Save Store Settings">
                                    <TextBlock Text="💾 Save Section" FontSize="11" FontWeight="Bold"
                                               Foreground="#0B0F17" />
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Unlock All Items (Sandbox Mode)" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" />
                                    <TextBlock Text="When enabled, all store items, avatars, and supplementary mod avatars are unlocked for all players. When disabled, players only own default items and items in their inventory."
                                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding UnlockAllItems}"
                                              OnContent="Unlocked (Sandbox)" OffContent="Progression"
                                              VerticalAlignment="Center" Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Floating Sticky Bottom Bar for Unsaved Changes -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                IsVisible="{Binding HasChanges}" Background="#1E293B"
                BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="10"
                Margin="24,0,24,16" Padding="16,10" BoxShadow="0 4 16 0 #8000F0FF">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Unsaved Configuration Changes" FontWeight="Bold" FontSize="13"
                               Foreground="#F8FAFC" />
                    <TextBlock Text="You have modified settings that need to be synchronized to .NET User Secrets."
                               FontSize="11" Foreground="#94A3B8" />
                </StackPanel>
                <Button Grid.Column="2" Classes="secondary" Command="{Binding DiscardChangesCommand}"
                        BorderBrush="#EF4444" Margin="0,0,10,0" Padding="12,6">
                    <TextBlock Text="🗑️ Discard Changes" FontSize="12" Foreground="#EF4444" FontWeight="SemiBold" />
                </Button>
                <Button Grid.Column="3" Classes="primary" Command="{Binding SaveSecretsCommand}" Padding="16,6">
                    <TextBlock Text="💾 Save All Changes" FontSize="12" FontWeight="Bold" Foreground="#0B0F17" />
                </Button>
            </Grid>
        </Border>

        <!-- In-GUI Documentation Popup Modal with Clickable Links -->
        <Border Background="#D00B0F17" IsVisible="{Binding IsDocModalOpen}" Padding="32">
            <Border Classes="card" MaxWidth="660" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#00F0FF" BorderThickness="1.5">
                <StackPanel Spacing="16">

                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding DocModalBadge}" FontSize="10" FontWeight="Black"
                                           Foreground="#00F0FF" LetterSpacing="1" />
                            </Border>
                            <TextBlock Text="{Binding DocModalTitle}" FontSize="16" FontWeight="Black"
                                       Foreground="#F8FAFC" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Command="{Binding CloseDocModalCommand}"
                                Padding="10,6" VerticalAlignment="Top">
                            <TextBlock Text="✕ Close" FontSize="12" />
                        </Button>
                    </Grid>

                    <Separator Background="#1E293B" />

                    <!-- Modal Body Content -->
                    <ScrollViewer MaxHeight="300">
                        <TextBlock Text="{Binding DocModalContent}" FontSize="13" Foreground="#CBD5E1" LineHeight="20"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>

                    <!-- Clickable Action Links & Copy Buttons -->
                    <StackPanel Spacing="8">

                        <!-- Primary Web Link Button -->
                        <Button Classes="secondary" Command="{Binding OpenDocUrlCommand}"
                                IsVisible="{Binding HasDocModalUrl}" HorizontalAlignment="Stretch" Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding DocModalUrlLabel}" FontWeight="Bold"
                                           Foreground="#00F0FF" />
                                <TextBlock Grid.Column="1" Text="↗ Open Link" FontSize="11" Foreground="#94A3B8" />
                            </Grid>
                        </Button>

                        <!-- Secondary Web Link Button -->
                        <Button Classes="secondary" Command="{Binding OpenDocSecondaryUrlCommand}"
                                IsVisible="{Binding HasDocModalSecondaryUrl}" HorizontalAlignment="Stretch"
                                Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding DocModalSecondaryUrlLabel}" FontWeight="Bold"
                                           Foreground="#38BDF8" />
                                <TextBlock Grid.Column="1" Text="↗ Open Link" FontSize="11" Foreground="#94A3B8" />
                            </Grid>
                        </Button>

                        <!-- Copyable Command / Text -->
                        <Button Classes="secondary" Command="{Binding CopyDocTextCommand}"
                                IsVisible="{Binding HasDocModalCopyText}" HorizontalAlignment="Stretch" Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding DocModalCopyLabel}" FontWeight="Bold"
                                           Foreground="#F59E0B" />
                                <TextBlock Grid.Column="1" Text="📋 Copy" FontSize="11" Foreground="#94A3B8" />
                            </Grid>
                        </Button>

                        <!-- Copy Feedback Message -->
                        <TextBlock Text="{Binding DocModalCopySuccessText}"
                                   IsVisible="{Binding HasDocModalCopySuccess}" Foreground="#10B981" FontWeight="Bold"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                </StackPanel>
            </Border>
        </Border>

    </Grid>

</UserControl>
