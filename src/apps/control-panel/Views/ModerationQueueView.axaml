<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NEXUS.ControlPanel.GUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="760"
             x:Class="NEXUS.ControlPanel.GUI.Views.ModerationQueueView"
             x:DataType="vm:ModerationQueueViewModel"
             Background="#0B0F17">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="🛡️ MODERATION QUEUE &amp; PLAYER SAFETY"
                           FontSize="20" FontWeight="Black" Foreground="#F8FAFC" LetterSpacing="0.8" />
                <TextBlock Text="Review incoming player reports, inspect match context, and issue auditable mutes, bans, or dismissals."
                           FontSize="12" Foreground="#94A3B8" />
            </StackPanel>
            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                    CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="PENDING:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <TextBlock AutomationProperties.AutomationId="ModerationPendingCount"
                               Text="{Binding PendingCount}" FontSize="15" FontWeight="Black" Foreground="#F59E0B" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter & Action Toolbar -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                CornerRadius="10" Padding="12" Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ComboBox AutomationProperties.AutomationId="ModerationStatusFilter"
                          Grid.Column="0" Width="150" Margin="0,0,10,0"
                          ItemsSource="{Binding AvailableStatusFilters}"
                          SelectedItem="{Binding StatusFilter}" />
                <TextBox AutomationProperties.AutomationId="ModerationSearchBox"
                         Grid.Column="1" Margin="0,0,10,0"
                         Text="{Binding SearchQuery}"
                         Watermark="Search reported player, reporter, or reason..." />
                <Button AutomationProperties.AutomationId="ModerationRefreshButton"
                        Grid.Column="2" Classes="primary"
                        Command="{Binding RefreshReportsCommand}"
                        Content="🔄 Refresh Queue" Padding="14,8" />
            </Grid>
        </Border>

        <!-- Split Queue & Detail Triage Workspace -->
        <Grid Grid.Row="2" ColumnDefinitions="1.15*,0.85*">

            <!-- Left: Report List -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                    CornerRadius="10" Padding="10" Margin="0,0,14,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="INCOMING REPORTS" FontSize="11" FontWeight="Bold"
                               Foreground="#94A3B8" LetterSpacing="1" Margin="4,0,0,8" />
                    <ListBox AutomationProperties.AutomationId="ModerationReportsList"
                             Grid.Row="1"
                             ItemsSource="{Binding Reports}"
                             SelectedItem="{Binding SelectedReport}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                        CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding ReportedAccountName}"
                                                   FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" />
                                        <Border Grid.Row="0" Grid.Column="1" Background="#0B0F17"
                                                CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding Reason}"
                                                   FontSize="11.5" Foreground="#CBD5E1" Margin="0,4,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock AutomationProperties.AutomationId="ModerationStatusBanner"
                               Grid.Row="2" Text="{Binding StatusBannerText}"
                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="4,8,4,0" />
                </Grid>
            </Border>

            <!-- Right: Selected Report Triage Panel -->
            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                    CornerRadius="10" Padding="16">
                <StackPanel Spacing="12" IsEnabled="{Binding HasSelectedReport}">
                    <TextBlock Text="CASE REVIEW &amp; SANCTIONS" FontSize="11" FontWeight="Bold"
                               Foreground="#94A3B8" LetterSpacing="1" />

                    <Border Background="#1E293B" CornerRadius="8" Padding="12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding SelectedReport.ReportedAccountName, FallbackValue='Select a report'}"
                                       FontSize="16" FontWeight="Black" Foreground="#F8FAFC" />
                            <TextBlock Text="{Binding SelectedReport.Reason, StringFormat='Reason: {0}', FallbackValue='Reason: —'}"
                                       FontSize="12" Foreground="#F59E0B" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedReport.ReporterAccountName, StringFormat='Reported by: {0}', FallbackValue='Reported by: —'}"
                                       FontSize="11.5" Foreground="#94A3B8" />
                            <TextBlock Text="{Binding SelectedReport.Description, FallbackValue='No additional details provided.'}"
                                       FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Sanction Duration (Hours; 0 = Permanent for Ban)" FontSize="11" Foreground="#94A3B8" />
                        <NumericUpDown AutomationProperties.AutomationId="ModerationDurationInput"
                                       Minimum="0" Maximum="8760" Value="{Binding SanctionDurationHours}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Audit Notes" FontSize="11" Foreground="#94A3B8" />
                        <TextBox AutomationProperties.AutomationId="ModerationStaffNotesBox"
                                 Text="{Binding StaffNotes}"
                                 AcceptsReturn="True" Height="74" TextWrapping="Wrap"
                                 Watermark="Record moderation rationale for the audit trail..." />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*,*" Margin="0,6,0,0">
                        <Button AutomationProperties.AutomationId="ModerationMuteButton"
                                Grid.Column="0" Classes="secondary" Margin="0,0,6,0"
                                Command="{Binding MuteSelectedCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,10"
                                Content="🔇 Mute" />
                        <Button AutomationProperties.AutomationId="ModerationBanButton"
                                Grid.Column="1" Background="#991B1B" Foreground="#F8FAFC" Margin="3,0,3,0"
                                Command="{Binding BanSelectedCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,10"
                                Content="⛔ Ban" />
                        <Button AutomationProperties.AutomationId="ModerationDismissButton"
                                Grid.Column="2" Classes="secondary" Margin="6,0,0,0"
                                Command="{Binding DismissSelectedCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,10"
                                Content="✓ Dismiss" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
