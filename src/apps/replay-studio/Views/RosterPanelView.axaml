<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ReplayStudio.GUI.ViewModels"
             xmlns:m="clr-namespace:ReplayStudio.GUI.Models"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="800"
             x:Class="ReplayStudio.GUI.Views.RosterPanelView"
             x:DataType="vm:RosterViewModel">

    <Border Classes="glass-card" Margin="4, 8, 8, 8" Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <!-- Panel Header -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⚔" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center" />
                        <TextBlock Text="ROSTER TELEMETRY" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="10 Players" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                </Grid>

                <!-- ================= LEGION TEAM (TEAM 1) ================= -->
                <Border Classes="legion-card">
                    <StackPanel Spacing="8">
                        <!-- Legion Header -->
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🛡" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center" />
                                <TextBlock Text="LEGION" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding LegionNetWorth, StringFormat='{}NW: {0:N0}'}"
                                       FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas, monospace" />
                            <TextBlock Grid.Column="2" Text="{Binding LegionScore, StringFormat='{}Kills: {0}'}"
                                       FontSize="11" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas, monospace" />
                        </Grid>

                        <!-- Legion Player List -->
                        <ItemsControl ItemsSource="{Binding LegionPlayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="m:RosterPlayerItem">
                                    <Border Background="#101726" BorderBrush="{Binding IsPovLocked, Converter={x:Null}, StringFormat='{}{0}'}"
                                            BorderThickness="1" CornerRadius="6" Padding="8, 6" Margin="0, 0, 0, 6">
                                        <Grid RowDefinitions="Auto, Auto, Auto" Margin="0">
                                            <!-- Player & Hero Header -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto" Margin="0, 0, 0, 4">
                                                <!-- Level Badge -->
                                                <Border Grid.Column="0" Background="#1E293B" CornerRadius="3" Padding="4, 1" Margin="0, 0, 6, 0">
                                                    <TextBlock Text="{Binding Level, StringFormat='{}L{0}'}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                                                </Border>

                                                <!-- Hero & Player Names -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CleanHeroName}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding PlayerName}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- KDA Readout -->
                                                <TextBlock Grid.Column="2" Text="{Binding KdaFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"
                                                           FontFamily="Cascadia Mono, Consolas, monospace" VerticalAlignment="Center" Margin="0, 0, 8, 0" />

                                                <!-- POV Lock Toggle -->
                                                <Button Grid.Column="3" Command="{Binding $parent[UserControl].((vm:RosterViewModel)DataContext).LockPovCommand}"
                                                        CommandParameter="{Binding}" Classes="action-btn" Padding="6, 2" Height="24"
                                                        ToolTip.Tip="Lock Director Camera POV to this hero">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="🎥" FontSize="10" />
                                                        <TextBlock Text="POV" FontSize="9" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- HP & MP Bars -->
                                            <StackPanel Grid.Row="1" Spacing="3" Margin="0, 0, 0, 4">
                                                <!-- HP Bar -->
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <ProgressBar Grid.Column="0" Value="{Binding CurrentHp}" Minimum="0" Maximum="{Binding MaxHp}"
                                                                 Height="6" Foreground="#10B981" Background="#1E293B" CornerRadius="3" />
                                                    <TextBlock Grid.Column="1" Text="{Binding CurrentHp, StringFormat='{}{0:F0}'}"
                                                               FontSize="9" Foreground="#34D399" FontFamily="Cascadia Mono, Consolas, monospace" Margin="4, 0, 0, 0" />
                                                </Grid>
                                                <!-- MP Bar -->
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <ProgressBar Grid.Column="0" Value="{Binding CurrentMp}" Minimum="0" Maximum="{Binding MaxMp}"
                                                                 Height="5" Foreground="#0284C7" Background="#1E293B" CornerRadius="3" />
                                                    <TextBlock Grid.Column="1" Text="{Binding CurrentMp, StringFormat='{}{0:F0}'}"
                                                               FontSize="9" Foreground="#38BDF8" FontFamily="Cascadia Mono, Consolas, monospace" Margin="4, 0, 0, 0" />
                                                </Grid>
                                            </StackPanel>

                                            <!-- GPM / XPM Stats -->
                                            <Grid Grid.Row="2" ColumnDefinitions="*, *">
                                                <TextBlock Grid.Column="0" Text="{Binding Gpm, StringFormat='{}GPM: {0}'}" FontSize="9" Foreground="#FBBF24"
                                                           FontFamily="Cascadia Mono, Consolas, monospace" />
                                                <TextBlock Grid.Column="1" Text="{Binding Xpm, StringFormat='{}XPM: {0}'}" FontSize="9" Foreground="#A78BFA"
                                                           FontFamily="Cascadia Mono, Consolas, monospace" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ================= HELLBOURNE TEAM (TEAM 2) ================= -->
                <Border Classes="hellbourne-card">
                    <StackPanel Spacing="8">
                        <!-- Hellbourne Header -->
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="💀" FontSize="13" Foreground="#F87171" VerticalAlignment="Center" />
                                <TextBlock Text="HELLBOURNE" FontSize="12" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding HellbourneNetWorth, StringFormat='{}NW: {0:N0}'}"
                                       FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas, monospace" />
                            <TextBlock Grid.Column="2" Text="{Binding HellbourneScore, StringFormat='{}Kills: {0}'}"
                                       FontSize="11" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas, monospace" />
                        </Grid>

                        <!-- Hellbourne Player List -->
                        <ItemsControl ItemsSource="{Binding HellbournePlayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="m:RosterPlayerItem">
                                    <Border Background="#1A0D14" BorderBrush="#331A24"
                                            BorderThickness="1" CornerRadius="6" Padding="8, 6" Margin="0, 0, 0, 6">
                                        <Grid RowDefinitions="Auto, Auto, Auto" Margin="0">
                                            <!-- Player & Hero Header -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto" Margin="0, 0, 0, 4">
                                                <!-- Level Badge -->
                                                <Border Grid.Column="0" Background="#2E121E" CornerRadius="3" Padding="4, 1" Margin="0, 0, 6, 0">
                                                    <TextBlock Text="{Binding Level, StringFormat='{}L{0}'}" FontSize="10" FontWeight="Bold" Foreground="#F87171" />
                                                </Border>

                                                <!-- Hero & Player Names -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CleanHeroName}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding PlayerName}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- KDA Readout -->
                                                <TextBlock Grid.Column="2" Text="{Binding KdaFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="#F87171"
                                                           FontFamily="Cascadia Mono, Consolas, monospace" VerticalAlignment="Center" Margin="0, 0, 8, 0" />

                                                <!-- POV Lock Toggle -->
                                                <Button Grid.Column="3" Command="{Binding $parent[UserControl].((vm:RosterViewModel)DataContext).LockPovCommand}"
                                                        CommandParameter="{Binding}" Classes="action-btn" Padding="6, 2" Height="24"
                                                        ToolTip.Tip="Lock Director Camera POV to this hero">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="🎥" FontSize="10" />
                                                        <TextBlock Text="POV" FontSize="9" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- HP & MP Bars -->
                                            <StackPanel Grid.Row="1" Spacing="3" Margin="0, 0, 0, 4">
                                                <!-- HP Bar -->
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <ProgressBar Grid.Column="0" Value="{Binding CurrentHp}" Minimum="0" Maximum="{Binding MaxHp}"
                                                                 Height="6" Foreground="#EF4444" Background="#1E293B" CornerRadius="3" />
                                                    <TextBlock Grid.Column="1" Text="{Binding CurrentHp, StringFormat='{}{0:F0}'}"
                                                               FontSize="9" Foreground="#F87171" FontFamily="Cascadia Mono, Consolas, monospace" Margin="4, 0, 0, 0" />
                                                </Grid>
                                                <!-- MP Bar -->
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <ProgressBar Grid.Column="0" Value="{Binding CurrentMp}" Minimum="0" Maximum="{Binding MaxMp}"
                                                                 Height="5" Foreground="#0284C7" Background="#1E293B" CornerRadius="3" />
                                                    <TextBlock Grid.Column="1" Text="{Binding CurrentMp, StringFormat='{}{0:F0}'}"
                                                               FontSize="9" Foreground="#38BDF8" FontFamily="Cascadia Mono, Consolas, monospace" Margin="4, 0, 0, 0" />
                                                </Grid>
                                            </StackPanel>

                                            <!-- GPM / XPM Stats -->
                                            <Grid Grid.Row="2" ColumnDefinitions="*, *">
                                                <TextBlock Grid.Column="0" Text="{Binding Gpm, StringFormat='{}GPM: {0}'}" FontSize="9" Foreground="#FBBF24"
                                                           FontFamily="Cascadia Mono, Consolas, monospace" />
                                                <TextBlock Grid.Column="1" Text="{Binding Xpm, StringFormat='{}XPM: {0}'}" FontSize="9" Foreground="#A78BFA"
                                                           FontFamily="Cascadia Mono, Consolas, monospace" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
