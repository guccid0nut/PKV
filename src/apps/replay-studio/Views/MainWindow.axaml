<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ReplayStudio.GUI.ViewModels"
        xmlns:views="clr-namespace:ReplayStudio.GUI.Views"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="ReplayStudio.GUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Heroes of Newerth - Replay Studio 3D"
        MinWidth="1280" MinHeight="720"
        Width="1600" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17">

    <Grid>
        <!-- Main Application Shell -->
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- ================= TOP METADATA HEADER ================= -->
            <Border Grid.Row="0" Classes="glass-card" Margin="8, 8, 8, 4" Padding="12, 8">
                <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto">
                    <!-- Brand & Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="🎬" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="REPLAY STUDIO 3D" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" />
                            <TextBlock Text="Vulkan 1.3 Viewport" FontSize="9" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>

                    <Separator Grid.Column="1" Background="#1E293B" Width="1" Height="28" Margin="16, 0" />

                    <!-- Match Metadata Badges -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <!-- Match ID Badge -->
                        <Border Classes="inset-card" Padding="8, 3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="ID:" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="{Binding MatchId}" Foreground="#F8FAFC" FontSize="11" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, monospace" />
                            </StackPanel>
                        </Border>

                        <!-- Map & Mode Badge -->
                        <Border Classes="inset-card" Padding="8, 3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🗺" FontSize="10" />
                                <TextBlock Text="{Binding MapName}" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="•" Foreground="#64748B" FontSize="10" />
                                <TextBlock Text="{Binding GameMode}" Foreground="#94A3B8" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <!-- Match Duration -->
                        <Border Classes="inset-card" Padding="8, 3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="⏱" FontSize="10" />
                                <TextBlock Text="{Binding MatchDurationFormatted}" Foreground="#FBBF24" FontSize="11" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, monospace" />
                            </StackPanel>
                        </Border>

                        <!-- Winner Banner -->
                        <Border Classes="inset-card" Padding="10, 3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🏆" FontSize="11" />
                                <TextBlock Text="{Binding WinnerTeamName, StringFormat='{}WINNER: {0}'}"
                                           Foreground="{Binding IsLegionWinner, Converter={x:Null}, StringFormat='{}{0}'}"
                                           FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Border>

                        <!-- Score Readout -->
                        <Border Classes="inset-card" Padding="10, 3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding ScoreLegion}" Foreground="#34D399" FontSize="12" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, monospace" />
                                <TextBlock Text=":" Foreground="#64748B" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="{Binding ScoreHellbourne}" Foreground="#F87171" FontSize="12" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, monospace" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Real-Time Render Telemetry -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12, 0">
                        <Border Classes="inset-card" Padding="8, 3">
                            <TextBlock Text="{Binding FpsReadout}" Foreground="#34D399" FontSize="10" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas, monospace" />
                        </Border>
                        <Border Classes="inset-card" Padding="8, 3">
                            <TextBlock Text="{Binding RenderTimeReadout}" Foreground="#38BDF8" FontSize="10" FontFamily="Cascadia Mono, Consolas, monospace" />
                        </Border>
                    </StackPanel>

                    <!-- Top Action Buttons -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Command="{Binding OpenReplayFileDialogCommand}" Classes="action-btn" Padding="8, 4" FontSize="11"
                                ToolTip.Tip="Open a .honreplay file from disk">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="📁" FontSize="11" />
                                <TextBlock Text="Open Replay..." FontSize="11" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding LoadDemoMatchCommand}" Classes="action-btn" Padding="8, 4" FontSize="11"
                                ToolTip.Tip="Load Grand Finals Demo Match">
                            <TextBlock Text="⚡ Demo Match" FontSize="11" />
                        </Button>
                        <Button Command="{Binding ToggleExportModalCommand}" Classes="btn-cyan" Height="30" Padding="10, 4"
                                ToolTip.Tip="Export Replay Clip">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="🎥" FontSize="11" />
                                <TextBlock Text="Export" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= CENTER WORKSPACE (VIEWPORT + ROSTER) ================= -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="4, 0">
                <!-- 3D Viewport Host -->
                <Border Grid.Column="0" Classes="glass-card" Margin="4" Padding="0" ClipToBounds="True">
                    <views:ViewportView x:Name="ViewportViewInstance" DataContext="{Binding ViewportVM}" />
                </Border>

                <!-- 10-Player Roster Telemetry Panel -->
                <views:RosterPanelView Grid.Column="1" Width="350" DataContext="{Binding RosterVM}" />
            </Grid>

            <!-- ================= BOTTOM TIMELINE & CONTROLS ================= -->
            <views:TimelineView Grid.Row="2" DataContext="{Binding TimelineVM}" />
        </Grid>

        <!-- ================= EXPORT MODAL LAYER ================= -->
        <views:ExportModalView DataContext="{Binding ExportVM}" />
    </Grid>
</Window>
