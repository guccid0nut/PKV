<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Kongor.Cli</RootNamespace>
    <AssemblyName>kongor</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Unified Developer, Operator &amp; TAO (Together As One) MCP Server CLI for Project KONGOR V (created by guccidonut)</Description>
    <Authors>guccidonut</Authors>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kongor</ToolCommandName>
    <PackageId>Kongor.Cli</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/guccidonut/PKV</PackageProjectUrl>
    <RepositoryUrl>https://github.com/guccidonut/PKV</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>kongor;pkv;cli;dotnet-tool;game-launcher;hon;modding;server-supervisor;aspire;mcp;tao-mcp;model-context-protocol</PackageTags>
    <NoWarn>$(NoWarn);MSB3277;AVLN5001</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
    <None Include="..\..\..\NOTICE" Pack="true" PackagePath="\" Link="NOTICE" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" />
    <PackageReference Include="Parquet.Net" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Magick.NET-Q16-AnyCPU" />
    <PackageReference Include="Interop.UIAutomationClient" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
    <PackageReference Include="MemoryPack" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\extensions\modding\Kongor.Modding.csproj" />
    <ProjectReference Include="..\..\libs\protocol-core\Kongor.Core.csproj" />
    <ProjectReference Include="..\..\libs\database-context\MERRICK.DatabaseContext.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kongor.Cli.Tests" />
    <InternalsVisibleTo Include="Kongor.Mcp.Tests" />
    <InternalsVisibleTo Include="Kongor.Mcp.E2E.Tests" />
    <InternalsVisibleTo Include="ASPIRE.Integration.Tests" />
  </ItemGroup>
</Project>

