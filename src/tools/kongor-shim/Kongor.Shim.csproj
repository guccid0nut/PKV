<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>kongor</AssemblyName>
    <RootNamespace>Kongor.Shim</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Zero-lock side-by-side launcher shim for the Project KONGOR V global CLI</Description>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

</Project>
