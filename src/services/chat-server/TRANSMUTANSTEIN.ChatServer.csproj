<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>exe</OutputType>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <Features>$(Features);runtime-async=on</Features>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <NoWarn>$(NoWarn);IL2026;IL2072</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TRANSMUTANSTEIN.ChatServer.Tests" />
    <InternalsVisibleTo Include="ASPIRE.Integration.Tests" />
    <InternalsVisibleTo Include="Kongor.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching"/>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid"/>
    <PackageReference Include="MemoryPack"/>
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream"/>
    <PackageReference Include="OneOf"/>
    <PackageReference Include="Serilog.AspNetCore"/>
    <PackageReference Include="Serilog.Sinks.Console"/>
    <PackageReference Include="Serilog.Sinks.File"/>
    <PackageReference Include="Serilog.Sinks.OpenTelemetry"/>
    <PackageReference Include="Grpc.AspNetCore"/>
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\libs\service-defaults\ASPIRE.ServiceDefaults.csproj"/>
    <ProjectReference Include="..\..\libs\protocol-core\Kongor.Core.csproj"/>
    <ProjectReference Include="..\..\libs\database-context\MERRICK.DatabaseContext.csproj"/>
    <ProjectReference Include="..\..\libs\contracts\NEXUS.Contracts.csproj"/>

  </ItemGroup>

</Project>
