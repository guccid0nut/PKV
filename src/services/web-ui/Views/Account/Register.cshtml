@model RegisterViewModel
@{
    ViewData["Title"] = "Complete Registration";
    var isInviteOnly = ViewData["IsInviteOnlyEnabled"] as bool? ?? false;
    var isStandaloneMode = ViewData["IsStandaloneMode"] as bool? ?? false;
}

<div class="w-full max-w-md mx-auto my-8 p-8 rounded-2xl glass-panel animate-fade-in-up">
    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold mb-2">Create Your Account</h1>
        <p class="text-slate-400">Choose your In-Game Name and Password</p>
    </div>

    @if (isInviteOnly)
    {
        <div id="inviteOnlyNotice" class="mb-6 p-4 rounded-xl bg-purple-900/30 border border-purple-500/40 text-purple-200 text-xs flex items-start gap-3 shadow-md">
            <span class="text-lg">🔒</span>
            <div class="space-y-1">
                <div class="font-bold">Private Invite-Only Active</div>
                <div class="text-slate-300 text-[11px] leading-relaxed">
                    You must provide a valid invite code from an active player to complete account registration.
                </div>
            </div>
        </div>
    }

    <form asp-controller="Account" asp-action="CompleteRegistration" method="post" class="space-y-4"
          data-environment="@Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT")">
        <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm mb-4"></div>

        <div>
            <label asp-for="IGN" class="block text-sm font-medium text-slate-300 mb-1">In-Game Name (IGN)</label>
            <input asp-for="IGN" autocomplete="username" autocapitalize="none" spellcheck="false"
                   class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                   placeholder="Enter your desired username"/>
            <span asp-validation-for="IGN" class="text-red-400 text-xs mt-1"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-slate-300 mb-1">Password</label>
            <input asp-for="Password" autocomplete="new-password"
                   class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                   placeholder="Enter a secure password"/>
            <span asp-validation-for="Password" class="text-red-400 text-xs mt-1"></span>
            <p class="text-[11px] text-slate-400 mt-1">At least 8 characters with uppercase, lowercase, digit, and symbol.</p>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="block text-sm font-medium text-slate-300 mb-1">Confirm
                Password</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password"
                   class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                   placeholder="Confirm your password"/>
            <span asp-validation-for="ConfirmPassword" class="text-red-400 text-xs mt-1"></span>
        </div>

        <div>
            <label asp-for="InviteCode" class="block text-sm font-medium text-slate-300 mb-1">
                Invite Code @(isInviteOnly ? Html.Raw("<span class=\"text-rose-400 font-bold\">*</span>") : Html.Raw("<span class=\"text-slate-500 text-xs font-normal\">(Optional)</span>"))
            </label>
            <input asp-for="InviteCode" autocomplete="off" spellcheck="false"
                   id="registerInviteCode"
                   class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all font-mono uppercase tracking-wider"
                   placeholder="KONGOR-XXXX-XXXX"/>
            <span asp-validation-for="InviteCode" class="text-red-400 text-xs mt-1"></span>
            @if (isInviteOnly)
            {
                <p class="text-xs text-amber-400/90 mt-1 flex items-center gap-1.5">
                    <span>⚠️</span> A valid invite code is required to finish registering.
                </p>
            }
        </div>

        <button type="submit"
                id="btnSubmitRegister"
                class="w-full bg-purple-600 hover:bg-purple-500 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300 mt-6 shadow-lg shadow-purple-600/30 cursor-pointer">
            Create Account
        </button>

        @if (isStandaloneMode)
        {
            <div class="text-center pt-3">
                <a asp-controller="Account" asp-action="Login"
                   class="text-xs text-purple-400 hover:text-purple-300 transition-colors font-medium">
                    Already have an account? Sign In
                </a>
            </div>
        }
    </form>
    @if (!isStandaloneMode)
    {
        <form asp-controller="Account" asp-action="Logout" method="post" class="text-center pt-3">
            <button type="submit"
                    class="text-xs text-slate-400 hover:text-rose-300 transition-colors font-medium cursor-pointer">
                Switch Discord Account / Cancel Setup
            </button>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script src="~/js/validation.js" defer asp-append-version="true"></script>
}
