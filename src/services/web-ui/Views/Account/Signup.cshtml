@{
    ViewData["Title"] = "Sign Up";
}

<div class="w-full max-w-md p-8 rounded-2xl glass-panel animate-fade-in-up">
    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold mb-2">Create Account</h1>
        <p class="text-slate-400">Join the Project KONGOR community today</p>
    </div>

    <!-- Discord Signup -->
    <form asp-controller="Account" asp-action="SignupDiscord" method="post" class="mb-6">
        <button type="submit"
                class="w-full flex items-center justify-center gap-3 bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg shadow-[#5865F2]/30">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 100 100" aria-hidden="true">
                <path
                    d="M85.22,24.958c-11.459-8.575-22.438-8.334-22.438-8.334l-1.122,1.282c13.623,4.087,19.954,10.097,19.954,10.097c-19.491-10.731-44.317-10.654-64.59,0c0,0,6.571-6.331,20.996-10.418l-0.801-0.962c0,0-10.899-0.24-22.438,8.334c0,0-11.54,20.755-11.54,46.319c0,0,6.732,11.54,24.442,12.101c0,0,2.965-3.526,5.369-6.571c-10.177-3.045-14.024-9.376-14.024-9.376c6.394,4.001,12.859,6.505,20.916,8.094c13.108,2.698,29.413-0.076,41.591-8.094c0,0-4.007,6.491-14.505,9.456c2.404,2.965,5.289,6.411,5.289,6.411c17.71-0.561,24.441-12.101,24.441-12.02C96.759,45.713,85.22,24.958,85.22,24.958z M35.055,63.824c-4.488,0-8.174-3.927-8.174-8.815c0.328-11.707,16.102-11.671,16.348,0C43.229,59.897,39.622,63.824,35.055,63.824z M64.304,63.824c-4.488,0-8.174-3.927-8.174-8.815c0.36-11.684,15.937-11.689,16.348,0C72.478,59.897,68.872,63.824,64.304,63.824z"/>
            </svg>
            Sign Up with Discord
        </button>
    </form>

    @if (ViewBag.HasApiKey == true)
    {
        <!-- Real Signup Link -->
        <a asp-controller="Account" asp-action="RegisterDirect"
           class="w-full flex items-center justify-center gap-3 bg-pink-600 hover:bg-pink-500 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg shadow-pink-600/30">
            Sign Up with Email
        </a>
    }
    else
    {
        <div class="relative mb-6">
            <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-slate-700"></div>
            </div>
            <div class="relative flex justify-center text-sm">
                <span class="px-2 bg-slate-900 text-slate-400">Or use developer mock signup</span>
            </div>
        </div>

        <!-- Mock Signup -->
        <form asp-controller="Account" asp-action="SignupMock" method="post" class="space-y-4">
            <div>
                <label for="email" class="block text-sm font-medium text-slate-300 mb-1">Email Address</label>
                <input type="email" id="email" name="email" required
                       class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-transparent transition-all"
                       placeholder="newuser@kongor.net">
            </div>

            <button type="submit"
                    class="w-full bg-slate-700 hover:bg-slate-600 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300">
                Mock Signup
            </button>
        </form>
    }

    <div class="mt-6 text-center text-sm text-slate-400">
        Already have an account? <a asp-controller="Account" asp-action="Login"
                                    class="text-pink-400 hover:text-pink-300 hover:underline">Log in</a>
    </div>
</div>
