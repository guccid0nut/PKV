@{
    ViewData["Title"] = "Login";
    var isDiscordConfigured = ViewData["IsDiscordConfigured"] as bool? ?? true;
    var isInviteOnly = ViewData["IsInviteOnlyEnabled"] as bool? ?? false;
    var appliedInvite = ViewData["AppliedInviteCode"] as string;
    var isPasswordAuthEnabled = ViewData["IsPasswordAuthEnabled"] as bool? ?? false;
}

<div class="w-full max-w-md p-8 rounded-2xl glass-panel animate-fade-in-up">
    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold mb-2">Welcome Back</h1>
        <p class="text-slate-400">Sign in to access your Project KONGOR account</p>
    </div>

    @if (ViewContext.TempData["ErrorMessage"] != null)
    {
        <div
            class="mb-6 p-4 rounded-xl bg-rose-500/20 border border-rose-500/40 text-rose-300 text-xs sm:text-sm font-semibold flex items-center gap-3 animate-shake">
            <span class="text-lg">🚫</span>
            <span>@ViewContext.TempData["ErrorMessage"]</span>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly"
             class="mb-6 p-4 rounded-xl bg-rose-500/20 border border-rose-500/40 text-rose-300 text-xs sm:text-sm font-semibold animate-shake">
        </div>
    }

    @if (isInviteOnly)
    {
        <div
            id="inviteOnlyBanner"
            class="mb-6 p-4 rounded-xl bg-purple-900/30 border border-purple-500/40 text-purple-200 text-xs flex items-start gap-3 shadow-md shadow-purple-950/40">
            <span class="text-lg">🔒</span>
            <div class="space-y-1">
                <div class="font-bold flex items-center gap-2">
                    <span>Private Invite-Only Mode Active</span>
                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-purple-500/30 text-purple-300 border border-purple-500/50 uppercase font-mono font-bold">Closed Beta</span>
                </div>
                <div class="text-slate-300 text-[11px] leading-relaxed">
                    Account registration is currently restricted. New accounts must be invited by an active Project KONGOR player with at least 100 matchmaking games.
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(appliedInvite))
    {
        <div
            id="appliedInviteBanner"
            class="mb-6 p-3.5 rounded-xl bg-emerald-950/40 border border-emerald-500/40 text-emerald-200 text-xs flex items-center justify-between gap-3 shadow-md">
            <div class="flex items-center gap-2 min-w-0">
                <span class="text-base">🎟️</span>
                <div class="truncate">
                    <span class="text-slate-400 text-[11px] block">Invite Code Attached:</span>
                    <span class="font-mono font-black text-emerald-300 text-sm tracking-wider" id="displayedAppliedCode">@appliedInvite</span>
                </div>
            </div>
            <span class="text-[10px] px-2 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 font-bold shrink-0">READY</span>
        </div>
    }

    @if (isPasswordAuthEnabled)
    {
        <!-- Password Login Form -->
        <form asp-controller="Account" asp-action="LoginPassword" method="post" class="mb-6 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div>
                <label for="loginInput" class="block text-xs font-medium text-slate-300 mb-1.5">
                    Username or Email
                </label>
                <input type="text"
                       id="loginInput"
                       name="login"
                       required
                       autocomplete="username" autocapitalize="none" spellcheck="false"
                       placeholder="Enter your username or email"
                       class="w-full bg-slate-800/60 border border-slate-700 rounded-xl px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all text-sm" />
            </div>

            <div>
                <label for="passwordInput" class="block text-xs font-medium text-slate-300 mb-1.5">
                    Password
                </label>
                <input type="password"
                       id="passwordInput"
                       name="password"
                       required
                       autocomplete="current-password"
                       placeholder="••••••••"
                       class="w-full bg-slate-800/60 border border-slate-700 rounded-xl px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all text-sm" />
            </div>

            <button type="submit"
                    id="btnPasswordLogin"
                    class="w-full flex items-center justify-center gap-2 bg-purple-600 hover:bg-purple-500 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg shadow-purple-600/30 cursor-pointer">
                Sign In
            </button>

            <div class="text-center pt-2">
                <a asp-controller="Account" asp-action="Register"
                   class="text-xs text-purple-400 hover:text-purple-300 transition-colors font-medium">
                    Create account (Invite Code)
                </a>
            </div>
        </form>

        <div class="relative flex py-2 items-center mb-6">
            <div class="flex-grow border-t border-slate-700"></div>
            <span class="flex-shrink mx-4 text-slate-500 text-xs uppercase font-medium">Or continue with</span>
            <div class="flex-grow border-t border-slate-700"></div>
        </div>
    }

    @if (!isDiscordConfigured)
    {
        <div
            class="mb-6 p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs flex items-start gap-3">
            <span class="text-base mt-0.5">⚠️</span>
            <div class="space-y-1">
                <div class="font-bold">Discord OAuth2 Setup Required</div>
                <div class="text-slate-400">Discord Client ID and Secret have not been configured yet. Click below to
                    view the setup guide.
                </div>
            </div>
        </div>
    }

    <!-- Discord Login -->
    <form asp-controller="Account" asp-action="LoginDiscord" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post"
          class="mb-6 space-y-4">
        <div>
            <label for="inviteInput" class="block text-xs font-medium text-slate-300 mb-1.5 flex items-center justify-between">
                <span>Have an Invite Code? @(isInviteOnly ? Html.Raw("<span class=\"text-rose-400 font-bold\">(Required for New Accounts)</span>") : Html.Raw("<span class=\"text-slate-500 font-normal\">(Optional)</span>"))</span>
            </label>
            <div class="relative">
                <input type="text"
                       id="inviteInput"
                       name="invite"
                       value="@appliedInvite"
                       placeholder="e.g. KONGOR-XXXX-XXXX"
                       autocomplete="off"
                       spellcheck="false"
                       class="w-full bg-slate-800/60 border border-slate-700 rounded-xl px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all font-mono uppercase text-sm tracking-wider" />
                <span class="absolute right-3 top-2.5 text-xs text-slate-400 pointer-events-none">🎟️</span>
            </div>
            <p class="text-[11px] text-slate-400 mt-1">If you are registering for the first time, your invite code will be verified upon linking your Discord.</p>
        </div>

        <button type="submit"
                id="btnDiscordLogin"
                class="w-full flex items-center justify-center gap-3 bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg shadow-[#5865F2]/30 cursor-pointer">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 100 100" aria-hidden="true">
                <path
                    d="M85.22,24.958c-11.459-8.575-22.438-8.334-22.438-8.334l-1.122,1.282c13.623,4.087,19.954,10.097,19.954,10.097c-19.491-10.731-44.317-10.654-64.59,0c0,0,6.571-6.331,20.996-10.418l-0.801-0.962c0,0-10.899-0.24-22.438,8.334c0,0-11.54,20.755-11.54,46.319c0,0,6.732,11.54,24.442,12.101c0,0,2.965-3.526,5.369-6.571c-10.177-3.045-14.024-9.376-14.024-9.376c6.394,4.001,12.859,6.505,20.916,8.094c13.108,2.698,29.413-0.076,41.591-8.094c0,0-4.007,6.491-14.505,9.456c2.404,2.965,5.289,6.411,5.289,6.411c17.71-0.561,24.441-12.101,24.441-12.02C96.759,45.713,85.22,24.958,85.22,24.958z M35.055,63.824c-4.488,0-8.174-3.927-8.174-8.815c0.328-11.707,16.102-11.671,16.348,0C43.229,59.897,39.622,63.824,35.055,63.824z M64.304,63.824c-4.488,0-8.174-3.927-8.174-8.815c0.36-11.684,15.937-11.689,16.348,0C72.478,59.897,68.872,63.824,64.304,63.824z"/>
            </svg>
            Continue with Discord
        </button>
    </form>
</div>
