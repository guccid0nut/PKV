@{
    ViewData["Title"] = "Discord Setup Required";
    var redirectUri = ViewData["RedirectUri"] as string ?? "https://localhost:5557/signin-discord";
    var returnUrl = ViewData["ReturnUrl"] as string ?? "";
}

<div
    class="w-full max-w-2xl p-8 sm:p-10 rounded-2xl glass-panel animate-fade-in-up border border-indigo-500/30 shadow-2xl shadow-indigo-950/40">
    <div class="text-center mb-8">
        <div
            class="w-16 h-16 rounded-2xl bg-[#5865F2]/20 border border-[#5865F2]/40 flex items-center justify-center mx-auto mb-4 text-3xl">
            🔐
        </div>
        <h1 class="text-3xl font-extrabold text-white mb-2 tracking-tight">Discord Credentials Required</h1>
        <p class="text-slate-400 text-sm sm:text-base">To enable secure player login and registration, your Discord
            OAuth2 Application keys must be configured.</p>
    </div>

    <!-- Step-by-Step Instructions -->
    <div class="space-y-6 text-sm text-slate-300">

        <!-- Step 1 -->
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 flex items-start gap-4">
            <div
                class="w-8 h-8 rounded-lg bg-indigo-500/20 text-indigo-400 font-bold flex items-center justify-center shrink-0">
                1
            </div>
            <div class="space-y-1">
                <div class="font-semibold text-white">Create a Discord Application</div>
                <div class="text-slate-400 text-xs">Visit the Discord Developer Portal and click <strong>New
                        Application</strong>.
                </div>
                <a href="https://discord.com/developers/applications" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#5865F2] hover:text-[#7983F5] underline mt-1">
                    <span>Open Discord Developer Portal</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                </a>
            </div>
        </div>

        <!-- Step 2 -->
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 flex items-start gap-4">
            <div
                class="w-8 h-8 rounded-lg bg-indigo-500/20 text-indigo-400 font-bold flex items-center justify-center shrink-0">
                2
            </div>
            <div class="space-y-2 w-full">
                <div class="font-semibold text-white">Add Redirect URI</div>
                <div class="text-slate-400 text-xs">Under <strong>OAuth2 &rarr; General</strong> in your Discord App,
                    add this exact Redirect URI:
                </div>
                <div class="flex items-center gap-2">
                    <input type="text" id="redirectUriBox" value="@redirectUri" readonly
                           class="w-full bg-slate-950/80 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-indigo-300 font-mono select-all focus:outline-none"/>
                    <button type="button"
                            onclick="navigator.clipboard.writeText('@redirectUri'); this.innerText='Copied!';"
                            class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-semibold shrink-0 transition-colors">
                        Copy
                    </button>
                </div>
            </div>
        </div>

        <!-- Step 3 -->
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 flex items-start gap-4">
            <div
                class="w-8 h-8 rounded-lg bg-indigo-500/20 text-indigo-400 font-bold flex items-center justify-center shrink-0">
                3
            </div>
            <div class="space-y-1">
                <div class="font-semibold text-white">Save in NEXUS Secrets Vault</div>
                <div class="text-slate-400 text-xs">
                    Open the <strong>NEXUS Control Panel GUI &rarr; Secrets &amp; Config</strong> tab, enter your
                    <strong>Discord Client ID</strong> and <strong>Discord Client Secret</strong>, then click <strong>💾
                        Save Secrets</strong>.
                </div>
            </div>
        </div>

    </div>

    <!-- Actions -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-slate-800">
        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl"
           class="w-full sm:w-auto text-center px-5 py-2.5 rounded-xl border border-slate-700 text-slate-300 hover:bg-slate-800 text-xs font-semibold transition-all">
            &larr; Back to Login
        </a>

        <form asp-controller="Account" asp-action="LoginDiscord" asp-route-returnUrl="@returnUrl" method="post"
              class="w-full sm:w-auto">
            <button type="submit"
                    class="w-full sm:w-auto flex items-center justify-center gap-2 bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold py-2.5 px-6 rounded-xl text-xs transition-all shadow-lg shadow-[#5865F2]/30">
                <span>🔄 Retry Discord Login</span>
            </button>
        </form>
    </div>
</div>
