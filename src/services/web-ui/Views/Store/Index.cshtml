@model StaffStoreViewModel
@{
    ViewData["Title"] = "Heroes of Newerth In-Game Store";
    var mainCat = Model.MainCategory ?? "alt_avatars";
    var subCat = Model.SubCategory ?? mainCat switch
    {
        "game_vanity" => "taunts",
        "account_vanity" => "icons",
        _ => ""
    };

    string GetMainCatClass(string catKey)
    {
        var active = string.Equals(mainCat, catKey, StringComparison.OrdinalIgnoreCase);
        return active
            ? "bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 text-slate-950 font-black shadow-lg shadow-amber-500/25 border-amber-400"
            : "bg-slate-900/90 text-slate-300 hover:text-white hover:bg-slate-800 border-slate-700/80";
    }

    string GetSubCatClass(string subKey)
    {
        var active = string.Equals(Model.SelectedCategory, subKey, StringComparison.OrdinalIgnoreCase) ||
                     (string.IsNullOrEmpty(Model.SelectedCategory) && string.Equals(subCat, subKey, StringComparison.OrdinalIgnoreCase));
        return active
            ? "bg-amber-500 text-slate-950 font-black shadow-md shadow-amber-500/20"
            : "bg-slate-950/80 text-slate-400 hover:text-slate-100 hover:bg-slate-800 border border-slate-800";
    }

    var firstItem = Model.Items.FirstOrDefault();
}

<div class="w-full max-w-[1750px] mx-auto px-3 sm:px-6 lg:px-8 py-4 space-y-5 animate-fadeIn">

    <!-- Top In-Game Store Ribbon & Category Bar -->
    <div
        class="bg-slate-950/95 rounded-2xl border border-amber-900/40 p-3 sm:p-4 shadow-2xl space-y-4 backdrop-blur-xl relative overflow-hidden">
        <div
            class="absolute -right-20 -top-20 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Top Row: Main HoN Shop Ribbons & Currency Bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-800/80 pb-3">

            <!-- In-Game Main Navigation Tabs -->
            <nav class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                <a asp-controller="Store" asp-action="Index" asp-route-category="featured"
                   class="px-4 py-1.5 rounded-xl text-xs uppercase tracking-wider transition-all border @GetMainCatClass("featured")">
                    Featured
                </a>
                <a asp-controller="Store" asp-action="Index" asp-route-category="avatars"
                   class="px-4 py-1.5 rounded-xl text-xs uppercase tracking-wider transition-all border @GetMainCatClass("alt_avatars")">
                    🦸 Alt Avatars (@Model.TotalAvatars)
                </a>
                <a asp-controller="Store" asp-action="Index" asp-route-category="announcers"
                   class="px-4 py-1.5 rounded-xl text-xs uppercase tracking-wider transition-all border @GetMainCatClass("announcers")">
                    🎙️ Announcers (@Model.TotalAnnouncers)
                </a>
                <a asp-controller="Store" asp-action="Index" asp-route-category="taunts"
                   class="px-4 py-1.5 rounded-xl text-xs uppercase tracking-wider transition-all border @GetMainCatClass("taunts")">
                    💀 Taunts (@Model.TotalTaunts)
                </a>
                <a asp-controller="Store" asp-action="Index" asp-route-category="couriers"
                   class="px-4 py-1.5 rounded-xl text-xs uppercase tracking-wider transition-all border @GetMainCatClass("game_vanity")">
                    🐎 Couriers & Wards
                </a>
                <a asp-controller="Store" asp-action="Index" asp-route-category="account_vanity"
                   class="px-4 py-1.5 rounded-xl text-xs uppercase tracking-wider transition-all border @GetMainCatClass("account_vanity")">
                    🎖️ Account Vanity
                </a>
                <a asp-controller="Store" asp-action="Index" asp-route-category="bundles"
                   class="px-4 py-1.5 rounded-xl text-xs uppercase tracking-wider transition-all border @GetMainCatClass("bundles")">
                    📦 Bundles (@Model.TotalBundles)
                </a>
                <a asp-controller="Store" asp-action="Index" asp-route-category="other"
                   class="px-4 py-1.5 rounded-xl text-xs uppercase tracking-wider transition-all border @GetMainCatClass("other")">
                    Other
                </a>
                <a asp-controller="Store" asp-action="Index" asp-route-category="plinko"
                   class="px-4 py-1.5 rounded-xl text-xs uppercase tracking-wider transition-all border @GetMainCatClass("plinko") flex items-center gap-1.5">
                    <span>🎪</span>
                    <span>Plinko & Daily Drop</span>
                    <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping inline-block"></span>
                </a>
            </nav>

            <!-- Top Right: Currency, Vault & Actions -->
            <div class="flex items-center gap-3">
                @if (Model.IsAuthenticated)
                {
                    <div
                        class="flex items-center gap-3 bg-slate-900/90 border border-slate-800 rounded-xl px-4 py-1.5 text-xs font-black shadow-inner">
                        <div class="flex items-center gap-1.5 text-amber-400">
                            <i class="fas fa-coins text-amber-500"></i>
                            <span id="userGoldDisplay">@Model.UserGold.ToString("N0")</span>
                            <span class="text-[10px] text-amber-500/70 uppercase">Gold</span>
                        </div>
                        <span class="text-slate-700">|</span>
                        <div class="flex items-center gap-1.5 text-slate-300">
                            <i class="fas fa-circle text-slate-400 text-[10px]"></i>
                            <span id="userSilverDisplay">@Model.UserSilver.ToString("N0")</span>
                            <span class="text-[10px] text-slate-400 uppercase">Silver</span>
                        </div>
                    </div>
                }
                else
                {
                    <form asp-controller="Account" asp-action="LoginDiscord" method="post" class="inline">
                        <button type="submit"
                                class="px-4 py-1.5 rounded-xl bg-[#5865F2] hover:bg-[#4752C4] text-white font-bold text-xs flex items-center gap-2 shadow-lg shadow-[#5865F2]/20 glow-discord transition-all">
                            <i class="fab fa-discord"></i>
                            <span>Connect with Discord</span>
                        </button>
                    </form>
                }

                @if (Model.IsStaff)
                {
                    <a asp-controller="Staff" asp-action="Inventory"
                       class="px-3.5 py-1.5 rounded-xl bg-purple-500/20 hover:bg-purple-500/30 text-purple-300 border border-purple-500/40 text-xs font-bold transition-all flex items-center gap-1.5 shadow-md">
                        <i class="fas fa-boxes"></i>
                        <span>Staff Inventory</span>
                    </a>
                    <a asp-controller="Staff" asp-action="Reports"
                       class="px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700 text-xs font-bold transition-all flex items-center gap-1">
                        <i class="fas fa-user-shield"></i>
                        <span>Staff Hub</span>
                    </a>
                }
            </div>
        </div>

        <!-- Sub-Category, Ownership & Breadcrumb Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-1">

            <!-- Left Side: Ownership Vault Filter Pills (DIRECTLY UNDER CATEGORIES) + Breadcrumbs -->
            <div class="flex flex-wrap items-center gap-3">
                @if (Model.IsAuthenticated)
                {
                    <!-- Ownership Vault Filter -->
                    <div
                        class="flex items-center gap-1 bg-slate-950/90 p-1 rounded-xl border border-slate-800 shadow-inner">
                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider px-2 font-mono"><i
                                class="fas fa-vault text-amber-400 mr-1"></i>Vault:</span>
                        @if (Model.IsUnlockAllItemsEnabled)
                        {
                            <a asp-controller="Store" asp-action="Index" asp-route-category="@Model.SelectedCategory"
                               asp-route-search="@Model.SearchQuery" asp-route-ownership="all"
                               class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all @(Model.OwnershipFilter == "all" ? "bg-emerald-500 text-slate-950 shadow-md shadow-emerald-500/20" : "text-slate-400 hover:text-white")">
                                ✨ All Unlocked (@Model.TotalOwnedInFilter)
                            </a>
                            <a asp-controller="Store" asp-action="Index" asp-route-category="@Model.SelectedCategory"
                               asp-route-search="@Model.SearchQuery" asp-route-ownership="equipped"
                               class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all @(Model.OwnershipFilter == "equipped" ? "bg-amber-500 text-slate-950 shadow-md shadow-amber-500/20" : "text-slate-400 hover:text-white")">
                                ⚡ Equipped (@Model.TotalEquippedInFilter)
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Store" asp-action="Index" asp-route-category="@Model.SelectedCategory"
                               asp-route-search="@Model.SearchQuery" asp-route-ownership="all"
                               class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all @(Model.OwnershipFilter == "all" ? "bg-amber-500 text-slate-950 shadow-md shadow-amber-500/20" : "text-slate-400 hover:text-white")">
                                All
                            </a>
                            <a asp-controller="Store" asp-action="Index" asp-route-category="@Model.SelectedCategory"
                               asp-route-search="@Model.SearchQuery" asp-route-ownership="unowned"
                               class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all @(Model.OwnershipFilter == "unowned" ? "bg-amber-500 text-slate-950 shadow-md shadow-amber-500/20" : "text-slate-400 hover:text-white")">
                                Unowned (@Model.TotalUnownedInFilter)
                            </a>
                            <a asp-controller="Store" asp-action="Index" asp-route-category="@Model.SelectedCategory"
                               asp-route-search="@Model.SearchQuery" asp-route-ownership="owned"
                               class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all @(Model.OwnershipFilter == "owned" ? "bg-emerald-500 text-slate-950 shadow-md shadow-emerald-500/20" : "text-slate-400 hover:text-white")">
                                Owned (@Model.TotalOwnedInFilter)
                            </a>
                        }
                    </div>
                }

                <!-- Breadcrumbs -->
                <div class="flex items-center gap-2 text-xs font-bold text-slate-400">
                    <span class="text-amber-500 flex items-center gap-1"><i class="fas fa-store"></i> Store</span>
                    <span class="text-slate-600">\</span>
                    <span class="text-slate-300 uppercase font-mono">@(mainCat.Replace("_", " "))</span>
                    @if (!string.IsNullOrEmpty(Model.SelectedCategory) && Model.SelectedCategory != "all")
                    {
                        <span class="text-slate-600">\</span>
                        <span class="text-amber-400 uppercase font-mono">@Model.SelectedCategory</span>
                    }
                </div>
            </div>

            <!-- Right Side: Subcategory Pills -->
            <div class="flex flex-wrap items-center gap-2">
                @if (mainCat == "announcers")
                {
                    <a asp-controller="Store" asp-action="Index" asp-route-category="announcers"
                       asp-route-ownership="@Model.OwnershipFilter"
                       class="px-3 py-1 rounded-lg text-xs font-bold transition-all @GetSubCatClass("announcers")">
                        🎙️ All Announcer Packs (@Model.TotalAnnouncers)
                    </a>
                }
                else if (mainCat == "taunts")
                {
                    <a asp-controller="Store" asp-action="Index" asp-route-category="taunts"
                       asp-route-ownership="@Model.OwnershipFilter"
                       class="px-3 py-1 rounded-lg text-xs font-bold transition-all @GetSubCatClass("taunts")">
                        💀 All Battlefield Taunts (@Model.TotalTaunts)
                    </a>
                }
                else if (mainCat == "game_vanity")
                {
                    <a asp-controller="Store" asp-action="Index" asp-route-category="couriers"
                       asp-route-ownership="@Model.OwnershipFilter"
                       class="px-3 py-1 rounded-lg text-xs font-bold transition-all @GetSubCatClass("couriers")">
                        🐎 Couriers (@Model.TotalCouriers)
                    </a>
                    <a asp-controller="Store" asp-action="Index" asp-route-category="wards"
                       asp-route-ownership="@Model.OwnershipFilter"
                       class="px-3 py-1 rounded-lg text-xs font-bold transition-all @GetSubCatClass("wards")">
                        👁️ Wards (@Model.TotalWards)
                    </a>
                    <a asp-controller="Store" asp-action="Index" asp-route-category="announcers"
                       asp-route-ownership="@Model.OwnershipFilter"
                       class="px-3 py-1 rounded-lg text-xs font-bold transition-all @GetSubCatClass("announcers")">
                        🎙️ Announcers (@Model.TotalAnnouncers)
                    </a>
                    <a asp-controller="Store" asp-action="Index" asp-route-category="taunts"
                       asp-route-ownership="@Model.OwnershipFilter"
                       class="px-3 py-1 rounded-lg text-xs font-bold transition-all @GetSubCatClass("taunts")">
                        💀 Taunts (@Model.TotalTaunts)
                    </a>
                }
                else if (mainCat == "account_vanity")
                {
                    <a asp-controller="Store" asp-action="Index" asp-route-category="icons"
                       asp-route-ownership="@Model.OwnershipFilter"
                       class="px-3 py-1 rounded-lg text-xs font-bold transition-all @GetSubCatClass("icons")">
                        🎖️ Account Icons (@Model.TotalIcons)
                    </a>
                    <a asp-controller="Store" asp-action="Index" asp-route-category="colors"
                       asp-route-ownership="@Model.OwnershipFilter"
                       class="px-3 py-1 rounded-lg text-xs font-bold transition-all @GetSubCatClass("colors")">
                        🎨 Name Colors & Shields (@Model.TotalUpgrades)
                    </a>
                    <a asp-controller="Store" asp-action="Index" asp-route-category="services"
                       asp-route-ownership="@Model.OwnershipFilter"
                       class="px-3 py-1 rounded-lg text-xs font-bold transition-all @GetSubCatClass("services")">
                        ⚡ Account Services
                    </a>
                }
                else if (mainCat == "alt_avatars")
                {
                    <a asp-controller="Store" asp-action="Index" asp-route-category="avatars"
                       asp-route-ownership="@Model.OwnershipFilter"
                       class="px-3 py-1 rounded-lg text-xs font-bold transition-all @GetSubCatClass("avatars")">
                        All Alt Avatars (@Model.TotalAvatars)
                    </a>
                }
            </div>
        </div>
    </div>

    @if (mainCat == "plinko")
    {
        <!-- Goblin Plinko & Daily Spin Arena -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start animate-fadeIn">
            <!-- Left Side: Plinko Canvas Game Board (7 cols) -->
            <div class="lg:col-span-7 space-y-4">
                <div
                    class="bg-slate-950/90 rounded-3xl p-5 border border-amber-500/30 shadow-2xl backdrop-blur-2xl space-y-4 relative overflow-hidden">
                    <div
                        class="absolute -right-20 -top-20 w-60 h-60 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

                    <!-- Plinko Header & Action Controls -->
                    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-800 pb-4">
                        <div class="space-y-0.5">
                            <div class="flex items-center gap-2">
                                <span
                                    class="text-xs font-black uppercase tracking-wider text-amber-400 bg-amber-950/50 px-2 py-0.5 rounded-lg border border-amber-500/30">🎪 Goblin King's Board</span>
                                <span id="plinkoDailyTimer"
                                      class="text-xs font-mono text-amber-400/90">Loading...</span>
                            </div>
                            <h2 class="text-2xl font-black text-white tracking-tight">Daily Plinko Drop</h2>
                        </div>

                        <div class="flex flex-wrap items-center gap-2">
                            <button id="plinkoDailyBtn" onclick="window.PlinkoGame.dropDaily()"
                                    class="px-4 py-2 rounded-2xl bg-gradient-to-r from-emerald-500 via-teal-500 to-emerald-600 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-black text-xs shadow-lg shadow-emerald-500/30 flex items-center gap-1.5 hover:scale-105 active:scale-95 transition-all">
                                <span>@(Model.IsUnlockAllItemsEnabled ? "🎁 Free Drop" : "🎁 Free Daily")</span>
                            </button>
                            <button id="plinkoTicketBtn" onclick="window.PlinkoGame.dropTicket()"
                                    class="px-3.5 py-2 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-black text-xs shadow-lg shadow-purple-600/30 flex items-center gap-1.5 hover:scale-105 active:scale-95 transition-all">
                                @if (Model.IsUnlockAllItemsEnabled)
                                {
                                    <span>🎟️ Free Bonus (<span id="plinkoTicketCount">0</span>)</span>
                                }
                                else
                                {
                                    <span>🎟️ 100 Tickets (<span id="plinkoTicketCount">0</span>)</span>
                                }
                            </button>
                            <button id="plinkoGoldBtn" onclick="window.PlinkoGame.dropGold()"
                                    class="px-3.5 py-2 rounded-2xl bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 text-slate-950 font-black text-xs shadow-lg shadow-amber-500/30 flex items-center gap-1.5 hover:scale-105 active:scale-95 transition-all">
                                <span>@(Model.IsUnlockAllItemsEnabled ? "🪙 Free Gold Drop" : "🪙 50 Gold")</span>
                            </button>
                        </div>
                    </div>

                    <!-- Canvas Physics Container -->
                    <div
                        class="relative rounded-2xl overflow-hidden bg-slate-900/90 border border-slate-800 shadow-inner flex justify-center items-center">
                        <canvas id="plinkoCanvas" class="w-full h-[510px] max-w-[650px]" role="img" aria-label="Goblin Plinko arcade physics board">Your browser does not support HTML5 Canvas.</canvas>
                    </div>
                </div>
            </div>

            <!-- Right Side: Unlocked Cosmetics & Loot Vault (5 cols) -->
            <div class="lg:col-span-5 space-y-4">
                <div
                    class="bg-slate-950/90 rounded-3xl p-5 border border-purple-500/30 shadow-2xl backdrop-blur-2xl space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                        <div class="flex items-center gap-2.5">
                            <div
                                class="w-8 h-8 rounded-xl bg-purple-500/20 border border-purple-500/40 flex items-center justify-center text-purple-300 text-sm">
                                ✨
                            </div>
                            <h3 class="text-base font-black text-white tracking-tight">Cosmetics & Prestige Vault</h3>
                        </div>
                        <span
                            class="text-[10px] text-amber-400 font-bold bg-amber-950/40 px-2 py-0.5 rounded border border-amber-500/30">Plinko Exclusive</span>
                    </div>

                    <!-- Live Container for Unlocked Avatar Frames & Titles -->
                    <div id="plinkoCosmeticsVault" class="space-y-3 min-h-[220px]">
                        <div class="text-center py-8 text-slate-500 text-xs">
                            <i class="fas fa-spinner fa-spin mr-2"></i> Loading unlocked cosmetics...
                        </div>
                    </div>

                    <!-- Drop Rates Card -->
                    <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 text-xs space-y-2">
                        <div
                            class="font-bold text-slate-300 uppercase text-[11px] tracking-wider flex items-center gap-1.5">
                            <span>📊</span>
                            <span>Plinko Drop Rates & Odds</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-400">
                            <div>🥈 100 - 500 Silver: <span class="text-slate-200 font-bold">60%</span></div>
                            <div>🎟️ 1x - 3x Tickets: <span class="text-purple-300 font-bold">25%</span></div>
                            <div>🪙 250 Gold Coins: <span class="text-amber-300 font-bold">10%</span></div>
                            <div>👑 Ultra-Rare Cosmetics: <span class="text-pink-400 font-bold">5%</span></div>
                        </div>
                        <p class="text-[10px] text-slate-500 pt-1">Free daily drops reset every 24 hours. Extra drops
                            can be launched using Plinko Tickets earned in-game or from rewards.</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Main In-Game Store Arena: Left Shelf (Alt Avatar Name & 4x2 Avatars Grid) + Right Pedestal Showcase -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

            <!-- Left Side: Alt Avatar Name + Voice Button + 4x2 Avatars Matrix (6 cols) -->
            <div class="lg:col-span-6 space-y-4">

                <!-- Alt Avatar Title & Voice Preview Header Banner -->
                <div id="stageNameplateBanner"
                     class="bg-slate-950/80 rounded-2xl p-4 shadow-xl border border-slate-800/80 flex items-center justify-between gap-3 backdrop-blur-xl">
                    <div>
                    <span id="stageItemCategory"
                          class="text-[10px] font-mono font-black uppercase tracking-widest text-amber-400/90 flex items-center gap-1.5">
                        <i class="fas fa-sparkles text-amber-500"></i>
                        <span>@(firstItem?.TypeName ?? "ALT AVATAR")</span>
                    </span>
                        <h2 id="stageItemTitle"
                            class="text-xl sm:text-2xl font-black text-slate-100 tracking-tight leading-tight mt-0.5">
                            @(firstItem?.Name ?? "Select Alt Avatar")
                        </h2>
                    </div>

                    <button onclick="playStageAudio(stageActiveAction ? stageActiveAction.getClip().name : 'idle')"
                            title="Play Character Voice Line"
                            class="px-4 py-2 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-amber-400 border border-amber-500/50 text-xs font-black transition-all flex items-center gap-2 shadow-lg cursor-pointer hover:scale-105 active:scale-95 flex-shrink-0">
                        <i class="fas fa-volume-up text-amber-400 text-sm"></i>
                        <span>Voice</span>
                    </button>
                </div>

                @if (Model.Items.Count == 0)
                {
                    <div class="bg-slate-950/80 border border-slate-800 rounded-2xl p-12 text-center space-y-3">
                        <div
                            class="w-16 h-16 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center mx-auto text-slate-500 text-2xl">
                            <i class="fas fa-box-open"></i>
                        </div>
                        <h3 class="text-base font-bold text-slate-200">No items found</h3>
                        <p class="text-xs text-slate-400">Try selecting a different category or clearing ownership
                            filters.</p>
                    </div>
                }
                else
                {
                    <!-- Section Header: Avatars -->
                    <div class="flex items-center justify-between px-1">
                    <span
                        class="text-xs font-black text-amber-400 uppercase tracking-widest font-mono flex items-center gap-2">
                        <i class="fas fa-mask"></i>
                        <span>Avatars Matrix</span>
                    </span>
                        <span class="text-xs font-mono font-bold text-slate-400">
                        Showing @Model.Items.Count of @Model.TotalCount items
                    </span>
                    </div>

                    <!-- 4 Columns x 2 Rows = 8 Slots Grid -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        @for (var i = 0; i < 8; i++)
                        {
                            if (i < Model.Items.Count)
                            {
                                var item = Model.Items[i];
                                var isFirst = i == 0;
                                var cleanHero = item.HeroName.Replace("Hero_", "").ToLowerInvariant();

                                var cardBaseClass = item.IsOwnedByUser
                                    ? isFirst
                                        ? "shop-item-card is-owned group relative bg-gradient-to-b from-stone-900/95 via-slate-950/95 to-stone-950/95 border-2 border-emerald-400 ring-2 ring-emerald-400/50 shadow-xl shadow-emerald-500/20 rounded-xl p-2 cursor-pointer transition-all flex flex-col justify-between"
                                        : "shop-item-card is-owned group relative bg-gradient-to-b from-stone-900/90 via-slate-950/90 to-stone-950/90 border-2 border-emerald-500/40 hover:border-emerald-400 shadow-md shadow-slate-950/40 hover:shadow-emerald-500/20 rounded-xl p-2 cursor-pointer transition-all flex flex-col justify-between"
                                    : isFirst
                                        ? "shop-item-card is-unowned group relative bg-gradient-to-b from-stone-900/95 via-slate-950/95 to-stone-950/95 border-2 border-amber-400 ring-2 ring-amber-400/60 shadow-xl shadow-amber-500/25 rounded-xl p-2 cursor-pointer transition-all flex flex-col justify-between"
                                        : "shop-item-card is-unowned group relative bg-gradient-to-b from-stone-900/90 via-slate-950/90 to-stone-950/90 border-2 border-amber-500/60 hover:border-amber-400 shadow-md shadow-amber-950/30 hover:shadow-amber-500/20 rounded-xl p-2 cursor-pointer transition-all flex flex-col justify-between";

                                <div id="shop-card-@item.Id"
                                     class="@cardBaseClass"
                                     onclick="selectShopItem(@item.Id, '@item.Name.Replace("'", "\\'")', '@cleanHero', '@item.AltAvatarSuffix', '@item.Resource.Replace("'", "\\'")', @item.GoldCost, @item.SilverCost, @(item.IsOwnedByUser ? "true" : "false"), @(item.CanPreview3D ? "true" : "false"), @(item.IsEnabled ? "true" : "false"), @(item.Purchasable ? "true" : "false"), '@item.TypeName', '@item.Code', '@item.Description.Replace("'", "\\'")', @(item.IsEquippedByUser ? "true" : "false"))">

                                    <!-- Thumbnail Area -->
                                    <div
                                        class="relative aspect-square rounded-lg overflow-hidden bg-slate-950 @(item.IsOwnedByUser ? "border border-emerald-500/30 shadow-inner" : "border border-amber-500/40 shadow-inner") mb-1.5 group-hover:scale-[1.02] transition-transform">
                                        <img src="@Url.Action("GetIcon", "Assets3D", new { path = item.Resource })"
                                             alt="@item.Name"
                                             width="160" height="160" @(i == 0 ? Html.Raw("fetchpriority=\"high\" decoding=\"async\"") : i < 4 ? Html.Raw("decoding=\"async\"") : Html.Raw("loading=\"lazy\" decoding=\"async\""))
                                             class="w-full h-full object-cover"
                                             onerror="this.src='/images/icons/hero_default.png'"/>

                                        @if (item.IsOwnedByUser)
                                        {
                                            <div
                                                class="card-owned-badge absolute top-1 right-1 px-1.5 py-0.5 rounded bg-emerald-500/90 text-slate-950 flex items-center gap-1 text-[8px] font-black shadow-md tracking-wider">
                                                <i class="fas fa-unlock text-[7px]"></i>
                                                <span>@(Model.IsUnlockAllItemsEnabled ? "FREE" : "OWNED")</span>
                                            </div>
                                        }

                                        @if (item.IsEquippedByUser)
                                        {
                                            <div
                                                class="card-equipped-badge absolute top-1 left-1 px-1.5 py-0.5 rounded bg-emerald-600/90 text-white flex items-center gap-1 text-[7px] font-black shadow-md tracking-wider">
                                                <i class="fas fa-bolt text-[6px]"></i>
                                                <span>ACTIVE</span>
                                            </div>
                                        }
                                        else if (item.CanPreview3D)
                                        {
                                            <div
                                                class="absolute top-1 left-1 px-1.5 py-0.5 rounded bg-slate-950/80 border border-sky-500/40 text-[8px] font-mono font-bold text-sky-300">
                                                3D
                                            </div>
                                        }
                                    </div>

                                    <!-- Name -->
                                    <div
                                        class="text-[11px] font-bold @(item.IsOwnedByUser ? "text-slate-100 group-hover:text-emerald-300" : "text-slate-100 group-hover:text-amber-300") truncate transition-colors text-center">
                                        @item.Name
                                    </div>

                                    <!-- Pricing -->
                                    <div
                                        class="card-price-container flex items-center justify-center gap-1.5 mt-1 pt-1 border-t border-slate-900 text-[10px] font-mono">
                                        @if (item.IsOwnedByUser)
                                        {
                                            <span class="text-emerald-400 font-bold text-[9px] flex items-center gap-1">
                                            <i class="fas fa-check-circle text-[8px]"></i>
                                            <span>@(item.IsEquippedByUser ? "Equipped" : Model.IsUnlockAllItemsEnabled ? "Unlocked • Free" : "Vault")</span>
                                        </span>
                                        }
                                        else
                                        {
                                            @if (item.GoldCost > 0)
                                            {
                                                <span class="flex items-center gap-0.5 text-amber-400 font-bold">
                                                <i class="fas fa-coins text-[9px] text-amber-500"></i>
                                                <span>@item.GoldCost</span>
                                            </span>
                                            }

                                            @if (item.SilverCost > 0)
                                            {
                                                <span class="flex items-center gap-0.5 text-slate-300 font-bold">
                                                <i class="fas fa-circle text-[7px] text-slate-400"></i>
                                                <span>@item.SilverCost</span>
                                            </span>
                                            }

                                            @if (item is { GoldCost: 0, SilverCost: 0 })
                                            {
                                                <span class="text-emerald-400 font-semibold text-[9px]">@(Model.IsUnlockAllItemsEnabled ? "Free" : "Unavailable")</span>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Authentic Embossed Empty Slot Placeholder -->
                                <div
                                    class="relative bg-slate-950/40 border-2 border-dashed border-slate-800/60 rounded-xl p-2 flex flex-col items-center justify-center opacity-40 select-none aspect-square">
                                    <div
                                        class="w-10 h-10 rounded-full border border-slate-700/50 flex items-center justify-center text-slate-600 text-sm font-black font-mono">
                                        HON
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <!-- Bottom Pagination & Goblin Shopkeeper Footer -->
                    <div
                        class="flex flex-wrap items-center justify-between gap-4 bg-slate-950/90 border border-slate-800 rounded-2xl p-3.5 shadow-lg">
                        <div class="flex items-center gap-3">
                            <div
                                class="relative w-11 h-11 rounded-xl bg-gradient-to-br from-amber-500/20 to-amber-950/60 border border-amber-500/40 p-1 flex items-center justify-center text-amber-400 font-bold shadow-inner overflow-hidden group">
                                <img
                                    src="@Url.Action("GetIcon", "Assets3D", new { path = "/shared/automated_courier/couriers/goblin_fly/icon.tga" })"
                                    alt="Merrick" width="44" height="44" loading="lazy" decoding="async"
                                    class="w-full h-full object-contain rounded-lg drop-shadow transition-transform group-hover:scale-110"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"/>
                                <div class="hidden w-full h-full items-center justify-center text-amber-400">
                                    <i class="fas fa-coins text-base animate-pulse"></i>
                                </div>
                            </div>
                            <div>
                            <span class="text-xs font-bold text-slate-100 flex items-center gap-1.5">
                                <span>Merrick's Vault</span>
                                <span
                                    class="text-[9px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-400 font-mono font-bold">MERCHANT</span>
                            </span>
                                <p class="text-[10px] text-slate-400 font-mono">
                                    Page @Model.Page of @Model.TotalPages</p>
                            </div>
                        </div>

                        <!-- Gold Pagination Controls -->
                        <div class="flex items-center gap-2">
                            @if (Model.Page > 1)
                            {
                                <a asp-controller="Store" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                                   asp-route-category="@Model.SelectedCategory" asp-route-search="@Model.SearchQuery"
                                   asp-route-ownership="@Model.OwnershipFilter"
                                   class="px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-amber-400 border border-amber-500/40 text-xs font-black uppercase tracking-wider transition-all shadow-md flex items-center gap-1 cursor-pointer">
                                    <i class="fas fa-chevron-left text-[10px]"></i>
                                    <span>Prev</span>
                                </a>
                            }

                            <form method="get" asp-controller="Store" asp-action="Index"
                                  class="flex items-center gap-1.5 font-mono text-xs px-2.5 py-1 rounded-xl bg-slate-900/90 border border-amber-500/60 text-amber-300 shadow-inner">
                                <input type="hidden" name="category" value="@Model.SelectedCategory"/>
                                <input type="hidden" name="search" value="@Model.SearchQuery"/>
                                <input type="hidden" name="ownership" value="@Model.OwnershipFilter"/>
                                <input type="number" name="page" min="1" max="@Model.TotalPages" value="@Model.Page"
                                       class="w-12 bg-slate-950/80 border border-amber-500/40 rounded px-1.5 py-0.5 text-center font-black text-amber-400 focus:outline-none focus:border-amber-400 text-xs font-mono"
                                       onchange="this.form.submit()"
                                       title="Type page number and press Enter"/>
                                <span class="text-amber-500/60">/</span>
                                <span class="font-bold text-amber-300 pr-1">@Model.TotalPages</span>
                            </form>

                            @if (Model.Page < Model.TotalPages)
                            {
                                <a asp-controller="Store" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                                   asp-route-category="@Model.SelectedCategory" asp-route-search="@Model.SearchQuery"
                                   asp-route-ownership="@Model.OwnershipFilter"
                                   class="px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-amber-400 border border-amber-500/40 text-xs font-black uppercase tracking-wider transition-all shadow-md flex items-center gap-1 cursor-pointer">
                                    <span>Next</span>
                                    <i class="fas fa-chevron-right text-[10px]"></i>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Right Side: The Showcase Stage & Action Pedestal (6 cols - Extra Large & Open) -->
            <div class="lg:col-span-6 space-y-4 sticky top-6">

                <div
                    class="bg-gradient-to-b from-slate-950/80 via-stone-950/80 to-slate-950/80 rounded-3xl shadow-2xl p-3 sm:p-4 space-y-3 backdrop-blur-2xl relative overflow-hidden">
                    <div
                        class="absolute -right-16 -top-16 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

                    <!-- Showcase Stage Viewport - Open & Extra Large -->
                    <div
                        class="relative w-full h-[560px] sm:h-[620px] lg:h-[650px] rounded-2xl overflow-hidden shadow-2xl flex items-center justify-center bg-slate-950/40">

                        <!-- 3D Canvas Stage -->
                        <div id="stage3DContainer"
                             class="absolute inset-0 w-full h-full @(firstItem?.CanPreview3D == true ? "" : "hidden")">
                            <canvas id="stage3DCanvas" role="region" aria-label="Webstore interactive 3D hero model stage"
                                    class="w-full h-full block cursor-grab active:cursor-grabbing">Your browser does not support HTML5 Canvas.</canvas>

                            <div id="stage3DLoading"
                                 class="absolute inset-0 bg-slate-950/80 backdrop-blur-sm z-20 flex flex-col items-center justify-center space-y-2">
                                <div
                                    class="w-10 h-10 border-4 border-amber-500/20 border-t-amber-500 rounded-full animate-spin"></div>
                                <span
                                    class="text-xs font-bold text-slate-200 font-mono">Rendering Character Model...</span>
                            </div>
                        </div>

                        <!-- 2D Winged Bronze Shield Stage -->
                        <div id="stage2DContainer"
                             class="relative z-10 flex flex-col items-center justify-center p-6 @(firstItem?.CanPreview3D == true ? "hidden" : "")">
                            <div
                                class="relative w-48 h-48 rounded-2xl bg-gradient-to-b from-amber-950/80 via-stone-900 to-black p-3.5 border-2 border-amber-600/60 shadow-2xl shadow-amber-500/10 flex items-center justify-center">
                                <div
                                    class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-amber-600 text-slate-950 font-black text-[9px] uppercase tracking-wider shadow">
                                    KONGOR
                                </div>

                                <img id="stage2DImage"
                                     src="@Url.Action("GetIcon", "Assets3D", new { path = firstItem?.Resource ?? "" })"
                                     alt="@(firstItem?.Name ?? "Item")" width="192" height="192" fetchpriority="high" decoding="async"
                                     class="w-full h-full object-contain drop-shadow-[0_10px_20px_rgba(0,0,0,0.8)]"
                                     onerror="this.src='/images/icons/hero_default.png'"/>
                            </div>
                        </div>

                        <!-- Top Stage Controls -->
                        <div
                            class="absolute top-3 left-3 right-3 flex items-center justify-between z-10 pointer-events-none">
                            <div class="flex items-center gap-2 pointer-events-auto">
                            <span
                                class="px-3 py-1 rounded-xl bg-gradient-to-b from-amber-400/90 via-amber-500/90 to-amber-600/90 text-slate-950 font-black text-[10px] uppercase tracking-wider shadow-lg shadow-amber-500/20">
                                Pedestal Showcase
                            </span>
                            </div>

                            <div id="stage3DControls"
                                 class="flex items-center gap-2 pointer-events-auto @(firstItem?.CanPreview3D == true ? "" : "hidden")">
                                <button id="stageArBtn" onclick="openCurrentItemInAR()" title="View in Tabletop AR (Turn on Camera)"
                                        class="px-2.5 h-9 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-sky-400 hover:text-white border border-sky-500/40 text-xs font-black shadow-md flex items-center gap-1.5 cursor-pointer active:scale-95 transition-all">
                                    <i class="fas fa-camera text-sky-400"></i>
                                    <span class="hidden sm:inline">AR</span>
                                </button>
                                <button id="stagePlayPauseBtn" onclick="toggleStagePlayPause()"
                                        title="Pause / Resume Animation"
                                        class="w-9 h-9 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-amber-400 border border-amber-500/40 text-sm font-black shadow-md flex items-center justify-center cursor-pointer">
                                    <i id="stagePlayPauseIcon" class="fas fa-pause"></i>
                                </button>
                                <button id="stageMuteBtn" onclick="toggleStageSound()" title="Mute / Unmute Audio"
                                        class="w-9 h-9 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-amber-400 border border-amber-500/40 text-sm font-black shadow-md flex items-center justify-center cursor-pointer">
                                    <i id="stageMuteIcon" class="fas fa-volume-up"></i>
                                </button>
                                <button id="stageResetCamBtn" onclick="resetStageCamera()" title="Reset Camera Framing"
                                        class="w-9 h-9 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-amber-400 border border-amber-500/40 text-sm font-black shadow-md flex items-center justify-center cursor-pointer">
                                    <i class="fas fa-crosshairs"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Bottom Animation Bar for 3D Viewport with Rich Gold Aesthetic -->
                        <div id="stageAnimBar"
                             class="absolute bottom-3 left-3 right-3 z-10 pointer-events-auto @(firstItem?.CanPreview3D == true ? "" : "hidden")">
                            <div
                                class="flex items-center justify-between gap-2.5 bg-slate-950/90 border border-amber-500/60 p-2 rounded-2xl backdrop-blur-xl shadow-2xl">

                                <!-- Animation Dropdown with Custom Gold Styling -->
                                <div class="flex items-center gap-2 flex-1 min-w-0">
                                <span
                                    class="hidden sm:flex items-center gap-1.5 text-amber-400 font-mono font-black text-[11px] uppercase tracking-wider pl-1.5 flex-shrink-0">
                                    <i class="fas fa-play text-amber-500 text-[10px]"></i>
                                    <span>Action:</span>
                                </span>
                                    <div class="relative flex-1 min-w-0">
                                        <select id="stageAnimSelect" onchange="playStageAnim(this.value)"
                                                class="w-full bg-slate-900/90 border border-amber-500/60 hover:border-amber-400 text-amber-300 font-black text-xs rounded-xl px-3 py-1.5 pr-8 focus:outline-none focus:ring-2 focus:ring-amber-400 font-mono shadow-inner cursor-pointer appearance-none truncate">
                                            <option value="">Animations...</option>
                                        </select>
                                        <div
                                            class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none text-amber-400">
                                            <i class="fas fa-chevron-down text-[10px]"></i>
                                        </div>
                                    </div>
                                </div>

                                <!-- Speed Slider -->
                                <div
                                    class="flex items-center gap-2 bg-slate-900/90 border border-amber-500/60 px-2.5 py-1 rounded-xl shadow-inner flex-shrink-0">
                                    <span
                                        class="text-[9px] font-black text-amber-400 uppercase tracking-wider font-mono">Speed</span>
                                    <input id="stageSpeedSlider" type="range" min="0.5" max="1.75" step="0.25"
                                           value="1.0"
                                           class="w-14 sm:w-16 accent-amber-500 cursor-pointer h-2"/>
                                    <span id="stageSpeedLabel"
                                          class="text-xs font-mono font-black text-amber-300 w-8 text-right">1.0x</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Grand Golden Purchase Button -->
                    <div id="stageActionBox" class="pt-1">
                        @if (firstItem != null)
                        {
                            @if (firstItem.IsOwnedByUser)
                            {
                                @if (firstItem.IsEquippedByUser)
                                {
                                    <div
                                        class="w-full py-4 px-6 rounded-2xl bg-slate-900/90 border border-slate-800 text-slate-500 text-base font-black text-center flex items-center justify-center gap-2 shadow-inner cursor-default opacity-80 select-none">
                                        <i class="fas fa-check-circle text-emerald-500"></i>
                                        <span>✓ IN LOADOUT</span>
                                    </div>
                                }
                                else
                                {
                                    <button onclick="equipCurrentSelectedItem()"
                                            class="w-full py-4 px-6 rounded-2xl bg-gradient-to-b from-amber-400 via-amber-500 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-slate-950 text-base font-black uppercase tracking-wider text-center flex items-center justify-center gap-2 shadow-2xl shadow-amber-500/30 transition-all cursor-pointer">
                                        <i class="fas fa-bolt"></i>
                                        <span>Equip in Loadout</span>
                                    </button>
                                }
                            }
                            else if (!Model.IsAuthenticated)
                            {
                                <a asp-controller="Account" asp-action="LoginDiscord"
                                   class="w-full py-4 px-6 rounded-2xl bg-[#5865F2] hover:bg-[#4752C4] text-white text-base font-black text-center flex items-center justify-center gap-2 shadow-2xl shadow-[#5865F2]/20 transition-all">
                                    <i class="fab fa-discord"></i>
                                    <span>Connect with Discord to Purchase</span>
                                </a>
                            }
                            else if (!firstItem.IsEnabled || !firstItem.Purchasable)
                            {
                                <button disabled
                                        class="w-full py-4 px-6 rounded-2xl bg-slate-800 text-slate-500 text-base font-bold text-center cursor-not-allowed">
                                    Unavailable
                                </button>
                            }
                            else
                            {
                                <div class="grid grid-cols-2 gap-3">
                                    @if (firstItem.GoldCost > 0)
                                    {
                                        <button
                                            onclick="openPurchaseModal(@firstItem.Id, '@firstItem.Name.Replace("'", "\\'")', @firstItem.GoldCost, 'gold')"
                                            class="py-3.5 px-4 rounded-2xl bg-gradient-to-b from-amber-400 via-amber-500 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-slate-950 font-black text-sm shadow-xl shadow-amber-500/30 border-2 border-amber-200 hover:border-white transition-all flex items-center justify-center gap-2 cursor-pointer transform hover:scale-[1.02] active:scale-98">
                                            <i class="fas fa-coins text-base"></i>
                                            <span>@firstItem.GoldCost Gold</span>
                                        </button>
                                    }
                                    @if (firstItem.SilverCost > 0)
                                    {
                                        <button
                                            onclick="openPurchaseModal(@firstItem.Id, '@firstItem.Name.Replace("'", "\\'")', @firstItem.SilverCost, 'silver')"
                                            class="py-3.5 px-4 rounded-2xl bg-slate-900 hover:bg-slate-800 text-slate-100 font-black text-sm border-2 border-slate-700 hover:border-amber-400 transition-all flex items-center justify-center gap-2 cursor-pointer transform hover:scale-[1.02] active:scale-98">
                                            <i class="fas fa-circle text-slate-400 text-xs"></i>
                                            <span>@firstItem.SilverCost Silver</span>
                                        </button>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <!-- Staff Price & Visibility Quick Editor -->
                    @if (Model.IsStaff)
                    {
                        <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between gap-2">
                        <span id="stageStaffItemId"
                              class="text-xs text-slate-500 font-mono">Product ID: #@(firstItem?.Id ?? 0)</span>
                            <div class="flex items-center gap-2">
                                <button onclick="openBulkDiscountModal()"
                                        class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-purple-900/80 to-indigo-950/80 hover:from-purple-800 hover:to-indigo-900 text-purple-200 border border-purple-600/50 text-xs font-bold transition-all flex items-center gap-1.5 shadow-md">
                                    <i class="fas fa-tags text-purple-400"></i>
                                    <span>Weekend Sale</span>
                                </button>
                                <button onclick="openStaffPriceEditorFromStage()"
                                        class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700 text-xs font-bold transition-all flex items-center gap-1.5 shadow-md">
                                    <i class="fas fa-pencil-alt"></i>
                                    <span>Price Editor</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Purchase Confirmation Modal -->
<div id="purchaseModal"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 backdrop-blur-md p-4 animate-fadeIn">
    <div class="relative w-full max-w-md bg-slate-900 border border-amber-500/30 rounded-2xl shadow-2xl p-6 space-y-5">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <h3 class="text-base font-bold text-slate-100 flex items-center gap-2">
                <i class="fas fa-lock text-amber-400"></i>
                <span>Confirm Vault Unlock</span>
            </h3>
            <button type="button" onclick="closePurchaseModal()" aria-label="Close purchase modal" title="Close" class="text-slate-400 hover:text-white"><i class="fas fa-times"></i>
            </button>
        </div>

        <div class="space-y-3 text-xs text-slate-300">
            <p>You are about to unlock <strong id="buyItemTitle" class="text-amber-300 text-sm"></strong>.</p>
            <div class="p-3 bg-slate-950/80 rounded-xl border border-slate-800 flex items-center justify-between">
                <span class="text-slate-400">Deduction:</span>
                <span id="buyCostDisplay" class="font-black text-sm text-slate-100"></span>
            </div>
            <p id="buyStatusMsg" class="hidden text-xs font-semibold"></p>
        </div>

        <input type="hidden" id="buyItemId"/>
        <input type="hidden" id="buyCurrency"/>

        <div class="flex items-center justify-end gap-3 pt-2">
            <button onclick="closePurchaseModal()"
                    class="px-4 py-2 rounded-xl bg-slate-800 text-slate-300 text-xs font-bold hover:bg-slate-700">Cancel
            </button>
            <button id="confirmBuyBtn" onclick="executePurchase()"
                    class="px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-black shadow-lg transition-all flex items-center gap-2">
                <i class="fas fa-check"></i>
                <span id="confirmBuyBtnText">Confirm Purchase</span>
            </button>
        </div>
    </div>
</div>

<!-- Staff Weekend Sale / Bulk Discount Modal -->
@if (Model.IsStaff)
{
    <div id="bulkDiscountModal"
         class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/85 backdrop-blur-md p-4 animate-fadeIn">
        <div
            class="relative w-full max-w-lg bg-slate-900 border border-purple-500/40 rounded-2xl shadow-2xl p-6 space-y-5">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <div class="flex items-center gap-2">
                    <div
                        class="w-8 h-8 rounded-xl bg-purple-500/20 border border-purple-500/40 flex items-center justify-center text-purple-400">
                        <i class="fas fa-tags text-sm"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-100">Weekend Sale / Bulk Discount Tool</h3>
                        <p class="text-[10px] text-purple-300">Quickly apply store-wide or category discounts with
                            1-click restore.</p>
                    </div>
                </div>
                <button type="button" onclick="closeBulkDiscountModal()" aria-label="Close bulk discount modal" title="Close" class="text-slate-400 hover:text-white"><i
                        class="fas fa-times"></i></button>
            </div>

            <div class="space-y-4 text-xs">
                <div>
                    <label class="block text-slate-400 font-bold mb-1">Target Category</label>
                    <select id="bulkCategory"
                            class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-slate-100 focus:border-purple-500 focus:outline-none font-medium">
                        <option value="all">Entire Store (All Items)</option>
