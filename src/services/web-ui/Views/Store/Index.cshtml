<!-- Three.js Dependencies for Interactive Showcase Stage -->
<script src="/lib/three/three.r16x.bundle.js" defer asp-append-version="true"></script>

<script>
    let stageScene, stageCamera, stageRenderer, stageControls, stageMixer, stageClock;
    let stageModelGroup = null;
    let currentStageModel = null;
    let stageActiveAction = null;
    let stageActions = {};
    let currentStageAudio = null;
    let stageAudioTimeout = null;
    let stageAnimSpeed = 1.0;
    let isStageAudioMuted = false;
    let stageLoadCounter = 0;
    let stageFetchController = null;
    let currentSelectedItem = {
        id: @(firstItem?.Id ?? 0),
        name: '@(firstItem?.Name.Replace("'", "\\'") ?? "")',
        hero: '@(firstItem?.HeroName.Replace("Hero_", "").ToLowerInvariant() ?? "")',
        alt: '@(firstItem?.AltAvatarSuffix ?? "")',
        resource: '@(firstItem?.Resource.Replace("'", "\\'") ?? "")',
        gold: @(firstItem?.GoldCost ?? 0),
        silver: @(firstItem?.SilverCost ?? 0),
        isOwned: @(firstItem?.IsOwnedByUser == true ? "true" : "false"),
        isEquipped: @(firstItem?.IsEquippedByUser == true ? "true" : "false"),
        can3d: @(firstItem?.CanPreview3D == true ? "true" : "false"),
        isEnabled: @(firstItem?.IsEnabled == true ? "true" : "false"),
        purchasable: @(firstItem?.Purchasable == true ? "true" : "false"),
        typeName: '@(firstItem?.TypeName ?? "")',
        code: '@(firstItem?.Code ?? "")',
        desc: '@(firstItem?.Description.Replace("'", "\\'") ?? "")'
    };

    window.addEventListener('DOMContentLoaded', () => {
        initStage3D();
        const isTrue3D = currentSelectedItem.can3d && currentSelectedItem.hero && (currentSelectedItem.typeName === 'Alt Avatar' || currentSelectedItem.typeName === 'Avatar' || currentSelectedItem.typeName === 'Hero' || currentSelectedItem.typeName === 'AltAvatar');
        if (isTrue3D) {
            loadStage3DModel(currentSelectedItem.hero, currentSelectedItem.alt, currentSelectedItem.resource);
        }
        if (currentSelectedItem && currentSelectedItem.hero) {
            updateHeroHeader(currentSelectedItem.hero);
        }
    });

    async function updateHeroHeader(heroName) {
        if (!heroName) return;
        const cleanHero = heroName.replace(/^Hero_/i, '').toLowerCase().trim();

        // 1. Single source of truth for Hero Portrait (matching Codex / HeroDetail)
        const portrait = document.getElementById('heroHeaderPortrait');
        if (portrait) {
            portrait.onerror = function () {
                this.onerror = null;
                this.src = '/images/heroes/default.png';
            };
            portrait.src = `/images/heroes/${cleanHero}.png`;
        }

        // 2. Single source of truth for 4 Ability Icons (matching Codex / HeroDetail)
        for (let i = 1; i <= 4; i++) {
            const abIcon = document.getElementById(`heroAbility${i - 1}`);
            if (abIcon) {
                abIcon.onerror = function () {
                    this.onerror = function () {
                        this.onerror = null;
                        this.src = '/images/heroes/default.png';
                    };
                    this.src = `/images/abilities/hero_${cleanHero}_${i}.png`;
                };
                abIcon.src = `/images/abilities/${cleanHero}_${i}.png`;
            }
        }

        // 3. Dynamic metadata (Display Name, Primary Attribute, Difficulty, Combat Roles)
        try {
            const resp = await fetch(`/api/v1/assets/hero-info/${encodeURIComponent(cleanHero)}`);
            if (!resp.ok) return;
            const data = await resp.json();

            const nameEl = document.getElementById('heroHeaderName');
            if (nameEl) nameEl.innerText = data.displayName || cleanHero;

            const attrEl = document.getElementById('heroHeaderAttrBadge');
            if (attrEl) {
                attrEl.innerText = data.primaryAttribute || 'Agility';
                attrEl.className = data.primaryAttribute === 'Strength'
                    ? 'px-2 py-0.5 rounded bg-red-500/20 text-red-400 font-mono text-[10px] font-black uppercase tracking-wider'
                    : (data.primaryAttribute === 'Intelligence'
                        ? 'px-2 py-0.5 rounded bg-blue-500/20 text-blue-400 font-mono text-[10px] font-black uppercase tracking-wider'
                        : 'px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-mono text-[10px] font-black uppercase tracking-wider');
            }

            const diffEl = document.getElementById('heroHeaderDifficulty');
            if (diffEl) {
                const diff = Math.round(data.difficulty || 2);
                let diffHtml = '';
                for (let d = 1; d <= 5; d++) {
                    diffHtml += d <= diff
                        ? '<i class="fas fa-diamond mx-0.5 text-amber-400"></i>'
                        : '<i class="far fa-diamond mx-0.5 text-amber-400/30"></i>';
                }
                diffEl.innerHTML = diffHtml;
            }

            const rolesEl = document.getElementById('heroHeaderRoles');
            if (rolesEl) rolesEl.innerText = data.roles || 'Carry';
        } catch (e) {
            console.warn("Failed updating hero header:", e);
        }
    }

    function resizeStage() {
        const container = document.getElementById('stage3DContainer');
        const canvas = document.getElementById('stage3DCanvas');
        if (!container || !canvas || !stageRenderer || !stageCamera) return;

        const width = container.clientWidth;
        const height = container.clientHeight;
        if (width > 0 && height > 0) {
            stageCamera.aspect = width / height;
            stageCamera.updateProjectionMatrix();
            stageRenderer.setSize(width, height, false);
            stageRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        }
    }

    function initStage3D() {
        const container = document.getElementById('stage3DContainer');
        const canvas = document.getElementById('stage3DCanvas');
        if (!container || !canvas) return;

        stageScene = new THREE.Scene();
        stageDefaultCameraPos = new THREE.Vector3(0, 50, 150);
        stageDefaultTarget = new THREE.Vector3(0, 40, 0);
        stageScene.background = new THREE.Color(0x070b14);

        stageModelGroup = new THREE.Group();
        stageScene.add(stageModelGroup);

        const initialW = container.clientWidth || 800;
        const initialH = container.clientHeight || 600;

        stageCamera = new THREE.PerspectiveCamera(42, initialW / initialH, 0.1, 1000);
        stageCamera.position.set(0, 48, 165);

        stageRenderer = new THREE.WebGLRenderer({canvas: canvas, antialias: true, powerPreference: "high-performance"});
        stageRenderer.setSize(initialW, initialH, false);
        stageRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        if (window.KongorViewerCore) {
            window.KongorViewerCore.configureRendererColorSpace(stageRenderer);
        } else if ('outputColorSpace' in stageRenderer && THREE.SRGBColorSpace) {
            stageRenderer.outputColorSpace = THREE.SRGBColorSpace;
        }

        stageControls = new THREE.OrbitControls(stageCamera, stageRenderer.domElement);
        stageControls.enableDamping = true;
        stageControls.dampingFactor = 0.05;

        window.addEventListener('resize', resizeStage);
        if (window.ResizeObserver) {
            new ResizeObserver(() => {
                resizeStage();
            }).observe(container);
        }
        resizeStage();

        // Dramatic HoN Studio Lighting Setup
        const ambient = new THREE.AmbientLight(0xfff7ed, 0.9);
        stageScene.add(ambient);

        const key = new THREE.DirectionalLight(0xffedd5, 1.25);
        key.position.set(70, 130, 100);
        stageScene.add(key);

        const fill = new THREE.DirectionalLight(0x93c5fd, 0.65);
        fill.position.set(-90, 70, 80);
        stageScene.add(fill);

        const rim = new THREE.DirectionalLight(0xfbbf24, 0.75);
        rim.position.set(0, 110, -120);
        stageScene.add(rim);

        const floorGlow = new THREE.PointLight(0xd97706, 0.5, 100);
        floorGlow.position.set(0, 1, 0);
        stageScene.add(floorGlow);

        // Authentic 3-Tier Bronze & Stone Dais Pedestal (Surface top at y = 0)
        const pedestalGroup = new THREE.Group();
        pedestalGroup.name = "hon_pedestal";

        // Floor Contact Shadow Disk
        const shadowGeo = new THREE.CircleGeometry(46, 32);
        const shadowMat = new THREE.MeshBasicMaterial({color: 0x010204, opacity: 0.88, transparent: true});
        const shadowDisk = new THREE.Mesh(shadowGeo, shadowMat);
        shadowDisk.rotation.x = -Math.PI / 2;
        shadowDisk.position.y = -3.98;
        pedestalGroup.add(shadowDisk);

        // Tier 1: Base Dark Stone
        const tier1Geo = new THREE.CylinderGeometry(38, 42, 3, 48);
        const tier1Mat = new THREE.MeshStandardMaterial({color: 0x111827, roughness: 0.9, metalness: 0.1});
        const tier1 = new THREE.Mesh(tier1Geo, tier1Mat);
        tier1.position.y = -2.5;
        pedestalGroup.add(tier1);

        // Tier 2: Bronze Beveled Ring
        const tier2Geo = new THREE.CylinderGeometry(36, 39, 1.2, 48);
        const tier2Mat = new THREE.MeshStandardMaterial({color: 0xb45309, roughness: 0.35, metalness: 0.8});
        const tier2 = new THREE.Mesh(tier2Geo, tier2Mat);
        tier2.position.y = -1.0;
        pedestalGroup.add(tier2);

        // Tier 3: Polished Stone Platform
        const tier3Geo = new THREE.CylinderGeometry(34, 36, 0.8, 48);
        const tier3Mat = new THREE.MeshStandardMaterial({color: 0x1f2937, roughness: 0.75, metalness: 0.25});
        const tier3 = new THREE.Mesh(tier3Geo, tier3Mat);
        tier3.position.y = -0.4;
        pedestalGroup.add(tier3);

        // Glowing Rune Ring on Platform Surface
        const runeRingGeo = new THREE.RingGeometry(20, 31, 48);
        const runeRingMat = new THREE.MeshBasicMaterial({
            color: 0xf59e0b,
            side: THREE.DoubleSide,
            opacity: 0.85,
            transparent: true
        });
        const runeRing = new THREE.Mesh(runeRingGeo, runeRingMat);
        runeRing.rotation.x = -Math.PI / 2;
        runeRing.position.y = 0.02;
        pedestalGroup.add(runeRing);

        stageScene.add(pedestalGroup);

        stageAbilityPropGroup = new THREE.Group();
        stageScene.add(stageAbilityPropGroup);

        stageAbilityFXGroup = new THREE.Group();
        stageScene.add(stageAbilityFXGroup);

        stageClock = new THREE.Clock();
        animateStage();

        document.getElementById('stageSpeedSlider')?.addEventListener('input', (e) => {
            stageAnimSpeed = parseFloat(e.target.value) || 1.0;
            document.getElementById('stageSpeedLabel').innerText = stageAnimSpeed.toFixed(2) + 'x';
            if (currentStageAudio) currentStageAudio.playbackRate = stageAnimSpeed;
        });

        document.getElementById('stageAnimSelect')?.addEventListener('change', (e) => {
            playStageAnim(e.target.value);
        });
    }

    let currentHeroMetadata = null;
    let stageAbilityPropGroup = null;
    let stageAbilityFXGroup = null;
    let activeAbilityPropModel = null;
    let activeAbilityPropType = null;
    let activeAbilityPropAnimTime = 0;
    let activeLightningLines = [];
    let activeSlashMesh = null;

    function clearAbilityPropsAndFX() {
        if (stageAbilityPropGroup) {
            stageAbilityPropGroup.traverse((c) => {
                if (c.isMesh) {
                    if (c.geometry) c.geometry.dispose();
                    if (c.material) {
                        if (Array.isArray(c.material)) c.material.forEach(m => m.dispose());
                        else c.material.dispose();
                    }
                }
            });
            stageAbilityPropGroup.clear();
        }
        if (stageAbilityFXGroup) {
            stageAbilityFXGroup.traverse((c) => {
                if (c.geometry) c.geometry.dispose();
                if (c.material) c.material.dispose();
            });
            stageAbilityFXGroup.clear();
        }
        activeAbilityPropModel = null;
        activeAbilityPropType = null;
        activeAbilityPropAnimTime = 0;
        activeLightningLines = [];
        activeSlashMesh = null;
    }

    function clearCurrentStageModel() {
        if (stageAudioTimeout) {
            clearTimeout(stageAudioTimeout);
            stageAudioTimeout = null;
        }
        if (currentStageAudio) {
            currentStageAudio.pause();
            currentStageAudio = null;
        }
        if (stageActiveAction) {
            stageActiveAction.stop();
            stageActiveAction = null;
        }
        if (stageMixer) {
            stageMixer.stopAllAction();
            stageMixer = null;
        }
        if (stageModelGroup) {
            stageModelGroup.traverse((child) => {
                if (child.isMesh) {
                    if (child.geometry) child.geometry.dispose();
                    if (child.material) {
                        if (Array.isArray(child.material)) {
                            child.material.forEach(m => {
                                if (m.map) m.map.dispose();
                                if (m.normalMap) m.normalMap.dispose();
                                if (m.roughnessMap) m.roughnessMap.dispose();
                                if (m.metalnessMap) m.metalnessMap.dispose();
                                if (m.emissiveMap) m.emissiveMap.dispose();
                                m.dispose();
                            });
                        } else {
                            if (child.material.map) child.material.map.dispose();
                            if (child.material.normalMap) child.material.normalMap.dispose();
                            if (child.material.roughnessMap) child.material.roughnessMap.dispose();
                            if (child.material.metalnessMap) child.material.metalnessMap.dispose();
                            if (child.material.emissiveMap) child.material.emissiveMap.dispose();
                            child.material.dispose();
                        }
                    }
                }
            });
            stageModelGroup.clear();
        }
        clearAbilityPropsAndFX();
        currentStageModel = null;
        stageActions = {};
    }

    function getFriendlyAnimName(clipName) {
        const lower = clipName.toLowerCase().replace(/_/g, ' ').trim();
        if (lower.includes('idle')) return `💤 ${clipName.toUpperCase().replace(/_/g, ' ')}`;
        if (lower.includes('attack')) return `⚔️ ${clipName.toUpperCase().replace(/_/g, ' ')}`;
        if (lower.includes('ability')) return `✨ ${clipName.toUpperCase().replace(/_/g, ' ')}`;
        if (lower.includes('walk') || lower.includes('run')) return `🚶 ${clipName.toUpperCase().replace(/_/g, ' ')}`;
        if (lower.includes('death') || lower.includes('die')) return `💀 ${clipName.toUpperCase().replace(/_/g, ' ')}`;
        if (lower.includes('knock') || lower.includes('stun')) return `💥 ${clipName.toUpperCase().replace(/_/g, ' ')}`;
        if (lower.includes('getup')) return `🛡️ ${clipName.toUpperCase().replace(/_/g, ' ')}`;
        if (lower.includes('taunt')) return `🎭 ${clipName.toUpperCase().replace(/_/g, ' ')}`;
        if (lower.includes('bored')) return `⏳ ${clipName.toUpperCase().replace(/_/g, ' ')}`;
        if (lower.includes('portrait')) return `🖼️ ${clipName.toUpperCase().replace(/_/g, ' ')}`;
        if (lower.includes('item')) return `🎒 ${clipName.toUpperCase().replace(/_/g, ' ')}`;
        return `🎬 ${clipName.toUpperCase().replace(/_/g, ' ')}`;
    }

    async function loadStage3DModel(hero, alt, resource) {
        if (!stageScene) return;

        const thisLoadId = ++stageLoadCounter;

        if (stageFetchController) {
            stageFetchController.abort();
        }
        stageFetchController = new AbortController();

        clearCurrentStageModel();

        // Fetch dynamic hero metadata (ability props, frameevents)
        fetch(`/api/v1/assets/hero-info/${encodeURIComponent(hero)}`)
            .then(r => r.ok ? r.json() : null)
            .then(info => {
                currentHeroMetadata = info;
            })
            .catch(() => {
            });

        const loading = document.getElementById('stage3DLoading');
        if (loading) loading.style.display = 'flex';

        const altParam = alt ? `/${encodeURIComponent(alt)}` : '';
        const resQuery = resource ? `?resource=${encodeURIComponent(resource)}` : (currentSelectedItem?.resource ? `?resource=${encodeURIComponent(currentSelectedItem.resource)}` : '');
        const url = `/api/v1/assets/3d/hero/${encodeURIComponent(hero)}${altParam}${resQuery}`;

        try {
            const resp = await fetch(url, {signal: stageFetchController.signal});
            if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
            const buffer = await resp.arrayBuffer();

            if (thisLoadId !== stageLoadCounter) {
                return;
            }

            const loader = new THREE.GLTFLoader();
            loader.parse(buffer, '', (gltf) => {
                if (thisLoadId !== stageLoadCounter) {
                    return;
                }

                if (stageModelGroup) {
                    stageModelGroup.clear();
                }

                currentStageModel = gltf.scene;

                // Configure Shadows & PBR Materials with Normal & Specular Sheen
                currentStageModel.traverse((child) => {
                    if (child.isMesh) {
                        child.castShadow = true;
                        child.receiveShadow = true;
                        if (child.material) {
                            const configureMaterial = (mat) => {
                                if (!mat) return;
                                mat.side = THREE.DoubleSide;
                                mat.roughness = 0.8;
                                mat.metalness = 0.1;
                                mat.transparent = false;
                                mat.depthWrite = true;
                                mat.color = new THREE.Color(0xffffff);

                                if (mat.map) {
                                    if (window.KongorViewerCore) {
                                        window.KongorViewerCore.configureTextureColorSpace(mat.map);
                                    } else if ('colorSpace' in mat.map && THREE.SRGBColorSpace) {
                                        mat.map.colorSpace = THREE.SRGBColorSpace;
                                    }
                                    mat.map.generateMipmaps = true;
                                    mat.map.minFilter = THREE.LinearMipmapLinearFilter;
                                    mat.map.magFilter = THREE.LinearFilter;
                                    mat.map.needsUpdate = true;
                                }
                                if (mat.normalMap) {
                                    mat.normalScale = new THREE.Vector2(1.0, 1.0);
                                    mat.normalMap.generateMipmaps = true;
                                    mat.normalMap.needsUpdate = true;
                                }
                                if (mat.emissiveMap) {
                                    if (window.KongorViewerCore) {
                                        window.KongorViewerCore.configureTextureColorSpace(mat.emissiveMap);
                                    } else if ('colorSpace' in mat.emissiveMap && THREE.SRGBColorSpace) {
                                        mat.emissiveMap.colorSpace = THREE.SRGBColorSpace;
                                    }
                                    mat.emissive = new THREE.Color(0xffffff);
                                    mat.emissiveIntensity = 1.5;
                                    mat.emissiveMap.needsUpdate = true;
                                }
                                mat.needsUpdate = true;
                            };

                            if (Array.isArray(child.material)) {
                                child.material.forEach(configureMaterial);
                            } else {
                                configureMaterial(child.material);
                            }
                        }
                    }
                });

                // Reset transform
                currentStageModel.position.set(0, 0, 0);
                currentStageModel.rotation.set(0, 0, 0);
                currentStageModel.scale.set(1, 1, 1);
                currentStageModel.updateMatrixWorld(true);

                // Center horizontally and position feet squarely atop the Dais Platform (Platform surface at y = 0)
                const bbox = new THREE.Box3().setFromObject(currentStageModel);
                const center = new THREE.Vector3();
                bbox.getCenter(center);
                const size = new THREE.Vector3();
                bbox.getSize(size);
                const maxDim = Math.max(size.x, size.y, size.z, 50);

                currentStageModel.position.x = -center.x;
                currentStageModel.position.z = -center.z;
                // Position feet at pedestal surface (y = 0), safeguarding against floating offsets
                if (bbox.min.y < -0.1 && bbox.min.y > -15) {
                    currentStageModel.position.y = -bbox.min.y;
                } else {
                    currentStageModel.position.y = 0;
                }
                currentStageModel.updateMatrixWorld(true);

                if (stageModelGroup) {
                    stageModelGroup.add(currentStageModel);
                } else {
                    stageScene.add(currentStageModel);
                }

                resizeStage();

                // Centered Heroic Pedestal Perspective: Character model and dais vertically centered in viewport
                const targetY = Math.max(20, Math.min(size.y * 0.45, 36));
                stageControls.target.set(0, targetY, 0);

                // Perfectly framed sweet spot on load (matches 8 scroll wheel notches back)
                const cameraDist = Math.max(160, Math.min(maxDim * 1.55, 185));
                const cameraY = targetY + 12;
                stageCamera.position.set(0, cameraY, cameraDist);
                stageDefaultCameraPos.set(0, cameraY, cameraDist);
                stageDefaultTarget.set(0, targetY, 0);
                stageControls.minDistance = 20;
                stageControls.maxDistance = 1500;
                stageControls.update();

                // Process embedded animations with player-friendly names
                stageActions = {};
                const select = document.getElementById('stageAnimSelect');
                if (select) {
                    select.innerHTML = '';
                    select.disabled = false;
                }

                if (gltf.animations && gltf.animations.length > 0) {
                    stageMixer = new THREE.AnimationMixer(currentStageModel);
                    stageMixer.timeScale = stageAnimSpeed;
                    stageMixer.addEventListener('finished', (e) => {
                        onActionAnimationFinished(e.action);
                    });

                    let defaultActionName = '';
                    gltf.animations.forEach((clip, idx) => {
                        const action = stageMixer.clipAction(clip);
                        const cleanName = clip.name || `Animation_${idx + 1}`;
                        stageActions[cleanName] = action;

                        if (select) {
                            const opt = document.createElement('option');
                            opt.value = cleanName;
                            opt.textContent = getFriendlyAnimName(cleanName);
                            select.appendChild(opt);
                        }

                        if (!defaultActionName) {
                            defaultActionName = cleanName;
                        }
                        if (cleanName.toLowerCase().includes('idle')) {
                            defaultActionName = cleanName;
                        }
                    });

                    if (select && defaultActionName) {
                        select.value = defaultActionName;
                    }
                    if (defaultActionName) {
                        playStageAnim(defaultActionName);
                    }
                } else if (select) {
                    const opt = document.createElement('option');
                    opt.value = 'default';
                    opt.textContent = 'REST POSE';
                    select.appendChild(opt);
                }

                if (loading) loading.style.display = 'none';
            }, (xhr) => {
                // Progress
            }, (error) => {
                if (thisLoadId === stageLoadCounter) {
                    if (loading) loading.style.display = 'none';
                }
            });
        } catch (err) {
            if (thisLoadId === stageLoadCounter) {
                if (loading) loading.style.display = 'none';
            }
        }
    }

    let stageActionCycleTimeout = null;
    let stageCurrentPlayingAnim = 'idle';

    function getHeroWeaponPoint() {
        let weaponPos = new THREE.Vector3();
        let foundBone = false;

        if (currentStageModel) {
            currentStageModel.traverse((child) => {
                if (foundBone) return;
                const name = (child.name || '').toLowerCase();
                if (child.isBone && (name.includes('weapon') || name.includes('staff') || name.includes('r hand') || name.includes('righthand') || name.includes('fx'))) {
                    child.getWorldPosition(weaponPos);
                    foundBone = true;
                }
            });
        }

        if (!foundBone && currentStageModel) {
            const bbox = new THREE.Box3().setFromObject(currentStageModel);
            const size = new THREE.Vector3();
            bbox.getSize(size);
            weaponPos.set(size.x * 0.22, size.y * 0.65, size.z * 0.25);
        }

        if (weaponPos.y < 20) {
            weaponPos.y = 35;
        }
        return weaponPos;
    }

    function playStageAnim(animName) {
        if (!stageMixer || !stageActions[animName]) return;

        if (stageActionCycleTimeout) {
            clearTimeout(stageActionCycleTimeout);
            stageActionCycleTimeout = null;
        }

        stageCurrentPlayingAnim = animName;
        const nextAction = stageActions[animName];
        const rawAction = (animName || 'idle').toLowerCase().trim();
        const isContinuous = rawAction.includes('idle') || rawAction.includes('walk') || rawAction.includes('run');

        if (stageActiveAction && stageActiveAction !== nextAction) {
            stageActiveAction.fadeOut(0.25);
        }

        nextAction.reset();
        nextAction.fadeIn(0.25);

        if (isContinuous) {
            nextAction.setLoop(THREE.LoopRepeat);
            nextAction.clampWhenFinished = false;
        } else {
            nextAction.setLoop(THREE.LoopOnce, 1);
            nextAction.clampWhenFinished = true;
        }

        nextAction.play();
        stageActiveAction = nextAction;

        clearAbilityPropsAndFX();
        triggerAbilityPropsAndFX(animName);
        playStageAudio(animName);
    }

    function onActionAnimationFinished(action) {
        if (isStagePaused) return;
        const currentClipName = stageCurrentPlayingAnim;
        const raw = currentClipName.toLowerCase().trim();
        const isContinuous = raw.includes('idle') || raw.includes('walk') || raw.includes('run');

        if (isContinuous) return;

        // Immediately hide ability visual effects when action finishes
        clearAbilityPropsAndFX();

        // Crossfade to idle pose for natural rest break
        let idleActionName = Object.keys(stageActions).find(k => k.toLowerCase().includes('idle'));
        if (idleActionName && stageActions[idleActionName]) {
            const idleAction = stageActions[idleActionName];
            if (stageActiveAction) stageActiveAction.fadeOut(0.25);
            idleAction.reset().fadeIn(0.25).play();
            stageActiveAction = idleAction;
        }

        // Wait 1.4 seconds in idle rest before re-playing the action
        stageActionCycleTimeout = setTimeout(() => {
            if (isStagePaused || stageCurrentPlayingAnim !== currentClipName) return;
            playStageAnim(currentClipName);
        }, 1400);
    }

    function triggerAbilityPropsAndFX(animName) {
        const raw = (animName || 'idle').toLowerCase().trim();
        const heroName = (currentSelectedItem?.hero || currentHeroMetadata?.heroName || '').toLowerCase();

        let targetSlot = null;
        if (raw.includes('ability_1') || raw.includes('ability1')) targetSlot = 'ability_1';
        else if (raw.includes('ability_2') || raw.includes('ability2')) targetSlot = 'ability_2';
        else if (raw.includes('ability_3') || raw.includes('ability3')) targetSlot = 'ability_3';
        else if (raw.includes('ability_4') || raw.includes('ability4')) targetSlot = 'ability_4';

        if (targetSlot === 'ability_4') {
            if (heroName.includes('pollywog')) {
                spawnSerpentWardsOnDais();
            }
        }
    }

    function spawnSerpentWardsOnDais() {
        if (!stageAbilityPropGroup) return;

        const loader = new THREE.GLTFLoader();
        loader.load('/api/v1/assets/3d/hero/pollywogpriest/ability_04/wards/high.model', (gltf) => {
            const ward = gltf.scene;
            ward.scale.set(0.35, 0.35, 0.35);
            ward.traverse((c) => {
                if (c.isMesh && c.material) {
                    c.material.side = THREE.DoubleSide;
                    c.material.emissive = new THREE.Color(0xf59e0b);
                    c.material.emissiveIntensity = 1.5;
                }
            });
            activeAbilityPropType = 'summon_wards';
            const angles = [Math.PI / 4, 3 * Math.PI / 4, 5 * Math.PI / 4, 7 * Math.PI / 4];
            const radius = 22;
            angles.forEach((ang) => {
                const wardClone = ward.clone();
                wardClone.position.set(Math.cos(ang) * radius, 0, Math.sin(ang) * radius);
                wardClone.rotation.y = -ang + Math.PI / 2;
                stageAbilityPropGroup.add(wardClone);
            });
        }, undefined, () => {
        });
    }

    function updateAbilityPropsAndFX(delta) {
        if (!stageActiveAction) return;

        const clip = stageActiveAction.getClip();
        const animDuration = clip.duration > 0 ? clip.duration : 1.5;
        const currentAnimTime = stageActiveAction.time;
        const progress = Math.min(1.0, Math.max(0.0, currentAnimTime / animDuration));

        // Update Serpent Wards Visibility
        if (activeAbilityPropType === 'summon_wards') {
            if (progress >= 0.25 && progress <= 0.85) {
                stageAbilityPropGroup.visible = true;
            } else {
                stageAbilityPropGroup.visible = false;
            }
        }
    }

    function playStageAudio(actionName) {
        if (stageAudioTimeout) {
            clearTimeout(stageAudioTimeout);
            stageAudioTimeout = null;
        }

        if (isStageAudioMuted || isStagePaused || !currentSelectedItem || !currentSelectedItem.hero) return;

        try {
            if (currentStageAudio) {
                currentStageAudio.pause();
                currentStageAudio.currentTime = 0;
                currentStageAudio = null;
            }

            const rawAction = (actionName || 'idle').toLowerCase().trim();
            let delayMs = rawAction.includes('attack') ? 350 : (rawAction.includes('ability') ? 250 : 0);
            let customSoundPath = null;

            if (currentHeroMetadata && currentHeroMetadata.animations) {
                const animDetail = currentHeroMetadata.animations.find(a => a.name.toLowerCase() === rawAction);
                if (animDetail && animDetail.frameEvents && animDetail.frameEvents.length > 0) {
                    const soundEvent = animDetail.frameEvents.find(fe => fe.soundAction);
                    if (soundEvent) {
                        const fps = animDetail.fps > 0 ? animDetail.fps : 30;
                        delayMs = Math.round((soundEvent.frame / fps) * 1000);
                        customSoundPath = soundEvent.soundAction;
                    }
                }
            }

            stageAudioTimeout = setTimeout(() => {
                if (isStageAudioMuted || isStagePaused || !currentSelectedItem || !currentSelectedItem.hero) return;

                const pathParam = customSoundPath ? `&path=${encodeURIComponent(customSoundPath)}` : '';
                const soundUrl = `/api/v1/assets/sound?hero=${encodeURIComponent(currentSelectedItem.hero)}&alt=${encodeURIComponent(currentSelectedItem.alt || '')}&action=${encodeURIComponent(rawAction)}${pathParam}&_t=${Date.now()}`;
                currentStageAudio = new Audio(soundUrl);
                currentStageAudio.onerror = () => { /* gracefully ignore missing audio */
                };
                currentStageAudio.volume = 0.75;
                currentStageAudio.loop = false;
                currentStageAudio.playbackRate = stageAnimSpeed;
                currentStageAudio.play().catch(() => {
                });
            }, delayMs);
        } catch (err) {
        }
    }

    let isStagePaused = false;

    function toggleStagePlayPause() {
        isStagePaused = !isStagePaused;
        const icon = document.getElementById('stagePlayPauseIcon');
        if (icon) {
            icon.className = isStagePaused ? 'fas fa-play' : 'fas fa-pause';
        }
        if (isStagePaused) {
            if (stageAudioTimeout) {
                clearTimeout(stageAudioTimeout);
                stageAudioTimeout = null;
            }
            if (currentStageAudio) currentStageAudio.pause();
        } else {
            if (!isStageAudioMuted && stageActiveAction) {
                const clipName = stageActiveAction.getClip().name;
                playStageAudio(clipName);
            }
        }
    }

    function toggleStageSound() {
        isStageAudioMuted = !isStageAudioMuted;
        const icon = document.getElementById('stageMuteIcon');
        if (icon) {
            icon.className = isStageAudioMuted ? 'fas fa-volume-mute opacity-40' : 'fas fa-volume-up';
        }
        if (isStageAudioMuted) {
            if (stageAudioTimeout) {
                clearTimeout(stageAudioTimeout);
                stageAudioTimeout = null;
            }
            if (currentStageAudio) currentStageAudio.pause();
        } else {
            if (!isStagePaused && stageActiveAction) {
                const currentAnim = stageActiveAction.getClip().name;
                playStageAudio(currentAnim);
            }
        }
    }

    let stageDefaultCameraPos = null;
    let stageDefaultTarget = null;


    function resetStageCamera() {
        if (!stageControls || !stageCamera) return;
        stageControls.target.copy(stageDefaultTarget);
        stageCamera.position.copy(stageDefaultCameraPos);
        stageControls.update();
    }

    function openCurrentItemInAR() {
        if (!window.KongorStoreAR) return;
        if (currentSelectedItem && currentSelectedItem.hero) {
            window.KongorStoreAR.open({
                hero: currentSelectedItem.hero,
                alt: currentSelectedItem.alt,
                name: currentSelectedItem.name,
                resource: currentSelectedItem.resource
            });
        }
    }

    // Auto-resume audio on first user gesture if blocked by browser policy
    document.addEventListener('click', () => {
        if (!isStageAudioMuted && !isStagePaused && currentStageAudio && currentStageAudio.paused && currentSelectedItem && currentSelectedItem.can3d) {
            currentStageAudio.play().catch(() => {
            });
        }
    }, {once: true});

    let stageRafId = 0;
    function ensureStageAnimating() {
        if (!stageRafId && !document.hidden && stageRenderer) {
            if (stageClock) stageClock.getDelta();
            stageRafId = requestAnimationFrame(animateStage);
        }
    }
    document.addEventListener('visibilitychange', () => {
        if (!document.hidden) ensureStageAnimating();
    });
    function animateStage() {
        if (document.hidden) {
            stageRafId = 0;
            return;
        }
        stageRafId = requestAnimationFrame(animateStage);
        const delta = stageClock ? stageClock.getDelta() : 0;
        if (stageMixer && !isStagePaused) stageMixer.update(delta * stageAnimSpeed);
        if (!isStagePaused) updateAbilityPropsAndFX(delta);
        if (stageControls) stageControls.update();
        if (stageRenderer && stageScene && stageCamera) stageRenderer.render(stageScene, stageCamera);
    }

