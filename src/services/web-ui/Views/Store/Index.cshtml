            } else {
                activeCard.className = 'shop-item-card is-unowned group relative bg-gradient-to-b from-stone-900/95 via-slate-950/95 to-stone-950/95 border-2 border-amber-400 ring-2 ring-amber-400/60 shadow-xl shadow-amber-500/25 rounded-xl p-2 cursor-pointer transition-all flex flex-col justify-between';
