    // Equip in Loadout Handlers
    async function equipCurrentSelectedItem() {
        if (!currentSelectedItem || !currentSelectedItem.id) return;
        const actionBox = document.getElementById('stageActionBox');
        if (actionBox) {
            actionBox.innerHTML = `
                <div class="w-full py-3.5 px-4 rounded-xl bg-slate-800 text-amber-300 text-xs font-bold text-center flex items-center justify-center gap-2">
                    <i class="fas fa-spinner fa-spin"></i>
                    <span>Equipping in in-game loadout...</span>
                </div>
            `;
        }

        try {
            const resp = await fetch('/store/equip', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({itemId: currentSelectedItem.id, code: currentSelectedItem.code})
            });

            const data = await resp.json();

            if (resp.ok && data.success) {
                currentSelectedItem.isEquipped = true;
                if (actionBox) {
                    actionBox.innerHTML = `
                        <div class="w-full py-3.5 px-4 rounded-xl bg-slate-900/90 border border-slate-800 text-slate-500 text-sm font-bold text-center flex items-center justify-center gap-2 shadow-inner cursor-default opacity-80 select-none">
                            <i class="fas fa-check-circle text-emerald-500"></i>
                            <span>✓ EQUIPPED</span>
                        </div>
                    `;
                }

                // Add active badge to card
                const card = document.getElementById('shop-card-' + currentSelectedItem.id);
                if (card) {
                    const thumb = card.querySelector('.aspect-square');
                    if (thumb && !card.querySelector('.card-equipped-badge')) {
                        const badge = document.createElement('div');
                        badge.className = 'card-equipped-badge absolute top-1 left-1 px-1.5 py-0.5 rounded bg-emerald-600/90 text-white flex items-center gap-1 text-[8px] font-black shadow-md tracking-wider';
                        badge.innerHTML = '<i class="fas fa-bolt text-[7px]"></i><span>ACTIVE</span>';
                        thumb.appendChild(badge);
                    }
                }

                showStoreToast("✓ " + data.message, "success");
            } else {
                if (actionBox) {
                    actionBox.innerHTML = `
                        <button onclick="equipCurrentSelectedItem()" class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 text-sm font-black text-center flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20 transition-all cursor-pointer">
                            <i class="fas fa-bolt"></i>
                            <span>Equip in Loadout</span>
                        </button>
                    `;
                }
                showStoreToast("Error: " + (data.error || "Failed to equip item."), "error");
            }
        } catch (err) {
            if (actionBox) {
                actionBox.innerHTML = `
                    <button onclick="equipCurrentSelectedItem()" class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 text-sm font-black text-center flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20 transition-all cursor-pointer">
                        <i class="fas fa-bolt"></i>
                        <span>Equip in Loadout</span>
                    </button>
                `;
            }
            showStoreToast("Network error: " + err.message, "error");
        }
    }

    // Purchase Modal Logic
    function openPurchaseModal(id, name, cost, currency) {
        document.getElementById('buyItemId').value = id;
        document.getElementById('buyItemTitle').innerText = name;
        document.getElementById('buyCurrency').value = currency;
        document.getElementById('buyCostDisplay').innerHTML = currency === 'gold'
            ? `<span class="text-amber-400 font-bold">${cost} Gold Coins</span>`
            : `<span class="text-slate-300 font-bold">${cost} Silver Coins</span>`;

        const statusMsg = document.getElementById('buyStatusMsg');
        statusMsg.classList.add('hidden');
        document.getElementById('purchaseModal').style.display = 'flex';
    }

    function closePurchaseModal() {
        document.getElementById('purchaseModal').style.display = 'none';
    }

    async function executePurchase() {
        const id = parseInt(document.getElementById('buyItemId').value, 10);
        const currency = document.getElementById('buyCurrency').value;
        const buyBtn = document.getElementById('confirmBuyBtn');
        const buyBtnText = document.getElementById('confirmBuyBtnText');
        const statusMsg = document.getElementById('buyStatusMsg');

        buyBtn.disabled = true;
        buyBtnText.innerText = "Unlocking...";

        try {
            const resp = await fetch('/store/purchase', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({itemId: id, currency: currency})
            });

            const data = await resp.json();

            if (resp.ok && data.success) {
                statusMsg.innerText = "✓ " + data.message;
                statusMsg.className = "text-xs font-semibold text-emerald-400";
                statusMsg.classList.remove('hidden');

                const goldEl = document.getElementById('userGoldDisplay');
                if (goldEl && data.newGold !== undefined) goldEl.innerText = Number(data.newGold).toLocaleString();

                const silverEl = document.getElementById('userSilverDisplay');
                if (silverEl && data.newSilver !== undefined) silverEl.innerText = Number(data.newSilver).toLocaleString();

                // Mark current item as owned in client memory
                currentSelectedItem.isOwned = true;
                currentSelectedItem.isEquipped = false;

                // Update card in left shelf grid immediately
                const card = document.getElementById('shop-card-' + id);
                if (card) {
                    card.classList.remove('is-unowned');
                    card.classList.add('is-owned');
                    card.className = 'shop-item-card is-owned group relative bg-slate-950/70 opacity-90 border-2 border-emerald-500/60 ring-2 ring-emerald-500/40 rounded-xl p-2.5 cursor-pointer transition-all flex flex-col justify-between';

                    const thumb = card.querySelector('.aspect-square');
                    if (thumb && !card.querySelector('.card-owned-badge')) {
                        thumb.className = 'relative aspect-square rounded-lg overflow-hidden bg-slate-950 border border-slate-800/40 opacity-75 group-hover:opacity-100 mb-2 group-hover:scale-[1.02] transition-transform';

                        const badge = document.createElement('div');
                        badge.className = 'card-owned-badge absolute top-1 right-1 px-1.5 py-0.5 rounded bg-emerald-500/90 text-slate-950 flex items-center gap-1 text-[9px] font-black shadow-md tracking-wider';
                        badge.innerHTML = '<i class="fas fa-check text-[8px]"></i><span>OWNED</span>';
                        thumb.appendChild(badge);

                        const check = document.createElement('div');
                        check.className = 'card-owned-check absolute bottom-1 right-1 w-5 h-5 rounded-full bg-emerald-500 text-slate-950 flex items-center justify-center text-[10px] font-black shadow-md';
                        check.innerHTML = '<i class="fas fa-check"></i>';
                        thumb.appendChild(check);
                    }

                    const nameEl = card.querySelector('.truncate');
                    if (nameEl) {
                        nameEl.className = 'text-xs font-bold text-slate-400 group-hover:text-slate-200 truncate transition-colors text-center';
                    }

                    const priceContainer = card.querySelector('.card-price-container');
                    if (priceContainer) {
                        priceContainer.innerHTML = '<span class="text-emerald-400 font-bold text-[10px] flex items-center gap-1"><i class="fas fa-check-circle text-[9px]"></i><span>In Vault</span></span>';
                    }
                }

                const actionBox = document.getElementById('stageActionBox');
                if (actionBox) {
                    actionBox.innerHTML = `
                        <button onclick="equipCurrentSelectedItem()" class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 text-sm font-black text-center flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20 transition-all cursor-pointer">
                            <i class="fas fa-bolt"></i>
                            <span>Equip in Loadout</span>
                        </button>
                    `;
                }

                setTimeout(() => {
                    closePurchaseModal();
                    buyBtn.disabled = false;
                    buyBtnText.innerText = "Confirm Purchase";
                }, 900);
            } else {
                statusMsg.innerText = "Error: " + (data.error || "Purchase failed.");
                statusMsg.className = "text-xs font-semibold text-red-400";
                statusMsg.classList.remove('hidden');
                buyBtn.disabled = false;
                buyBtnText.innerText = "Confirm Purchase";
            }
        } catch (err) {
            statusMsg.innerText = "Network error: " + err.message;
            statusMsg.className = "text-xs font-semibold text-red-400";
            statusMsg.classList.remove('hidden');
            buyBtn.disabled = false;
            buyBtnText.innerText = "Confirm Purchase";
        }
    }

    // Staff Handlers
    @if (Model.IsStaff)
    {
        <text>
            function openStaffPriceEditorFromStage() {
                if (!currentSelectedItem) return;
                document.getElementById('editItemHiddenId').value = currentSelectedItem.id;
                document.getElementById('editItemId').innerText = 'Product ID: #' + currentSelectedItem.id + ' (' + currentSelectedItem.name + ')';
                document.getElementById('editGoldCost').value = currentSelectedItem.gold || 0;
                document.getElementById('editSilverCost').value = currentSelectedItem.silver || 0;
                document.getElementById('editIsEnabled').checked = currentSelectedItem.isEnabled !== false;
                document.getElementById('editPurchasable').checked = currentSelectedItem.purchasable !== false;

                const statusMsg = document.getElementById('editStatusMsg');
                if (statusMsg) statusMsg.classList.add('hidden');

                document.getElementById('priceEditorModal').style.display = 'flex';
            }

            function closePriceEditor() {
                document.getElementById('priceEditorModal').style.display = 'none';
            }

            async function saveStoreItemChanges() {
                const id = parseInt(document.getElementById('editItemHiddenId').value, 10);
                const gold = parseInt(document.getElementById('editGoldCost').value, 10) || 0;
                const silver = parseInt(document.getElementById('editSilverCost').value, 10) || 0;
                const isEnabled = document.getElementById('editIsEnabled').checked;
                const purchasable = document.getElementById('editPurchasable').checked;

                const saveBtn = document.getElementById('savePriceBtn');
                const statusMsg = document.getElementById('editStatusMsg');

                saveBtn.disabled = true;
                saveBtn.innerText = "Saving...";

                try {
                    const resp = await fetch('/staff/store/update', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({
                            id: id,
                            goldCost: gold,
                            silverCost: silver,
                            isEnabled: isEnabled,
                            purchasable: purchasable
                        })
                    });

                    const data = await resp.json();

                    if (resp.ok && data.success) {
                        statusMsg.innerText = "✓ Saved and synchronized!";
                        statusMsg.className = "text-xs font-semibold text-emerald-400";
                        statusMsg.classList.remove('hidden');

                        if (currentSelectedItem && currentSelectedItem.id === id) {
                            currentSelectedItem.gold = gold;
                            currentSelectedItem.silver = silver;
                            currentSelectedItem.isEnabled = isEnabled;
                            currentSelectedItem.purchasable = purchasable;
                            selectShopItem(currentSelectedItem.id, currentSelectedItem.name, currentSelectedItem.hero, currentSelectedItem.alt, currentSelectedItem.resource, gold, silver, currentSelectedItem.isOwned, currentSelectedItem.can3d, isEnabled, purchasable, currentSelectedItem.typeName, currentSelectedItem.code, currentSelectedItem.desc, currentSelectedItem.isEquipped);
                        }

                        setTimeout(() => {
                            closePriceEditor();
                            saveBtn.disabled = false;
                            saveBtn.innerText = "Save Changes";
                        }, 800);
                    } else {
                        statusMsg.innerText = "Error: " + (data.error || "Save failed.");
                        statusMsg.className = "text-xs font-semibold text-red-400";
                        statusMsg.classList.remove('hidden');
                        saveBtn.disabled = false;
                        saveBtn.innerText = "Save Changes";
                    }
                } catch (err) {
                    statusMsg.innerText = "Network error: " + err.message;
                    statusMsg.className = "text-xs font-semibold text-red-400";
                    statusMsg.classList.remove('hidden');
                    saveBtn.disabled = false;
                    saveBtn.innerText = "Save Changes";
                }
            }

            // Weekend Sale / Bulk Discount Handlers
            function openBulkDiscountModal() {
                const statusMsg = document.getElementById('bulkStatusMsg');
                if (statusMsg) statusMsg.classList.add('hidden');
                document.getElementById('bulkDiscountModal').style.display = 'flex';
            }

            function closeBulkDiscountModal() {
                document.getElementById('bulkDiscountModal').style.display = 'none';
            }

            function setBulkPercent(val) {
                document.getElementById('bulkDiscountPercent').value = val;
            }

            async function executeBulkDiscount() {
                const category = document.getElementById('bulkCategory').value;
                const currency = document.getElementById('bulkCurrency').value;
                const percent = parseInt(document.getElementById('bulkDiscountPercent').value, 10) || 20;

                const applyBtn = document.getElementById('applyBulkBtn');
                const statusMsg = document.getElementById('bulkStatusMsg');

                applyBtn.disabled = true;
                applyBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>Applying...</span>';

                try {
                    const resp = await fetch('/staff/store/bulk-discount', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({category: category, currency: currency, discountPercent: percent})
                    });

                    const data = await resp.json();

                    if (resp.ok && data.success) {
                        statusMsg.innerText = "✓ " + data.message;
                        statusMsg.className = "text-xs font-semibold text-emerald-400";
                        statusMsg.classList.remove('hidden');

                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        statusMsg.innerText = "Error: " + (data.error || "Failed to apply discount.");
                        statusMsg.className = "text-xs font-semibold text-red-400";
                        statusMsg.classList.remove('hidden');
                        applyBtn.disabled = false;
                        applyBtn.innerHTML = '<i class="fas fa-bolt"></i><span>Apply Discount</span>';
                    }
                } catch (err) {
                    statusMsg.innerText = "Network error: " + err.message;
                    statusMsg.className = "text-xs font-semibold text-red-400";
                    statusMsg.classList.remove('hidden');
                    applyBtn.disabled = false;
                    applyBtn.innerHTML = '<i class="fas fa-bolt"></i><span>Apply Discount</span>';
                }
            }

            async function executeRestorePrices() {
                if (!confirm('Are you sure you want to restore all baseline prices?')) return;

                const restoreBtn = document.getElementById('restorePricesBtn');
                const statusMsg = document.getElementById('bulkStatusMsg');

                restoreBtn.disabled = true;
                restoreBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>Restoring...</span>';

                try {
                    const resp = await fetch('/staff/store/restore-prices', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'}
                    });

                    const data = await resp.json();

                    if (resp.ok && data.success) {
                        statusMsg.innerText = "✓ " + data.message;
                        statusMsg.className = "text-xs font-semibold text-emerald-400";
                        statusMsg.classList.remove('hidden');

                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        statusMsg.innerText = "Error: " + (data.error || "Failed to restore prices.");
                        statusMsg.className = "text-xs font-semibold text-red-400";
                        statusMsg.classList.remove('hidden');
                        restoreBtn.disabled = false;
                        restoreBtn.innerHTML = '<i class="fas fa-undo"></i><span>Restore Baseline Prices</span>';
                    }
                } catch (err) {
                    statusMsg.innerText = "Network error: " + err.message;
                    statusMsg.className = "text-xs font-semibold text-red-400";
                    statusMsg.classList.remove('hidden');
                    restoreBtn.disabled = false;
                    restoreBtn.innerHTML = '<i class="fas fa-undo"></i><span>Restore Baseline Prices</span>';
                }
            }
        </text>
    }

    function showStoreToast(message, type) {
        const toast = document.createElement('div');
        toast.className = `fixed bottom-6 right-6 z-50 px-4 py-3 rounded-2xl shadow-2xl backdrop-blur-md text-xs font-bold flex items-center gap-2 border transition-all animate-fadeIn ${
            type === 'success'
                ? 'bg-emerald-950/90 border-emerald-500/50 text-emerald-200'
                : 'bg-rose-950/90 border-rose-500/50 text-rose-200'
        }`;
        toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle text-emerald-400' : 'fa-exclamation-circle text-rose-400'}"></i><span>${message}</span>`;
        document.body.appendChild(toast);
        setTimeout(() => {
            toast.style.opacity = '0';
            setTimeout(() => toast.remove(), 400);
        }, 3500);
    }
</script>

