<!-- Three.js Dependencies for Product 3D Viewport -->
<script src="/lib/three/three.r16x.bundle.js"></script>

<script>
    // 3D Product Rig Engine
    @if (Model.Item.CanPreview3D && !string.IsNullOrEmpty(Model.Item.HeroName))
    {
        <text>
            (function () {
                let scene, camera, renderer, controls, mixer, clock;
                let currentModel = null;
                let activeAction = null;
                let actions = {};
                let currentAudio = null;
                let isMuted = false;
                let isPaused = false;
                let animSpeed = 1.0;
                const hero = '@cleanHero';
                const alt = '@altAvatar';
                const resource = '@Model.Item.Resource';
                let defaultCameraPos = new THREE.Vector3(0, 48, 165);
                let defaultTarget = new THREE.Vector3(0, 26, 0);

                if (document.readyState === 'loading') {
                    window.addEventListener('DOMContentLoaded', init3D);
                } else {
                    init3D();
                }

                function init3D() {
                    const container = document.getElementById('product3DContainer');
                    const canvas = document.getElementById('product3DCanvas');
                    if (!container || !canvas) return;

                    const width = container.clientWidth;
                    const height = container.clientHeight;

                    scene = new THREE.Scene();
                    scene.background = new THREE.Color(0x070b14);
                    camera = new THREE.PerspectiveCamera(42, width / height, 0.1, 1000);
                    camera.position.copy(defaultCameraPos);

                    renderer = new THREE.WebGLRenderer({
                        canvas: canvas,
                        antialias: true,
                        powerPreference: "high-performance"
                    });
                    renderer.setSize(width, height);
                    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
                    renderer.shadowMap.enabled = true;
                    if (window.KongorViewerCore) {
                        window.KongorViewerCore.configureRendererColorSpace(renderer);
                    } else if ('outputColorSpace' in renderer && THREE.SRGBColorSpace) {
                        renderer.outputColorSpace = THREE.SRGBColorSpace;
                    }

                    controls = new THREE.OrbitControls(camera, renderer.domElement);
                    controls.enableDamping = true;
                    controls.dampingFactor = 0.05;
                    controls.target.copy(defaultTarget);
                    controls.maxDistance = 1500;
                    controls.minDistance = 20;
                    controls.maxPolarAngle = Math.PI / 2 + 0.05;

                    // Studio Lighting (Preserves authentic diffuse colors without color tinting)
                    const ambient = new THREE.AmbientLight(0xffffff, 1.4);
                    scene.add(ambient);

                    const key = new THREE.DirectionalLight(0xffffff, 1.6);
                    key.position.set(80, 140, 120);
                    scene.add(key);

                    const fill = new THREE.DirectionalLight(0xffffff, 0.85);
                    fill.position.set(-100, 80, 80);
                    scene.add(fill);

                    const rim = new THREE.DirectionalLight(0xf59e0b, 1.2);
                    rim.position.set(0, 120, -150);
                    scene.add(rim);

                    // Pedestal Dais Platform (surface at y = 0)
                    const pedestal = new THREE.Group();
                    const grid = new THREE.GridHelper(160, 32, 0xf59e0b, 0x1e293b);
                    grid.position.y = 0.05;
                    pedestal.add(grid);
                    scene.add(pedestal);

                    clock = new THREE.Clock();
                    animate();

                    window.addEventListener('resize', onResize);

                    // Hook Control Elements
                    document.getElementById('btnOpenStoreAR')?.addEventListener('click', () => {
                        if (window.KongorStoreAR) {
                            window.KongorStoreAR.open({
                                hero: '@cleanHero',
                                alt: '@altAvatar',
                                name: '@Html.Raw(Model.Item.Name.Replace("'", "\\'"))',
                                resource: '@Html.Raw(Model.Item.Resource?.Replace("'", "\\'") ?? "")'
                            });
                        }
                    });
                    document.getElementById('btnResetView')?.addEventListener('click', () => {
                        controls.target.copy(defaultTarget);
                        camera.position.copy(defaultCameraPos);
                        controls.update();
                    });
                    document.getElementById('btnPlayPause3D')?.addEventListener('click', () => {
                        isPaused = !isPaused;
                        const icon = document.getElementById('productPlayPauseIcon');
                        if (icon) icon.className = isPaused ? 'fas fa-play' : 'fas fa-pause';
                        const btn = document.getElementById('btnPlayPauseText');
                        if (btn) btn.innerText = isPaused ? 'Resume' : 'Pause';
                        if (isPaused) {
                            if (audioTimeout) clearTimeout(audioTimeout);
                            if (currentAudio) currentAudio.pause();
                        } else {
                            if (!isMuted && activeAction) {
                                playAudio(activeAction.getClip().name);
                            }
                        }
                    });

                    document.getElementById('btnSoundToggle3D')?.addEventListener('click', () => {
                        isMuted = !isMuted;
                        const icon = document.getElementById('productSoundIcon');
                        if (icon) icon.className = isMuted ? 'fas fa-volume-mute opacity-40' : 'fas fa-volume-up';
                        const txt = document.getElementById('btnSoundText');
                        if (txt) txt.innerText = isMuted ? 'Muted' : 'Audio';
                        if (isMuted) {
                            if (audioTimeout) clearTimeout(audioTimeout);
                            if (currentAudio) currentAudio.pause();
                        } else {
                            if (!isPaused && activeAction) {
                                playAudio(activeAction.getClip().name);
                            }
                        }
                    });

                    document.getElementById('productSpeedSlider')?.addEventListener('input', (e) => {
                        animSpeed = parseFloat(e.target.value) || 1.0;
                        document.getElementById('productSpeedLabel').innerText = animSpeed.toFixed(2) + 'x';
                    });

                    document.getElementById('productAnimSelect')?.addEventListener('change', (e) => {
                        playAnim(e.target.value);
                    });

                    // Load 3D Model
                    loadModel();
                }

                async function loadModel() {
                    const altParam = alt ? `/${encodeURIComponent(alt)}` : '';
                    const resQuery = resource ? `?resource=${encodeURIComponent(resource)}` : '';
                    const url = `/api/v1/assets/3d/hero/${encodeURIComponent(hero)}${altParam}${resQuery}`;

                    try {
                        const resp = await fetch(url);
                        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
                        const buffer = await resp.arrayBuffer();

                        const loader = new THREE.GLTFLoader();
                        loader.parse(buffer, '', (gltf) => {
                            if (currentModel) {
                                scene.remove(currentModel);
                            }

                            currentModel = gltf.scene;

                            // Configure Shadows & PBR Materials (Matches Store/Index.cshtml)
                            currentModel.traverse((child) => {
                                if (child.isMesh) {
                                    child.castShadow = true;
                                    child.receiveShadow = true;
                                    if (child.material) {
                                        const configureMaterial = (mat) => {
                                            if (!mat) return;
                                            mat.side = THREE.DoubleSide;
                                            mat.roughness = 0.8;
                                            mat.metalness = 0.1;
                                            mat.transparent = false;
                                            mat.depthWrite = true;
                                            mat.color = new THREE.Color(0xffffff);

                                            if (mat.map) {
                                                if (window.KongorViewerCore) {
                                                    window.KongorViewerCore.configureTextureColorSpace(mat.map);
                                                } else if ('colorSpace' in mat.map && THREE.SRGBColorSpace) {
                                                    mat.map.colorSpace = THREE.SRGBColorSpace;
                                                }
                                                mat.map.generateMipmaps = true;
                                                mat.map.minFilter = THREE.LinearMipmapLinearFilter;
                                                mat.map.magFilter = THREE.LinearFilter;
                                                mat.map.needsUpdate = true;
                                            }
                                            if (mat.normalMap) {
                                                mat.normalScale = new THREE.Vector2(1.0, 1.0);
                                                mat.normalMap.generateMipmaps = true;
                                                mat.normalMap.needsUpdate = true;
                                            }
                                            if (mat.emissiveMap) {
                                                if (window.KongorViewerCore) {
                                                    window.KongorViewerCore.configureTextureColorSpace(mat.emissiveMap);
                                                } else if ('colorSpace' in mat.emissiveMap && THREE.SRGBColorSpace) {
                                                    mat.emissiveMap.colorSpace = THREE.SRGBColorSpace;
                                                }
                                                mat.emissive = new THREE.Color(0xffffff);
                                                mat.emissiveIntensity = 1.5;
                                                mat.emissiveMap.needsUpdate = true;
                                            }
                                            mat.needsUpdate = true;
                                        };

                                        if (Array.isArray(child.material)) {
                                            child.material.forEach(configureMaterial);
                                        } else {
                                            configureMaterial(child.material);
                                        }
                                    }
                                }
                            });

                            // Reset transform
                            currentModel.position.set(0, 0, 0);
                            currentModel.rotation.set(0, 0, 0);
                            currentModel.scale.set(1, 1, 1);
                            currentModel.updateMatrixWorld(true);

                            // Center horizontally and position feet at y = 0
                            const bbox = new THREE.Box3().setFromObject(currentModel);
                            const center = new THREE.Vector3();
                            bbox.getCenter(center);
                            const size = new THREE.Vector3();
                            bbox.getSize(size);
                            const maxDim = Math.max(size.x, size.y, size.z, 50);

                            currentModel.position.x = -center.x;
                            currentModel.position.z = -center.z;
                            if (bbox.min.y < -0.1 && bbox.min.y > -15) {
                                currentModel.position.y = -bbox.min.y;
                            } else {
                                currentModel.position.y = 0;
                            }
                            currentModel.updateMatrixWorld(true);

                            scene.add(currentModel);

                            // Auto-frame camera based on model bounding box dimensions (sweet spot)
                            const targetHeight = Math.max(20, Math.min(size.y * 0.45, 36));
                            const cameraDistance = Math.max(160, Math.min(maxDim * 1.55, 185));

                            defaultCameraPos.set(0, targetHeight + 12, cameraDistance);
                            defaultTarget.set(0, targetHeight, 0);

                            camera.position.copy(defaultCameraPos);
                            controls.target.copy(defaultTarget);
                            controls.minDistance = 20;
                            controls.maxDistance = 1500;
                            controls.update();

                            mixer = new THREE.AnimationMixer(currentModel);
                            actions = {};

                            mixer.addEventListener('finished', (e) => {
                                onActionFinished(e.action);
                            });

                            const animSelect = document.getElementById('productAnimSelect');
                            if (animSelect) animSelect.innerHTML = '';

                            gltf.animations.forEach((clip) => {
                                const act = mixer.clipAction(clip);
                                actions[clip.name] = act;

                                if (animSelect) {
                                    const opt = document.createElement('option');
                                    opt.value = clip.name;
                                    opt.innerText = clip.name.replace(/_/g, ' ').toUpperCase();
                                    animSelect.appendChild(opt);
                                }
                            });

                            // Play Idle by default
                            const idleAnim = gltf.animations.find(a => a.name.toLowerCase().includes('idle')) || gltf.animations[0];
                            if (idleAnim) {
                                playAnim(idleAnim.name);
                                if (animSelect) animSelect.value = idleAnim.name;
                            }

                            const loadingOverlay = document.getElementById('product3DLoading');
                            if (loadingOverlay) loadingOverlay.style.display = 'none';
                        });
                    } catch (e) {
                        const msg = document.getElementById('product3DLoadingMsg');
                        if (msg) msg.innerText = 'Failed to load 3D Model: ' + e.message;
                    }
                }

                let audioTimeout = null;
                let actionCycleTimeout = null;
                let currentPlayingAnim = 'idle';

                function playAnim(name) {
                    if (!actions[name]) return;
                    if (actionCycleTimeout) {
                        clearTimeout(actionCycleTimeout);
                        actionCycleTimeout = null;
                    }

                    currentPlayingAnim = name;
                    const nextAction = actions[name];
                    const rawAction = (name || 'idle').toLowerCase().trim();
                    const isContinuous = rawAction.includes('idle') || rawAction.includes('walk') || rawAction.includes('run');

                    if (activeAction && activeAction !== nextAction) {
                        activeAction.fadeOut(0.25);
                    }

                    nextAction.reset();
                    nextAction.fadeIn(0.25);

                    if (isContinuous) {
                        nextAction.setLoop(THREE.LoopRepeat);
                        nextAction.clampWhenFinished = false;
                    } else {
                        nextAction.setLoop(THREE.LoopOnce, 1);
                        nextAction.clampWhenFinished = true;
                    }

                    nextAction.play();
                    activeAction = nextAction;

                    if (!isPaused) {
                        playAudio(name);
                    }
                }

                function onActionFinished(action) {
                    if (isPaused) return;
                    const currentClip = currentPlayingAnim;
                    const raw = currentClip.toLowerCase().trim();
                    const isContinuous = raw.includes('idle') || raw.includes('walk') || raw.includes('run');
                    if (isContinuous) return;

                    // Crossfade to idle pose for 1.4s rest break
                    let idleActionName = Object.keys(actions).find(k => k.toLowerCase().includes('idle'));
                    if (idleActionName && actions[idleActionName]) {
                        const idleAct = actions[idleActionName];
                        if (activeAction) activeAction.fadeOut(0.25);
                        idleAct.reset().fadeIn(0.25).play();
                        activeAction = idleAct;
                    }

                    actionCycleTimeout = setTimeout(() => {
                        if (isPaused || currentPlayingAnim !== currentClip) return;
                        playAnim(currentClip);
                    }, 1400);
                }

                function playAudio(actionName) {
                    if (audioTimeout) {
                        clearTimeout(audioTimeout);
                        audioTimeout = null;
                    }

                    if (isMuted || isPaused || !hero) return;

                    try {
                        if (currentAudio) {
                            currentAudio.pause();
                            currentAudio.currentTime = 0;
                            currentAudio = null;
                        }

                        const rawAction = (actionName || 'idle').toLowerCase().trim();
                        let delayMs = rawAction.includes('attack') ? 350 : (rawAction.includes('ability') ? 250 : 0);

                        audioTimeout = setTimeout(() => {
                            if (isMuted || isPaused || !hero) return;
                            const soundUrl = `/api/v1/assets/sound?hero=${encodeURIComponent(hero)}&alt=${encodeURIComponent(alt || '')}&action=${encodeURIComponent(rawAction)}&_t=${Date.now()}`;
                            currentAudio = new Audio(soundUrl);
                            currentAudio.onerror = () => { /* gracefully handle missing audio */
                            };
                            currentAudio.volume = 0.75;
                            currentAudio.loop = false;
                            currentAudio.playbackRate = animSpeed;
                            currentAudio.play().catch(() => {
                            });
                        }, delayMs);
                    } catch (err) {
                    }
                }

                function onResize() {
                    const container = document.getElementById('product3DContainer');
                    if (!container || !renderer || !camera) return;
                    const w = container.clientWidth;
                    const h = container.clientHeight;
                    camera.aspect = w / h;
                    camera.updateProjectionMatrix();
                    renderer.setSize(w, h);
                }

                function animate() {
                    requestAnimationFrame(animate);
                    const delta = clock.getDelta();
                    if (mixer && !isPaused) {
                        mixer.update(delta * animSpeed);
                    }
                    controls.update();
                    renderer.render(scene, camera);
                }
            })();
        </text>
    }

    // Equip in Loadout Handler
    async function equipCurrentItem(itemId, itemCode) {
        const actionBox = document.getElementById('productActionBox');
        if (actionBox) {
            actionBox.innerHTML = `
                <div class="w-full py-3.5 px-4 rounded-xl bg-slate-800 text-amber-300 text-xs font-bold text-center flex items-center justify-center gap-2">
                    <i class="fas fa-spinner fa-spin"></i>
                    <span>Equipping in in-game loadout...</span>
                </div>
            `;
        }

        try {
            const resp = await fetch('/store/equip', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({itemId: itemId, code: itemCode})
            });

            const data = await resp.json();

            if (resp.ok && data.success) {
                if (actionBox) {
                    actionBox.innerHTML = `
                        <div class="w-full py-3.5 px-4 rounded-xl bg-slate-900/90 border border-slate-800 text-slate-500 text-sm font-bold text-center flex items-center justify-center gap-2 shadow-inner cursor-default opacity-80 select-none">
                            <i class="fas fa-check-circle text-emerald-500"></i>
                            <span>✓ EQUIPPED</span>
                        </div>
                    `;
                }
            } else {
                if (actionBox) {
                    actionBox.innerHTML = `
                        <button onclick="equipCurrentItem(${itemId}, '${itemCode}')" class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 text-sm font-black text-center flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20 transition-all cursor-pointer">
                            <i class="fas fa-bolt"></i>
                            <span>Equip in Loadout</span>
                        </button>
                    `;
                }
                alert(data.error || "Failed to equip item.");
            }
        } catch (err) {
            if (actionBox) {
                actionBox.innerHTML = `
                    <button onclick="equipCurrentItem(${itemId}, '${itemCode}')" class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 text-sm font-black text-center flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20 transition-all cursor-pointer">
                        <i class="fas fa-bolt"></i>
                        <span>Equip in Loadout</span>
                    </button>
                `;
            }
            alert("Network error: " + err.message);
        }
    }

    // Purchase Modal Functions
    function openPurchaseModal(id, name, cost, currency) {
        document.getElementById('buyItemId').value = id;
        document.getElementById('buyItemTitle').innerText = name;
        document.getElementById('buyCurrency').value = currency;
        document.getElementById('buyCostDisplay').innerHTML = currency === 'gold'
            ? `<span class="text-amber-400 font-bold">${cost} Gold Coins</span>`
            : `<span class="text-slate-300 font-bold">${cost} Silver Coins</span>`;

        const statusMsg = document.getElementById('buyStatusMsg');
        statusMsg.classList.add('hidden');
        document.getElementById('purchaseModal').style.display = 'flex';
    }

    function closePurchaseModal() {
        document.getElementById('purchaseModal').style.display = 'none';
    }

    async function executePurchase() {
        const id = parseInt(document.getElementById('buyItemId').value, 10);
        const currency = document.getElementById('buyCurrency').value;
        const buyBtn = document.getElementById('confirmBuyBtn');
        const buyBtnText = document.getElementById('confirmBuyBtnText');
        const statusMsg = document.getElementById('buyStatusMsg');

        buyBtn.disabled = true;
        buyBtnText.innerText = "Unlocking...";

        try {
            const resp = await fetch('/store/purchase', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({itemId: id, currency: currency})
            });

            const data = await resp.json();

            if (resp.ok && data.success) {
                statusMsg.innerText = "✓ " + data.message;
                statusMsg.className = "text-xs font-semibold text-emerald-400";
                statusMsg.classList.remove('hidden');

                const goldEl = document.getElementById('userGoldDisplay');
                if (goldEl && data.newGold !== undefined) goldEl.innerText = data.newGold.toLocaleString();

                const silverEl = document.getElementById('userSilverDisplay');
                if (silverEl && data.newSilver !== undefined) silverEl.innerText = data.newSilver.toLocaleString();

                const actionBox = document.getElementById('productActionBox');
                if (actionBox) {
                    actionBox.innerHTML = `
                        <div class="w-full py-3.5 px-4 rounded-xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-sm font-black text-center flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/10">
                            <i class="fas fa-check-circle text-base"></i>
                            <span>Unlocked In Your Vault</span>
                        </div>
                    `;
                }

                setTimeout(() => {
                    closePurchaseModal();
                    buyBtn.disabled = false;
                    buyBtnText.innerText = "Confirm Purchase";
                }, 900);
            } else {
                statusMsg.innerText = "Error: " + (data.error || "Purchase failed.");
                statusMsg.className = "text-xs font-semibold text-red-400";
                statusMsg.classList.remove('hidden');
                buyBtn.disabled = false;
                buyBtnText.innerText = "Confirm Purchase";
            }
        } catch (err) {
            statusMsg.innerText = "Network error: " + err.message;
            statusMsg.className = "text-xs font-semibold text-red-400";
            statusMsg.classList.remove('hidden');
            buyBtn.disabled = false;
            buyBtnText.innerText = "Confirm Purchase";
        }
    }

    // Staff Price Editor Functions
    @if (Model.IsStaff)
    {
        <text>
            function openPriceEditor(id, name, gold, silver, enabled, purchasable) {
                document.getElementById('editItemHiddenId').value = id;
                document.getElementById('editItemId').innerText = 'Product ID: #' + id;
                document.getElementById('editGoldCost').value = gold;
                document.getElementById('editSilverCost').value = silver;
                document.getElementById('editIsEnabled').checked = enabled;
                document.getElementById('editPurchasable').checked = purchasable;

                const statusMsg = document.getElementById('editStatusMsg');
                statusMsg.classList.add('hidden');

                document.getElementById('priceEditorModal').style.display = 'flex';
            }

            function closePriceEditor() {
                document.getElementById('priceEditorModal').style.display = 'none';
            }

            async function saveStoreItemChanges() {
                const id = parseInt(document.getElementById('editItemHiddenId').value, 10);
                const gold = parseInt(document.getElementById('editGoldCost').value, 10) || 0;
                const silver = parseInt(document.getElementById('editSilverCost').value, 10) || 0;
                const isEnabled = document.getElementById('editIsEnabled').checked;
                const purchasable = document.getElementById('editPurchasable').checked;

                const saveBtn = document.getElementById('savePriceBtn');
                const statusMsg = document.getElementById('editStatusMsg');

                saveBtn.disabled = true;
                saveBtn.innerText = "Saving...";

                try {
                    const resp = await fetch('/staff/store/update', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({
                            id: id,
                            goldCost: gold,
                            silverCost: silver,
                            isEnabled: isEnabled,
                            purchasable: purchasable
                        })
                    });

                    const data = await resp.json();

                    if (resp.ok && data.success) {
                        statusMsg.innerText = "✓ Saved and synchronized!";
                        statusMsg.className = "text-xs font-semibold text-emerald-400";
                        statusMsg.classList.remove('hidden');

                        setTimeout(() => {
                            closePriceEditor();
                            window.location.reload();
                        }, 800);
                    } else {
                        statusMsg.innerText = "Error: " + (data.error || "Save failed.");
                        statusMsg.className = "text-xs font-semibold text-red-400";
                        statusMsg.classList.remove('hidden');
                        saveBtn.disabled = false;
                        saveBtn.innerText = "Save Changes";
                    }
                } catch (err) {
                    statusMsg.innerText = "Network error: " + err.message;
                    statusMsg.className = "text-xs font-semibold text-red-400";
                    statusMsg.classList.remove('hidden');
                    saveBtn.disabled = false;
                    saveBtn.innerText = "Save Changes";
                }
            }
        </text>
    }

    // Audio Preview Helpers for Announcers & Taunts
    function playAnnouncerLine(packCode, action, label) {
        const url = `/api/v1/assets/sound?announcer=${encodeURIComponent(packCode)}&action=${encodeURIComponent(action)}`;
        if (window.NexusSoundboard) {
            NexusSoundboard.playUrl(url, label);
        } else {
            const audio = new Audio(url);
            audio.play().catch(e => console.warn('Audio play failed:', e));
        }

        const labelEl = document.getElementById('announcerCurrentTrackLabel');
        if (labelEl) {
            labelEl.innerText = `🔊 Playing: ${label}`;
        }
    }

    function playTauntSfx(tauntCode, action, label) {
        const url = `/api/v1/assets/sound?taunt=${encodeURIComponent(tauntCode)}&action=${encodeURIComponent(action)}`;
        if (window.NexusSoundboard) {
            NexusSoundboard.playUrl(url, label);
        } else {
            const audio = new Audio(url);
            audio.play().catch(e => console.warn('Audio play failed:', e));
        }

        const labelEl = document.getElementById('tauntPlayingStatus');
        if (labelEl) {
            labelEl.innerText = `🔊 Playing: ${label}`;
        }
    }
