        // Desktop top-navbar dropdown persistence: keeps submenu open on downward pointer movement,
        // supports click/tap/keyboard activation, and closes cleanly only when leaving submenu or pressing Escape.
        (function initDesktopNavDropdowns() {
            const dropdowns = Array.from(document.querySelectorAll('.nav-dropdown'));
            if (!dropdowns.length) return;

            let openDropdown = null;
            let closeTimer = null;

            function clearCloseTimer() {
                if (closeTimer !== null) {
                    clearTimeout(closeTimer);
                    closeTimer = null;
                }
            }

            function setDropdownState(dd, shouldOpen) {
                const trigger = dd.querySelector('.nav-dropdown-trigger');
                if (shouldOpen) {
                    clearCloseTimer();
                    dropdowns.forEach(other => {
                        if (other !== dd) {
                            other.classList.remove('is-open');
                            const otherBtn = other.querySelector('.nav-dropdown-trigger');
                            if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
                        }
                    });
                    dd.classList.add('is-open');
                    if (trigger) trigger.setAttribute('aria-expanded', 'true');
                    openDropdown = dd;
                } else {
                    dd.classList.remove('is-open');
                    if (trigger) trigger.setAttribute('aria-expanded', 'false');
                    if (openDropdown === dd) openDropdown = null;
                }
            }

            function closeAllDropdowns(restoreFocusToTrigger = false) {
                clearCloseTimer();
                const prev = openDropdown;
                dropdowns.forEach(dd => setDropdownState(dd, false));
                if (restoreFocusToTrigger && prev) {
                    const trigger = prev.querySelector('.nav-dropdown-trigger');
                    if (trigger) trigger.focus();
                }
            }

            function isPointerInsideSafeZone(dd, clientX, clientY) {
                const trigger = dd.querySelector('.nav-dropdown-trigger');
                const panel = dd.querySelector('.nav-dropdown-panel');
                if (!trigger || !panel) return false;

                const tRect = trigger.getBoundingClientRect();
                const pRect = panel.getBoundingClientRect();

                // 1. Inside trigger button (with small cushion)
                if (clientX >= tRect.left - 6 && clientX <= tRect.right + 6 &&
                    clientY >= tRect.top - 6 && clientY <= tRect.bottom + 6) {
                    return true;
                }

                // 2. Inside downward corridor bridging trigger bottom -> submenu top (covers straight & diagonal downward motion)
                const minLeft = Math.min(tRect.left, pRect.left) - 24;
                const maxRight = Math.max(tRect.right, pRect.right) + 24;
                if (clientX >= minLeft && clientX <= maxRight &&
                    clientY >= tRect.bottom - 6 && clientY <= pRect.top + 10) {
                    return true;
                }

                // 3. Inside submenu panel itself (with slight outer border cushion)
                if (clientX >= pRect.left - 10 && clientX <= pRect.right + 10 &&
                    clientY >= pRect.top - 8 && clientY <= pRect.bottom + 10) {
                    return true;
                }

                return false;
            }

            dropdowns.forEach(dd => {
                const trigger = dd.querySelector('.nav-dropdown-trigger');
                const panel = dd.querySelector('.nav-dropdown-panel');

                dd.addEventListener('pointerenter', function (e) {
                    if (e.pointerType === 'touch') return;
                    setDropdownState(dd, true);
                });

                dd.addEventListener('pointerleave', function (e) {
                    if (e.pointerType === 'touch') return;
                    if (isPointerInsideSafeZone(dd, e.clientX, e.clientY)) {
                        return;
                    }
                    clearCloseTimer();
                    closeTimer = setTimeout(() => {
                        if (openDropdown === dd) {
                            setDropdownState(dd, false);
                        }
                    }, 90);
                });

                if (trigger) {
                    trigger.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        const currentlyOpen = dd.classList.contains('is-open');
                        setDropdownState(dd, !currentlyOpen);
                    });

                    trigger.addEventListener('keydown', function (e) {
                        if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
                            e.preventDefault();
                            setDropdownState(dd, true);
                            if (panel) {
                                const firstLink = panel.querySelector('a[href], button:not([disabled])');
                                if (firstLink) firstLink.focus();
                            }
                        }
                    });
                }

                if (panel) {
                    panel.addEventListener('click', function (e) {
                        const disabledItem = e.target.closest('[aria-disabled="true"]');
                        if (disabledItem) {
                            e.preventDefault();
                            e.stopPropagation();
                        }
                    });
                }
            });

            document.addEventListener('pointermove', function (e) {
                if (!openDropdown || e.pointerType === 'touch') return;
                // Check if pointer entered a sibling dropdown directly
                const hoveredSibling = e.target && e.target.closest ? e.target.closest('.nav-dropdown') : null;
                if (hoveredSibling && hoveredSibling !== openDropdown) {
                    setDropdownState(hoveredSibling, true);
                    return;
                }
                if (isPointerInsideSafeZone(openDropdown, e.clientX, e.clientY)) {
                    clearCloseTimer();
                } else if (closeTimer === null) {
                    const targetDd = openDropdown;
                    closeTimer = setTimeout(() => {
                        if (openDropdown === targetDd) {
                            setDropdownState(targetDd, false);
                        }
                    }, 80);
                }
            }, { passive: true });

            document.addEventListener('pointerdown', function (e) {
                if (!openDropdown) return;
                if (!openDropdown.contains(e.target)) {
                    closeAllDropdowns(false);
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && openDropdown) {
                    const restoreFocus = openDropdown.contains(document.activeElement);
                    closeAllDropdowns(restoreFocus);
                }
            });
        })();
    })();
</script>
