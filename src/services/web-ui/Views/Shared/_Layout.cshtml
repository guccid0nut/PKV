@{
    var currentPath = (Context.Request.Path.Value ?? "").ToLowerInvariant();

    bool IsPathActive(string targetPath)
    {
        if (targetPath == "/")
        {
            return currentPath == "/" || string.IsNullOrEmpty(currentPath) || currentPath == "/home" || currentPath == "/home/index";
        }

        var cleanTarget = targetPath.Trim('/').ToLowerInvariant();
        var cleanCurrent = currentPath.Trim('/').ToLowerInvariant();

        return cleanCurrent == cleanTarget ||
               cleanCurrent.StartsWith(cleanTarget + "/") ||
               cleanCurrent == "home/" + cleanTarget ||
               cleanCurrent.StartsWith("home/" + cleanTarget + "/") ||
               (cleanTarget == "codex" && (cleanCurrent.StartsWith("hero") || cleanCurrent.StartsWith("home/hero")));
    }


    string GetDropdownBtnClass(bool hasActiveChild)
    {
        return hasActiveChild
            ? "text-xs font-bold px-2.5 xl:px-3 py-1.5 rounded-xl bg-amber-500/15 text-amber-300 border border-amber-500/40 shadow-sm shadow-amber-950/30 transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer"
            : "text-xs font-semibold px-2.5 xl:px-3 py-1.5 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-300 hover:text-cyan-300 border border-slate-700/60 hover:border-cyan-500/30 transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer";
    }

    string GetDropdownItemClass(string targetPath)
    {
        var active = IsPathActive(targetPath);
        return active
            ? "flex items-center gap-2.5 px-3 py-2 rounded-xl bg-amber-500/15 text-amber-300 border border-amber-500/30 text-xs font-bold transition-all shadow-sm"
            : "flex items-center gap-2.5 px-3 py-2 rounded-xl hover:bg-slate-800/90 text-slate-300 hover:text-white text-xs font-semibold transition-all";
    }

    string GetMobileNavClass(string targetPath)
    {
        var active = IsPathActive(targetPath);
        return active
            ? "w-full py-2.5 px-3.5 rounded-xl bg-amber-500/15 text-amber-300 border border-amber-500/40 text-xs font-bold flex items-center gap-2.5 transition-all shadow-sm"
            : "w-full py-2.5 px-3.5 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-300 hover:text-cyan-300 border border-slate-700/60 text-xs font-semibold flex items-center gap-2.5 transition-all";
    }

    string GetStaffDropdownItemClass(string targetPath)
    {
        var active = IsPathActive(targetPath);
        return active
            ? "flex items-center gap-2.5 px-3 py-2 rounded-xl bg-purple-500/25 text-purple-100 border border-purple-500/50 text-xs font-black transition-all shadow-md shadow-purple-950/40 ring-1 ring-purple-400/40"
            : "flex items-center gap-2.5 px-3 py-2 rounded-xl bg-purple-950/45 hover:bg-purple-900/65 text-purple-200 hover:text-white border border-purple-500/35 text-xs font-bold transition-all shadow-sm";
    }

    string GetMobileStaffNavClass(string targetPath)
    {
        var active = IsPathActive(targetPath);
        return active
            ? "w-full py-2.5 px-3.5 rounded-xl bg-purple-600/30 text-purple-200 border border-purple-500/50 text-xs font-black flex items-center gap-2.5 transition-all shadow-md"
            : "w-full py-2.5 px-3.5 rounded-xl bg-purple-950/40 hover:bg-purple-900/60 text-purple-300 hover:text-purple-200 border border-purple-500/30 text-xs font-bold flex items-center gap-2.5 transition-all";
    }

    var isStaffUser = DAWNBRINGER.WebPortal.UI.Infrastructure.StaffAuthorizationHelper.IsStaff(User);

    var isDiscordConnected = User.Identity?.IsAuthenticated == true &&
                             (User.HasClaim(c => c.Type == "discord_id" || c.Type == "urn:discord:id" || c.Type == "urn:discord:avatar") ||
                              !string.IsNullOrEmpty(User.FindFirst("discord_id")?.Value) ||
                              !string.IsNullOrEmpty(User.FindFirst("urn:discord:id")?.Value));

    var layoutConfig = Context.RequestServices.GetService(typeof(Microsoft.Extensions.Configuration.IConfiguration)) as Microsoft.Extensions.Configuration.IConfiguration;
    var isStandaloneMode = string.Equals(layoutConfig?["KONGOR_STANDALONE"], "true", StringComparison.OrdinalIgnoreCase) ||
                           string.Equals(layoutConfig?["KONGOR_STANDALONE"], "1", StringComparison.OrdinalIgnoreCase);
    var isPendingRegistration = User.HasClaim("pending_registration", "true");
    var hasAccountIdClaim = !string.IsNullOrWhiteSpace(User.FindFirst("AccountId")?.Value);
    var isFullyOnboardedUser = User.Identity?.IsAuthenticated == true &&
                               !isPendingRegistration &&
                               (isStandaloneMode ||
                                (isDiscordConnected && hasAccountIdClaim) ||
                                string.Equals(User.Identity.AuthenticationType, "TestAuth", StringComparison.OrdinalIgnoreCase) ||
                                string.Equals(User.Identity.AuthenticationType, "TestCookieAuth", StringComparison.OrdinalIgnoreCase));

    var rawHeaderReturnUrl = Context.Request.Query["returnUrl"].ToString();
    var safeHeaderReturnUrl = !string.IsNullOrWhiteSpace(rawHeaderReturnUrl) && Url.IsLocalUrl(rawHeaderReturnUrl) ? rawHeaderReturnUrl : null;
    var rawHeaderInvite = Context.Request.Query["invite"].ToString();

    bool isMatchesActive = IsPathActive("/matches") || IsPathActive("/stats") || IsPathActive("/leaderboard") || IsPathActive("/clans") || (isStaffUser && (IsPathActive("/live") || IsPathActive("/tools/replays") || IsPathActive("/tools/replay-studio")));
    bool isCompendiumActive = IsPathActive("/codex") || IsPathActive("/items") || IsPathActive("/guides") || (isStaffUser && IsPathActive("/lore"));
    bool isArmoryActive = IsPathActive("/store") || (isStaffUser && (IsPathActive("/staff/inventory") || IsPathActive("/tools/inventory")));
    bool isArMiniGamesActive = IsPathActive("/ar-mini-games") || IsPathActive("/AR-Mini-Games");
    bool isPlatformActive = IsPathActive("/cloud") || IsPathActive("/setup") || IsPathActive("/tools/message-generator") || (isStaffUser && (IsPathActive("/docs") || IsPathActive("/developer-docs") || IsPathActive("/staff") || IsPathActive("/admin/issues") || IsPathActive("/System/Issues") || IsPathActive("/staff/issues")));
}
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Project KONGOR Web Portal</title>

    <!-- Open Graph / Discord & Social Embeds -->
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="Project KONGOR"/>
    <meta property="og:title" content="@(ViewData["Title"] ?? "Web Portal") — Project KONGOR"/>
    <meta property="og:description" content="@(ViewData["Description"] ?? "Private server platform and modern runtime for Heroes of Newerth")"/>
    <meta property="og:image" content="@(ViewData["OgImage"] ?? "/images/logo-nobg.png")"/>

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content="@(ViewData["Title"] ?? "Web Portal") — Project KONGOR"/>
    <meta name="twitter:description" content="@(ViewData["Description"] ?? "Private server platform and modern runtime for Heroes of Newerth")"/>

    <!-- General SEO -->
    <meta name="description" content="@(ViewData["Description"] ?? "Project KONGOR — Private server platform and modern runtime for Heroes of Newerth")"/>

    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico"/>
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon.png"/>
    <link rel="apple-touch-icon" href="~/images/kongor-icon.png"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin/>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous" referrerpolicy="no-referrer" media="print" onload="this.media='all'"/>
    <link rel="stylesheet" href="~/css/profile_cosmetics.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'"/>
    <noscript>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"/>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer"/>
    </noscript>
    <style>
        /* Render-blocking Google Fonts CSS import moved to non-blocking stylesheet link above */

        body {
            font-family: 'Outfit', 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            font-size-adjust: from-font;
            overflow-x: hidden;
        }

        /* Accessibility: high-contrast focus indicator for keyboard navigation */
        :focus-visible {
            outline: 2px solid rgb(245, 158, 11) !important;
            outline-offset: 2px !important;
        }

        :focus:not(:focus-visible) {
            outline: none;
        }

        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .glass-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .glass-card:hover {
            border-color: rgba(168, 85, 247, 0.4);
            box-shadow: 0 0 25px rgba(168, 85, 247, 0.15);
        }

        .glow-purple {
            box-shadow: 0 0 35px -5px rgba(168, 85, 247, 0.4);
        }

        .glow-discord {
            box-shadow: 0 0 30px -5px rgba(88, 101, 242, 0.4);
        }

        @@keyframes pulseGlow {
            0%, 100% {
                opacity: 0.4;
                transform: scale(1);
            }
            50% {
                opacity: 0.7;
                transform: scale(1.05);
            }
        }

        .animate-pulse-glow {
            animation: pulseGlow 8s ease-in-out infinite;
        }

        /* Scrollbar suppression with standard CSS + guarded legacy WebKit fallback */
        .no-scrollbar {
            scrollbar-width: none;
        }

        @@supports not (scrollbar-width: none) {
            .no-scrollbar::-webkit-scrollbar {
                display: none;
                width: 0;
                height: 0;
            }
        }

        .drag-scroll-strip {
            cursor: grab;
            -webkit-user-drag: none;
        }

        .drag-scroll-strip.is-dragging {
            cursor: grabbing;
        }

        /* Desktop mega-nav submenu hover bridge & forgiving downward hit corridor */
        .nav-dropdown-panel {
            overflow: visible;
        }

        .nav-dropdown-panel::before {
            content: "";
            position: absolute;
            top: -16px;
            left: -16px;
            right: -16px;
            height: 22px;
            background: transparent;
            pointer-events: auto;
        }

        .nav-dropdown.is-open > .nav-dropdown-panel {
            visibility: visible !important;
            opacity: 1 !important;
            pointer-events: auto !important;
        }

        .nav-dropdown.is-open .nav-dropdown-chevron {
            transform: rotate(180deg);
            color: rgb(251, 191, 36);
        }
    </style>
</head>
<body
    class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-purple-500 selection:text-white overflow-x-hidden">
<!-- Accessibility: Skip-to-content link for keyboard / screen reader users -->
<a href="#main-content"
   class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-slate-900 focus:text-amber-300 focus:border-2 focus:border-amber-400 focus:rounded-xl focus:shadow-2xl focus:outline-none font-bold text-xs">
    Skip to main content
</a>
<header class="w-full glass-panel sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950/90 backdrop-blur-2xl">
    <div class="w-full max-w-[1920px] mx-auto px-3 sm:px-5 lg:px-8 py-2 flex items-center justify-between gap-3 lg:gap-4 relative">
        
        <!-- Left: Mobile Toggle & Brand Logo -->
        <div class="flex items-center gap-2.5 sm:gap-3 flex-shrink-0">
            @if (isFullyOnboardedUser)
            {
                <!-- Mobile Menu Toggle Button (< lg) -->
                <div class="lg:hidden flex items-center">
                    <button id="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu"
                            class="p-2 rounded-xl bg-slate-900/80 border border-slate-700/80 text-slate-300 hover:text-white hover:border-purple-500/50 focus:outline-none transition-all flex items-center justify-center">
                        <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                                  d="M4 6h16M4 12h16M4 18h16"/>
                            <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                                  d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
            }

            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-2.5 group flex-shrink-0" title="Project KONGOR Home">
                <img src="/images/logo-nobg.png" alt="PROJECT KONGOR" width="36" height="36" fetchpriority="high" decoding="async"
                     class="h-8 sm:h-9 w-auto flex-shrink-0 group-hover:scale-105 transition-transform drop-shadow-lg"/>
                <span class="text-base sm:text-lg xl:text-xl font-black tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-purple-400 via-pink-400 to-amber-400 leading-none whitespace-nowrap drop-shadow-sm hidden xs:inline">
                    PROJECT KONGOR
                </span>
            </a>
        </div>

        @if (isFullyOnboardedUser)
        {
        <!-- Center: Desktop Grouped Mega-Nav Dropdowns (>= lg) -->
        <nav class="hidden lg:flex items-center gap-1.5 xl:gap-2 flex-shrink-0" aria-label="Primary navigation">
            <!-- Dropdown 1: Matches & Live -->
            <div class="relative group nav-dropdown">
                <button type="button" aria-haspopup="true" aria-expanded="false" class="nav-dropdown-trigger @GetDropdownBtnClass(isMatchesActive)">
                    @if (isStaffUser)
                    {
                        <span class="w-2 h-2 rounded-full bg-red-500 animate-ping inline-block mr-0.5"></span>
                    }
                    <span>Matches & Live</span>
                    <svg class="nav-dropdown-chevron w-3 h-3 text-slate-400 group-hover:text-amber-400 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                <div class="nav-dropdown-panel invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 absolute top-full left-0 mt-1.5 w-60 p-1.5 rounded-2xl bg-slate-900/95 border border-slate-700/90 shadow-2xl backdrop-blur-2xl transition-all duration-150 z-50 space-y-0.5">
                    @if (isStaffUser)
                    {
                        <a asp-controller="Live" asp-action="Index" class="@GetStaffDropdownItemClass("/live")">
                            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                            <div class="flex flex-col min-w-0">
                                <div class="flex items-center gap-1.5">
                                    <span>Live Matches</span>
                                    <span class="text-[9px] px-1.5 py-0.2 rounded bg-purple-500/25 text-purple-200 border border-purple-400/40 font-bold uppercase tracking-wider">Staff</span>
                                </div>
                                <span class="text-[10px] text-purple-300/90 font-normal">Real-time spectator radar</span>
                            </div>
                        </a>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Home" asp-action="Matches" class="@GetDropdownItemClass("/matches")">
                            <span>⚔️</span>
                            <div class="flex flex-col min-w-0">
                                <span>Match History</span>
                                <span class="text-[10px] text-slate-400 font-normal">Scoreboards & replays</span>
                            </div>
                        </a>
                        <a asp-controller="Home" asp-action="Stats" class="@GetDropdownItemClass("/stats")">
                            <span>📊</span>
                            <div class="flex flex-col min-w-0">
                                <span>Player Stats</span>
                                <span class="text-[10px] text-slate-400 font-normal">MMR, KDR & Hero mastery</span>
                            </div>
                        </a>
                    }
                    <a asp-controller="Home" asp-action="Leaderboard" class="@GetDropdownItemClass("/leaderboard")">
                        <span aria-hidden="true">🏆</span>
                        <div class="flex flex-col min-w-0">
                            <span>Leaderboard</span>
                            <span class="text-[10px] text-slate-400 font-normal">Top ranked Newerth players</span>
                        </div>
                    </a>
                    <a asp-controller="Clans" asp-action="Index" class="@GetDropdownItemClass("/clans")">
                        <span aria-hidden="true">🛡️</span>
                        <div class="flex flex-col min-w-0">
                            <span>Clans</span>
                            <span class="text-[10px] text-slate-400 font-normal">Standings, tags &amp; member rosters</span>
                        </div>
                    </a>
                    @if (isStaffUser)
                    {
                        <div role="link"
                             aria-disabled="true"
                             data-staff-disabled="replay-studio"
                             title="Deferred future work — Headless Linux Docker K2 client POV recorder"
                             class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold bg-purple-950/20 border border-purple-500/20 text-slate-400 opacity-50 grayscale cursor-not-allowed select-none">
                            <span>🎬</span>
                            <div class="flex flex-col min-w-0">
                                <div class="flex items-center gap-1 flex-wrap">
                                    <span>Replay Studio</span>
                                    <span class="text-[9px] px-1.5 py-0.2 rounded bg-purple-500/20 text-purple-200 border border-purple-400/35 font-bold uppercase tracking-wider">Staff</span>
                                    <span class="text-[9px] px-1.5 py-0.2 rounded bg-slate-800 text-slate-300 border border-slate-600 font-bold uppercase tracking-wider">Future</span>
                                </div>
                                <span class="text-[10px] text-slate-400 font-normal">Deferred · Docker client POV</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Dropdown 2: Compendium -->
            <div class="relative group nav-dropdown">
                <button type="button" aria-haspopup="true" aria-expanded="false" class="nav-dropdown-trigger @GetDropdownBtnClass(isCompendiumActive)">
                    <span>📚</span>
                    <span>Compendium</span>
                    <svg class="nav-dropdown-chevron w-3 h-3 text-slate-400 group-hover:text-amber-400 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                <div class="nav-dropdown-panel invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 absolute top-full left-0 mt-1.5 w-56 p-1.5 rounded-2xl bg-slate-900/95 border border-slate-700/90 shadow-2xl backdrop-blur-2xl transition-all duration-150 z-50 space-y-0.5">
                    <a asp-controller="Home" asp-action="Codex" class="@GetDropdownItemClass("/codex")">
                        <span>🦸</span>
                        <div class="flex flex-col min-w-0">
                            <span>Hero Codex</span>
                            <span class="text-[10px] text-slate-400 font-normal">All 128 heroes & abilities</span>
                        </div>
                    </a>
                    <a asp-controller="Home" asp-action="Items" class="@GetDropdownItemClass("/items")">
                        <span>📦</span>
                        <div class="flex flex-col min-w-0">
                            <span>Item Compendium</span>
                            <span class="text-[10px] text-slate-400 font-normal">Recipes, stats & passive FX</span>
                        </div>
                    </a>
                    <a asp-controller="Guide" asp-action="Index" class="@GetDropdownItemClass("/guides")">
                        <span>📜</span>
                        <div class="flex flex-col min-w-0">
                            <span>Hero Guides</span>
                            <span class="text-[10px] text-slate-400 font-normal">Community builds & leveling</span>
                        </div>
                    </a>
                    @if (isStaffUser)
                    {
                        <a href="/lore" class="@GetStaffDropdownItemClass("/lore")">
                            <span>📖</span>
                            <div class="flex flex-col min-w-0">
                                <div class="flex items-center gap-1.5">
                                    <span>Newerth Lore</span>
                                    <span class="text-[9px] px-1.5 py-0.2 rounded bg-purple-500/25 text-purple-200 border border-purple-400/40 font-bold uppercase tracking-wider">Staff</span>
                                </div>
                                <span class="text-[10px] text-purple-300/90 font-normal">Interactive comic archives</span>
                            </div>
                        </a>
                    }
                </div>
            </div>

            <!-- Dropdown 3: Armory & Store -->
            <div class="relative group nav-dropdown">
                <button type="button" aria-haspopup="true" aria-expanded="false" class="nav-dropdown-trigger @GetDropdownBtnClass(isArmoryActive)">
                    <span>🏪</span>
                    <span>Armory</span>
                    <svg class="nav-dropdown-chevron w-3 h-3 text-slate-400 group-hover:text-amber-400 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                <div class="nav-dropdown-panel invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 absolute top-full left-0 mt-1.5 w-56 p-1.5 rounded-2xl bg-slate-900/95 border border-slate-700/90 shadow-2xl backdrop-blur-2xl transition-all duration-150 z-50 space-y-0.5">
                    <a asp-controller="Store" asp-action="Index" class="@GetDropdownItemClass("/store")">
                        <span>✨</span>
                        <div class="flex flex-col min-w-0">
                            <span>Vanity Store</span>
                            <span class="text-[10px] text-slate-400 font-normal">Avatars, Taunts & Announcers</span>
                        </div>
                    </a>
                    <a href="/store?category=plinko" class="@GetDropdownItemClass("/store?category=plinko")">
                        <span>🎪</span>
                        <div class="flex flex-col min-w-0">
                            <span>Goblin Plinko</span>
                            <span class="text-[10px] text-slate-400 font-normal">Daily drop & coin rewards</span>
                        </div>
                    </a>
                    @if (isStaffUser)
                    {
                        <a asp-controller="Staff" asp-action="Inventory" class="@GetStaffDropdownItemClass("/staff/inventory")">
                            <span>🎒</span>
                            <div class="flex flex-col min-w-0">
                                <div class="flex items-center gap-1.5">
                                    <span>Inventory Management</span>
                                    <span class="text-[9px] px-1.5 py-0.2 rounded bg-purple-500/25 text-purple-200 border border-purple-400/40 font-bold uppercase tracking-wider">Staff</span>
                                </div>
                                <span class="text-[10px] text-purple-300/90 font-normal">Player vaults & cosmetic grants</span>
                            </div>
                        </a>
                    }
                </div>
            </div>

            <!-- Dropdown 4: AR Mini Games (Requires Discord Login) -->
