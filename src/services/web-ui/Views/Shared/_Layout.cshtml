<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toggleBtn = document.getElementById("mobile-menu-toggle");
        const mobileMenu = document.getElementById("mobile-menu");
        const hamburgerIcon = document.getElementById("hamburger-icon");
        const closeIcon = document.getElementById("close-icon");

        if (toggleBtn && mobileMenu) {
            toggleBtn.addEventListener("click", function () {
                const isHidden = mobileMenu.classList.contains("hidden");
                if (isHidden) {
                    mobileMenu.classList.remove("hidden");
                    toggleBtn.setAttribute("aria-expanded", "true");
                    if (hamburgerIcon) hamburgerIcon.classList.add("hidden");
                    if (closeIcon) closeIcon.classList.remove("hidden");
                } else {
                    mobileMenu.classList.add("hidden");
                    toggleBtn.setAttribute("aria-expanded", "false");
                    if (hamburgerIcon) hamburgerIcon.classList.remove("hidden");
                    if (closeIcon) closeIcon.classList.add("hidden");
                }
            });
        }

        // Global Navigation Search Script with Instant Client-Side Cache & Request Cancellation
        const globalSearchInput = document.getElementById("globalNavSearchInput");
        const globalSearchResults = document.getElementById("globalNavSearchResults");
        const globalSearchClear = document.getElementById("globalNavSearchClear");
        const globalSearchCache = new Map();
        let globalSearchAbortController = null;
        let globalDebounceTimer = null;
        let selectedSearchIndex = -1;

        const isMacPlatform = typeof navigator !== "undefined" && /Mac|iPhone|iPod|iPad/i.test(navigator.platform || navigator.userAgent);
        const shortcutBadgeEl = document.getElementById("globalSearchShortcutBadge");
        if (shortcutBadgeEl) {
            shortcutBadgeEl.textContent = isMacPlatform ? "⌘K" : "Ctrl+K";
        }
        if (globalSearchInput) {
            globalSearchInput.placeholder = isMacPlatform ? "Search Newerth... (⌘K)" : "Search Newerth... (Ctrl+K)";
        }

        function updateSearchHighlight(rows) {
            rows.forEach((row, idx) => {
                if (idx === selectedSearchIndex) {
                    row.classList.add("bg-amber-500/20", "border-amber-500/50", "ring-1", "ring-amber-400/60");
                    row.classList.remove("hover:bg-amber-500/10");
                    row.scrollIntoView({block: "nearest"});
                } else {
                    row.classList.remove("bg-amber-500/20", "border-amber-500/50", "ring-1", "ring-amber-400/60");
                    row.classList.add("hover:bg-amber-500/10");
                }
            });
        }

        function clearGlobalSearch() {
            if (globalSearchAbortController) {
                globalSearchAbortController.abort();
                globalSearchAbortController = null;
            }
            if (globalSearchInput) {
                globalSearchInput.value = "";
            }
            if (globalSearchClear) {
                globalSearchClear.classList.add("hidden");
            }
            if (globalSearchResults) {
                globalSearchResults.classList.add("hidden");
                globalSearchResults.innerHTML = "";
            }
            selectedSearchIndex = -1;
        }

        function toSafeRelativeUrl(rawUrl) {
            if (typeof rawUrl !== "string") return "#";
            const trimmed = rawUrl.trim();
            return trimmed.startsWith("/") && !trimmed.startsWith("//") ? trimmed : "#";
        }

        function renderSearchResults(data, query) {
            globalSearchResults.replaceChildren();
            selectedSearchIndex = -1;
            if (data && data.length > 0) {
                data.forEach(item => {
                    const row = document.createElement("a");
                    row.href = toSafeRelativeUrl(item.url);
                    const badgeLabel = String(item.badge || item.type || "RESULT").toUpperCase();
                    const isStaffPage = badgeLabel === "STAFF";
                    row.className = isStaffPage
                        ? "flex items-center justify-between px-3.5 py-2.5 bg-purple-950/35 hover:bg-purple-900/50 text-purple-100 hover:text-white transition-colors cursor-pointer border-b border-purple-500/25 last:border-0"
                        : "flex items-center justify-between px-3.5 py-2.5 hover:bg-amber-500/10 text-slate-200 hover:text-white transition-colors cursor-pointer border-b border-slate-800/60 last:border-0";

                    const fallbackIcon = item.type === "hero" ? "/images/heroes/default.png" :
                        item.type === "item" ? "/images/items/default.png" :
                            item.type === "store" ? (item.heroIcon || "/images/heroes/default.png") :
                                "/images/default-avatar.png";

                    const iconSrc = item.iconUrl || item.avatarUrl || item.icon || fallbackIcon;
                    const displayName = String(item.name || item.title || "Result");
                    const isPlayer = item.type === "player";
                    const imgShape = isPlayer ? "rounded-full border border-purple-500/40" : "rounded-xl border border-slate-700";

                    const badgeClass = isStaffPage ? "bg-purple-500/25 text-purple-200 border-purple-400/40" :
                        item.type === "clan" ? "bg-indigo-500/20 text-indigo-300 border-indigo-400/40" :
                        item.type === "hero" ? "bg-emerald-500/20 text-emerald-300 border-emerald-500/30" :
                        item.type === "item" ? "bg-sky-500/20 text-sky-300 border-sky-500/30" :
                            item.type === "store" ? "bg-amber-500/20 text-amber-300 border-amber-500/40" :
                                item.type === "page" ? "bg-cyan-500/20 text-cyan-300 border-cyan-500/30" :
                                    "bg-purple-500/20 text-purple-300 border-purple-500/30";

                    const leftWrap = document.createElement("div");
                    leftWrap.className = "flex items-center gap-3 min-w-0";

                    if (item.type === "clan") {
                        const crestBox = document.createElement("div");
                        crestBox.className = "w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-indigo-950/80 border border-indigo-500/45 text-indigo-200 flex items-center justify-center flex-shrink-0 shadow text-[10px] font-black tracking-tight px-0.5 truncate";
                        crestBox.textContent = "[" + String(item.icon || "CLN") + "]";
                        leftWrap.appendChild(crestBox);
                    } else if (item.type === "page") {
                        const pageBoxClass = isStaffPage
                            ? "bg-purple-950/80 border-purple-500/45 text-purple-200"
                            : "bg-cyan-950/80 border-cyan-500/40 text-cyan-300";
                        const pageBox = document.createElement("div");
                        pageBox.className = "w-7 h-7 sm:w-8 sm:h-8 rounded-xl " + pageBoxClass + " border flex items-center justify-center flex-shrink-0 shadow text-sm";
                        pageBox.setAttribute("aria-hidden", "true");
                        pageBox.textContent = String(item.icon || "📄");
                        leftWrap.appendChild(pageBox);
                    } else {
                        const img = document.createElement("img");
                        img.src = iconSrc;
                        img.alt = "";
                        img.className = "w-7 h-7 sm:w-8 sm:h-8 " + imgShape + " object-cover bg-slate-800 flex-shrink-0";
                        img.addEventListener("error", function () {
                            if (img.dataset.fallbackApplied) return;
                            img.dataset.fallbackApplied = "1";
                            img.src = fallbackIcon;
                        });
                        leftWrap.appendChild(img);
                    }

                    const textCol = document.createElement("div");
                    textCol.className = "flex flex-col min-w-0";

                    const nameSpan = document.createElement("span");
                    nameSpan.className = "font-bold text-xs sm:text-sm text-slate-100 truncate";
                    nameSpan.textContent = displayName;
                    textCol.appendChild(nameSpan);

                    if (item.subtitle) {
                        const subSpan = document.createElement("span");
                        subSpan.className = "text-[11px] text-slate-400 truncate";
                        subSpan.textContent = String(item.subtitle);
                        textCol.appendChild(subSpan);
                    }

                    leftWrap.appendChild(textCol);

                    const badgeSpan = document.createElement("span");
                    badgeSpan.className = "text-[9px] sm:text-[10px] font-black px-2 py-0.5 rounded-full border " + badgeClass + " uppercase tracking-wider flex-shrink-0 ml-2";
                    badgeSpan.textContent = badgeLabel;

                    row.append(leftWrap, badgeSpan);
                    row.addEventListener('click', function () {
                        globalSearchResults.classList.add("hidden");
                    });

                    globalSearchResults.appendChild(row);
                });
                globalSearchResults.classList.remove("hidden");
                selectedSearchIndex = 0;
                const rows = globalSearchResults.querySelectorAll("a");
                updateSearchHighlight(rows);
            } else {
                selectedSearchIndex = -1;
                const noResult = document.createElement("div");
                noResult.className = "px-4 py-3 text-xs text-slate-400 text-center";
                noResult.textContent = "No results found matching '" + query + "'";
                globalSearchResults.appendChild(noResult);
                globalSearchResults.classList.remove("hidden");
            }
        }

        if (globalSearchInput && globalSearchResults) {
            globalSearchInput.addEventListener("keydown", function (e) {
                const rows = globalSearchResults.querySelectorAll("a");
                const isVisible = !globalSearchResults.classList.contains("hidden") && rows.length > 0;

                if (e.key === "ArrowDown") {
                    if (!isVisible) return;
                    e.preventDefault();
                    selectedSearchIndex = (selectedSearchIndex + 1) % rows.length;
                    updateSearchHighlight(rows);
                } else if (e.key === "ArrowUp") {
                    if (!isVisible) return;
                    e.preventDefault();
                    selectedSearchIndex = selectedSearchIndex <= 0 ? rows.length - 1 : selectedSearchIndex - 1;
                    updateSearchHighlight(rows);
                } else if (e.key === "Enter") {
                    if (!isVisible) return;
                    e.preventDefault();
                    const targetIndex = selectedSearchIndex >= 0 && selectedSearchIndex < rows.length ? selectedSearchIndex : 0;
                    if (rows[targetIndex]) {
                        window.location.href = rows[targetIndex].href;
                    }
                } else if (e.key === "Escape") {
                    e.preventDefault();
                    e.stopPropagation();
                    if (globalSearchInput.value.length > 0) {
                        clearGlobalSearch();
                    } else {
                        clearGlobalSearch();
                        globalSearchInput.blur();
                    }
                }
            });

            globalSearchInput.addEventListener("input", function () {
                clearTimeout(globalDebounceTimer);
                selectedSearchIndex = -1;
                const query = globalSearchInput.value.trim();

                if (globalSearchClear) {
                    if (query.length > 0) globalSearchClear.classList.remove("hidden");
                    else globalSearchClear.classList.add("hidden");
                }

                if (query.length < 2) {
                    if (globalSearchAbortController) {
                        globalSearchAbortController.abort();
                        globalSearchAbortController = null;
                    }
                    globalSearchResults.classList.add("hidden");
                    globalSearchResults.innerHTML = "";
                    return;
                }

                // Instant cache hit: render immediately with 0ms delay!
                const cacheKey = query.toLowerCase();
                if (globalSearchCache.has(cacheKey)) {
                    renderSearchResults(globalSearchCache.get(cacheKey), query);
                    return;
                }

                globalDebounceTimer = setTimeout(() => {
                    if (globalSearchAbortController) {
                        globalSearchAbortController.abort();
                    }
                    globalSearchAbortController = new AbortController();

                    fetch("/api/global/search?q=" + encodeURIComponent(query), {signal: globalSearchAbortController.signal})
                        .then(res => res.json())
                        .then(data => {
                            globalSearchCache.set(cacheKey, data);
                            if (globalSearchInput.value.trim().toLowerCase() === cacheKey) {
                                renderSearchResults(data, query);
                            }
                        })
                        .catch(err => {
                            if (err.name !== 'AbortError') {
                                console.error("Global search error:", err);
                            }
                        });
                }, 120);
            });

            if (globalSearchClear) {
                globalSearchClear.addEventListener("click", function () {
                    globalSearchInput.value = "";
                    globalSearchResults.classList.add("hidden");
                    globalSearchResults.innerHTML = "";
                    globalSearchClear.classList.add("hidden");
                    selectedSearchIndex = -1;
                    globalSearchInput.focus();
                });
            }

            document.addEventListener("click", function (e) {
                if (!globalSearchInput.contains(e.target) && !globalSearchResults.contains(e.target)) {
                    globalSearchResults.classList.add("hidden");
                    selectedSearchIndex = -1;
                }
            });

            // Upgraded Double-Shift & Cmd+K Shortcut Handler
            // CRITICAL: Pushing and holding Shift is strictly prevented from triggering search
            let shiftPressStartTime = 0;
            let lastShiftTapReleaseTime = 0;

            function focusAndOpenGlobalSearch() {
                if (globalSearchInput) {
                    globalSearchInput.focus();
                    globalSearchInput.select();
                    globalSearchInput.scrollIntoView({behavior: 'smooth', block: 'nearest'});
                    if (globalSearchInput.value.trim().length >= 2 && globalSearchResults && globalSearchResults.children.length > 0) {
                        globalSearchResults.classList.remove("hidden");
                    }
                }
            }

            document.addEventListener("keydown", function (e) {
                // Ignore OS key-repeat events when holding keys down!
                if (e.repeat) return;

                // Cmd+K (Mac) or Ctrl+K (Windows/Linux)
                if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
                    e.preventDefault();
                    focusAndOpenGlobalSearch();
                    return;
                }

                if (e.key === "Shift") {
                    const now = Date.now();
                    // Only trigger if the previous Shift release was a quick tap within the last 350ms
                    if (now - lastShiftTapReleaseTime < 350 && lastShiftTapReleaseTime > 0) {
                        e.preventDefault();
                        focusAndOpenGlobalSearch();
                        lastShiftTapReleaseTime = 0;
                    } else {
                        shiftPressStartTime = now;
                    }
                } else if (e.key === "Escape") {
                    if (globalSearchInput) {
                        if (globalSearchInput.value.length > 0) {
                            clearGlobalSearch();
                        } else if (document.activeElement === globalSearchInput) {
                            clearGlobalSearch();
                            globalSearchInput.blur();
                        }
                    }
                }
            });

            document.addEventListener("keyup", function (e) {
                if (e.key === "Shift") {
                    const pressDuration = Date.now() - shiftPressStartTime;
                    // ONLY count as a tap if released quickly (< 250ms)
                    // If user pushed and held Shift (sprinting, caps, etc.), discard it!
                    if (pressDuration < 250 && shiftPressStartTime > 0) {
                        lastShiftTapReleaseTime = Date.now();
                    } else {
                        lastShiftTapReleaseTime = 0;
                    }
                    shiftPressStartTime = 0;
                }
            });
        }
    });
</script>

@if (isFullyOnboardedUser)
{
<!-- Floating Soundboard Quick Trigger -->
<button onclick="NexusSoundboard.openSoundboardModal()"
        title="Open HoN Announcer Soundboard"
        class="fixed bottom-6 right-6 z-40 px-3.5 py-3 rounded-2xl bg-slate-900/90 hover:bg-slate-800 border border-amber-500/40 text-amber-300 font-bold text-xs shadow-2xl shadow-amber-950/50 hover:scale-105 transition-all flex items-center gap-2 backdrop-blur-xl group">
    <span class="text-base group-hover:animate-bounce">🔊</span>
    <span class="hidden sm:inline">Soundboard</span>
</button>

<script src="~/js/soundboard.js" defer asp-append-version="true"></script>
<script src="~/js/brag_card_generator.js" defer asp-append-version="true"></script>
<script src="~/js/kongor-viewer-core.js" defer asp-append-version="true"></script>
@await Html.PartialAsync("_VanityBoothModal")
@await Html.PartialAsync("_StoreARModal")
<script>
    (() => {
        const loadedBundles = new Map();
        function loadKongorScriptOnce(src) {
            if (!loadedBundles.has(src)) {
                loadedBundles.set(src, new Promise((resolve, reject) => {
                    const s = document.createElement('script');
                    s.src = src;
                    s.onload = () => resolve();
                    s.onerror = (err) => { loadedBundles.delete(src); reject(err); };
                    document.head.appendChild(s);
                }));
            }
            return loadedBundles.get(src);
        }

        const vanityBundleUrl = '@Url.Content("~/js/vanity_booth_3d.js")';
        const storeArBundleUrl = '@Url.Content("~/js/store_ar.js")';

        window.VanityBooth3D = {
            __isLazyStub: true,
            openHero: async (...args) => {
                await loadKongorScriptOnce(vanityBundleUrl);
