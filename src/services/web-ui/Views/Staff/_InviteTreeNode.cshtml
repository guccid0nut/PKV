@model ASPIRE.Common.DTOs.InviteTreeNodeDto

<div class="p-3.5 sm:p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80 hover:border-slate-700 transition-all space-y-3">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center text-xs font-bold">
                ↳
            </span>
            <div>
                <div class="flex items-center gap-2">
                    <span class="font-bold text-white text-xs sm:text-sm">@(Model.MainAccountName ?? "No IGN")</span>
                    <span class="text-[10px] font-mono text-purple-300 px-1.5 py-0.5 rounded bg-purple-500/20">#@Model.UserId</span>
                    @if (Model.IsBanned)
                    {
                        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-300 border border-rose-500/40 uppercase">BANNED</span>
                    }
                    else
                    {
                        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 uppercase">ACTIVE</span>
                    }
                </div>
                <div class="text-[10px] text-slate-500 mt-0.5 flex flex-wrap items-center gap-2">
                    <span>Discord: @(Model.DiscordUsername ?? Model.DiscordId ?? "None")</span>
                    <span>•</span>
                    <span>@Model.TotalGames Matches</span>
                    <span>•</span>
                    <span>Joined @Model.CreatedAt.ToString("yyyy-MM-dd")</span>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2 self-end sm:self-auto">
            @if (Model.IsBanned && Model.MainAccountId.HasValue)
            {
                <form asp-controller="Staff" asp-action="UnbanAccount" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="accountId" value="@Model.MainAccountId.Value" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <button type="submit"
                            title="Instantly restore and unban this account"
                            class="px-2.5 py-1 rounded-lg bg-emerald-600/30 hover:bg-emerald-600/50 text-emerald-300 border border-emerald-500/40 font-bold text-[11px] transition-all cursor-pointer flex items-center gap-1">
                        <span>🕊️</span>
                        <span>Unban</span>
                    </button>
                </form>
            }

            <button type="button"
                    onclick="openPruneModal(@Model.UserId, '@(Model.MainAccountName ?? $"User {Model.UserId}")')"
                    class="px-2.5 py-1 rounded-lg bg-rose-600/20 hover:bg-rose-600/40 text-rose-300 border border-rose-500/30 font-bold text-[11px] transition-all cursor-pointer flex items-center gap-1">
                <span>✂️</span>
                <span>Prune Branch</span>
            </button>
        </div>
    </div>

    @if (Model.Invitees != null && Model.Invitees.Count > 0)
    {
        <div class="space-y-2 pl-3 sm:pl-4 border-l border-slate-700/60 mt-2">
            @foreach (var subChild in Model.Invitees)
            {
                @await Html.PartialAsync("_InviteTreeNode", subChild)
            }
        </div>
    }
</div>
