            <div class="flex items-center gap-2 overflow-x-auto text-[11px]">
                <span class="text-slate-500 font-bold uppercase tracking-wider shrink-0">Authentic Roster:</span>
                <div id="evidence-roster-list" class="flex items-center gap-1.5 flex-wrap"></div>
            </div>
        </div>

        <!-- Modal Body (Split: Voice Audio + Interactive Chat Log) -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">

            <!-- Voice Comms Player Card -->
            <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800 space-y-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-bold text-white flex items-center gap-1.5">
                            <span>🎧</span>
                            <span>In-Game Voice Comms (VoIP)</span>
                        </span>
                        <span
                            class="px-2 py-0.5 rounded text-[10px] font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">Dual-Channel</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <button type="button" id="btn-voice-team1" onclick="switchVoiceTeam(1)"
                                class="px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-600 text-white shadow-sm transition-all">
                            🛡️ Team 1 (Legion)
                        </button>
                        <button type="button" id="btn-voice-team2" onclick="switchVoiceTeam(2)"
                                class="px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-800 text-slate-400 hover:text-white transition-all">
                            ⚔️ Team 2 (Hellbourne)
                        </button>
                    </div>
                </div>

                <div class="space-y-2">
                    <audio id="evidence-audio-player" controls preload="metadata"
