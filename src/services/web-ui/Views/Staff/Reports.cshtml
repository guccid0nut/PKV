            </div>
            <div class="flex items-center gap-2">
                <div id="evidence-suggested-time-container" class="hidden">
                    <button type="button" id="evidence-suggested-time-btn"
                            class="px-3 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm">
                        <span>⏱️ Incident Mentioned:</span>
                        <span id="evidence-suggested-time-text" class="font-mono underline font-black">00:00</span>
                        <span class="text-[10px] text-amber-200/80">(Seek Audio)</span>
