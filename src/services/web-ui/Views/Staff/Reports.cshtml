            </div>
            <button onclick="closeEvidenceModal()" title="Close (Esc)"
                    class="w-9 h-9 rounded-xl bg-slate-800/80 hover:bg-slate-700 hover:text-white border border-slate-700/60 text-slate-400 flex items-center justify-center transition-all">
                ✕
            </button>
        </div>

        <!-- Evidence Meta Bar -->
        <div
            class="p-3.5 sm:px-6 bg-slate-950/40 border-b border-slate-800/60 flex flex-wrap items-center justify-between gap-3 shrink-0">
            <div class="flex flex-wrap items-center gap-2.5 text-xs font-semibold">
                <span class="text-slate-400">Target Player:</span>
                <span id="evidence-target-player"
                      class="text-rose-400 font-bold px-2 py-0.5 rounded bg-rose-500/10 border border-rose-500/30">Target</span>
                <span class="text-slate-600">•</span>
                <span class="text-slate-400">Map:</span>
                <span id="evidence-map-name" class="text-slate-200 capitalize">Caldavar</span>
                <span class="text-slate-600">•</span>
                <span class="text-slate-400">Duration:</span>
                <span id="evidence-duration" class="font-mono text-slate-200">00:00</span>
