                            </button>
                            <button type="button" onclick="seekAudioRelative(10)"
                                    class="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono">
                                +10s
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- In-Game Chat Console Card -->
            <div class="rounded-2xl bg-slate-950/70 border border-slate-800 overflow-hidden space-y-0">
                <!-- Chat Toolbar -->
                <div
                    class="p-3 bg-slate-950/90 border-b border-slate-800 flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5 overflow-x-auto">
                        <button type="button" onclick="setChatFilter('all')" id="filter-chat-all"
                                class="px-2.5 py-1 rounded-lg text-xs font-bold bg-purple-600 text-white transition-all">
                            All (<span id="chat-count-all">0</span>)
                        </button>
                        <button type="button" onclick="setChatFilter('target')" id="filter-chat-target"
                                class="px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-800 text-slate-400 hover:text-white transition-all">
                            🎯 Target Only (<span id="chat-count-target">0</span>)
                        </button>
                        <button type="button" onclick="setChatFilter('team')" id="filter-chat-team"
                                class="px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-800 text-slate-400 hover:text-white transition-all">
                            Team Comms
                        </button>
                        <button type="button" onclick="setChatFilter('global')" id="filter-chat-global"
                                class="px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-800 text-slate-400 hover:text-white transition-all">
                            All Chat
                        </button>
                    </div>
                    <div class="relative min-w-[180px]">
                        <input type="text" id="chat-search-input" oninput="applyChatFilters()"
                               placeholder="Filter chat messages..."
                               class="w-full px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-700 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-purple-500">
                    </div>
                </div>

                <!-- Chat Messages List -->
                <div id="chat-messages-container"
                     class="p-3 divide-y divide-slate-800/60 max-h-72 overflow-y-auto font-sans text-xs space-y-1">
