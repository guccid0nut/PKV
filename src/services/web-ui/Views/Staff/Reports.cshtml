                </div>
            </div>
        </div>

        <!-- Modal Footer -->
        <div
            class="p-4 sm:p-5 border-t border-slate-800 bg-slate-950/80 flex flex-wrap items-center justify-between gap-3 shrink-0">
            <div class="text-xs text-slate-400">
                <span>Case Reference: </span>
                <span id="evidence-report-ref" class="font-mono text-purple-300 font-bold">#0</span>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" onclick="closeEvidenceModal()"
                        class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs transition-all">
                    Close
                </button>
                <button type="button" id="evidence-open-judge-btn"
                        class="px-4 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-xs shadow-md shadow-purple-600/30 transition-all flex items-center gap-1.5">
                    <span>⚡ Apply Judgment</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentEvidenceData = null;
    let currentChatFilter = 'all';

    async function openEvidenceModal(matchId, reportedPlayer, reportId) {
        const modal = document.getElementById('match-evidence-modal');
        document.getElementById('evidence-match-id').textContent = '#' + matchId;
        document.getElementById('evidence-target-player').textContent = reportedPlayer || "Unknown";
        document.getElementById('evidence-report-ref').textContent = reportId ? '#' + reportId : "Direct";

        const judgeBtn = document.getElementById('evidence-open-judge-btn');
        if (judgeBtn && reportId) {
            judgeBtn.onclick = function () {
                closeEvidenceModal();
                const targetRow = document.getElementById('report-row-' + reportId);
                if (targetRow) {
                    const rowJudgeBtn = targetRow.querySelector('button[onclick*="openJudgmentModal"]');
                    if (rowJudgeBtn) rowJudgeBtn.click();
                }
            };
        }

        modal.classList.remove('hidden');
        document.getElementById('chat-messages-container').innerHTML = '<div class="text-center py-10 text-slate-400 animate-pulse">📡 Extracting in-game chat and audio stream telemetry...</div>';

        try {
            const res = await fetch(`/staff/matches/${matchId}/evidence?reportedAccountName=${encodeURIComponent(reportedPlayer || "")}`, {
                headers: {"Accept": "application/json", "X-Requested-With": "XMLHttpRequest", "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""}
            });

            if (!res.ok) {
                document.getElementById('chat-messages-container').innerHTML = '<div class="text-center py-8 text-rose-400">Failed to load match evidence. (Status ' + res.status + ')</div>';
                return;
            }

            const data = await res.json();
            renderEvidenceData(data);
        } catch (err) {
            console.error("Error loading match evidence:", err);
            document.getElementById('chat-messages-container').innerHTML = '<div class="text-center py-8 text-rose-400">Error connecting to replay evidence service.</div>';
        }
    }

    function renderEvidenceData(data) {
        currentEvidenceData = data;

        document.getElementById('evidence-map-name').textContent = data.mapName || "Caldavar";
        document.getElementById('evidence-duration').textContent = data.formattedDuration || "00:00";

        // Update Source Badge
        const sourceBadge = document.getElementById('evidence-source-badge');
        if (sourceBadge) {
            if (data.evidenceSource === 'replay_archive') {
                const sizeStr = data.replayFileSize ? ` • ${formatBytes(data.replayFileSize)}` : '';
                sourceBadge.className = "px-2.5 py-0.5 rounded text-[11px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-sm";
                sourceBadge.innerHTML = `🟢 Authentic .honreplay (${data.replayFileName || "Archive"}${sizeStr})`;
            } else {
                sourceBadge.className = "px-2.5 py-0.5 rounded text-[11px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 shadow-sm";
                sourceBadge.innerHTML = `🟡 Telemetry Simulation (No Replay File)`;
            }
        }

        // Update Roster List
        const rosterContainer = document.getElementById('evidence-roster-container');
        const rosterList = document.getElementById('evidence-roster-list');
        if (rosterContainer && rosterList) {
            if (data.rosterPlayers && data.rosterPlayers.length > 0) {
                rosterContainer.classList.remove('hidden');
                rosterList.innerHTML = data.rosterPlayers.map(p => `<span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700 font-semibold">${escapeHtml(p)}</span>`).join('');
            } else {
                rosterContainer.classList.add('hidden');
            }
        }

        const suggestedContainer = document.getElementById('evidence-suggested-time-container');
        if (data.suggestedTimestampFormatted) {
            suggestedContainer.classList.remove('hidden');
            document.getElementById('evidence-suggested-time-text').textContent = data.suggestedTimestampFormatted;
            document.getElementById('evidence-suggested-time-btn').onclick = function () {
                const sec = Math.floor((data.suggestedTimestampMs || 0) / 1000);
                seekVoiceAudio(sec);
            };
        } else {
            suggestedContainer.classList.add('hidden');
        }

        switchVoiceTeam(1);
        applyChatFilters();
    }

    async function triggerReExtraction() {
        if (!currentEvidenceData) return;
        const btn = document.getElementById('btn-re-extract');
        const matchId = currentEvidenceData.matchId || currentEvidenceData.matchID;
        const reportedPlayer = currentEvidenceData.reportedAccountName || "";

        btn.disabled = true;
        btn.innerHTML = '<span>⏳ Extracting...</span>';
        document.getElementById('chat-messages-container').innerHTML = '<div class="text-center py-10 text-slate-400 animate-pulse">🔄 Re-scanning server storage and parsing .honreplay packet stream...</div>';

        try {
            const res = await fetch(`/staff/matches/${matchId}/evidence/extract?reportedAccountName=${encodeURIComponent(reportedPlayer)}`, {
                method: "POST",
                headers: {"Accept": "application/json", "X-Requested-With": "XMLHttpRequest", "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""}
            });
            if (res.ok) {
                const data = await res.json();
                renderEvidenceData(data);
            } else {
                alert("Failed to re-extract replay data (Status " + res.status + ")");
            }
        } catch (err) {
            console.error("Re-extraction error:", err);
            alert("Error during re-extraction");
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<span>🔄 Re-Extract</span>';
        }
    }

    async function handleReplayFileUpload(event) {
        if (!currentEvidenceData || !event.target.files || event.target.files.length === 0) return;
        const file = event.target.files[0];
        const matchId = currentEvidenceData.matchId || currentEvidenceData.matchID;
        const reportedPlayer = currentEvidenceData.reportedAccountName || "";

        const formData = new FormData();
        formData.append("replayFile", file);

        document.getElementById('chat-messages-container').innerHTML = `<div class="text-center py-10 text-cyan-300 animate-pulse">📂 Uploading and extracting genuine replay archive (${escapeHtml(file.name)})...</div>`;

        try {
            const res = await fetch(`/staff/matches/${matchId}/evidence/extract?reportedAccountName=${encodeURIComponent(reportedPlayer)}`, {
                method: "POST",
                body: formData,
                headers: {"Accept": "application/json", "X-Requested-With": "XMLHttpRequest", "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""}
            });
            if (res.ok) {
                const data = await res.json();
                renderEvidenceData(data);
            } else {
                alert("Failed to extract uploaded replay (Status " + res.status + ")");
            }
        } catch (err) {
            console.error("Upload error:", err);
            alert("Error uploading replay file");
        } finally {
            event.target.value = "";
        }
    }

    function formatBytes(bytes, decimals = 1) {
        if (!bytes || bytes === 0) return '0 B';
        const k = 1024;
        const dm = decimals < 0 ? 0 : decimals;
        const sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
    }

    function closeEvidenceModal() {
        const modal = document.getElementById('match-evidence-modal');
        modal.classList.add('hidden');
        const audio = document.getElementById('evidence-audio-player');
        if (audio) {
            audio.pause();
            audio.src = "";
        }
    }

    function handleEvidenceBackdropClick(e) {
        if (e.target.id === 'match-evidence-modal') {
            closeEvidenceModal();
        }
    }

    function switchVoiceTeam(team) {
        if (!currentEvidenceData) return;
        const btn1 = document.getElementById('btn-voice-team1');
        const btn2 = document.getElementById('btn-voice-team2');
        const audio = document.getElementById('evidence-audio-player');

        if (team === 1) {
            btn1.className = "px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-600 text-white shadow-sm transition-all";
            btn2.className = "px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-800 text-slate-400 hover:text-white transition-all";
            if (currentEvidenceData.voiceTrackLegionUrl) {
                audio.src = currentEvidenceData.voiceTrackLegionUrl;
            }
        } else {
            btn2.className = "px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-600 text-white shadow-sm transition-all";
            btn1.className = "px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-800 text-slate-400 hover:text-white transition-all";
            if (currentEvidenceData.voiceTrackHellbourneUrl) {
                audio.src = currentEvidenceData.voiceTrackHellbourneUrl;
            }
        }
    }

    function seekVoiceAudio(seconds) {
        const audio = document.getElementById('evidence-audio-player');
        if (audio) {
            audio.currentTime = seconds;
            audio.play().catch(() => {
            });
        }
    }

    function seekAudioRelative(delta) {
        const audio = document.getElementById('evidence-audio-player');
        if (audio) {
            audio.currentTime = Math.max(0, audio.currentTime + delta);
        }
    }

    function setChatFilter(filter) {
        currentChatFilter = filter;
        const buttons = {
            'all': document.getElementById('filter-chat-all'),
            'target': document.getElementById('filter-chat-target'),
            'team': document.getElementById('filter-chat-team'),
            'global': document.getElementById('filter-chat-global')
        };
        for (const [key, btn] of Object.entries(buttons)) {
            if (!btn) continue;
            if (key === filter) {
                btn.className = "px-2.5 py-1 rounded-lg text-xs font-bold bg-purple-600 text-white transition-all";
            } else {
                btn.className = "px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-800 text-slate-400 hover:text-white transition-all";
            }
        }
        applyChatFilters();
    }

    function applyChatFilters() {
        if (!currentEvidenceData || !currentEvidenceData.chatLog) return;
        const query = (document.getElementById('chat-search-input').value || "").toLowerCase().trim();
        const chatLog = currentEvidenceData.chatLog;

        const targetCount = chatLog.filter(c => c.isReportedPlayer).length;
        document.getElementById('chat-count-all').textContent = chatLog.length;
        document.getElementById('chat-count-target').textContent = targetCount;

        let filtered = chatLog.filter(msg => {
            if (currentChatFilter === 'target' && !msg.isReportedPlayer) return false;
            if (currentChatFilter === 'team' && msg.channel !== 'TEAM') return false;
            if (currentChatFilter === 'global' && msg.channel !== 'ALL') return false;
            if (query && !msg.message.toLowerCase().includes(query) && !msg.playerName.toLowerCase().includes(query)) return false;
            return true;
        });

        const container = document.getElementById('chat-messages-container');
        if (filtered.length === 0) {
            container.innerHTML = '<div class="text-center py-8 text-slate-500">No chat messages match the selected filters.</div>';
            return;
        }

        container.innerHTML = filtered.map(msg => {
            const sec = Math.floor(msg.timestampMs / 1000);
            const isTarget = msg.isReportedPlayer;
            const targetBadge = isTarget ? '<span class="px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30 text-[10px] font-bold">🎯 Reported</span>' : '';
            const channelBadge = msg.channel === 'ALL'
                ? '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">[ALL]</span>'
                : (msg.team === 1
                    ? '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">[LEGION]</span>'
                    : '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-rose-500/15 text-rose-300 border border-rose-500/30">[HELLBOURNE]</span>');

            const rowStyle = isTarget ? 'bg-rose-950/25 border border-rose-500/30 shadow-sm' : 'hover:bg-slate-900/60';

            return `
                <div class="p-2 rounded-xl flex items-start gap-2.5 transition-all ${rowStyle}">
                    <button type="button" onclick="seekVoiceAudio(${sec})" title="Click to seek voice audio to ${msg.formattedTime}" class="px-2 py-0.5 rounded-lg bg-slate-800 hover:bg-purple-600 text-slate-300 hover:text-white font-mono text-[11px] font-bold transition-all shrink-0">
                        ⏱️ ${msg.formattedTime}
                    </button>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            ${channelBadge}
                            <span class="font-bold text-slate-200">${escapeHtml(msg.playerName)}</span>
                            ${targetBadge}
                        </div>
                        <div class="text-slate-300 mt-1 text-xs break-words">${escapeHtml(msg.message)}</div>
                    </div>
                </div>
            `;
        }).join('');
    }

    function escapeHtml(text) {
        if (!text) return "";
        return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    function openJudgmentModal(reportId, targetPlayer, reporter, reason, description, matchId) {
        document.getElementById('form-report-id').value = reportId;
        document.getElementById('modal-report-id').textContent = '#' + reportId;
        document.getElementById('modal-target-player').textContent = targetPlayer;
        document.getElementById('modal-reporter-player').textContent = reporter;
        document.getElementById('modal-reason').textContent = reason;
        document.getElementById('modal-description').textContent = description || "(No comment provided)";
        document.getElementById('judgment-notes').value = reason ? `Disciplinary action for: ${reason}` : "";

        const matchContainer = document.getElementById('modal-match-container');
        if (matchId) {
            matchContainer.innerHTML = `<span class="text-xs">⚔️</span><a href="/matches/${matchId}" target="_blank" class="font-mono font-bold text-xs text-cyan-400 hover:underline">#${matchId}</a>`;
        } else {
            matchContainer.innerHTML = `<span class="text-xs">⚔️</span><span class="font-mono font-bold text-xs text-slate-500">N/A</span>`;
        }

        const muteRadio = document.querySelector('input[name="judgmentAction"][value="MUTE"]');
        if (muteRadio) muteRadio.checked = true;
        handleActionChange('MUTE');

        const durationSelect = document.getElementById('duration-select');
        if (durationSelect) durationSelect.value = "24";
        updateDurationPreview();

        const modal = document.getElementById('judgment-modal');
        modal.classList.remove('hidden');
    }

    function closeJudgmentModal() {
        const modal = document.getElementById('judgment-modal');
        modal.classList.add('hidden');
    }

    function handleBackdropClick(e) {
        if (e.target.id === 'judgment-modal') {
            closeJudgmentModal();
        }
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            const judgeModal = document.getElementById('judgment-modal');
            if (judgeModal && !judgeModal.classList.contains('hidden')) {
                closeJudgmentModal();
            }
            const evidenceModal = document.getElementById('match-evidence-modal');
            if (evidenceModal && !evidenceModal.classList.contains('hidden')) {
                closeEvidenceModal();
            }
        }
    });

    function handleActionChange(action) {
        const durationContainer = document.getElementById('duration-container');
        if (action === 'DISMISS') {
            durationContainer.style.display = 'none';
        } else {
            durationContainer.style.display = 'block';
            updateDurationPreview();
        }
    }

    function updateDurationPreview() {
        const durationSelect = document.getElementById('duration-select');
        const preview = document.getElementById('duration-calculated-preview');
        if (!durationSelect || !preview) return;

        const hours = parseInt(durationSelect.value, 10);
        if (hours >= 800000) {
            preview.textContent = "Permanent sanction (indefinite duration)";
            return;
        }

        const targetDate = new Date(Date.now() + hours * 3600 * 1000);
        preview.textContent = `Expires on ${targetDate.toLocaleDateString(undefined, {
            month: 'short',
            day: 'numeric',
            year: 'numeric'
        })} at ${targetDate.toLocaleTimeString(undefined, {hour: '2-digit', minute: '2-digit'})}`;
    }

    async function submitJudgment(e) {
        e.preventDefault();
        const form = document.getElementById('judgment-form');
        const reportId = document.getElementById('form-report-id').value;
        const formData = new FormData(form);

        const submitBtn = document.getElementById('submit-judgment-btn');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>⏳ Applying Judgment...</span>';

        try {
            const res = await fetch(`/staff/reports/${reportId}/judge`, {
                method: "POST",
                body: formData,
                headers: {
                    "X-Requested-With": "XMLHttpRequest",
                    "Accept": "application/json"
                }
            });

            if (res.ok) {
                const data = await res.json();
                if (data.success) {
                    closeJudgmentModal();
                    location.reload();
                } else {
                    alert(data.message || "Failed to apply judgment");
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<span>⚡ Apply Judgment</span>';
                }
            } else {
                alert("Action failed with status: " + res.status);
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<span>⚡ Apply Judgment</span>';
            }
        } catch (err) {
            console.error("Failed to submit judgment", err);
            alert("Error submitting judgment");
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>⚡ Apply Judgment</span>';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const urlParams = new URLSearchParams(window.location.search);
        const queryParam = urlParams.get('query') || urlParams.get('reportId');
        const openJudge = urlParams.get('openJudge') === 'true';
        let targetId = @(Model.ReportIdFilter.HasValue ? Model.ReportIdFilter.Value.ToString() : "null");

        if (!targetId && queryParam) {
            const clean = queryParam.trim().replace(/^#/, '');
            if (/^\d+$/.test(clean)) {
                targetId = clean;
            }
        }
        if (!targetId) {
            const pathMatch = window.location.pathname.match(/\/staff\/reports\/(\d+)/i);
            if (pathMatch) {
                targetId = pathMatch[1];
            }
        }
        if (!targetId && window.location.hash) {
            const hashMatch = window.location.hash.match(/report-row-(\d+)/);
            if (hashMatch) {
                targetId = hashMatch[1];
            }
        }

        if (targetId) {
            const targetRow = document.getElementById('report-row-' + targetId);
            if (targetRow) {
                targetRow.scrollIntoView({behavior: 'smooth', block: 'center'});
                targetRow.classList.add('bg-purple-900/50', 'ring-2', 'ring-purple-400', 'shadow-2xl', 'shadow-purple-950/80');

                if (openJudge || @(Model.ReportIdFilter.HasValue ? "true" : "false")) {
                    const judgeBtn = targetRow.querySelector('button[onclick*="openJudgmentModal"]');
                    if (judgeBtn) {
                        setTimeout(() => judgeBtn.click(), 300);
                    }
                }
            }
        }
    });
</script>
