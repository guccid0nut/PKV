@model LoreComicDetailDto
@{
    var isNew = ViewBag.IsNew is true;
    ViewData["Title"] = isNew ? "Create New Comic - Staff Portal" : $"Edit Comic #{Model.ID} - Staff Portal";
    var arcs = ViewBag.Arcs as IReadOnlyList<LoreArcDto> ?? [];
    var staffMetrics = ViewBag.StaffMetrics as LoreRatingMetricDto;
}

<div class="min-h-screen pb-20 text-slate-100 max-w-5xl mx-auto">
    @Html.AntiForgeryToken()

    <div class="flex items-center justify-between gap-4 mb-8">
        <div>
            <div class="text-xs font-bold uppercase tracking-wider text-purple-400 mb-1">
                <a asp-action="LoreManagement" class="hover:underline">← Staff Lore Management</a>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-white">
                @(isNew ? "Create New Comic Issue" : $"Edit: {Model.Title}")
            </h1>
        </div>
        <div class="flex items-center gap-3">
            @if (!isNew)
            {
                <button id="btn-delete-comic" type="button"
                        class="px-4 py-2 rounded-xl bg-red-950/60 hover:bg-red-900 border border-red-500/40 text-red-300 text-xs font-bold transition-all">
                    <i class="fa-solid fa-trash"></i> Delete
                </button>
            }
            <button id="btn-save-comic" type="button"
                    class="px-6 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-black shadow-lg shadow-purple-900/40 transition-all">
                <i class="fa-solid fa-floppy-disk"></i> Save Comic
            </button>
        </div>
    </div>

    <!-- Metadata Card -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900/80 p-6 mb-8 space-y-4">
        <h2 class="text-base font-bold text-white mb-2 flex items-center gap-2">
            <span>📝</span> Issue Metadata
        </h2>

        <input type="hidden" id="comic-id" value="@(isNew ? "" : Model.ID.ToString())"/>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="sm:col-span-2">
                <label class="block text-xs font-bold text-slate-300 mb-1">Comic Title</label>
                <input type="text" id="comic-title" value="@Model.Title"
                       class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2 text-xs font-semibold text-white focus:border-purple-500 focus:outline-none"
                       placeholder="e.g. Whispers in the Ironwood"/>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1">URL Slug</label>
                <input type="text" id="comic-slug" value="@Model.Slug"
                       class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2 text-xs font-mono text-purple-300 focus:border-purple-500 focus:outline-none"
                       placeholder="e.g. whispers-in-the-ironwood"/>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1">Story Arc / Saga</label>
                <select id="comic-arc-id"
                        class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2 text-xs font-semibold text-white focus:border-purple-500 focus:outline-none">
                    @foreach (var arc in arcs)
                    {
                        <option value="@arc.ID" selected="@(Model.ArcID == arc.ID)">@arc.Title</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1">Issue Number</label>
                <input type="number" id="comic-issue-num" value="@(isNew ? 1 : Model.IssueNumber)" min="1"
                       class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2 text-xs font-semibold text-white focus:border-purple-500 focus:outline-none"/>
            </div>
            <div class="flex items-center gap-3 pt-5">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="comic-is-published"
                           class="w-4 h-4 rounded text-purple-600 bg-slate-950 border-slate-700 focus:ring-0"
                           @(Model.IsPublished || isNew ? "checked" : "")/>
                    <span class="text-xs font-bold text-white">Publish Immediately</span>
                </label>
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Synopsis & Story Summary</label>
            <textarea id="comic-synopsis" rows="3"
                      class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2 text-xs text-white focus:border-purple-500 focus:outline-none"
                      placeholder="Detailed synopsis of the issue...">@Model.Synopsis</textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1">Cover Image URL</label>
                <input type="text" id="comic-cover-url" value="@Model.CoverImageUrl"
                       class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2 text-xs font-mono text-white focus:border-purple-500 focus:outline-none"
                       placeholder="/images/lore/comics/issue-1/cover.webp"/>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-300 mb-1">Cinematic Video URL (Optional 3D
                    Short)</label>
                <input type="text" id="comic-video-url" value="@Model.CinematicVideoUrl"
                       class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2 text-xs font-mono text-amber-300 focus:border-purple-500 focus:outline-none"
                       placeholder="https://cdn.projectkongor.com/cinematics/short-1.mp4"/>
            </div>
        </div>
    </div>

    <!-- Production Credits Manager -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900/80 p-6 mb-8">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
                <span>🎨</span> Creative Credits & Author Attribution
            </h2>
            <button id="btn-add-credit" type="button"
                    class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-purple-300 text-xs font-bold border border-purple-500/20">
                <i class="fa-solid fa-plus"></i> Add Contributor
            </button>
        </div>

        <div id="credits-list" class="space-y-3">
            @if (Model.Credits.Count == 0)
            {
                <div
                    class="credit-row grid grid-cols-1 sm:grid-cols-12 gap-3 p-3 bg-slate-950/60 rounded-xl border border-slate-800">
                    <div class="sm:col-span-4">
                        <label class="text-[10px] uppercase font-bold text-slate-400">Role</label>
                        <input type="text"
                               class="credit-role w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white"
                               value="Story & Lore"/>
                    </div>
                    <div class="sm:col-span-4">
                        <label class="text-[10px] uppercase font-bold text-slate-400">Account In-Game Name</label>
                        <input type="text"
                               class="credit-account-name w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white"
                               placeholder="KongorStaff"/>
                    </div>
                    <div class="sm:col-span-3">
                        <label class="text-[10px] uppercase font-bold text-slate-400">Display Override
                            (Optional)</label>
                        <input type="text"
                               class="credit-override w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white"
                               placeholder="Custom pen name"/>
                    </div>
                    <div class="sm:col-span-1 flex items-end justify-center">
                        <button type="button" class="btn-remove-credit p-2 text-red-400 hover:text-red-300"><i
                                class="fa-solid fa-trash"></i></button>
                    </div>
                </div>
            }
            else
            {
                @foreach (var credit in Model.Credits)
                {
                    <div
                        class="credit-row grid grid-cols-1 sm:grid-cols-12 gap-3 p-3 bg-slate-950/60 rounded-xl border border-slate-800">
                        <div class="sm:col-span-4">
                            <label class="text-[10px] uppercase font-bold text-slate-400">Role</label>
                            <input type="text"
                                   class="credit-role w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white"
                                   value="@credit.Role"/>
                        </div>
                        <div class="sm:col-span-4">
                            <label class="text-[10px] uppercase font-bold text-slate-400">Account In-Game Name</label>
                            <input type="text"
                                   class="credit-account-name w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white"
                                   value="@credit.AccountName" placeholder="KongorStaff"/>
                        </div>
                        <div class="sm:col-span-3">
                            <label class="text-[10px] uppercase font-bold text-slate-400">Display Override</label>
                            <input type="text"
                                   class="credit-override w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white"
                                   value="@credit.CustomNameOverride"/>
                        </div>
                        <div class="sm:col-span-1 flex items-end justify-center">
                            <button type="button" class="btn-remove-credit p-2 text-red-400 hover:text-red-300"><i
                                    class="fa-solid fa-trash"></i></button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Comic Pages / Slices Manager -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900/80 p-6 mb-8">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
                <span>📄</span> Comic Pages & Slices (<span id="pages-count">@Model.Pages.Count</span>)
            </h2>
            <button id="btn-add-page" type="button"
                    class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-purple-300 text-xs font-bold border border-purple-500/20">
                <i class="fa-solid fa-plus"></i> Add Page
            </button>
        </div>

        <div id="pages-list" class="space-y-4">
            @for (var pIdx = 0; pIdx < Model.Pages.Count; pIdx++)
            {
                var comicPage = Model.Pages[pIdx];
                <div
                    class="page-row p-4 bg-slate-950/60 rounded-xl border border-slate-800 grid grid-cols-1 sm:grid-cols-12 gap-4 items-start">
                    <div class="sm:col-span-1 text-center pt-2 font-bold text-purple-400">
                        #<span class="page-num">@(pIdx + 1)</span>
                    </div>
                    <div class="sm:col-span-6 space-y-2">
                        <label class="text-[10px] uppercase font-bold text-slate-400">Image WebP URL</label>
                        <input type="text"
                               class="page-img-url w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white font-mono"
                               value="@comicPage.ImageUrl"/>
                    </div>
                    <div class="sm:col-span-4 space-y-2">
                        <label class="text-[10px] uppercase font-bold text-slate-400">Dialogue Transcript / Alt
                            Text</label>
                        <input type="text"
                               class="page-transcript w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white"
                               value="@comicPage.DialogueTranscript" placeholder="Panel dialogue..."/>
                    </div>
                    <div class="sm:col-span-1 pt-6 text-center">
                        <button type="button" class="btn-remove-page p-2 text-red-400 hover:text-red-300"><i
                                class="fa-solid fa-trash"></i></button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const btnSave = document.getElementById('btn-save-comic');
        const btnDelete = document.getElementById('btn-delete-comic');
        const btnAddCredit = document.getElementById('btn-add-credit');
        const btnAddPage = document.getElementById('btn-add-page');
        const creditsList = document.getElementById('credits-list');
        const pagesList = document.getElementById('pages-list');

        // Add credit row
        btnAddCredit.addEventListener('click', () => {
            const row = document.createElement('div');
            row.className = 'credit-row grid grid-cols-1 sm:grid-cols-12 gap-3 p-3 bg-slate-950/60 rounded-xl border border-slate-800';
            row.innerHTML = `
                <div class="sm:col-span-4">
                    <label class="text-[10px] uppercase font-bold text-slate-400">Role</label>
                    <input type="text" class="credit-role w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white" value="Illustrator" />
                </div>
                <div class="sm:col-span-4">
                    <label class="text-[10px] uppercase font-bold text-slate-400">Account In-Game Name</label>
                    <input type="text" class="credit-account-name w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white" placeholder="KongorArtist" />
                </div>
                <div class="sm:col-span-3">
                    <label class="text-[10px] uppercase font-bold text-slate-400">Display Override</label>
                    <input type="text" class="credit-override w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white" />
                </div>
                <div class="sm:col-span-1 flex items-end justify-center">
                    <button type="button" class="btn-remove-credit p-2 text-red-400 hover:text-red-300"><i class="fa-solid fa-trash"></i></button>
                </div>
            `;
            creditsList.appendChild(row);
        });

        // Add page row
        btnAddPage.addEventListener('click', () => {
            const count = pagesList.querySelectorAll('.page-row').length + 1;
            const row = document.createElement('div');
            row.className = 'page-row p-4 bg-slate-950/60 rounded-xl border border-slate-800 grid grid-cols-1 sm:grid-cols-12 gap-4 items-start';
            row.innerHTML = `
                <div class="sm:col-span-1 text-center pt-2 font-bold text-purple-400">
                    #<span class="page-num">${count}</span>
                </div>
                <div class="sm:col-span-6 space-y-2">
                    <label class="text-[10px] uppercase font-bold text-slate-400">Image WebP URL</label>
                    <input type="text" class="page-img-url w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white font-mono" value="/images/lore/comics/page-${count}.webp" />
                </div>
                <div class="sm:col-span-4 space-y-2">
                    <label class="text-[10px] uppercase font-bold text-slate-400">Dialogue Transcript / Alt Text</label>
                    <input type="text" class="page-transcript w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white" placeholder="Panel dialogue..." />
                </div>
                <div class="sm:col-span-1 pt-6 text-center">
                    <button type="button" class="btn-remove-page p-2 text-red-400 hover:text-red-300"><i class="fa-solid fa-trash"></i></button>
                </div>
            `;
            pagesList.appendChild(row);
        });

        // Remove row delegations
        document.addEventListener('click', (e) => {
            if (e.target.closest('.btn-remove-credit')) {
                e.target.closest('.credit-row')?.remove();
            }
            if (e.target.closest('.btn-remove-page')) {
                e.target.closest('.page-row')?.remove();
                renumberPages();
            }
        });

        function renumberPages() {
            const rows = pagesList.querySelectorAll('.page-row');
            rows.forEach((r, idx) => {
                const numSpan = r.querySelector('.page-num');
                if (numSpan) numSpan.textContent = (idx + 1).toString();
            });
            const cntSpan = document.getElementById('pages-count');
            if (cntSpan) cntSpan.textContent = rows.length.toString();
        }

        // Save Comic
        btnSave.addEventListener('click', async () => {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const comicIdVal = document.getElementById('comic-id').value;
            const id = comicIdVal ? parseInt(comicIdVal, 10) : null;
            const arcId = parseInt(document.getElementById('comic-arc-id').value, 10);
            const title = document.getElementById('comic-title').value.trim();
            const slug = document.getElementById('comic-slug').value.trim();
            const issueNum = parseInt(document.getElementById('comic-issue-num').value, 10);
            const synopsis = document.getElementById('comic-synopsis').value.trim();
            const coverUrl = document.getElementById('comic-cover-url').value.trim();
            const videoUrl = document.getElementById('comic-video-url').value.trim() || null;
            const isPub = document.getElementById('comic-is-published').checked;

            const credits = [];
            document.querySelectorAll('.credit-row').forEach((cr, idx) => {
                const role = cr.querySelector('.credit-role')?.value.trim();
                const accName = cr.querySelector('.credit-account-name')?.value.trim();
                const override = cr.querySelector('.credit-override')?.value.trim();
                if (role) {
                    credits.push({
                        role: role,
                        accountName: accName || null,
                        customNameOverride: override || null,
                        orderIndex: idx
                    });
                }
            });

            const pages = [];
            document.querySelectorAll('.page-row').forEach((p, idx) => {
                const img = p.querySelector('.page-img-url')?.value.trim();
                const transcript = p.querySelector('.page-transcript')?.value.trim();
                if (img) {
                    pages.push({
                        pageNumber: idx + 1,
                        imageUrl: img,
                        dialogueTranscript: transcript || null
                    });
                }
            });

            const payload = {
                id: id,
                arcId: arcId,
                title: title,
                slug: slug,
                issueNumber: issueNum,
                synopsis: synopsis,
                coverImageUrl: coverUrl,
                cinematicVideoUrl: videoUrl,
                isPublished: isPub,
                credits: credits,
                pages: pages
            };

            btnSave.disabled = true;
            btnSave.textContent = "Saving...";

            try {
                const resp = await fetch('/staff/lore/comic/save', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                });
                const data = await resp.json();
                if (resp.ok && data.success) {
                    window.location.href = '/staff/lore';
                } else {
                    alert("Error saving comic: " + (data.message || "Unknown error"));
                    btnSave.disabled = false;
                    btnSave.textContent = "Save Comic";
                }
            } catch (err) {
                alert("Network error saving comic: " + err);
                btnSave.disabled = false;
                btnSave.textContent = "Save Comic";
            }
        });

        // Delete Comic
        btnDelete?.addEventListener('click', async () => {
            if (!confirm("Are you sure you want to delete this comic issue?")) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const comicId = document.getElementById('comic-id').value;
            const resp = await fetch(`/staff/lore/comic/delete/${comicId}`, {
                method: 'POST',
                headers: {'RequestVerificationToken': token}
            });
            if (resp.ok) {
                window.location.href = '/staff/lore';
            } else {
                alert("Could not delete comic");
            }
        });
    });
</script>
