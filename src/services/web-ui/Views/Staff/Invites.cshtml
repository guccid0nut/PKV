@model StaffInvitesViewModel
@{
    ViewData["Title"] = "Staff Command Center - Invites & Lineage";

    string TimeAgo(DateTimeOffset dateTime)
    {
        var span = TimeProvider.System.GetUtcNow() - dateTime;
        return span.TotalDays switch
        {
            > 30 => $"{(int)(span.TotalDays / 30)}mo ago",
            >= 1 => $"{(int)span.TotalDays}d ago",
            _ when span.TotalHours >= 1 => $"{(int)span.TotalHours}h ago",
            _ when span.TotalMinutes >= 1 => $"{(int)span.TotalMinutes}m ago",
            _ => "just now"
        };
    }
}

<div class="w-full max-w-[1700px] mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6 animate-fadeIn">
    <!-- Top Header Banner -->
    <div class="relative overflow-hidden rounded-2xl p-5 sm:p-6 bg-gradient-to-r from-purple-950/70 via-slate-900/80 to-slate-950/90 border border-purple-500/25 shadow-xl backdrop-blur-xl">
        <div class="absolute -right-12 -top-12 w-64 h-64 bg-purple-600/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-12 -bottom-12 w-64 h-64 bg-pink-600/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="space-y-1.5">
                <div class="inline-flex items-center gap-2 px-3 py-0.5 rounded-full bg-purple-500/15 border border-purple-500/30 text-purple-300 text-xs font-bold tracking-wider uppercase">
                    <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
                    <span>Staff Moderation Suite</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
                    Invite-Only Access &amp; Lineage Graph
                </h1>
                <p class="text-slate-400 text-xs sm:text-sm max-w-3xl">
                    Configure beta registration gates, review staff policy change logs, inspect player invitation networks, and prune malicious subtrees.
                </p>
            </div>

            <div class="flex items-center gap-2 self-start md:self-auto">
                <div class="flex items-center gap-1.5 bg-slate-950/80 p-1.5 rounded-xl border border-slate-800">
                    <a asp-controller="Staff" asp-action="Reports"
                       class="px-3.5 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition-all flex items-center gap-2">
                        <i class="fas fa-shield-alt"></i>
                        <span>Player Reports</span>
                    </a>
                    <a asp-controller="Staff" asp-action="Invites"
                       class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-purple-600 text-white shadow-md shadow-purple-600/20 transition-all flex items-center gap-2">
                        <i class="fas fa-envelope-open-text"></i>
                        <span>Invites &amp; Lineage</span>
                    </a>
                    <a asp-controller="Staff" asp-action="Streamers"
                       class="px-3.5 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-[#C499FF] transition-all flex items-center gap-2">
                        <i class="fab fa-twitch text-[#9146FF]"></i>
                        <span>Streamers</span>
                    </a>
                    <a asp-controller="Staff" asp-action="Hosts"
                       class="px-3.5 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition-all flex items-center gap-2">
                        <i class="fas fa-server"></i>
                        <span>Volunteer Hosts</span>
                    </a>
                    <a asp-controller="Staff" asp-action="Inventory"
                       class="px-3.5 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition-all flex items-center gap-2">
                        <i class="fas fa-boxes"></i>
                        <span>Inventory</span>
                    </a>
                    <a asp-controller="Store" asp-action="Index"
                       class="px-3.5 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-amber-400 transition-all flex items-center gap-2">
                        <i class="fas fa-store text-amber-500"></i>
                        <span>Live Store</span>
                    </a>
                    <a href="/admin/issues"
                       class="px-3.5 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-emerald-400 transition-all flex items-center gap-2"
                       title="Developer Issues & Autonomous Self-Healing Telemetry">
                        <i class="fas fa-bolt text-emerald-400"></i>
                        <span>Issues &amp; Healing</span>
                    </a>
                </div>

                <a asp-controller="Staff" asp-action="Invites"
                   class="px-4 py-2 rounded-xl bg-purple-600/20 hover:bg-purple-600/30 text-purple-300 border border-purple-500/30 font-bold text-xs sm:text-sm flex items-center gap-2 transition-all">
                    <span>🔄 Refresh</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="p-4 rounded-2xl bg-emerald-950/80 border border-emerald-500/40 text-emerald-200 flex items-start gap-3 shadow-lg shadow-emerald-950/40">
            <span class="text-emerald-400 text-xl">✅</span>
            <div class="flex-1">
                <h4 class="font-bold text-sm">Success</h4>
                <p class="text-xs text-emerald-300/90 mt-0.5">@Model.SuccessMessage</p>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="p-4 rounded-2xl bg-rose-950/80 border border-rose-500/40 text-rose-200 flex items-start gap-3 shadow-lg shadow-rose-950/40">
            <span class="text-rose-400 text-xl">⚠️</span>
            <div class="flex-1">
                <h4 class="font-bold text-sm">Notice</h4>
                <p class="text-xs text-rose-300/90 mt-0.5">@Model.ErrorMessage</p>
            </div>
        </div>
    }

    <!-- Metric KPI Stat Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        <!-- Card 1: System Status -->
        <div class="p-5 rounded-2xl bg-slate-900/60 border @(Model.Status.IsInviteOnlyEnabled ? "border-purple-500/40 bg-gradient-to-br from-purple-950/30 to-slate-900/60" : "border-emerald-500/30 bg-gradient-to-br from-emerald-950/20 to-slate-900/60") backdrop-blur-md shadow-lg">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Registration Mode</span>
                <span class="w-3 h-3 rounded-full @(Model.Status.IsInviteOnlyEnabled ? "bg-purple-400 shadow-purple-500/50" : "bg-emerald-400 shadow-emerald-500/50") shadow-md animate-pulse"></span>
            </div>
            <div class="text-xl sm:text-2xl font-black mt-2 @(Model.Status.IsInviteOnlyEnabled ? "text-purple-300" : "text-emerald-300")">
                @(Model.Status.IsInviteOnlyEnabled ? "INVITE ONLY" : "OPEN ACCESS")
            </div>
            <p class="text-[11px] text-slate-500 mt-1">
                @(Model.Status.IsInviteOnlyEnabled ? "Invite code required to register" : "Public signups enabled")
            </p>
        </div>

        <!-- Card 2: Generated Codes -->
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 backdrop-blur-md shadow-lg">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Generated</span>
            <div class="text-xl sm:text-2xl font-black text-white mt-2">
                @Model.Status.TotalInvitesGenerated.ToString("N0")
            </div>
            <p class="text-[11px] text-slate-500 mt-1">Lifetime codes created</p>
        </div>

        <!-- Card 3: Redeemed Codes -->
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 backdrop-blur-md shadow-lg">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Redeemed Invites</span>
            <div class="text-xl sm:text-2xl font-black text-emerald-400 mt-2">
                @Model.Status.TotalRedeemed.ToString("N0")
            </div>
            <p class="text-[11px] text-slate-500 mt-1">Successfully linked players</p>
        </div>

        <!-- Card 4: Active Unredeemed -->
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 backdrop-blur-md shadow-lg">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Pending Unredeemed</span>
            <div class="text-xl sm:text-2xl font-black text-amber-300 mt-2">
                @((Model.Status.TotalInvitesGenerated - Model.Status.TotalRedeemed).ToString("N0"))
            </div>
            <p class="text-[11px] text-slate-500 mt-1">Codes in the wild</p>
        </div>
    </div>

    <!-- Master Mode Toggle Card -->
    <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-purple-500/30 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-purple-500/20 pb-5">
            <div>
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <span>🎛️ Invite-Only Registration Gate Switch</span>
                </h3>
                <p class="text-xs text-slate-400 mt-1">
                    Any staff member can toggle this gate. All changes are permanently recorded in the immutable audit log below.
                </p>
            </div>

            <form asp-controller="Staff" asp-action="ToggleInviteMode" method="post" class="flex flex-wrap items-center gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="enabled" value="@(Model.Status.IsInviteOnlyEnabled ? "false" : "true")" />
                <input type="text"
                       name="notes"
                       placeholder="Audit reason / release notes (optional)..."
                       class="px-3.5 py-2 rounded-xl bg-slate-950/80 border border-slate-700 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-purple-500 w-64" />
                <button type="submit"
                        id="btnToggleInviteMode"
                        class="px-5 py-2 rounded-xl text-xs font-bold text-white transition-all shadow-md cursor-pointer flex items-center gap-2 @(Model.Status.IsInviteOnlyEnabled ? "bg-rose-600 hover:bg-rose-500 shadow-rose-950/40" : "bg-purple-600 hover:bg-purple-500 shadow-purple-950/40")">
                    <span>@(Model.Status.IsInviteOnlyEnabled ? "🔓 Disable Invite-Only (Open Beta)" : "🔒 Enable Invite-Only (Closed Beta)")</span>
                </button>
            </form>
        </div>

        <!-- Audit Log History -->
        <div class="space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2">
                <span>📋 Staff Mode Toggle Audit Log</span>
            </h4>

            @if (Model.Status.RecentAuditLogs == null || Model.Status.RecentAuditLogs.Count == 0)
            {
                <div class="text-center py-6 text-xs text-slate-500 bg-slate-950/40 rounded-xl border border-slate-800">
                    No policy toggle logs recorded yet.
                </div>
            }
            else
            {
                <div class="overflow-x-auto rounded-xl border border-slate-800">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-950 text-slate-400 font-bold uppercase text-[10px] tracking-wider border-b border-slate-800">
                            <tr>
                                <th class="py-3 px-4">Timestamp</th>
                                <th class="py-3 px-4">Staff Member</th>
                                <th class="py-3 px-4">Action</th>
                                <th class="py-3 px-4">Notes / Reason</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800/60 bg-slate-900/40 text-slate-300">
                            @foreach (var log in Model.Status.RecentAuditLogs)
                            {
                                <tr class="hover:bg-slate-800/30 transition-colors">
                                    <td class="py-3 px-4 whitespace-nowrap text-slate-400 font-mono text-[11px]">
                                        @log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") (@TimeAgo(log.Timestamp))
                                    </td>
                                    <td class="py-3 px-4 font-bold text-white">
                                        @log.StaffAccountName <span class="text-slate-500 font-mono font-normal">#@log.StaffAccountId</span>
                                    </td>
                                    <td class="py-3 px-4">
                                        @if (log.Enabled)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-500/20 text-purple-300 border border-purple-500/40">
                                                ENABLED INVITE-ONLY
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">
                                                DISABLED INVITE-ONLY
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3 px-4 text-slate-400">
                                        @(string.IsNullOrWhiteSpace(log.Notes) ? "—" : log.Notes)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Lineage Graph & Disciplinary Subtree Management -->
    <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-purple-500/30 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-purple-500/20 pb-5">
            <div>
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <span>🌳 Player Lineage Graph &amp; Subtree Moderation</span>
                </h3>
                <p class="text-xs text-slate-400 mt-1">
                    Trace who invited whom. Prune toxic branches ("cut the head of the snake") to ban coordinated smurfs or ban-evaders.
                </p>
            </div>

            <!-- Search Form -->
            <form method="get" asp-controller="Staff" asp-action="Invites" class="flex items-center gap-2">
                <input type="text"
                       name="search"
                       value="@Model.SearchQuery"
                       placeholder="Search User ID or Account IGN..."
                       class="px-3.5 py-2 rounded-xl bg-slate-950/80 border border-slate-700 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-purple-500 w-64" />
                <button type="submit"
                        class="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs transition-all cursor-pointer">
                    🔍 Inspect Lineage
                </button>
            </form>
        </div>

        @if (Model.LineageTree != null)
        {
            <div class="space-y-6">
                <!-- Root Player Summary -->
                <div class="p-5 rounded-2xl bg-slate-950/80 border border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-purple-600/20 border border-purple-500/40 text-purple-300 flex items-center justify-center text-xl font-bold">
                            👤
                        </div>
                        <div>
                            <div class="flex items-center gap-2.5">
                                <h4 class="text-base font-black text-white">@(Model.LineageTree.MainAccountName ?? "Unknown")</h4>
                                <span class="text-xs font-mono text-purple-300 px-2 py-0.5 rounded-md bg-purple-500/20 border border-purple-500/30">User #@Model.LineageTree.UserId</span>
                                @if (Model.LineageTree.IsBanned)
                                {
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-300 border border-rose-500/40 uppercase">BANNED</span>
                                }
                                else
                                {
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 uppercase">ACTIVE</span>
                                }
                            </div>
                            <div class="text-xs text-slate-400 mt-1 flex flex-wrap items-center gap-3">
                                <span>Discord: @(Model.LineageTree.DiscordUsername ?? Model.LineageTree.DiscordId ?? "None")</span>
                                <span>•</span>
                                <span>Games: @Model.LineageTree.TotalGames</span>
                                <span>•</span>
                                <span>Joined: @Model.LineageTree.CreatedAt.ToString("yyyy-MM-dd")</span>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        @if (Model.LineageTree.IsBanned && Model.LineageTree.MainAccountId.HasValue)
                        {
                            <form asp-controller="Staff" asp-action="UnbanAccount" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="accountId" value="@Model.LineageTree.MainAccountId.Value" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit"
                                        class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition-all shadow-md cursor-pointer flex items-center gap-1.5">
                                    <span>🕊️</span>
                                    <span>Unban Account</span>
                                </button>
                            </form>
                        }

                        <button type="button"
                                onclick="openPruneModal(@Model.LineageTree.UserId, '@(Model.LineageTree.MainAccountName ?? $"User {Model.LineageTree.UserId}")')"
                                class="px-3.5 py-1.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs transition-all shadow-md cursor-pointer flex items-center gap-1.5">
                            <span>✂️</span>
                            <span>Prune Subtree</span>
                        </button>
                    </div>
                </div>

                <!-- Recursive Subtree View -->
                <div class="space-y-3">
                    <h5 class="text-xs font-bold uppercase tracking-wider text-slate-400">
                        Downstream Invitees Network (@Model.LineageTree.Invitees.Count Direct Invites)
                    </h5>

                    @if (Model.LineageTree.Invitees.Count == 0)
                    {
                        <div class="p-6 rounded-2xl bg-slate-950/40 border border-slate-800 text-center text-xs text-slate-500">
                            This player has not successfully invited any other users yet.
                        </div>
                    }
                    else
                    {
                        <div class="space-y-3 pl-2 sm:pl-4 border-l-2 border-purple-500/30">
                            @foreach (var child in Model.LineageTree.Invitees)
                            {
                                @await Html.PartialAsync("_InviteTreeNode", child)
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
        {
            <div class="p-8 rounded-2xl bg-slate-950/40 border border-slate-800 text-center space-y-2">
                <div class="text-2xl">🔍</div>
                <div class="text-sm font-bold text-white">No Lineage Found</div>
                <p class="text-xs text-slate-400">No account or user matched "@Model.SearchQuery". Try searching by exact IGN or User ID.</p>
            </div>
        }
        else
        {
            <div class="p-8 rounded-2xl bg-slate-950/40 border border-slate-800 text-center space-y-2">
                <div class="text-2xl">🌱</div>
                <div class="text-sm font-bold text-white">Lineage Graph Explorer</div>
                <p class="text-xs text-slate-400">Enter a player IGN or User ID above to visualize their entire downstream invitation hierarchy.</p>
            </div>
        }
    </div>
</div>

<!-- Prune Subtree Confirmation Modal -->
<div id="pruneModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md hidden transition-all animate-fade-in">
    <div class="glass-panel w-full max-w-lg rounded-3xl border border-rose-500/40 p-6 sm:p-8 space-y-6 shadow-2xl relative">
        <div class="flex items-center justify-between border-b border-rose-500/20 pb-4">
            <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-rose-500/20 text-rose-300 flex items-center justify-center text-base">✂️</span>
                <h3 class="text-lg font-bold text-white">Prune Invite Subtree</h3>
            </div>
            <button type="button" onclick="closePruneModal()" class="text-slate-400 hover:text-white text-lg">&times;</button>
        </div>

        <p class="text-xs text-slate-300 leading-relaxed">
            You are about to prune the entire invitation subtree under <strong id="pruneTargetName" class="text-rose-400">Player</strong>.
            This will suspend all descendant accounts and revoke all unredeemed invite codes issued along this branch.
        </p>

        <form asp-controller="Staff" asp-action="PruneInviteSubtree" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="rootUserId" id="pruneRootUserId" value="" />
            <input type="hidden" name="searchQuery" value="@Model.SearchQuery" />

            <div>
                <label for="pruneReason" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">
                    Disciplinary Reason
                </label>
                <textarea id="pruneReason"
                          name="reason"
                          required
                          rows="3"
                          placeholder="e.g. Toxic multi-account network / ban evasion ring..."
                          class="w-full bg-slate-900/80 border border-slate-700 rounded-xl px-4 py-3 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-rose-500"></textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" onclick="closePruneModal()" class="px-4 py-2 rounded-xl bg-slate-800 text-slate-300 text-xs font-bold hover:bg-slate-700 transition-all cursor-pointer">
                    Cancel
                </button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold transition-all shadow-md shadow-rose-950/50 cursor-pointer">
                    Confirm Prune &amp; Ban Branch
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openPruneModal(userId, name) {
        document.getElementById('pruneRootUserId').value = userId;
        document.getElementById('pruneTargetName').textContent = name;
        document.getElementById('pruneModal').classList.remove('hidden');
    }

    function closePruneModal() {
        document.getElementById('pruneModal').classList.add('hidden');
    }
</script>
