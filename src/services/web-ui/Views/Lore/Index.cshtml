@model IReadOnlyList<LoreComicSummaryDto>
@{
    ViewData["Title"] = "Project Kongor Lore & Comics";
    var arcs = ViewBag.Arcs as IReadOnlyList<LoreArcDto> ?? [];
    var selectedArc = ViewBag.SelectedArcSlug as string ?? "";
    var currentAccount = ViewBag.CurrentAccount as AccountDto;
    var isStaff = ViewBag.IsStaff is true;
    var featuredComic = Model.FirstOrDefault(c => c.IssueNumber == 1) ?? Model.FirstOrDefault();
}

<div class="min-h-screen pb-24 text-slate-100">
    <!-- Universe Hero Banner -->
    <div
        class="relative overflow-hidden rounded-3xl border border-purple-500/20 bg-gradient-to-br from-slate-900 via-purple-950/40 to-slate-950 p-6 sm:p-10 mb-10 shadow-2xl shadow-purple-950/30">
        <div
            class="absolute -right-20 -top-20 w-96 h-96 rounded-full bg-purple-600/15 blur-3xl pointer-events-none"></div>
        <div
            class="absolute -left-20 -bottom-20 w-96 h-96 rounded-full bg-amber-500/10 blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-4xl">
            <div class="flex items-center gap-2 mb-4">
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/15 border border-purple-500/30 text-purple-300 text-xs font-bold uppercase tracking-wider">
                    <span>🌌</span> Parallel Universe Lore
                </div>
                <div
                    class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-purple-500/20 border border-purple-500/40 text-purple-300 text-xs font-bold tracking-wider uppercase">
                    <span>🛡️ STAFF ONLY (WIP)</span>
                </div>
            </div>
            <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-4">
                The Chronicles of <span
                    class="bg-clip-text text-transparent bg-gradient-to-r from-purple-400 via-pink-400 to-amber-300">Project Kongor</span>
            </h1>
            <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-4 max-w-3xl">
                Enter an entirely new parallel timeline. Experience the untold origins, ancient friendships, and cosmic
                clashes of the heroes before the world was shattered—told through high-fidelity interactive graphic
                novels and 3D cinematic shorts.
            </p>
            <div class="mb-6 rounded-2xl border border-amber-500/30 bg-amber-950/25 px-4 py-3 text-xs text-amber-200/90 max-w-3xl leading-relaxed">
                <strong class="text-amber-300 uppercase tracking-wider">Sample Development Preview:</strong>
                The bundled issues below use AI-generated placeholder artwork for development testing—they are <strong>not</strong> official Heroes of Newerth comics. Each community Master Server can host its own custom <em>Parallel Universe Timeline</em> and original lore canon.
            </div>
            @if (isStaff)
            {
                <div class="flex items-center gap-3">
                    <a asp-controller="Staff" asp-action="LoreManagement"
                       class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold transition-all shadow-lg shadow-purple-900/40">
                        <i class="fa-solid fa-shield-halved"></i> Staff Lore Management
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Arc Filter Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 no-scrollbar">
        <a href="/lore"
           class="px-4 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap @(string.IsNullOrEmpty(selectedArc) ? "bg-purple-600 text-white shadow-lg shadow-purple-900/40" : "bg-slate-900/80 hover:bg-slate-800 text-slate-400 hover:text-slate-200 border border-slate-800")">
            ✨ All Sagas (@Model.Count Issues)
        </a>
        @foreach (var arc in arcs)
        {
            var active = string.Equals(selectedArc, arc.Slug, StringComparison.OrdinalIgnoreCase);
            <a href="/lore?arc=@arc.Slug"
               class="px-4 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap @(active ? "bg-purple-600 text-white shadow-lg shadow-purple-900/40" : "bg-slate-900/80 hover:bg-slate-800 text-slate-400 hover:text-slate-200 border border-slate-800")">
                📖 @arc.Title (@arc.ComicCount)
            </a>
        }
    </div>

    @if (featuredComic != null && string.IsNullOrEmpty(selectedArc))
    {
        <!-- Featured Issue Showcase Card -->
        <div
            class="rounded-3xl border border-slate-800/80 bg-slate-900/70 backdrop-blur-xl p-6 sm:p-8 mb-12 shadow-xl hover:border-purple-500/40 transition-all group">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <div
                    class="lg:col-span-4 overflow-hidden rounded-2xl border border-slate-700/60 relative group-hover:scale-[1.01] transition-transform">
                    <img src="@featuredComic.CoverImageUrl" alt="@featuredComic.Title"
                         class="w-full h-80 lg:h-96 object-cover object-center"/>
                    <div
                        class="absolute top-3 left-3 px-3 py-1 rounded-lg bg-black/70 backdrop-blur-md border border-purple-500/40 text-purple-300 text-xs font-black">
                        FEATURED SAGA
                    </div>
                </div>
                <div class="lg:col-span-8 flex flex-col justify-between">
                    <div>
                        <div
                            class="flex items-center gap-2 text-xs font-bold text-purple-400 uppercase tracking-wider mb-2">
                            <span>@featuredComic.ArcTitle</span> • <span>Issue #@featuredComic.IssueNumber</span>
                        </div>
                        <h2 class="text-2xl sm:text-4xl font-black text-white mb-4 group-hover:text-purple-300 transition-colors">
                            @featuredComic.Title
                        </h2>
                        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
                            @featuredComic.Synopsis
                        </p>
                    </div>

                    <div>
                        <!-- Creator Credits Preview -->
                        @if (featuredComic.Credits.Count > 0)
                        {
                            <div class="flex flex-wrap items-center gap-2 mb-6 text-xs text-slate-400">
                                <span class="font-bold text-slate-300">Created by:</span>
                                @foreach (var cr in featuredComic.Credits)
                                {
                                    <span
                                        class="px-2.5 py-1 rounded-lg bg-slate-800/80 border border-slate-700/60 text-slate-300">
                                        <strong class="text-purple-400">@cr.Role:</strong> @cr.DisplayName
                                    </span>
                                }
                            </div>
                        }

                        <div class="flex flex-wrap items-center gap-4">
                            <a href="/lore/@featuredComic.Slug"
                               class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-sm font-bold shadow-lg shadow-purple-900/40 hover:scale-105 transition-all">
                                <i class="fa-solid fa-book-open"></i> Read Issue #@featuredComic.IssueNumber
                            </a>
                            @if (!string.IsNullOrEmpty(featuredComic.CinematicVideoUrl))
                            {
                                <a href="/lore/@featuredComic.Slug#cinematic"
                                   class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 text-sm font-bold transition-all">
                                    <i class="fa-solid fa-play"></i> Watch 3D Short
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Issues Grid -->
    <div class="mb-8 flex items-center justify-between">
        <h2 class="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
            <span>📚</span> Available Issues (@Model.Count)
        </h2>
    </div>

    @if (Model.Count == 0)
    {
        <div class="rounded-2xl border border-dashed border-slate-800 p-12 text-center text-slate-400">
            <i class="fa-solid fa-book text-4xl mb-4 text-slate-600"></i>
            <p class="text-base font-bold">No comics found in this arc yet.</p>
            <p class="text-xs text-slate-500 mt-1">Check back soon as new stories are published!</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            @foreach (var comic in Model)
            {
                <div
                    class="rounded-2xl border border-slate-800/80 bg-slate-900/70 backdrop-blur-xl overflow-hidden hover:border-purple-500/40 hover:shadow-xl hover:shadow-purple-950/20 transition-all flex flex-col group">
                    <a href="/lore/@comic.Slug" class="relative block overflow-hidden aspect-[16/10] bg-slate-950">
                        <img src="@comic.CoverImageUrl" alt="@comic.Title"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"/>
                        <div
                            class="absolute top-3 left-3 px-2.5 py-1 rounded-lg bg-black/75 backdrop-blur-md border border-slate-700/80 text-white text-xs font-black">
                            ISSUE #@comic.IssueNumber
                        </div>
                        @if (!string.IsNullOrEmpty(comic.CinematicVideoUrl))
                        {
                            <div
                                class="absolute bottom-3 right-3 px-2 py-0.5 rounded-md bg-amber-500/80 backdrop-blur-md text-slate-950 text-[10px] font-black uppercase flex items-center gap-1">
                                <i class="fa-solid fa-film"></i> 3D Short
                            </div>
                        }
                    </a>

                    <div class="p-5 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="text-[11px] font-bold text-purple-400 uppercase tracking-wider mb-1.5">
                                @comic.ArcTitle
                            </div>
                            <h3 class="text-lg font-bold text-white mb-2 group-hover:text-purple-300 transition-colors line-clamp-1">
                                <a href="/lore/@comic.Slug">@comic.Title</a>
                            </h3>
                            <p class="text-slate-400 text-xs leading-relaxed line-clamp-3 mb-4">
                                @comic.Synopsis
                            </p>
                        </div>

                        <div class="pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs">
                            <span class="text-slate-400">
                                <i class="fa-regular fa-file-lines text-purple-400"></i> @comic.PageCount Pages
                            </span>
                            <a href="/lore/@comic.Slug"
                               class="font-bold text-purple-400 hover:text-purple-300 flex items-center gap-1">
                                Read Now <i class="fa-solid fa-arrow-right text-[10px]"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
