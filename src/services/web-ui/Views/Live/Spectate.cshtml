@using System.Text.Json
@model LiveMatchData
@{
    ViewData["Title"] = $"Live Spectate - Match #{Model.MatchID}";
    var initialJson = JsonSerializer.Serialize(Model, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

<div class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6 animate-fadeIn relative">
    <!-- Floating Universal Minimap Tooltip -->
    <div id="minimap-tooltip"
         class="hidden fixed pointer-events-none z-[99999] p-2.5 rounded-xl bg-slate-900/95 border border-purple-500/40 shadow-2xl backdrop-blur-md"></div>

    <!-- Header Bar -->
    <div
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-2xl bg-slate-900/80 border border-purple-500/25 shadow-xl backdrop-blur-xl">
        <div class="flex items-center gap-3">
            <a asp-controller="Live" asp-action="Index"
               class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 transition-all"
               title="Back to Live Overview">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
            </a>
            <div>
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></span>
                    <h1 class="text-xl sm:text-2xl font-black text-white">Live Match #@Model.MatchID</h1>
                    <span
                        class="px-2.5 py-0.5 rounded-md bg-purple-500/20 text-purple-300 text-xs font-bold border border-purple-500/30">
                        @Model.GameMode
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full bg-purple-500/20 border border-purple-500/40 text-purple-300 font-bold text-xs uppercase tracking-wider flex items-center gap-1.5 shadow-sm">
                        <span>🛡️</span> STAFF ONLY (WIP)
                    </span>
                </div>
                <div class="text-xs text-slate-400 mt-0.5">Map: <b class="text-slate-200 uppercase">@Model.Map</b> ·
                    Server: @Model.ServerName</div>
            </div>
        </div>

        <div class="flex items-center gap-4 self-end sm:self-auto">
            <!-- Score Indicator -->
            <div class="flex items-center gap-3 px-4 py-2 rounded-xl bg-slate-950/80 border border-slate-800">
                <div class="text-amber-400 font-bold text-sm">Legion: <b id="score-legion"
                                                                         class="text-white text-lg ml-1">@Model.ScoreLegion</b>
                </div>
                <div class="text-slate-600 font-mono">|</div>
                <div class="text-rose-400 font-bold text-sm">Hellbourne: <b id="score-hellbourne"
                                                                            class="text-white text-lg ml-1">@Model.ScoreHellbourne</b>
                </div>
            </div>

            <!-- Elapsed Time -->
            <div
                class="px-4 py-2 rounded-xl bg-emerald-950/40 border border-emerald-500/30 text-emerald-400 font-mono font-black text-base flex items-center gap-2 shadow-sm">
                <span>⏱️</span>
                <span id="live-match-timer">@Model.FormattedTime</span>
            </div>
        </div>
    </div>

    <!-- Dual Team Advantage Push Bar (matching specui.lua) -->
    <div
        class="w-full rounded-2xl bg-slate-900/80 border border-purple-500/25 p-3 space-y-1.5 shadow-lg backdrop-blur-md">
        <div class="flex items-center justify-between text-[11px] font-extrabold uppercase tracking-wider px-1">
            <span class="text-sky-400 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-sky-400"></span> Legion Momentum</span>
            <span class="text-rose-400 flex items-center gap-1.5">Hellbourne Momentum <span
                    class="w-2 h-2 rounded-full bg-rose-400"></span></span>
        </div>
        <div class="w-full h-3.5 rounded-full bg-slate-950 border border-slate-800 overflow-hidden flex shadow-inner">
            <div id="push-bar-legion"
                 class="h-full bg-gradient-to-r from-blue-600 to-cyan-400 transition-all duration-700 shadow-md"
                 style="width: 50%;"></div>
            <div id="push-bar-hellbourne"
                 class="h-full bg-gradient-to-l from-rose-600 to-rose-400 transition-all duration-700 shadow-md"
                 style="width: 50%;"></div>
        </div>
    </div>

    <!-- Main Spectator Layout: 2D Minimap Canvas on Left, Live Ticker & Inspector on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- 2D Minimap Canvas Stage (7 Cols) -->
        <div
            class="lg:col-span-7 flex flex-col items-center justify-center p-4 sm:p-6 rounded-3xl bg-slate-950/90 border border-purple-500/20 shadow-2xl backdrop-blur-2xl relative overflow-hidden">
            <!-- Glow background -->
            <div
                class="absolute -right-20 -top-20 w-80 h-80 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>

            <!-- View Mode Switcher (3D Live Viewport vs 2D Minimap) -->
            <div class="w-full max-w-[620px] mb-3 flex items-center justify-between z-10">
                <div class="inline-flex rounded-xl bg-slate-900/90 p-1 border border-slate-800 shadow-md">
                    <button id="btn-view-3d" type="button" class="px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-purple-600 transition-all flex items-center gap-1.5 shadow-md">
                        <span>🎥</span> 3D Live Viewport
                    </button>
                    <button id="btn-view-2d" type="button" class="px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-slate-200 transition-all flex items-center gap-1.5">
                        <span>🗺️</span> 2D Minimap
                    </button>
                </div>
                <div class="flex items-center gap-2 px-3 py-1 rounded-lg bg-slate-900/80 border border-emerald-500/30">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-[10px] font-mono text-emerald-400 font-bold tracking-wider">VULKAN RELAY</span>
                </div>
            </div>

            <!-- Stage Container: 3D Live Viewport Stream Frame -->
            <div id="container-3d-stream" class="relative w-full max-w-[620px] aspect-video rounded-2xl overflow-hidden shadow-2xl border border-purple-500/30 bg-black">
                <iframe id="iframe-viewport-stream" src="http://localhost:8088/?embed=true" class="w-full h-full border-0 block" allow="fullscreen"></iframe>
            </div>

            <!-- Stage Container: 2D Minimap Canvas (Toggleable) -->
            <div id="container-2d-minimap"
                class="hidden relative w-full max-w-[620px] aspect-square rounded-2xl overflow-hidden shadow-2xl border border-slate-800">
                <canvas id="live-minimap-canvas" width="620" height="620" role="region" aria-label="Live match 2D minimap tactical overview"
                        class="w-full h-full block bg-slate-950">Your browser does not support HTML5 Canvas.</canvas>
            </div>

            <!-- Canvas Legend / Controls -->
            <div class="w-full max-w-[620px] mt-4 flex items-center justify-between text-xs text-slate-400 font-medium">
                <div class="flex items-center gap-4 flex-wrap">
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-sky-400"></span> Legion Heroes</span>
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span> Hellbourne Heroes</span>
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span> Sight Ward</span>
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-purple-400"></span> Rev Ward</span>
                </div>
                <div class="text-[11px] text-purple-300 font-semibold flex items-center gap-1">
                    <span>💡 Click hero to inspect</span>
                </div>
            </div>

            <!-- Live Net Worth & Gold Advantage Card -->
            <div
                class="w-full max-w-[620px] mt-5 p-4 rounded-2xl bg-slate-900/80 border border-purple-500/25 shadow-lg space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="text-amber-400 font-bold text-xs">💰 Dynamic Net Worth Advantage</span>
                        <span id="gold-lead-badge"
                              class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-slate-800 text-slate-300">Even</span>
                    </div>
                    <div class="flex items-center gap-3 text-[10px] font-mono">
                        <span class="text-sky-400 font-bold">▲ Legion</span>
                        <span class="text-rose-400 font-bold">▼ Hellbourne</span>
                    </div>
                </div>
                <div class="w-full h-28 relative bg-slate-950 rounded-xl overflow-hidden border border-slate-800/80">
                    <canvas id="live-gold-chart-canvas" class="w-full h-full block" role="img" aria-label="Dynamic net worth advantage chart">Your browser does not support HTML5 Canvas.</canvas>
                </div>
            </div>
        </div>

        <!-- Sidebar: Combat Feed & Player Inspector (5 Cols) -->
        <div class="lg:col-span-5 space-y-5">
            <!-- Player Inspector Card -->
            <div class="p-5 rounded-2xl bg-slate-900/70 border border-slate-800 shadow-xl backdrop-blur-xl space-y-3">
                <div
                    class="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center justify-between">
                    <span>🎯 Selected Hero Inspector</span>
                    <span class="text-[10px] text-purple-400 font-semibold">Live Telemetry</span>
                </div>
                <div id="player-inspector" class="space-y-3">
                    <div class="p-4 rounded-xl bg-slate-950/50 text-center text-xs text-slate-500 italic">
                        Click on any hero on the map to inspect live combat stats and items.
                    </div>
                </div>
            </div>

            <!-- Live Combat Ticker Feed -->
            <div class="p-5 rounded-2xl bg-slate-900/70 border border-slate-800 shadow-xl backdrop-blur-xl space-y-3">
                <div class="flex items-center justify-between">
                    <div class="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                        <span>Live Combat Feed</span>
                    </div>
                    <span class="text-[10px] text-slate-500 font-mono">Real-Time</span>
                </div>
                <div id="live-combat-feed" class="space-y-2 max-h-56 overflow-y-auto pr-1">
                    @foreach (var ev in Model.RecentEvents)
                    {
                        <div
                            class="p-2 rounded-lg bg-slate-950/60 border border-slate-800 text-xs flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2">
                                <span class="@(ev.EventType == "KILL" ? "text-rose-400" : "text-amber-400") font-bold">
                                    @(ev.EventType == "KILL" ? "⚔️" : "🏰")
                                </span>
                                <span class="text-slate-200 font-medium">@ev.Description</span>
                            </div>
                            <span class="text-[10px] text-slate-500 font-mono">@(ev.MatchTimeSeconds / 60)m</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Match Scoreboard Summary List -->
            <div class="p-5 rounded-2xl bg-slate-900/70 border border-slate-800 shadow-xl backdrop-blur-xl space-y-3">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">
                    <span>⚔️ Full Match Roster</span>
                </div>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <!-- Legion List -->
                    <div class="space-y-1.5">
                        <div class="text-[11px] font-bold text-sky-400 uppercase">Legion</div>
                        <div id="roster-legion-container" class="space-y-1.5">
                            @foreach (var p in Model.Players.Where(p => p.Team == 1))
                            {
                                <div onclick="window.ActiveMinimapVisualizer?.selectPlayerByAccountId(@p.AccountID)"
                                     class="p-2 rounded-lg bg-slate-950/60 border border-sky-500/20 hover:bg-slate-900/90 hover:border-sky-500/50 flex items-center gap-2 cursor-pointer transition-all duration-150 group"
                                     title="Click to inspect @p.AccountName">
                                    <div
                                        class="w-6 h-6 rounded-md overflow-hidden bg-slate-900 flex-shrink-0 border border-slate-700/60 group-hover:border-sky-400">
                                        <img src="/images/heroes/@(p.HeroIdentifier.ToLower().Replace("hero_", "")).png"
                                             onError="this.src='/images/heroes/default.png';"
                                             class="w-full h-full object-cover" alt=""/>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div
                                            class="font-bold text-white text-[11px] truncate group-hover:text-sky-300 transition-colors">@p.AccountName</div>
                                        <div class="text-[9px] text-slate-400 font-mono">@p.Kills/@p.Deaths/@p.Assists ·
                                            Lv @p.Level</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Hellbourne List -->
                    <div class="space-y-1.5">
                        <div class="text-[11px] font-bold text-rose-400 uppercase">Hellbourne</div>
                        <div id="roster-hellbourne-container" class="space-y-1.5">
                            @foreach (var p in Model.Players.Where(p => p.Team == 2))
                            {
                                <div onclick="window.ActiveMinimapVisualizer?.selectPlayerByAccountId(@p.AccountID)"
                                     class="p-2 rounded-lg bg-slate-950/60 border border-rose-500/20 hover:bg-slate-900/90 hover:border-rose-500/50 flex items-center gap-2 cursor-pointer transition-all duration-150 group"
                                     title="Click to inspect @p.AccountName">
                                    <div
                                        class="w-6 h-6 rounded-md overflow-hidden bg-slate-900 flex-shrink-0 border border-slate-700/60 group-hover:border-rose-400">
                                        <img src="/images/heroes/@(p.HeroIdentifier.ToLower().Replace("hero_", "")).png"
                                             onError="this.src='/images/heroes/default.png';"
                                             class="w-full h-full object-cover" alt=""/>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div
                                            class="font-bold text-white text-[11px] truncate group-hover:text-rose-300 transition-colors">@p.AccountName</div>
                                        <div class="text-[9px] text-slate-400 font-mono">@p.Kills/@p.Deaths/@p.Assists ·
                                            Lv @p.Level</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Live Gold & Net Worth Timeline Chart -->
    <div class="p-5 rounded-2xl bg-slate-900/80 border border-purple-500/25 shadow-xl backdrop-blur-xl space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">📊 Net Worth & Gold Advantage Timeline</span>
                <span id="gold-advantage-badge"
                      class="px-2.5 py-0.5 rounded text-[11px] font-bold font-mono bg-slate-950 text-sky-400 border border-sky-500/30">
                    @(Model.GoldAdvantageLegion >= Model.GoldAdvantageHellbourne ? $"Legion +{Model.GoldAdvantageLegion:N0} Gold" : $"Hellbourne +{Model.GoldAdvantageHellbourne:N0} Gold")
                </span>
            </div>
            <div class="flex items-center gap-4 text-xs font-medium text-slate-400">
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded bg-sky-400"></span> Legion (+ Advantage)</span>
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded bg-rose-400"></span> Hellbourne (- Advantage)</span>
            </div>
        </div>
        <div class="relative w-full h-44">
            <canvas id="live-gold-chart" class="w-full h-full" role="img" aria-label="Live match gold advantage chart">Your browser does not support HTML5 Canvas.</canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" defer></script>
    <script src="/js/minimap-visualizer.js" defer asp-append-version="true"></script>
    <script>
        const initialMatch = @Html.Raw(initialJson);
        document.addEventListener('DOMContentLoaded', () => {
            window.visualizer = new MinimapVisualizer('live-minimap-canvas', 'live-gold-chart', initialMatch);

            // 3D Viewport vs 2D Minimap Stage Switcher
            const btn3D = document.getElementById('btn-view-3d');
            const btn2D = document.getElementById('btn-view-2d');
            const container3D = document.getElementById('container-3d-stream');
            const container2D = document.getElementById('container-2d-minimap');

            if (btn3D && btn2D && container3D && container2D) {
                btn3D.addEventListener('click', () => {
                    btn3D.className = 'px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-purple-600 transition-all flex items-center gap-1.5 shadow-md';
                    btn2D.className = 'px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-slate-200 transition-all flex items-center gap-1.5';
                    container3D.classList.remove('hidden');
                    container2D.classList.add('hidden');
                });

                btn2D.addEventListener('click', () => {
                    btn2D.className = 'px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-purple-600 transition-all flex items-center gap-1.5 shadow-md';
                    btn3D.className = 'px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-slate-200 transition-all flex items-center gap-1.5';
                    container2D.classList.remove('hidden');
                    container3D.classList.add('hidden');
                });
            }
        });
    </script>
}

