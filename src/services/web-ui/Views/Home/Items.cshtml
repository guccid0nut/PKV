    function escapeHtmlText(str) {
        return String(str || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function buildModalDownstreamList(itemObj, depth = 0, visited = new Set()) {
        if (!itemObj || depth > 4) return [];
        const rawComps = (itemObj.components && itemObj.components.length > 0) ? itemObj.components : [];
        const grouped = new Map();
        let hasRecipe = false;
        let recipeCost = Number(itemObj.recipeCost || 0);

        rawComps.forEach(c => {
            const rawCode = extractItemRefCode(c);
            const isRecipe = isRecipeRef(c);
            if (isRecipe) {
                hasRecipe = true;
                const objCost = typeof c === 'object' && c !== null ? Number(c.cost || c.Cost || 0) : 0;
                if (!recipeCost && objCost > 0) recipeCost = objCost;
                return;
            }
            const matched = getItemByCode(rawCode);
            const normCode = matched ? String(matched.key || matched.code || rawCode).toLowerCase() : rawCode.replace(/^item_/i, '');
            if (!normCode) return;

            const cObjName = typeof c === 'object' && c !== null ? (c.name || c.Name) : '';
            const cObjCost = typeof c === 'object' && c !== null ? (c.cost || c.Cost) : 0;
            const cObjIcon = typeof c === 'object' && c !== null ? (c.icon || c.Icon) : '';
            const explicitQty = typeof c === 'object' && c !== null && Number(c.quantity || c.Quantity) > 1
                ? Number(c.quantity || c.Quantity)
                : 1;

            if (grouped.has(normCode)) {
                grouped.get(normCode).quantity += explicitQty;
            } else {
                const nextVisited = new Set(visited);
                nextVisited.add(normCode);
                const children = (matched && !visited.has(normCode))
                    ? buildModalDownstreamList(matched, depth + 1, nextVisited)
                    : [];
                grouped.set(normCode, {
                    code: normCode,
                    name: (matched && matched.name) ? matched.name : (cObjName || normCode),
                    cost: Number((matched && matched.cost) ? matched.cost : (cObjCost || 0)),
                    icon: (matched && matched.icon)
                        ? matched.icon
                        : (cObjIcon && String(cObjIcon).startsWith('/') ? cObjIcon : `/images/items/${cObjIcon || normCode}.png`),
                    isRecipe: false,
                    quantity: explicitQty,
                    children: children
                });
            }
        });

        const nodes = Array.from(grouped.values());
        if ((hasRecipe || recipeCost > 0) && recipeCost > 0) {
            nodes.push({
                code: 'recipe',
                name: 'Recipe Scroll',
                cost: recipeCost,
                icon: '/images/items/recipe.png',
                isRecipe: true,
                quantity: 1,
                children: []
            });
        }
        return nodes;
    }

    function buildModalUpstreamList(itemObj, depth = 0, visited = new Set()) {
        if (!itemObj || depth > 2) return [];
        const rawBuilds = (itemObj.buildsInto && itemObj.buildsInto.length > 0) ? itemObj.buildsInto : [];
        const nodes = [];
        rawBuilds.forEach(b => {
            const rawCode = extractItemRefCode(b);
            if (!rawCode) return;
            const matched = getItemByCode(rawCode);
            const normCode = matched ? String(matched.key || matched.code || rawCode).toLowerCase() : rawCode.replace(/^item_/i, '');
            if (visited.has(normCode)) return;

            const bObjName = typeof b === 'object' && b !== null ? (b.name || b.Name) : '';
            const bObjCost = typeof b === 'object' && b !== null ? (b.cost || b.Cost) : 0;
            const bObjIcon = typeof b === 'object' && b !== null ? (b.icon || b.Icon) : '';

            const nextVisited = new Set(visited);
            nextVisited.add(normCode);
            const children = matched ? buildModalUpstreamList(matched, depth + 1, nextVisited) : [];
            nodes.push({
                code: normCode,
                name: (matched && matched.name) ? matched.name : (bObjName || normCode),
                cost: Number((matched && matched.cost) ? matched.cost : (bObjCost || 0)),
                icon: (matched && matched.icon)
                    ? matched.icon
                    : (bObjIcon ? (String(bObjIcon).startsWith('/') ? bObjIcon : `/images/items/${bObjIcon}.png`) : `/images/items/${normCode}.png`),
                children: children
            });
        });
        return nodes;
    }

    function renderModalUpstreamHtml(nodes) {
        if (!nodes || nodes.length === 0) return '';
        let html = '<ul class="moba-modal-tree-up">';
        nodes.forEach(n => {
            const safeCodeJs = String(n.code || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
            html += `
                <li>
                    <button type="button" onclick="openItemModal('${safeCodeJs}')"
                            class="group flex flex-col items-center gap-1 px-2.5 py-2 rounded-2xl bg-slate-900/95 border border-cyan-500/35 hover:border-cyan-400 hover:bg-slate-800 transition-all shadow-md min-w-[92px] max-w-[122px] text-center cursor-pointer">
                        <div class="w-9 h-9 rounded-xl p-0.5 bg-slate-950 border border-cyan-400/40 overflow-hidden">
                            <img src="${escapeHtmlText(n.icon)}" onError="this.onerror=null;this.src='/images/items/default.png';" alt="${escapeHtmlText(n.name)}" class="w-full h-full object-cover rounded-lg" />
                        </div>
                        <span class="font-bold text-[10px] text-white group-hover:text-cyan-300 leading-tight line-clamp-2">${escapeHtmlText(n.name)}</span>
                        <span class="text-[9px] font-mono font-bold text-cyan-300">💰 ${Number(n.cost || 0).toLocaleString()}g</span>
                    </button>
                    ${renderModalUpstreamHtml(n.children)}
                </li>
            `;
        });
        html += '</ul>';
        return html;
    }

    function renderModalDownstreamHtml(nodes) {
        if (!nodes || nodes.length === 0) return '';
        let html = '<ul class="moba-modal-tree-down">';
        nodes.forEach(n => {
            if (n.isRecipe) {
                html += `
                    <li>
                        <div class="flex flex-col items-center gap-1 px-2.5 py-2 rounded-2xl bg-slate-900/75 border border-purple-500/35 min-w-[92px] max-w-[122px] text-center shadow-md">
                            <div class="w-9 h-9 rounded-xl bg-slate-950 border border-amber-400/40 flex items-center justify-center text-base overflow-hidden">📜</div>
                            <span class="font-bold text-[10px] text-purple-200 leading-tight">Recipe Scroll</span>
                            <span class="text-[9px] font-mono font-bold text-amber-300">+${Number(n.cost || 0).toLocaleString()}g</span>
                        </div>
                    </li>
                `;
            } else {
                const safeCodeJs = String(n.code || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
                const qtyBadge = n.quantity > 1
                    ? `<span class="absolute -top-1.5 -right-1.5 px-1.5 py-0.2 rounded-full bg-amber-400 text-slate-950 font-black text-[9px] leading-tight ring-2 ring-slate-950">×${n.quantity}</span>`
                    : '';
                html += `
                    <li>
                        <button type="button" onclick="openItemModal('${safeCodeJs}')"
                                class="group flex flex-col items-center gap-1 px-2.5 py-2 rounded-2xl bg-slate-900/95 border border-amber-500/35 hover:border-amber-400 hover:bg-slate-800 transition-all shadow-md min-w-[92px] max-w-[122px] text-center cursor-pointer">
                            <div class="relative w-9 h-9 rounded-xl p-0.5 bg-slate-950 border border-amber-400/40 overflow-visible">
                                <img src="${escapeHtmlText(n.icon)}" onError="this.onerror=null;this.src='/images/items/default.png';" alt="${escapeHtmlText(n.name)}" class="w-full h-full object-cover rounded-lg" />
                                ${qtyBadge}
                            </div>
                            <span class="font-bold text-[10px] text-white group-hover:text-amber-300 leading-tight line-clamp-2">${escapeHtmlText(n.name)}</span>
                            <span class="text-[9px] font-mono font-bold text-amber-300">💰 ${Number(n.cost || 0).toLocaleString()}g</span>
                        </button>
                        ${renderModalDownstreamHtml(n.children)}
                    </li>
                `;
            }
        });
        html += '</ul>';
        return html;
    }

    function renderVisualCraftingTreeModal(item) {
        const rootKey = String(item.key || item.code || '').toLowerCase();
        const rootVisitedUp = new Set(rootKey ? [rootKey] : []);
        const rootVisitedDown = new Set(rootKey ? [rootKey] : []);
        const upstream = buildModalUpstreamList(item, 0, rootVisitedUp);
        const downstream = buildModalDownstreamList(item, 0, rootVisitedDown);
        const iconUrl = item.icon || `/images/items/${rootKey}.png`;

        const upHtml = upstream.length > 0
            ? `<div class="mb-1.5 px-2.5 py-0.5 rounded-full bg-cyan-950/70 border border-cyan-500/30 text-[9px] font-bold uppercase tracking-wider text-cyan-300">⚡ Builds Into</div>${renderModalUpstreamHtml(upstream)}`
            : `<div class="mb-2 px-3 py-1 rounded-full bg-slate-900/70 border border-slate-800 text-[10px] text-slate-400">👑 Terminal Item</div>`;

        const downHtml = downstream.length > 0
            ? `${renderModalDownstreamHtml(downstream)}<div class="mt-2 px-2.5 py-0.5 rounded-full bg-amber-950/60 border border-amber-500/30 text-[9px] font-bold uppercase tracking-wider text-amber-300">🔨 Required Components</div>`
            : `<div class="mt-2 px-3 py-1 rounded-full bg-slate-900/70 border border-slate-800 text-[10px] text-slate-400">🌱 Base Shop Component</div>`;

        return `
            <div class="overflow-x-auto py-2">
                <div class="min-w-full w-max mx-auto flex flex-col items-center px-3">
                    ${upHtml}
                    <div class="relative z-10 flex flex-col items-center gap-1.5 px-5 py-3 rounded-2xl bg-gradient-to-b from-amber-500/20 via-slate-900 to-slate-950 border-2 border-amber-400 shadow-xl shadow-amber-500/15 min-w-[144px] text-center">
                        <span class="px-2 py-0.2 rounded-full bg-amber-400 text-slate-950 text-[8px] font-black uppercase tracking-widest">🌟 Active Item</span>
                        <div class="w-12 h-12 rounded-xl p-0.5 bg-slate-950 border border-amber-300 overflow-hidden">
                            <img src="${escapeHtmlText(iconUrl)}" onError="this.onerror=null;this.src='/images/items/default.png';" alt="${escapeHtmlText(item.name)}" class="w-full h-full object-cover rounded-lg" />
                        </div>
                        <span class="font-extrabold text-xs text-white leading-tight">${escapeHtmlText(item.name)}</span>
                        <span class="text-[10px] font-mono font-extrabold text-amber-300">💰 ${Number(item.cost || 0).toLocaleString()}g</span>
                    </div>
                    ${downHtml}
                </div>
            </div>
        `;
    }

    function openItemModal(cleanCode) {
        const key = (cleanCode || '').toLowerCase().trim();
        let item = getItemByCode(key);

        if (!item) {
            item = {
                name: (cleanCode || '').replace(/_/g, ' ').toUpperCase(),
                cost: "1000",
                description: "Standard Hero Item used in Project KONGOR combat.",
                flavor: "",
                icon: `/images/items/${key}.png`,
                components: [],
                buildsInto: [],
                upgrade: "",
                isActive: true
            };
        }

        const isActive = item.isActive !== false;

        const rawIcon = item.icon || `/images/items/${key}.png`;
        document.getElementById('modal-item-icon').src = rawIcon;
        document.getElementById('modal-item-name').innerText = item.name;

        const codeElem = document.getElementById('modal-item-code-val');
        if (codeElem) codeElem.innerText = item.code || item.key || key;

        document.getElementById('modal-item-desc').innerText = item.description || "No description available.";

        const statusBadge = document.getElementById('modal-status-badge');
        const disabledWarning = document.getElementById('modal-disabled-warning');

        if (isActive) {
            statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-emerald-500/10 border border-emerald-500/30 text-emerald-400';
            statusBadge.innerText = 'ACTIVE';
            disabledWarning.classList.add('hidden');
        } else {
            statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-red-500/10 border border-red-500/30 text-red-400';
            statusBadge.innerText = 'DISABLED';
            disabledWarning.classList.remove('hidden');
        }

        // Header Metadata Pills
        const costContainer = document.getElementById('modal-item-cost-container');
        if (costContainer) {
            let html = '';
            if (item.category) {
                html += `<span class="px-3 py-1 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 font-medium">Category: <strong class="text-amber-300">${escapeHtmlText(item.category)}</strong></span>`;
            }
            html += `<span class="px-3 py-1 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 font-medium">Cost: <strong class="text-amber-400 font-mono">💰 ${Number(item.cost || 0).toLocaleString()} Gold</strong></span>`;
            if (item.recipeCost && Number(item.recipeCost) > 0) {
                html += `<span class="px-3 py-1 rounded-xl bg-purple-500/10 border border-purple-500/30 text-purple-300 font-medium">Recipe Scroll Cost: <strong class="font-mono">${Number(item.recipeCost).toLocaleString()}g</strong></span>`;
            }
            costContainer.innerHTML = html;
        }

        let compsToRender = (item.components && item.components.length > 0) ? [...item.components] : [];
        const realComps = compsToRender.filter(c => !isRecipeRef(c));
        const hasRecipe = compsToRender.some(c => isRecipeRef(c)) || (item.recipeCost && Number(item.recipeCost) > 0);

        const fullPageLink = document.getElementById('modal-full-page-link');
        if (fullPageLink) {
            fullPageLink.href = `/item/${encodeURIComponent(item.key || item.code || key)}`;
        }

        // Populate Connected MOBA Visual Crafting Tree (Forward & Backward)
        const treeContainer = document.getElementById('modal-item-tree-container');
        const treeContent = document.getElementById('modal-item-tree-content');
        const treeSummary = document.getElementById('modal-item-tree-summary');
        if (treeContainer && treeContent) {
            const upstreamCount = (item.buildsInto && item.buildsInto.length) ? item.buildsInto.length : 0;
            const downstreamCount = realComps.length + (hasRecipe ? 1 : 0);
            if (treeSummary) {
                treeSummary.innerText = `${upstreamCount} Upgrades • ${downstreamCount} Ingredients`;
            }
            treeContent.innerHTML = renderVisualCraftingTreeModal(item);
            treeContainer.classList.remove('hidden');
        }

        // Populate Builds Into section
        const buildsContainer = document.getElementById('modal-item-builds-into-container');
        const buildsList = document.getElementById('modal-item-builds-into-list');
        if (buildsList && buildsContainer) {
            buildsList.innerHTML = '';
            let buildsToRender = (item.buildsInto && item.buildsInto.length > 0) ? item.buildsInto : [];

            if (buildsToRender.length > 0) {
                buildsContainer.classList.remove('hidden');
                buildsToRender.forEach(b => {
                    const bCode = extractItemRefCode(b);
                    if (!bCode) return;
                    const matchedTarget = getItemByCode(bCode);
                    const bObjIcon = typeof b === 'object' && b !== null ? (b.icon || b.Icon) : '';
                    const bObjName = typeof b === 'object' && b !== null ? (b.name || b.Name) : '';
                    const bObjCost = typeof b === 'object' && b !== null ? (b.cost || b.Cost) : 0;

                    const normCode = matchedTarget ? (matchedTarget.key || matchedTarget.code || bCode) : bCode.replace(/^item_/i, '');
                    const bIcon = (matchedTarget && matchedTarget.icon)
                        ? matchedTarget.icon
                        : (bObjIcon ? (String(bObjIcon).startsWith('/') ? bObjIcon : `/images/items/${bObjIcon}.png`) : `/images/items/${normCode}.png`);
                    const bName = (matchedTarget && matchedTarget.name) ? matchedTarget.name : (bObjName || normCode);
                    const bCost = (matchedTarget && matchedTarget.cost) ? matchedTarget.cost : bObjCost;

                    const bCard = document.createElement('div');
                    bCard.className = 'flex items-center gap-3 p-3 rounded-2xl bg-slate-900 border border-cyan-500/30 hover:border-cyan-400 hover:bg-slate-800/80 transition-all text-slate-200 group cursor-pointer';
                    const targetBCode = normCode;
                    bCard.addEventListener('click', function () {
                        openItemModal(targetBCode);
                    });
                    bCard.innerHTML = `
                        <img src="${escapeHtmlText(bIcon)}" onError="this.onerror=null;this.src='/images/items/default.png';" alt="${escapeHtmlText(bName)}" class="w-9 h-9 rounded-xl object-cover border border-slate-700 bg-slate-950 flex-shrink-0" />
                        <div class="flex flex-col min-w-0">
                            <span class="font-bold text-xs text-white group-hover:text-cyan-300 transition-colors truncate">${escapeHtmlText(bName)}</span>
                            <span class="text-[11px] text-amber-400 font-mono">💰 ${Number(bCost || 0).toLocaleString()}g</span>
                        </div>
                    `;
                    buildsList.appendChild(bCard);
                });
            } else {
                buildsContainer.classList.add('hidden');
            }
        }

        const upgradeContainer = document.getElementById('modal-item-upgrade-container');
        const upgradeText = document.getElementById('modal-item-upgrade-text');
        if (item.upgrade && item.upgrade.trim().length > 0) {
            upgradeText.innerText = item.upgrade;
            upgradeContainer.classList.remove('hidden');
        } else {
            upgradeContainer.classList.add('hidden');
        }

        // Populate Level Upgrade Breakdown
        const levelsContainer = document.getElementById('modal-item-levels-container');
        const levelsList = document.getElementById('modal-item-levels-list');
        const levelsCount = document.getElementById('modal-item-levels-count');

        if (levelsContainer && levelsList) {
            levelsList.innerHTML = '';
            const upgText = item.upgrade || item.description || '';
            const lvlMatch = upgText.match(/level\s*(\d+)/i) || upgText.match(/upgradable\s*to\s*level\s*(\d+)/i);
            let maxLvl = lvlMatch ? parseInt(lvlMatch[1]) : 0;
            if (maxLvl <= 1) {
                const keyLower = (item.key || item.code || cleanCode || '').toLowerCase();
                if (['shieldbreaker', 'pierce', 'spellshards', 'riftshards', 'puzzlebox', 'nullfireblade', 'manaburn1'].includes(keyLower)) {
                    maxLvl = (keyLower === 'riftshards') ? 4 : 3;
                }
            }

            if (maxLvl > 1) {
                levelsContainer.classList.remove('hidden');
                if (levelsCount) levelsCount.innerText = `${maxLvl} Upgradable Tiers`;

                const baseCost = Number(item.cost || 0);
                const scrollCost = Number(item.recipeCost || 1000);

                for (let l = 1; l <= maxLvl; l++) {
                    const totalCost = baseCost + (l - 1) * scrollCost;
                    const tierCard = document.createElement('div');
                    tierCard.className = 'p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1.5 hover:border-slate-700 transition-colors';
                    tierCard.innerHTML = `
                        <div class="flex items-center justify-between">
                            <span class="px-2.5 py-0.5 rounded-lg text-xs font-bold bg-slate-800 text-amber-300 border border-slate-700">
                                LEVEL ${l}
                            </span>
                            <span class="text-xs font-bold text-amber-400 font-mono">
                                💰 ${totalCost.toLocaleString()}g
                            </span>
                        </div>
                        <div class="text-[11px] text-slate-400 font-mono pt-1 border-t border-slate-800/60">
                            ${l === 1 ? 'Base Item Initial Cost' : `Recipe Scroll (+${scrollCost.toLocaleString()}g)`}
                        </div>
                    `;
                    levelsList.appendChild(tierCard);
                }
            } else {
                levelsContainer.classList.add('hidden');
            }
        }

        const flavorElem = document.getElementById('modal-item-flavor');
        const flavorContainer = document.getElementById('modal-item-flavor-container');
        if (item.flavor && item.flavor.trim().length > 0) {
            flavorElem.innerText = `"${item.flavor}"`;
            flavorContainer.classList.remove('hidden');
        } else {
            flavorContainer.classList.add('hidden');
        }

        document.getElementById('item-detail-modal').classList.remove('hidden');
    }

    function closeItemModal() {
        const modal = document.getElementById('item-detail-modal');
        if (modal) modal.classList.add('hidden');
    }

    window.openItemModal = openItemModal;
    window.closeItemModal = closeItemModal;

    // Close modal when clicking backdrop outside dialog card or pressing Escape key
    const itemModalElem = document.getElementById('item-detail-modal');
    if (itemModalElem) {
        itemModalElem.addEventListener('click', function (e) {
            if (e.target === this) {
                closeItemModal();
            }
        });
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeItemModal();
        }
    });

    // Click-and-drag horizontal scrolling on mini component strips (zero visible scrollbar; suppresses card click only when dragged)
    (function initComponentDragScroll() {
        const gridElem = document.getElementById('items-grid');
        if (!gridElem) return;

        let activeStrip = null;
        let pointerId = null;
        let startX = 0;
        let startScrollLeft = 0;
        let hasDragged = false;
        let suppressCardClickUntil = 0;

        gridElem.addEventListener('pointerdown', function (e) {
            if (e.button !== 0) return;
            const strip = e.target.closest('[data-drag-scroll="true"]');
            if (!strip || strip.scrollWidth <= strip.clientWidth) return;
            activeStrip = strip;
            pointerId = e.pointerId;
            startX = e.clientX;
            startScrollLeft = strip.scrollLeft;
            hasDragged = false;
        });

        gridElem.addEventListener('pointermove', function (e) {
            if (!activeStrip || e.pointerId !== pointerId) return;
            const dx = e.clientX - startX;
            if (!hasDragged && Math.abs(dx) > 5) {
                hasDragged = true;
                activeStrip.classList.add('is-dragging');
                try { activeStrip.setPointerCapture(e.pointerId); } catch (_) { }
            }
            if (hasDragged) {
                activeStrip.scrollLeft = startScrollLeft - dx;
                e.preventDefault();
            }
        });

        function endStripDrag(e) {
            if (!activeStrip) return;
            if (hasDragged) {
                suppressCardClickUntil = performance.now() + 220;
                console.debug('[ItemsCompendium] Completed horizontal drag-scroll on component strip (scrollLeft=%d)', activeStrip.scrollLeft);
            }
            activeStrip.classList.remove('is-dragging');
            try {
                if (pointerId !== null && activeStrip.hasPointerCapture(pointerId)) {
                    activeStrip.releasePointerCapture(pointerId);
                }
            } catch (_) { }
            activeStrip = null;
            pointerId = null;
            hasDragged = false;
        }

        gridElem.addEventListener('pointerup', endStripDrag);
        gridElem.addEventListener('pointercancel', endStripDrag);

        gridElem.addEventListener('click', function (e) {
            if (performance.now() < suppressCardClickUntil) {
                e.preventDefault();
                e.stopPropagation();
                suppressCardClickUntil = 0;
            }
        }, true);
    })();
</script>
