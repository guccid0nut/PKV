@model HeroItemDto
@{
    ViewData["Title"] = $"{Model.Name} - Item Compendium";
    var components = ViewBag.Components as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var buildsInto = ViewBag.BuildsInto as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var levelTiers = ViewBag.LevelTiers as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var backwardTree = ViewBag.BackwardTree as List<DAWNBRINGER.WebPortal.UI.Controllers.HomeController.ItemCraftingTreeNode> ?? new List<DAWNBRINGER.WebPortal.UI.Controllers.HomeController.ItemCraftingTreeNode>();
    var forwardTree = ViewBag.ForwardTree as List<DAWNBRINGER.WebPortal.UI.Controllers.HomeController.ItemCraftingTreeNode> ?? new List<DAWNBRINGER.WebPortal.UI.Controllers.HomeController.ItemCraftingTreeNode>();
    var isActive = Model.IsActive;
    var costNum = Model.Cost;

    IEnumerable<dynamic> compList = components as dynamic[] ?? components.ToArray();
    IEnumerable<dynamic> buildsIntoListEnum = buildsInto as dynamic[] ?? buildsInto.ToArray();
    IEnumerable<dynamic> levelTiersEnum = levelTiers as dynamic[] ?? levelTiers.ToArray();

    int compCount = compList.Count();
    int buildsCount = buildsIntoListEnum.Count();

    string catLower = (Model.Category ?? "").ToLowerInvariant();
    string auraClass = "from-amber-500/25 via-yellow-500/10 to-transparent";
    string borderGlow = "border-amber-400/50 shadow-amber-500/20";
    if (costNum >= 4500 || catLower.Contains("relic") || catLower.Contains("artifact"))
    {
        auraClass = "from-amber-400/30 via-yellow-500/15 to-transparent";
        borderGlow = "border-amber-400/70 shadow-amber-500/30";
    }
    else if (catLower.Contains("combative") || catLower.Contains("morph"))
    {
        auraClass = "from-purple-500/25 via-fuchsia-500/10 to-transparent";
        borderGlow = "border-purple-400/60 shadow-purple-500/20";
    }
    else if (catLower.Contains("initiation") || catLower.Contains("protective"))
    {
        auraClass = "from-cyan-500/25 via-blue-500/10 to-transparent";
        borderGlow = "border-cyan-400/60 shadow-cyan-500/20";
    }
    else if (catLower.Contains("supplies") || catLower.Contains("consumable"))
    {
        auraClass = "from-emerald-500/25 via-teal-500/10 to-transparent";
        borderGlow = "border-emerald-400/60 shadow-emerald-500/20";
    }
}

<div class="max-w-5xl mx-auto space-y-6 animate-fade-in pb-16">
    <!-- Back Navigation -->
    <div class="flex items-center justify-between flex-wrap gap-3">
        <a asp-controller="Home" asp-action="Items"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-300 hover:text-white text-xs font-bold border border-slate-800 transition-all shadow-sm group">
            <span class="group-hover:-translate-x-1 transition-transform">←</span>
            <span>Back to Item Compendium</span>
        </a>

        <div class="flex items-center gap-2 flex-wrap">
            <span
                class="px-3.5 py-1 rounded-full text-xs font-bold bg-amber-500/10 border border-amber-500/30 text-amber-400 shadow-sm font-mono">
                💰 @costNum.ToString("N0")g
            </span>
            <span
                class="px-3 py-1 rounded-full text-xs font-bold bg-slate-800 border border-slate-700 text-slate-300 uppercase tracking-wider">
                @Model.Category
            </span>
            @if (isActive)
            {
                <span
                    class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 uppercase tracking-wider">
                    ACTIVE
                </span>
            }
            else
            {
                <span
                    class="px-3 py-1 rounded-full text-xs font-bold bg-red-500/10 border border-red-500/30 text-red-400 uppercase tracking-wider">
                    DISABLED
                </span>
            }
        </div>
    </div>

    <!-- Recipe Flowchart Breadcrumb Stepper -->
    <div class="glass-card p-3 sm:p-4 rounded-2xl border border-slate-800 bg-slate-950/60 flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2 text-slate-400 font-semibold">
            <span class="text-amber-400">🗺️</span>
            <span class="uppercase tracking-wider text-[11px] text-slate-300">Recipe Flow:</span>
        </div>
        <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
            <!-- Step 1: Components (Backward Path) -->
            @if (compCount > 0)
            {
                <a href="#recipe-components" class="px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-700 hover:border-amber-400/50 text-slate-300 hover:text-amber-300 transition-all flex items-center gap-1.5 font-bold shadow-sm">
                    <span>🔨</span>
                    <span>@compCount Components</span>
                </a>
            }
            else
            {
                <span class="px-3 py-1.5 rounded-xl bg-slate-900/40 border border-slate-800/60 text-slate-500 flex items-center gap-1.5 font-medium" title="Raw component that does not require crafting ingredients.">
                    <span>🌱</span>
                    <span>Base Component</span>
                </span>
            }

            <span class="text-amber-400 font-bold">➔</span>

            <!-- Step 2: Current Item -->
            <div class="px-3.5 py-1.5 rounded-xl bg-amber-500/20 border border-amber-400/60 text-amber-300 font-extrabold flex items-center gap-1.5 shadow-lg shadow-amber-500/10">
                <span>🌟</span>
                <span>@Model.Name</span>
            </div>

            <span class="text-cyan-400 font-bold">➔</span>

            <!-- Step 3: Builds Into (Forward Path) -->
            @if (buildsCount > 0)
            {
                <a href="#builds-into" class="px-3 py-1.5 rounded-xl bg-slate-900 border border-cyan-500/40 hover:border-cyan-400 text-cyan-300 hover:text-white transition-all flex items-center gap-1.5 font-bold shadow-sm">
                    <span>⚡</span>
                    <span>Builds Into @buildsCount @(buildsCount == 1 ? "Item" : "Items")</span>
                </a>
            }
            else
            {
                <span class="px-3 py-1.5 rounded-xl bg-slate-900/40 border border-slate-800/60 text-slate-500 flex items-center gap-1.5 font-medium" title="Terminal item that does not craft into higher tiers.">
                    <span>👑</span>
                    <span>Terminal Item</span>
                </span>
            }
        </div>
    </div>

    <!-- Main Header Card (With Embedded Item Effects & Stats) -->
    <div
        class="glass-card p-6 sm:p-8 rounded-3xl border border-slate-800 relative overflow-hidden shadow-2xl space-y-5">
        <div
            class="absolute -right-20 -top-20 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 relative z-10">
            <!-- Gilded Glassmorphic Socket with Category Radiant Aura -->
            <div class="relative group flex-shrink-0">
                <div class="absolute -inset-2 bg-gradient-radial @auraClass rounded-3xl blur-xl pointer-events-none opacity-80 group-hover:opacity-100 transition-opacity"></div>
                <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-3xl p-1 bg-gradient-to-b from-amber-400/40 via-slate-800 to-amber-600/30 border-2 @borderGlow shadow-2xl overflow-hidden">
                    <div class="relative w-full h-full rounded-2xl overflow-hidden bg-slate-950 ring-1 ring-white/15 ring-inset flex items-center justify-center">
                        <img src="@Model.IconPath" onError="this.onerror=null;this.src='/images/items/default.png';"
                             alt="@Model.Name" class="w-full h-full object-cover rounded-2xl transition-transform duration-500 group-hover:scale-110"/>
                        <div class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-transparent via-white/15 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    </div>
                    @if (Model.RecipeCost > 0)
                    {
                        <div class="absolute bottom-1.5 right-1.5 px-2 py-0.5 rounded-lg bg-slate-950/95 border border-amber-400/70 text-[10px] font-mono font-bold text-amber-300 shadow-md flex items-center gap-1 backdrop-blur-sm" title="Recipe Scroll (+@Model.RecipeCost.ToString("N0")g)">
                            <span>📜</span>
                            <span>+@Model.RecipeCost.ToString("N0")g</span>
                        </div>
                    }
                </div>
            </div>

            <div class="space-y-3 flex-1 min-w-0">
                <div>
                    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">@Model.Name</h1>
                    <p class="text-xs font-mono text-amber-400/80 mt-1">Item Code: <span
                            class="font-bold text-white">@Model.Code</span></p>
                </div>

                <div class="flex flex-wrap items-center gap-2 text-xs">
                    <span class="px-3 py-1 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 font-medium">
                        Category: <strong class="text-amber-300">@Model.Category</strong>
                    </span>
                    <span class="px-3 py-1 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 font-medium">
                        Total Cost: <strong class="text-amber-400 font-mono">@costNum.ToString("N0") Gold</strong>
                    </span>
                    @if (Model.RecipeCost > 0)
                    {
                        <span
                            class="px-3 py-1 rounded-xl bg-purple-500/10 border border-purple-500/30 text-purple-300 font-medium flex items-center gap-1">
                            <span>📜</span>
                            <span>Recipe Scroll:</span> <strong class="font-mono text-amber-300">@Model.RecipeCost.ToString("N0")g</strong>
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Embedded Item Description / Effects & Stats -->
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="p-4 sm:p-5 rounded-2xl bg-slate-950/70 border border-slate-800/80 relative z-10 space-y-1.5 shadow-inner">
                <div class="text-[11px] font-bold text-amber-400 uppercase tracking-widest flex items-center gap-1.5">
                    <span>✨</span> ITEM EFFECTS & STATS
                </div>
                <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
                    @Model.Description
                </p>
            </div>
        }
    </div>

    <!-- Interactive Connected MOBA Visual Crafting Tree (Forward & Backward Hierarchy) -->
    @{
        void RenderUpstreamNodes(List<DAWNBRINGER.WebPortal.UI.Controllers.HomeController.ItemCraftingTreeNode> nodes)
        {
            if (nodes == null || nodes.Count == 0) return;
            <ul class="moba-tree-up">
                @foreach (var node in nodes)
                {
                    <li>
                        <a href="/item/@node.Code"
                           title="Builds into @node.Name (@node.Cost.ToString("N0")g)"
                           class="group flex flex-col items-center gap-1.5 px-3 py-2.5 rounded-2xl bg-slate-900/95 border border-cyan-500/35 hover:border-cyan-400 hover:bg-slate-800/95 transition-all duration-200 shadow-lg hover:shadow-cyan-500/20 min-w-[104px] max-w-[136px] text-center no-underline relative">
                            <div class="relative w-11 h-11 rounded-xl p-0.5 bg-slate-950 border border-cyan-400/40 group-hover:border-cyan-300 shadow-inner overflow-hidden">
                                <img src="@node.Icon"
                                     onError="this.onerror=null;this.src='/images/items/default.png';"
                                     alt="@node.Name"
                                     class="w-full h-full object-cover rounded-lg group-hover:scale-110 transition-transform" />
                            </div>
                            <span class="font-bold text-[11px] text-white group-hover:text-cyan-300 leading-tight line-clamp-2">@node.Name</span>
                            <span class="text-[10px] font-mono font-bold text-cyan-300/90 bg-cyan-950/60 px-2 py-0.5 rounded-full border border-cyan-500/25">💰 @node.Cost.ToString("N0")g</span>
                        </a>
                        @if (node.Children != null && node.Children.Count > 0)
                        {
                            RenderUpstreamNodes(node.Children);
                        }
                    </li>
                }
            </ul>
        }

        void RenderDownstreamNodes(List<DAWNBRINGER.WebPortal.UI.Controllers.HomeController.ItemCraftingTreeNode> nodes)
        {
            if (nodes == null || nodes.Count == 0) return;
            <ul class="moba-tree-down">
                @foreach (var node in nodes)
                {
                    <li>
                        @if (node.IsRecipe)
                        {
                            <div title="Recipe Scroll (+@node.Cost.ToString("N0")g)"
                                 class="flex flex-col items-center gap-1.5 px-3 py-2.5 rounded-2xl bg-slate-900/75 border border-purple-500/35 min-w-[104px] max-w-[136px] text-center shadow-md">
                                <div class="w-11 h-11 rounded-xl bg-slate-950 border border-amber-400/40 flex items-center justify-center text-lg shadow-inner overflow-hidden">
                                    <img src="/images/items/recipe.png"
                                         onError="this.onerror=null;this.parentElement.innerHTML='📜';"
                                         alt="Recipe Scroll"
                                         class="w-8 h-8 object-contain" />
                                </div>
                                <span class="font-bold text-[11px] text-purple-200 leading-tight">Recipe Scroll</span>
                                <span class="text-[10px] font-mono font-bold text-amber-300 bg-purple-950/60 px-2 py-0.5 rounded-full border border-purple-500/30">+@node.Cost.ToString("N0")g</span>
                            </div>
                        }
                        else
                        {
                            <a href="/item/@node.Code"
                               title="Requires @node.Name (@node.Cost.ToString("N0")g)"
                               class="group flex flex-col items-center gap-1.5 px-3 py-2.5 rounded-2xl bg-slate-900/95 border border-amber-500/35 hover:border-amber-400 hover:bg-slate-800/95 transition-all duration-200 shadow-lg hover:shadow-amber-500/20 min-w-[104px] max-w-[136px] text-center no-underline relative">
                                <div class="relative w-11 h-11 rounded-xl p-0.5 bg-slate-950 border border-amber-400/40 group-hover:border-amber-300 shadow-inner overflow-visible">
                                    <img src="@node.Icon"
                                         onError="this.onerror=null;this.src='/images/items/default.png';"
                                         alt="@node.Name"
                                         class="w-full h-full object-cover rounded-lg group-hover:scale-110 transition-transform" />
                                    @if (node.Quantity > 1)
                                    {
                                        <span class="absolute -top-2 -right-2 px-1.5 py-0.5 rounded-full bg-amber-400 text-slate-950 font-black text-[10px] leading-none shadow-md ring-2 ring-slate-950">×@node.Quantity</span>
                                    }
                                </div>
                                <span class="font-bold text-[11px] text-white group-hover:text-amber-300 leading-tight line-clamp-2">@node.Name</span>
                                <span class="text-[10px] font-mono font-bold text-amber-300 bg-amber-950/50 px-2 py-0.5 rounded-full border border-amber-500/25">💰 @node.Cost.ToString("N0")g</span>
                            </a>
                        }
                        @if (node.Children != null && node.Children.Count > 0)
                        {
                            RenderDownstreamNodes(node.Children);
                        }
                    </li>
                }
            </ul>
        }
    }

    <style>
        .moba-tree-down, .moba-tree-up {
            display: flex;
            justify-content: center;
            list-style: none;
            margin: 0;
            padding: 0;
            position: relative;
        }
        .moba-tree-down {
            padding-top: 20px;
        }
        .moba-tree-down::before {
            content: '';
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 2px;
            height: 20px;
            background: rgba(251, 191, 36, 0.65);
        }
        .moba-tree-down > li {
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            padding: 20px 8px 0 8px;
        }
        .moba-tree-down > li::before,
        .moba-tree-down > li::after {
            content: '';
            position: absolute;
            top: 0;
            right: 50%;
            width: 50%;
            height: 20px;
            border-top: 2px solid rgba(251, 191, 36, 0.55);
        }
        .moba-tree-down > li::after {
            right: auto;
            left: 50%;
            border-left: 2px solid rgba(251, 191, 36, 0.55);
        }
        .moba-tree-down > li:first-child::before {
            border: 0 none;
        }
        .moba-tree-down > li:first-child::after {
            border-top-left-radius: 10px;
        }
        .moba-tree-down > li:last-child::after {
            border: 0 none;
        }
        .moba-tree-down > li:last-child::before {
            border-right: 2px solid rgba(251, 191, 36, 0.55);
            border-top-right-radius: 10px;
        }
        .moba-tree-down > li:only-child {
            padding-top: 0;
        }
        .moba-tree-down > li:only-child::before,
        .moba-tree-down > li:only-child::after {
            display: none;
        }

        .moba-tree-up {
            padding-bottom: 20px;
        }
        .moba-tree-up::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 2px;
            height: 20px;
            background: rgba(34, 211, 238, 0.65);
        }
        .moba-tree-up > li {
            display: flex;
            flex-direction: column-reverse;
            align-items: center;
            position: relative;
            padding: 0 8px 20px 8px;
        }
        .moba-tree-up > li::before,
        .moba-tree-up > li::after {
            content: '';
            position: absolute;
            bottom: 0;
            right: 50%;
            width: 50%;
            height: 20px;
            border-bottom: 2px solid rgba(34, 211, 238, 0.55);
        }
        .moba-tree-up > li::after {
            right: auto;
            left: 50%;
            border-left: 2px solid rgba(34, 211, 238, 0.55);
        }
        .moba-tree-up > li:first-child::before {
            border: 0 none;
        }
        .moba-tree-up > li:first-child::after {
            border-bottom-left-radius: 10px;
        }
        .moba-tree-up > li:last-child::after {
            border: 0 none;
        }
        .moba-tree-up > li:last-child::before {
            border-right: 2px solid rgba(34, 211, 238, 0.55);
            border-bottom-right-radius: 10px;
        }
        .moba-tree-up > li:only-child {
            padding-bottom: 0;
        }
        .moba-tree-up > li:only-child::before,
        .moba-tree-up > li:only-child::after {
            display: none;
        }
    </style>

    <div id="crafting-tree" class="glass-card p-6 sm:p-7 rounded-3xl border border-slate-800 space-y-5 shadow-2xl bg-slate-950/75 relative overflow-hidden">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800/80 pb-4">
            <div>
                <h2 class="text-xs sm:text-sm font-extrabold text-white uppercase tracking-widest flex items-center gap-2">
                    <span class="text-amber-400">🌳</span> INTERACTIVE CRAFTING TREE (FORWARD &amp; BACKWARD HIERARCHY)
                </h2>
                <p class="text-[11px] text-slate-400 mt-1">Click any upstream upgrade or downstream ingredient node to inspect its full shop hierarchy.</p>
            </div>
            <div class="flex items-center gap-2 text-[10px] font-mono uppercase">
                <span class="px-2.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 font-bold">⚡ Upstream Upgrades (@forwardTree.Count)</span>
                <span class="px-2.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 font-bold">🔨 Base Ingredients (@backwardTree.Count)</span>
            </div>
        </div>

        <div class="overflow-x-auto py-2">
            <div class="min-w-full w-max mx-auto flex flex-col items-center px-4">
                <!-- Upstream Branch: Builds Into -->
                @if (forwardTree.Count > 0)
                {
                    <div class="mb-2 px-3 py-1 rounded-full bg-cyan-950/70 border border-cyan-500/30 text-[10px] font-bold uppercase tracking-wider text-cyan-300">
                        ⚡ Builds Into (Upper Tiers)
                    </div>
                    RenderUpstreamNodes(forwardTree);
                }
                else
                {
                    <div class="mb-3 px-3.5 py-1.5 rounded-full bg-slate-900/70 border border-slate-800 text-[11px] font-semibold text-slate-400 flex items-center gap-1.5">
                        <span>👑</span>
                        <span>Terminal Tier Item — Does not combine into higher recipes</span>
                    </div>
                }

                <!-- Center Focal Active Item Hub -->
                <div class="relative z-10 flex flex-col items-center gap-2 px-6 py-4 rounded-3xl bg-gradient-to-b from-amber-500/20 via-slate-900 to-slate-950 border-2 border-amber-400 shadow-2xl shadow-amber-500/20 min-w-[168px] text-center">
                    <span class="px-2.5 py-0.5 rounded-full bg-amber-400 text-slate-950 text-[9px] font-black uppercase tracking-widest shadow">
                        🌟 Active Item
                    </span>
                    <div class="w-16 h-16 rounded-2xl p-0.5 bg-slate-950 border-2 border-amber-300 shadow-lg overflow-hidden">
                        <img src="@Model.IconPath"
                             onError="this.onerror=null;this.src='/images/items/default.png';"
                             alt="@Model.Name"
                             class="w-full h-full object-cover rounded-xl" />
                    </div>
                    <div class="font-extrabold text-sm text-white leading-tight">@Model.Name</div>
                    <div class="text-xs font-mono font-extrabold text-amber-300 bg-slate-950/90 px-3 py-0.5 rounded-full border border-amber-400/40">
                        💰 @costNum.ToString("N0")g
                    </div>
                </div>

                <!-- Downstream Branch: Requires Components -->
                @if (backwardTree.Count > 0)
                {
                    RenderDownstreamNodes(backwardTree);
                    <div class="mt-3 px-3 py-1 rounded-full bg-amber-950/60 border border-amber-500/30 text-[10px] font-bold uppercase tracking-wider text-amber-300">
                        🔨 Required Crafting Components (Lower Tiers)
                    </div>
                }
                else
                {
                    <div class="mt-3 px-3.5 py-1.5 rounded-full bg-slate-900/70 border border-slate-800 text-[11px] font-semibold text-slate-400 flex items-center gap-1.5">
                        <span>🌱</span>
                        <span>Base Shop Component — Purchased directly for @costNum.ToString("N0")g</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 1. Recipe Components Section (Backward Crafting Path) -->
    @if (compList.Any())
    {
        <div id="recipe-components" class="glass-card p-6 sm:p-7 rounded-3xl border border-slate-800 space-y-4 shadow-xl">
            <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold text-slate-200 uppercase tracking-widest flex items-center gap-2">
                    <span class="text-amber-400">🔨</span> RECIPE COMPONENTS (Backward Crafting Path)
                </h3>
                <span class="text-[11px] font-mono text-slate-400">@compCount Total Ingredients</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3.5">
                @foreach (var comp in compList)
                {
                    bool isRecipe = comp.isRecipe;
                    string compCode = comp.code;
                    string compName = comp.name;
                    string compCost = comp.cost;
                    string compIcon = comp.icon;

                    if (isRecipe)
                    {
                        <div class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-slate-900/60 border border-slate-800 text-slate-400 shadow-sm">
                            <div class="w-12 h-12 rounded-xl bg-slate-950 border border-amber-500/30 flex items-center justify-center text-xl flex-shrink-0 shadow-inner overflow-hidden">
                                <img src="/images/items/recipe.png" onError="this.onerror=null;this.parentElement.innerHTML='📜';" alt="Recipe Scroll" class="w-8 h-8 object-contain" />
                            </div>
                            <div class="flex flex-col min-w-0 flex-1">
                                <span class="font-bold text-xs text-slate-300 truncate">@compName</span>
                                <span class="text-[11px] text-amber-400 font-mono font-semibold">💰 @compCost g</span>
                            </div>
                            <span class="text-[10px] font-mono text-slate-500 uppercase">Scroll</span>
                        </div>
                    }
                    else
                    {
                        <a href="/item/@compCode"
                           class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-slate-900/90 border border-slate-800 hover:border-amber-400/50 hover:bg-slate-800/90 transition-all duration-300 text-slate-200 group shadow-md hover:shadow-amber-500/10">
                            <div class="w-12 h-12 rounded-xl bg-slate-950 border border-amber-400/30 p-0.5 flex-shrink-0 group-hover:border-amber-400 transition-colors shadow-inner overflow-hidden relative">
                                <img src="@compIcon" onError="this.onerror=null;this.src='/images/items/default.png';"
                                     alt="@compName"
                                     class="w-full h-full object-cover rounded-lg group-hover:scale-105 transition-transform"/>
                            </div>
                            <div class="flex flex-col min-w-0 flex-1">
                                <span class="font-bold text-xs text-white group-hover:text-amber-300 transition-colors truncate">@compName</span>
                                <span class="text-[11px] text-amber-400 font-mono font-semibold">💰 @compCost g</span>
                            </div>
                            <span class="text-slate-500 group-hover:text-amber-300 group-hover:translate-x-0.5 transition-all text-sm">➔</span>
                        </a>
                    }
                }
            </div>
        </div>
    }

    <!-- 2. Builds Into Section (Forward Crafting Path) -->
    @if (buildsIntoListEnum.Any())
    {
        <div id="builds-into" class="glass-card p-6 sm:p-7 rounded-3xl border border-cyan-500/30 space-y-4 shadow-xl">
            <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold text-cyan-400 uppercase tracking-widest flex items-center gap-2">
                    <span>⚡</span> BUILDS INTO (Forward Upgrade Path)
                </h3>
                <span class="text-[11px] font-mono text-cyan-400/80 font-medium">Used in @buildsCount @(buildsCount == 1 ? "Recipe" : "Recipes")</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3.5">
                @foreach (var target in buildsIntoListEnum)
                {
                    string targetCode = target.code;
                    string targetName = target.name;
                    string targetCost = target.cost;
                    string targetIcon = target.icon;

                    <a href="/item/@targetCode"
                       class="flex items-center gap-3.5 p-3.5 rounded-2xl bg-slate-900/90 border border-cyan-500/30 hover:border-cyan-400 hover:bg-slate-800/90 transition-all duration-300 text-slate-200 group shadow-md hover:shadow-cyan-500/10">
                        <div class="w-12 h-12 rounded-xl bg-slate-950 border border-cyan-400/40 p-0.5 flex-shrink-0 group-hover:border-cyan-400 transition-colors shadow-inner overflow-hidden relative">
                            <img src="@targetIcon" onError="this.onerror=null;this.src='/images/items/default.png';"
                                 alt="@targetName"
                                 class="w-full h-full object-cover rounded-lg group-hover:scale-105 transition-transform"/>
                        </div>
                        <div class="flex flex-col min-w-0 flex-1">
                            <span class="font-bold text-xs text-white group-hover:text-cyan-300 transition-colors truncate">@targetName</span>
                            <span class="text-[11px] text-amber-400 font-mono font-semibold">💰 @targetCost g</span>
                        </div>
                        <span class="text-slate-500 group-hover:text-cyan-300 group-hover:translate-x-0.5 transition-all text-sm">➔</span>
                    </a>
                }
            </div>
        </div>
    }

    <!-- Disabled Warning Banner if Item is Disabled -->
    @if (!isActive)
    {
        <div
            class="p-4 rounded-2xl bg-red-950/40 border border-red-500/40 text-red-300 text-xs flex items-center gap-3">
            <span class="text-xl">⚠️</span>
            <div>
                <strong class="font-bold">Item Disabled:</strong> This item is currently inactive or disabled in active
                competitive matchmaking modes.
            </div>
        </div>
    }

    <!-- Upgrade Banner -->
    @if (!string.IsNullOrWhiteSpace(Model.Upgrade))
    {
        <div
            class="p-4 rounded-2xl bg-cyan-950/40 border border-cyan-500/40 text-cyan-300 text-xs sm:text-sm flex items-center gap-3 shadow-md">
            <span class="text-xl">🛡️</span>
            <div>
                <strong class="font-bold">Upgrade Path:</strong> @Model.Upgrade
            </div>
        </div>
    }

    <!-- Level Upgrade Tier Pricing Section (Card Grid matching modal style) -->
    @if (levelTiersEnum.Any())
    {
        <div class="glass-card p-6 sm:p-7 rounded-3xl border border-amber-500/30 space-y-4 bg-slate-950/60 shadow-xl">
            <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold text-amber-400 uppercase tracking-widest flex items-center gap-2">
                    <span>📈</span> LEVEL UPGRADE & PRICING BREAKDOWN
                </h3>
                <span
                    class="text-[11px] font-medium text-slate-400 font-mono">@levelTiersEnum.Count() Upgradable Tiers</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                @foreach (var tier in levelTiersEnum)
                {
                    int lvl = tier.level;
                    int totalCost = tier.totalCost;
                    int recipeScrollCost = tier.recipeScrollCost;
                    bool isBaseLevel = tier.isBaseLevel;

                    <div
                        class="p-4 rounded-2xl bg-slate-900 border border-slate-800 space-y-2.5 shadow-sm hover:border-amber-400/40 transition-colors">
                        <div class="flex items-center justify-between">
                            <span
                                class="px-3 py-1 rounded-xl text-xs font-bold bg-slate-800 text-amber-300 border border-slate-700">
                                LEVEL @lvl
                            </span>
                            <span class="text-sm font-bold text-amber-400 font-mono">
                                💰 @totalCost.ToString("N0")g
                            </span>
                        </div>

                        <div class="text-xs text-slate-400 font-mono pt-2 border-t border-slate-800/60 flex items-center justify-between">
                            <span>@(isBaseLevel ? "Base Item Initial Cost" : "Recipe Scroll")</span>
                            @if (!isBaseLevel)
                            {
                                <span class="text-amber-300 font-semibold">+@recipeScrollCost.ToString("N0")g</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- 3. Shop Lore / Flavor (Positioned at the very bottom of the page) -->
    @if (!string.IsNullOrWhiteSpace(Model.Flavor))
    {
        <div class="glass-card p-6 rounded-3xl border border-slate-800/80 space-y-2 bg-slate-950/40">
            <h3 class="text-xs font-bold text-purple-400 uppercase tracking-widest flex items-center gap-2">
                <span>📜</span> SHOP LORE
            </h3>
            <p class="text-xs sm:text-sm italic text-slate-400 leading-relaxed font-serif">
                "@Model.Flavor"
            </p>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const tierDetails = document.querySelectorAll(".level-tier-details");
        if (tierDetails.length === 0) return;

        let isSyncing = false;

        tierDetails.forEach(detail => {
            detail.addEventListener("toggle", function () {
                if (isSyncing) return;
                isSyncing = true;

                const targetState = detail.open;
                tierDetails.forEach(other => {
                    if (other !== detail) {
                        other.open = targetState;
                    }
                });

                isSyncing = false;
            });
        });
    });
</script>
