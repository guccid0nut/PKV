@using NEXUS.Contracts.Clients
@model List<HeroDetailDto>
@{
    ViewData["Title"] = "Hero Codex";
    var heroList = Model ?? (ViewData["HeroList"] as List<HeroDetailDto>) ?? [];
}

<div class="w-full max-w-6xl mx-auto py-4 sm:py-8 px-3 sm:px-4 space-y-6 sm:space-y-8 animate-fade-in-up">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <a href="/" class="text-xs text-purple-400 hover:underline font-semibold flex items-center gap-1 mb-2">
                <span>←</span> Back to Command Center
            </a>
            <h1 class="text-2xl sm:text-4xl font-black text-white tracking-tight">Hero Codex & Roster</h1>
            <p class="text-slate-400 text-xs sm:text-sm mt-1">Explore the complete Heroes of Newerth champion roster and
                avatar telemetry</p>
        </div>

        <div class="flex items-center gap-3 flex-wrap w-full md:w-auto">
            <button type="button" onclick="NexusSoundboard.openSoundboardModal()"
                    class="px-4 py-2.5 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-xs shadow-lg shadow-amber-500/25 flex items-center gap-2 hover:scale-105 transition-all cursor-pointer">
                <span>🔊</span>
                <span>Announcer & Taunts</span>
            </button>

            <!-- Live Hero Search Bar -->
            <div class="relative flex-1 md:w-80">
                <input type="text" id="heroSearchInput"
                       placeholder="Search hero by name..."
                       autocomplete="off"
                       class="w-full px-4 py-2.5 sm:py-3 pl-10 rounded-2xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all shadow-inner"/>
                <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5" fill="none" stroke="currentColor"
                     viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div
        class="glass-panel p-3.5 sm:p-4 rounded-2xl flex flex-col sm:flex-row flex-wrap items-start sm:items-center justify-between gap-3 sm:gap-4 border border-slate-800">
        <!-- Attribute Filters -->
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-1">Attribute:</span>
            <button
                class="attr-filter-btn px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 active-attr"
                data-attr="all">All
            </button>
            <button
                class="attr-filter-btn px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900/80 text-red-400 border border-red-500/20 hover:border-red-500/50 transition-all"
                data-attr="strength">💪 Strength
            </button>
            <button
                class="attr-filter-btn px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900/80 text-emerald-400 border border-emerald-500/20 hover:border-emerald-500/50 transition-all"
                data-attr="agility">⚡ Agility
            </button>
            <button
                class="attr-filter-btn px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900/80 text-blue-400 border border-blue-500/20 hover:border-blue-500/50 transition-all"
                data-attr="intelligence">✨ Intelligence
            </button>
        </div>

        <!-- Attack Type Filters -->
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-1">Attack:</span>
            <button
                class="atk-filter-btn px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-semibold bg-purple-500/20 text-purple-300 border border-purple-500/40 active-atk"
                data-atk="all">All
            </button>
            <button
                class="atk-filter-btn px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900/80 text-amber-400 border border-amber-500/20 hover:border-amber-500/50 transition-all"
                data-atk="melee">⚔️ Melee
            </button>
            <button
                class="atk-filter-btn px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-900/80 text-cyan-400 border border-cyan-500/20 hover:border-cyan-500/50 transition-all"
                data-atk="ranged">🎯 Ranged
            </button>
        </div>
    </div>

    <!-- Hero Roster Grid -->
    <div class="glass-panel p-4 sm:p-8 rounded-3xl space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
            <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
                <span>🛡️</span> Project KONGOR Roster
            </h2>
            <span
                class="text-xs text-emerald-400 font-semibold px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20">
                @heroList.Count Champions Synchronized
            </span>
        </div>

        <div id="heroGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 sm:gap-4">
            @{ var heroCardIdx = 0; }
            @foreach (var hero in heroList)
            {
                var id = hero.HeroCode;
                var isBelowFold = heroCardIdx++ >= 18;
                var cvClass = isBelowFold ? "kongor-cv-card" : "";
                var cleanHeroCode = id.Replace("Hero_", "");
                var name = hero.DisplayName;
                var attr = hero.PrimaryAttribute ?? "Strength";
                var atk = hero.AttackType ?? "Melee";
                var iconName = id.ToLowerInvariant();
                var iconPath = !string.IsNullOrWhiteSpace(hero.IconPath) ? hero.IconPath : $"/images/heroes/{iconName}.png";

                bool isStr = attr.Equals("Strength", StringComparison.OrdinalIgnoreCase);
                bool isAgi = attr.Equals("Agility", StringComparison.OrdinalIgnoreCase);
                bool isInt = attr.Equals("Intelligence", StringComparison.OrdinalIgnoreCase);

                string cardBorderGlow = isStr ? "border-red-500/30 hover:border-red-400/80 hover:shadow-red-950/60 shadow-red-950/20" :
                                        isAgi ? "border-emerald-500/30 hover:border-emerald-400/80 hover:shadow-emerald-950/60 shadow-emerald-950/20" :
                                        "border-blue-500/30 hover:border-blue-400/80 hover:shadow-blue-950/60 shadow-blue-950/20";

                string socketBorder = isStr ? "border-red-500/40 group-hover:border-red-400 shadow-red-950/60" :
                                      isAgi ? "border-emerald-500/40 group-hover:border-emerald-400 shadow-emerald-950/60" :
                                      "border-blue-500/40 group-hover:border-blue-400 shadow-blue-950/60";

                string socketBg = isStr ? "from-red-950/30 via-slate-900 to-slate-950" :
                                  isAgi ? "from-emerald-950/30 via-slate-900 to-slate-950" :
                                  "from-blue-950/30 via-slate-900 to-slate-950";

                string titleHover = isStr ? "group-hover:text-red-300" :
                                    isAgi ? "group-hover:text-emerald-300" :
                                    "group-hover:text-blue-300";

                string attrBadge = isStr ? "bg-red-950/90 border-red-500/50 text-red-400" :
                                   isAgi ? "bg-emerald-950/90 border-emerald-500/50 text-emerald-400" :
                                   "bg-blue-950/90 border-blue-500/50 text-blue-400";

                string attrColor = isStr ? "text-red-400" :
                                   isAgi ? "text-emerald-400" :
                                   "text-blue-400";

                string attrIcon = isStr ? "💪" : isAgi ? "⚡" : "✨";

                <a href="/codex/@cleanHeroCode"
                   class="hero-card @cvClass glass-card p-4 rounded-2xl flex flex-col items-center text-center space-y-3 group hover:scale-105 transition-all border @cardBorderGlow hover:shadow-xl cursor-pointer bg-slate-900/85 relative overflow-hidden"
                   data-name="@name.ToLowerInvariant()" data-id="@id.ToLowerInvariant()"
                   data-attr="@attr.ToLowerInvariant()" data-atk="@atk.ToLowerInvariant()">
                    <!-- Deluxe Color-Coded Icon Socket -->
                    <div class="relative w-16 h-16 rounded-2xl p-0.5 bg-gradient-to-b @socketBg border-2 @socketBorder transition-all duration-300 flex-shrink-0 shadow-lg group-hover:scale-105">
                        <div class="relative w-full h-full rounded-xl overflow-hidden bg-slate-950 ring-1 ring-white/10 ring-inset">
                            <img src="@iconPath" width="64" height="64" @(isBelowFold ? Html.Raw("loading=\"lazy\" decoding=\"async\"") : Html.Raw("decoding=\"async\""))
                                 onError="this.onerror=null;this.src='/images/heroes/default.png';"
                                 alt="@name"
                                 class="w-full h-full object-cover rounded-xl transition-transform duration-300 group-hover:scale-110"/>
                            <div class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-transparent via-white/10 to-transparent"></div>
                        </div>
                    </div>
                    <div class="space-y-0.5 w-full">
                        <h4 class="font-bold text-white text-sm @titleHover transition-colors truncate">@name</h4>
                        <div class="flex items-center justify-center gap-1 text-[10px] font-mono">
                            <span class="@attrColor font-bold">@attr</span>
                            <span class="text-slate-600">•</span>
                            <span class="text-slate-400">@atk</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("heroSearchInput");
        const cards = document.querySelectorAll(".hero-card");
        const attrBtns = document.querySelectorAll(".attr-filter-btn");
        const atkBtns = document.querySelectorAll(".atk-filter-btn");

        let selectedAttr = "all";
        let selectedAtk = "all";

        function filterHeroes() {
            const query = input.value.trim().toLowerCase();
            cards.forEach(card => {
                const name = card.getAttribute("data-name") || "";
                const id = card.getAttribute("data-id") || "";
                const attr = card.getAttribute("data-attr") || "";
                const atk = card.getAttribute("data-atk") || "";

                const matchesQuery = !query || name.includes(query) || id.includes(query);
                const matchesAttr = selectedAttr === "all" || attr === selectedAttr;
                const matchesAtk = selectedAtk === "all" || atk === selectedAtk;

                if (matchesQuery && matchesAttr && matchesAtk) {
                    card.style.display = "flex";
                } else {
                    card.style.display = "none";
                }
            });
        }

        input.addEventListener("input", filterHeroes);

        attrBtns.forEach(btn => {
            btn.addEventListener("click", function () {
                attrBtns.forEach(b => {
                    b.classList.remove(
                        "active-attr",
                        "bg-emerald-500/20", "text-emerald-300", "border-emerald-500/40",
                        "bg-red-500/20", "text-red-300", "border-red-500/40",
                        "bg-blue-500/20", "text-blue-300", "border-blue-500/40"
                    );
                });
                selectedAttr = this.getAttribute("data-attr");
                this.classList.add("active-attr");
                if (selectedAttr === "strength") {
                    this.classList.add("bg-red-500/20", "text-red-300", "border-red-500/40");
                } else if (selectedAttr === "agility") {
                    this.classList.add("bg-emerald-500/20", "text-emerald-300", "border-emerald-500/40");
                } else if (selectedAttr === "intelligence") {
                    this.classList.add("bg-blue-500/20", "text-blue-300", "border-blue-500/40");
                } else {
                    this.classList.add("bg-emerald-500/20", "text-emerald-300", "border-emerald-500/40");
                }
                filterHeroes();
            });
        });

        atkBtns.forEach(btn => {
            btn.addEventListener("click", function () {
                atkBtns.forEach(b => b.classList.remove("active-atk", "bg-purple-500/20", "text-purple-300", "border-purple-500/40"));
                this.classList.add("active-atk", "bg-purple-500/20", "text-purple-300", "border-purple-500/40");
                selectedAtk = this.getAttribute("data-atk");
                filterHeroes();
            });
        });
    });
</script>
