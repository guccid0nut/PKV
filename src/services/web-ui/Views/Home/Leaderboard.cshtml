                        <table class="w-full text-left text-xs border-collapse">
                            <thead>
                            <tr class="bg-slate-900/90 border-b border-slate-800 text-slate-400 font-bold uppercase tracking-wider text-[11px]">
                                <th class="py-4 px-5 text-center w-16">Rank</th>
                                <th class="py-4 px-5">Host Operator</th>
                                <th class="py-4 px-5 text-center w-36">Games Hosted</th>
                                <th class="py-4 px-5 w-44">Contribution</th>
                                <th class="py-4 px-5 text-center w-28">Region</th>
                                <th class="py-4 px-5 text-center w-28">Instances</th>
                                <th class="py-4 px-5 text-right w-32">Badge Tier</th>
                            </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800/60 bg-slate-950/40">
                            @foreach (var host in hostEntries)
                            {
                                var rankBadgeClass = host.Rank switch
                                {
                                    1 => "bg-amber-500 text-slate-950 border-amber-300 font-black shadow-md shadow-amber-500/20",
                                    2 => "bg-slate-300 text-slate-950 border-white font-bold",
                                    3 => "bg-amber-800 text-amber-100 border-amber-600 font-bold",
                                    _ => "bg-slate-900 text-slate-400 border-slate-800 font-semibold"
                                };

                                <tr class="hover:bg-slate-900/70 transition-colors group">
                                    <td class="py-4 px-5 text-center">
                                        <span class="inline-flex items-center justify-center w-8 h-8 rounded-xl border text-xs font-mono @rankBadgeClass">
                                            #@host.Rank
                                        </span>
                                    </td>
                                    <td class="py-4 px-5">
                                        <div class="flex items-center gap-3">
                                            <img src="@host.AvatarUrl"
                                                 onError="this.onerror=null;this.src='/images/default-avatar.png';"
                                                 alt="@host.AccountName"
                                                 class="w-10 h-10 rounded-xl object-cover border border-slate-700 bg-slate-900 flex-shrink-0"/>
                                            <div class="flex flex-col min-w-0">
                                                <span class="font-bold text-white text-sm truncate">
                                                    @host.AccountName
                                                </span>
                                                <span class="text-[11px] text-slate-400 font-mono">
                                                    Host: @host.HostAccountName
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-5 text-center font-mono font-bold">
                                        <span class="px-3 py-1 rounded-xl bg-purple-500/15 border border-purple-500/30 text-purple-300 font-black text-sm">
                                            @host.GamesHosted.ToString("N0")
                                        </span>
                                    </td>
                                    <td class="py-4 px-5">
                                        <div class="space-y-1.5">
                                            <div class="flex items-center justify-between font-mono">
                                                <span class="font-extrabold text-xs text-purple-400">
                                                    @host.CommunityContributionPercentage.ToString("F1")%
                                                </span>
                                                <span class="text-[10px] text-slate-500 font-normal">of community</span>
                                            </div>
                                            <div class="w-full h-1.5 rounded-full bg-slate-900 border border-slate-800 overflow-hidden">
                                                <div class="h-full rounded-full bg-gradient-to-r from-purple-500 to-indigo-400"
                                                     style="width: @Math.Min(100.0, Math.Max(0.0, host.CommunityContributionPercentage))%"></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-5 text-center font-mono text-slate-300">
                                        <span class="px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800 text-xs font-semibold">
                                            @host.Location
                                        </span>
                                    </td>
                                    <td class="py-4 px-5 text-center font-mono font-bold text-slate-300">
                                        @host.Instances
                                    </td>
                                    <td class="py-4 px-5 text-right font-mono">
                                        <span class="px-3 py-1 rounded-xl bg-slate-900 border border-slate-700 text-amber-300 font-bold text-xs">
                                            @host.HostBadgeTier
                                        </span>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else if (Model.Count == 0)
            {
                <div class="p-12 text-center space-y-3">
                    <div class="text-4xl">⚔️</div>
                    <h3 class="text-lg font-bold text-white">No Warriors Found</h3>
                    <p class="text-xs text-slate-400 max-w-sm mx-auto">No players matching the active filter criteria
                        were found.</p>
                    <a href="@Url.Action("Leaderboard", "Home")"
                       class="inline-block px-4 py-2 rounded-xl bg-slate-800 text-amber-400 text-xs font-bold border border-slate-700 hover:bg-slate-700 transition-all">
                        Reset All Filters
                    </a>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead>
                        <tr class="bg-slate-900/90 border-b border-slate-800 text-slate-400 font-bold uppercase tracking-wider text-[11px]">
                            <th class="py-4 px-5 text-center w-16">Rank</th>
                            <th class="py-4 px-5">Warrior</th>
                            @if (isMatchesSort)
                            {
                                <th class="py-4 px-5 text-center w-36">Matches Played</th>
                                <th class="py-4 px-5 w-44">Win Rate</th>
                            }
                            else
                            {
                                <th class="py-4 px-5 w-48">Win Rate</th>
                                <th class="py-4 px-5 text-center w-28">Matches</th>
                            }
                            <th class="py-4 px-5 text-center w-32">Record (W-L)</th>
                            <th class="py-4 px-5 w-40">Top Hero</th>
                            <th class="py-4 px-5 text-right w-32">Action</th>
                        </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800/60 bg-slate-950/40">
                        @foreach (var entry in Model)
                        {
                            var rankBadgeClass = entry.Rank switch
                            {
                                1 => "bg-amber-500 text-slate-950 border-amber-300 font-black shadow-md shadow-amber-500/20",
                                2 => "bg-slate-300 text-slate-950 border-white font-bold",
                                3 => "bg-amber-800 text-amber-100 border-amber-600 font-bold",
                                _ => "bg-slate-900 text-slate-400 border-slate-800 font-semibold"
                            };

                            <tr class="hover:bg-slate-900/70 transition-colors group">
                                <td class="py-4 px-5 text-center">
                                    <span
                                        class="inline-flex items-center justify-center w-8 h-8 rounded-xl border text-xs font-mono @rankBadgeClass">
                                        #@entry.Rank
                                    </span>
                                </td>
                                <td class="py-4 px-5">
                                    <div class="flex items-center gap-3">
                                        <img src="@entry.AvatarUrl"
                                             onError="this.onerror=null;this.src='/images/default-avatar.png';"
                                             alt="@entry.AccountName"
                                             class="w-10 h-10 rounded-xl object-cover border border-slate-700 bg-slate-900 flex-shrink-0"/>
                                        <div class="flex flex-col min-w-0">
                                            <a href="/stats?accountName=@Uri.EscapeDataString(entry.AccountName)"
                                               class="font-bold text-white group-hover:text-amber-300 transition-colors text-sm truncate">
                                                @entry.AccountName
                                            </a>
                                        </div>
                                    </div>
                                </td>
                                @if (isMatchesSort)
                                {
                                    <td class="py-4 px-5 text-center font-mono font-bold">
                                        <span
                                            class="px-3 py-1 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-300 font-black text-sm">
                                            @entry.TotalMatches.ToString("N0") @(entry.TotalMatches == 1 ? "Match" : "Matches")
                                        </span>
                                    </td>
                                    <td class="py-4 px-5">
                                        <div class="space-y-1.5">
                                            <div class="flex items-center justify-between font-mono">
                                                <span
                                                    class="font-extrabold text-xs @(entry.WinRate >= 60.0 ? "text-amber-400" : entry.WinRate >= 50.0 ? "text-emerald-400" : "text-slate-300")">
                                                    @entry.WinRate.ToString("F1")%
                                                </span>
                                                <span
                                                    class="text-[10px] text-slate-500 font-normal">@entry.Wins W</span>
                                            </div>
                                            <div
                                                class="w-full h-1.5 rounded-full bg-slate-900 border border-slate-800 overflow-hidden">
                                                <div
                                                    class="h-full rounded-full @(entry.WinRate >= 60.0 ? "bg-gradient-to-r from-amber-500 to-yellow-400" : entry.WinRate >= 50.0 ? "bg-gradient-to-r from-emerald-500 to-teal-400" : "bg-slate-700")"
                                                    style="width: @Math.Min(100.0, Math.Max(0.0, entry.WinRate))%"></div>
                                            </div>
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td class="py-4 px-5">
                                        <div class="space-y-1.5">
                                            <div class="flex items-center justify-between font-mono">
                                                <span
                                                    class="font-extrabold text-sm @(entry.WinRate >= 60.0 ? "text-amber-400" : entry.WinRate >= 50.0 ? "text-emerald-400" : "text-slate-300")">
                                                    @entry.WinRate.ToString("F1")%
                                                </span>
                                                <span
                                                    class="text-[10px] text-slate-500 font-normal">@entry.Wins / @entry.TotalMatches</span>
                                            </div>
                                            <div
                                                class="w-full h-2 rounded-full bg-slate-900 border border-slate-800 overflow-hidden">
                                                <div
                                                    class="h-full rounded-full @(entry.WinRate >= 60.0 ? "bg-gradient-to-r from-amber-500 to-yellow-400" : entry.WinRate >= 50.0 ? "bg-gradient-to-r from-emerald-500 to-teal-400" : "bg-slate-700")"
                                                    style="width: @Math.Min(100.0, Math.Max(0.0, entry.WinRate))%"></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-5 text-center font-mono font-bold text-slate-300">
                                        @entry.TotalMatches.ToString("N0") @(entry.TotalMatches == 1 ? "Match" : "Matches")
                                    </td>
                                }
                                <td class="py-4 px-5 text-center">
                                    <span
                                        class="inline-flex items-center gap-1 px-3 py-1 rounded-xl bg-slate-900 border border-slate-800 font-mono font-bold text-xs">
                                        <span class="text-emerald-400">@entry.Wins W</span>
                                        <span class="text-slate-600">-</span>
                                        <span class="text-rose-400">@entry.Losses L</span>
                                    </span>
                                </td>
                                <td class="py-4 px-5">
                                    <div class="flex items-center gap-2">
                                        <img src="@entry.TopHeroIcon"
                                             onError="this.onerror=null;this.src='/images/default-avatar.png';"
                                             alt="@entry.TopHeroName"
                                             class="w-7 h-7 rounded-lg object-cover border border-slate-700 bg-slate-900 flex-shrink-0"/>
                                        <span
                                            class="text-xs font-semibold text-slate-200 truncate">@entry.TopHeroName</span>
                                    </div>
                                </td>
                                <td class="py-4 px-5 text-right">
                                    <a href="/stats?accountName=@Uri.EscapeDataString(entry.AccountName)"
                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-amber-500 hover:text-slate-950 text-slate-300 font-bold text-xs border border-slate-800 hover:border-amber-400 transition-all">
                                        <span>Stats</span>
                                        <span>➔</span>
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>
