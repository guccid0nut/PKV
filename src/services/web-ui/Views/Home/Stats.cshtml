<script>
    function exportPlayerCard() {
        const topHeroStr = '@(topHeroes?.FirstOrDefault()?.HeroCode?.Replace("Hero_", "") ?? "Legion Warrior")';
        const estKills = @((int)Math.Round(kdr * totalMatches * 3));
        const estDeaths = @(Math.Max(1, totalMatches * 3));
        const estAssists = @((int)Math.Round(kdr * totalMatches * 2));
        const estDamage = @(totalMatches * 14500);
        const estWards = @(totalMatches * 4);
        const estCreeps = @(totalMatches * 110);

        const playerData = {
            matchId: 'CAREER',
            mapName: 'Newerth Veteran',
            duration: '@totalMatches Matches',
            gameMode: 'Career Record',
            isVictory: @(winRate >= 50.0 ? "true" : "false"),
            isMvp: @(kdr >= 1.5 ? "true" : "false"),
            playerName: '@accountName',
            heroName: topHeroStr,
            rankName: '@(skillRating >= 1800 ? "Immortal" : skillRating >= 1700 ? "Diamond" : skillRating >= 1600 ? "Gold" : "Silver") (@skillRating MMR)',
            title: '@(titleDisplayName ?? "HoN Champion")',
            kills: estKills,
            deaths: estDeaths,
            assists: estAssists,
            kdr: @kdr,
            gpm: 520,
            xpm: 580,
            damage: estDamage,
            wards: estWards,
            creeps: estCreeps,
            items: ['Frostwolf', 'Daemonic', 'Savage Mace', 'Geometer', 'Shrunken Head', 'Ghost Marchers']
        };
        if (window.NexusBragCard) {
            window.NexusBragCard.generate(playerData);
        }
    }
</script>

<style>
    /* 3D Smoke & Portal Transition Effects */
    .banner-3d-particle {
        position: absolute;
        pointer-events: none;
        user-select: none;
        opacity: 0;
        animation: bannerParticlePuff ease-out forwards;
    }

    @@keyframes bannerParticlePuff {
        0% {
            opacity: 0.95;
            transform: translate(-50%, -50%) scale(0.3) rotate(0deg);
        }
        50% {
            opacity: 0.85;
            transform: translate(calc(-50% + var(--px)), calc(-50% + var(--py))) scale(var(--pscale)) rotate(var(--prot));
        }
        100% {
            opacity: 0;
            transform: translate(calc(-50% + var(--px) * 1.5), calc(-50% + var(--py) * 1.5 - 10px)) scale(calc(var(--pscale) * 1.3)) rotate(calc(var(--prot) + 45deg));
        }
    }
</style>

