}

<!-- Autocomplete & Staff Modals Script -->
<script>
    function openDirectSanctionModal() {
        const modal = document.getElementById('direct-sanction-modal');
        if (modal) {
            modal.classList.remove('hidden');
            updateDirectDurationPreview();
        }
    }

    function closeDirectSanctionModal() {
        const modal = document.getElementById('direct-sanction-modal');
        if (modal) modal.classList.add('hidden');
    }

    function handleDirectActionChange(action) {
        const durationContainer = document.getElementById('direct-duration-container');
        if (durationContainer) {
            durationContainer.style.display = (action === 'DISMISS' || action === 'APPEAL') ? 'none' : 'block';
        }
        updateDirectDurationPreview();
    }

    function updateDirectDurationPreview() {
        const select = document.getElementById('direct-duration-select');
        const preview = document.getElementById('direct-duration-preview');
        if (!select || !preview) return;

        const hours = parseInt(select.value, 10);
        if (hours >= 800000) {
            preview.textContent = "Permanent sanction (No expiration)";
        } else {
            const exp = new Date(Date.now() + hours * 3600000);
            preview.textContent = "Expires on " + exp.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
            }) + " at " + exp.toLocaleTimeString('en-US', {hour: '2-digit', minute: '2-digit'});
        }
    }

    async function submitDirectSanction(e) {
        e.preventDefault();
        const form = document.getElementById('direct-sanction-form');
        const btn = document.getElementById('submit-direct-sanction-btn');
        if (!form || !btn) return;

        btn.disabled = true;
        btn.innerHTML = '<span>⏳ Applying...</span>';

        const formData = new FormData(form);

        try {
            const res = await fetch('/staff/reports/create-direct', {
                method: 'POST',
                body: formData,
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            });

            if (res.ok) {
                window.location.reload();
            } else {
                const errData = await res.json();
                alert(errData.message || 'Failed to apply disciplinary action.');
                btn.disabled = false;
                btn.innerHTML = '<span>⚡ Apply Sanction</span>';
            }
        } catch (err) {
            console.error('Error issuing direct sanction:', err);
            alert('Error issuing disciplinary action.');
            btn.disabled = false;
            btn.innerHTML = '<span>⚡ Apply Sanction</span>';
        }
    }

    function openAppealModal(reportId, playerName) {
        const modal = document.getElementById('appeal-modal');
        const idInput = document.getElementById('appeal-report-id');
        const idText = document.getElementById('appeal-report-id-text');
        if (modal && idInput && idText) {
            idInput.value = reportId;
            idText.textContent = '#' + reportId;
            modal.classList.remove('hidden');
        }
    }

    function closeAppealModal() {
        const modal = document.getElementById('appeal-modal');
        if (modal) modal.classList.add('hidden');
    }

    async function submitAppeal(e) {
        e.preventDefault();
        const form = document.getElementById('appeal-form');
        const btn = document.getElementById('submit-appeal-btn');
        const reportId = document.getElementById('appeal-report-id')?.value;
        if (!form || !btn || !reportId) return;

        btn.disabled = true;
        btn.innerHTML = '<span>⏳ Processing Appeal...</span>';

        const formData = new FormData(form);

        try {
            const res = await fetch('/staff/reports/' + encodeURIComponent(reportId) + '/appeal', {
                method: 'POST',
                body: formData,
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            });

            if (res.ok) {
                window.location.reload();
            } else {
                const errData = await res.json();
                alert(errData.message || 'Failed to grant appeal.');
                btn.disabled = false;
                btn.innerHTML = '<span>🛡️ Grant Appeal & Overturn</span>';
            }
        } catch (err) {
            console.error('Error granting appeal:', err);
            alert('Error processing appeal request.');
            btn.disabled = false;
            btn.innerHTML = '<span>🛡️ Grant Appeal & Overturn</span>';
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("playerSearchInput");
        const resultsContainer = document.getElementById("playerSearchResults");
        let debounceTimer;
        let selectedIndex = 0;

        function updatePlayerHighlight(rows) {
            rows.forEach((row, idx) => {
                if (idx === selectedIndex) {
                    row.classList.add("bg-purple-600/30", "text-white", "ring-1", "ring-purple-400/60");
                    row.classList.remove("hover:bg-purple-600/20", "text-slate-200");
                    row.scrollIntoView({block: "nearest"});
                } else {
                    row.classList.remove("bg-purple-600/30", "text-white", "ring-1", "ring-purple-400/60");
                    row.classList.add("hover:bg-purple-600/20", "text-slate-200");
                }
            });
        }

        if (input && resultsContainer) {
            input.addEventListener("keydown", function (e) {
                const rows = resultsContainer.querySelectorAll("a");
                const isVisible = !resultsContainer.classList.contains("hidden") && rows.length > 0;

                if (e.key === "ArrowDown") {
                    if (!isVisible) return;
                    e.preventDefault();
                    selectedIndex = (selectedIndex + 1) % rows.length;
                    updatePlayerHighlight(rows);
                } else if (e.key === "ArrowUp") {
                    if (!isVisible) return;
                    e.preventDefault();
                    selectedIndex = selectedIndex <= 0 ? rows.length - 1 : selectedIndex - 1;
                    updatePlayerHighlight(rows);
                } else if (e.key === "Enter") {
                    if (!isVisible) return;
                    e.preventDefault();
                    const targetIndex = selectedIndex >= 0 && selectedIndex < rows.length ? selectedIndex : 0;
                    if (rows[targetIndex]) {
                        window.location.href = rows[targetIndex].href;
                    }
                } else if (e.key === "Escape") {
                    resultsContainer.classList.add("hidden");
                    selectedIndex = 0;
                    closeDirectSanctionModal();
                    closeAppealModal();
                }
            });

            input.addEventListener("input", function () {
                clearTimeout(debounceTimer);
                selectedIndex = 0;
                const query = input.value.trim();

                if (query.length < 2) {
                    resultsContainer.classList.add("hidden");
                    resultsContainer.innerHTML = "";
                    return;
                }

                debounceTimer = setTimeout(() => {
                    fetch("/api/players/search?q=" + encodeURIComponent(query))
                        .then(res => res.json())
                        .then(data => {
                            resultsContainer.innerHTML = "";
                            selectedIndex = 0;
                            if (data && data.length > 0) {
                                data.forEach((item, index) => {
                                    const row = document.createElement("a");
                                    row.href = "/stats?accountName=" + encodeURIComponent(item.name);
                                    row.className = "flex items-center justify-between px-4 py-3 text-slate-200 hover:text-white transition-colors cursor-pointer";

                                    const fallbackAvatar = "/images/default-avatar.png";
                                    const avatarSrc = item.avatarUrl || fallbackAvatar;

                                    let statusBadge = '';
                                    if (item.status === 'Banned') {
                                        statusBadge = '<span class="text-[10px] font-bold text-rose-400 bg-rose-500/20 px-1.5 py-0.5 rounded border border-rose-500/30">BANNED</span>';
                                    } else if (item.status === 'Suspended') {
                                        statusBadge = '<span class="text-[10px] font-bold text-amber-400 bg-amber-500/20 px-1.5 py-0.5 rounded border border-amber-500/30">SUSPENDED</span>';
                                    } else if (item.status === 'Muted') {
                                        statusBadge = '<span class="text-[10px] font-bold text-purple-400 bg-purple-500/20 px-1.5 py-0.5 rounded border border-purple-500/30">MUTED</span>';
                                    }

                                    row.innerHTML = `
                                        <div class="flex items-center gap-3">
                                            <img src="${avatarSrc}" 
                                                 onError="this.onerror=null;this.src='${fallbackAvatar}';" 
                                                 alt="${item.name}" 
                                                 class="w-7 h-7 rounded-full object-cover border border-purple-500/40 bg-slate-800 flex-shrink-0" />
                                            <span class="font-semibold text-sm">${item.name}</span>
                                            ${statusBadge}
                                        </div>
                                        <span class="text-xs text-purple-400 font-bold">View Stats →</span>
                                    `;

                                    row.addEventListener("mouseenter", function () {
                                        selectedIndex = index;
                                        const rows = resultsContainer.querySelectorAll("a");
                                        updatePlayerHighlight(rows);
                                    });

                                    resultsContainer.appendChild(row);
                                });
                                resultsContainer.classList.remove("hidden");
                                const rows = resultsContainer.querySelectorAll("a");
                                updatePlayerHighlight(rows);
                            } else {
                                selectedIndex = -1;
                                const noResult = document.createElement("div");
                                noResult.className = "px-4 py-3 text-xs text-slate-400 text-center";
                                noResult.textContent = "No players found matching '" + query + "'";
                                resultsContainer.appendChild(noResult);
                                resultsContainer.classList.remove("hidden");
                            }
                        })
                        .catch(err => {
                            console.error("Error searching players:", err);
                        });
                }, 250);
            });

            document.addEventListener("click", function (e) {
                if (!input.contains(e.target) && !resultsContainer.contains(e.target)) {
                    resultsContainer.classList.add("hidden");
                    selectedIndex = 0;
                }
            });
        }
    });

    function openApplyHostModal() {
        const modal = document.getElementById('applyHostModal');
        if (modal) modal.classList.remove('hidden');
    }

    function closeApplyHostModal() {
        const modal = document.getElementById('applyHostModal');
        if (modal) modal.classList.add('hidden');
    }
</script>

