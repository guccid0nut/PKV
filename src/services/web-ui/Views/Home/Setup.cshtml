@{
    ViewData["Title"] = "PKV App & Setup";
    const string githubRepoUrl = "https://github.com/guccidonut/PKV";
}

<div class="w-full max-w-4xl mx-auto pt-8 sm:pt-12 pb-14 px-4 sm:px-6 space-y-6 sm:space-y-8 animate-fade-in-up">

    <!-- Header -->
    <div class="text-center space-y-3">
        <div>
            <a href="/" class="text-xs text-purple-400 hover:text-purple-300 hover:underline font-semibold inline-flex items-center gap-1.5 mb-2">
                <span>←</span>
                <span>Back to Command Center</span>
            </a>
        </div>
        <div>
            <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/25 text-cyan-300 text-[11px] sm:text-xs font-bold uppercase tracking-wider">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                ONE UNIFIED OPEN-SOURCE APPLICATION
            </span>
        </div>
        <h1 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
            Project KONGOR V — Unified App &amp; Setup
        </h1>
        <p class="text-slate-400 text-xs sm:text-sm max-w-2xl mx-auto leading-relaxed">
            Everything in Project KONGOR V ships together in <strong class="text-slate-200">one single open-source application</strong> — launcher, VFS override manager, runtime tuning, cloud profile sync, and server orchestration in one place.
        </p>
    </div>

    <!-- Single Unified PKV Application Card -->
    <div class="glass-panel p-6 sm:p-9 rounded-3xl space-y-6 border border-purple-500/30 shadow-2xl backdrop-blur-xl bg-slate-900/85">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-6">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-purple-500/25 to-cyan-500/20 border border-purple-400/35 flex items-center justify-center text-3xl flex-shrink-0 shadow-lg">
                    🚀
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h2 class="text-xl sm:text-2xl font-black text-white">Project KONGOR V (PKV)</h2>
                        <span class="px-2.5 py-0.5 rounded-md text-[11px] font-mono font-bold bg-purple-500/20 text-purple-200 border border-purple-400/30">
                            ALL-IN-ONE APP
                        </span>
                        <span class="px-2.5 py-0.5 rounded-md text-[11px] font-mono font-bold bg-slate-800 text-slate-300 border border-slate-700">
                            AGPL-3.0-or-later
                        </span>
                    </div>
                    <p class="text-slate-400 text-xs sm:text-sm mt-1">
                        Single unified desktop &amp; CLI suite for connecting to Project KONGOR services, managing client settings, and supervising local match hosts.
                    </p>
                </div>
            </div>

            <a href="@githubRepoUrl" target="_blank" rel="noopener noreferrer"
               class="px-6 py-3.5 rounded-2xl bg-gradient-to-r from-purple-600 via-indigo-600 to-cyan-500 hover:from-purple-500 hover:to-cyan-400 text-white font-black text-xs sm:text-sm shadow-xl shadow-purple-500/25 transition-all flex items-center justify-center gap-2 flex-shrink-0">
                <i class="fab fa-github text-base"></i>
                <span>View PKV on GitHub</span>
                <span>↗</span>
            </a>
        </div>

        <!-- Unified Capabilities Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800 space-y-1.5">
                <div class="text-xs font-black text-cyan-300 uppercase tracking-wider">🎮 Client Launcher &amp; Tuning</div>
                <p class="text-xs text-slate-400 leading-relaxed">
                    One-click launch configuration, Vulkan/DirectX runtime tuning, frame-pacing presets, and VFS override management.
                </p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800 space-y-1.5">
                <div class="text-xs font-black text-purple-300 uppercase tracking-wider">☁️ Account &amp; Cloud Sync</div>
                <p class="text-xs text-slate-400 leading-relaxed">
                    Seamless Discord identity handshake, keybind &amp; macro profile synchronization, and instant cosmetics unlock integration.
                </p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800 space-y-1.5">
                <div class="text-xs font-black text-emerald-300 uppercase tracking-wider">🖥️ Built-In Host Supervision</div>
                <p class="text-xs text-slate-400 leading-relaxed">
                    Integrated local &amp; dedicated match host supervision inside the exact same PKV application — no separate tools required.
                </p>
            </div>
        </div>

        <!-- Quick GitHub Repository Link Row -->
        <div class="p-4 rounded-2xl bg-slate-950/90 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="text-xs text-slate-300">
                <span class="font-bold text-white">Official Source Code &amp; Documentation:</span>
                <span class="font-mono text-cyan-300 ml-1">@githubRepoUrl</span>
            </div>
            <a href="@githubRepoUrl" target="_blank" rel="noopener noreferrer"
               class="text-xs font-bold text-purple-300 hover:text-purple-200 inline-flex items-center gap-1">
                <span>github.com/guccidonut/PKV</span>
                <span>↗</span>
            </a>
        </div>
    </div>

    <!-- Zero Game / Server File Distribution Notice -->
    <div class="rounded-2xl bg-amber-950/25 border border-amber-500/35 p-5 sm:p-6 space-y-2">
        <div class="flex items-center gap-2 text-amber-300 text-xs sm:text-sm font-black uppercase tracking-wider">
            <span>🛡️</span>
            <span>Cleanroom Open-Source Notice — No Game or Server Files Distributed</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            This website and the <a href="@githubRepoUrl" target="_blank" rel="noopener noreferrer" class="text-cyan-300 hover:underline font-semibold">Project KONGOR V GitHub repository</a>
            <strong>do not host, provide, or distribute any game files, client binaries, server executables, or retail archives</strong> whatsoever.
            Project KONGOR V is strictly cleanroom open-source interoperability software (<code class="text-amber-200">AGPL-3.0-or-later</code>) designed for use with your own lawfully obtained installation.
        </p>
    </div>
</div>
