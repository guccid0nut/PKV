    let selectedMacroId = 'tombstone';
    let userMacroKeybindings = {};

    // Initialize default hotkeys
    HON_MACRO_LIBRARY.forEach(m => {
        userMacroKeybindings[m.id] = m.defaultKey || 'None';
    });

    document.addEventListener('DOMContentLoaded', () => {
        renderMacroCards();
        selectMacro('tombstone');
        renderHotkeyConfigList();
    });

    function filterMacroCategory(cat) {
        currentMacroCategory = cat;
        document.querySelectorAll('.macro-filter-btn').forEach(btn => {
            btn.className = "macro-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold transition-all border bg-slate-900 text-slate-400 border-slate-800 hover:text-slate-200 cursor-pointer";
        });
        const activeBtn = document.getElementById(`filterBtn-${cat}`);
        if (activeBtn) {
            activeBtn.className = "macro-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold transition-all border bg-amber-500/20 text-amber-300 border-amber-500/50 shadow-sm cursor-pointer";
        }
        renderMacroCards();
    }

    function onMacroSearchInput(term) {
        currentMacroSearch = (term || '').trim().toLowerCase();
        renderMacroCards();
    }

    function getFilteredMacros() {
        return HON_MACRO_LIBRARY.filter(m => {
            const matchesCat = currentMacroCategory === 'all' || m.category === currentMacroCategory;
            const matchesSearch = !currentMacroSearch ||
                m.title.toLowerCase().includes(currentMacroSearch) ||
                m.description.toLowerCase().includes(currentMacroSearch) ||
                m.tags.some(t => t.toLowerCase().includes(currentMacroSearch));
            return matchesCat && matchesSearch;
        });
    }

    function renderMacroCards() {
        const container = document.getElementById('macroCardsContainer');
        if (!container) return;

        const filtered = getFilteredMacros();
        document.getElementById('macroCountBadge').textContent = `${filtered.length} available`;

        if (filtered.length === 0) {
            container.innerHTML = `
                <div class="col-span-2 py-8 text-center text-slate-500 text-xs">
                    <i class="fa-solid fa-ghost text-2xl mb-2 text-slate-600 block"></i>
                    No macros matched your filter or search query.
                </div>
            `;
            return;
        }

        container.innerHTML = filtered.map(m => {
            const isSelected = m.id === selectedMacroId;
            const cardBg = isSelected
                ? "bg-slate-800/90 border-amber-500/70 shadow-lg shadow-amber-950/30 ring-1 ring-amber-500/30"
                : "bg-slate-900/80 border-slate-800/90 hover:border-slate-700 hover:bg-slate-850";

            const assignedKey = userMacroKeybindings[m.id] || 'None';

            return `
                <div onclick="selectMacro('${m.id}')"
                     class="p-3.5 rounded-2xl border transition-all cursor-pointer flex flex-col justify-between space-y-2.5 group ${cardBg}">
                    <div class="flex items-start justify-between gap-2">
                        <div class="flex items-center gap-2 min-w-0">
                            <span class="text-xl flex-shrink-0">${m.emoji}</span>
                            <div class="min-w-0">
                                <h4 class="text-xs font-bold text-slate-200 group-hover:text-amber-300 transition-colors truncate">
                                    ${m.title}
                                </h4>
                                <span class="text-[10px] text-slate-400 capitalize">
                                    ${m.category === 'kill' ? '💀 Kill & Taunt' : (m.category === 'meme' ? '🔥 Meme' : '✈️ Classic')}
                                </span>
                            </div>
                        </div>
                        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-950 border border-slate-800 text-amber-300 font-bold flex-shrink-0">
                            ${assignedKey}
                        </span>
                    </div>

                    <p class="text-[11px] text-slate-400 line-clamp-2 leading-relaxed">
                        ${m.description}
                    </p>

                    <div class="flex items-center justify-between pt-1 border-t border-slate-800/60 text-[10px] text-slate-500 font-semibold">
                        <span>${m.lines.length} lines</span>
                        <span class="text-amber-400/80 group-hover:text-amber-300 flex items-center gap-1">
                            Preview <i class="fa-solid fa-angle-right text-[9px]"></i>
                        </span>
                    </div>
                </div>
            `;
        }).join('');
    }

    function selectMacro(macroId) {
        selectedMacroId = macroId;
        const macro = HON_MACRO_LIBRARY.find(m => m.id === macroId) || HON_MACRO_LIBRARY[0];

        // Update titles and badges
        document.getElementById('previewMacroTitle').textContent = `${macro.emoji} ${macro.title}`;
        document.getElementById('previewMacroBadge').textContent = `${macro.lines.length} Lines`;
        const key = userMacroKeybindings[macro.id] || 'None';
        document.getElementById('selectedMacroKeyBadge').textContent = `Key: ${key}`;

        // Populate textarea
        document.getElementById('selectedMacroCodeOutput').value = macro.lines.join('\n');

        // Render In-Game Chat Simulation lines
        const previewContainer = document.getElementById('macroChatPreviewLines');
        if (previewContainer) {
            previewContainer.innerHTML = macro.lines.map(line => {
                // Strip the leading "/emote " or "/all " for clean visual in-game chat rendering
                let displayLine = line;
                if (displayLine.startsWith('/emote ')) displayLine = displayLine.substring(7);
                else if (displayLine.startsWith('/all ')) displayLine = displayLine.substring(5);

                const coloredHtml = parseHonFormattedString(displayLine);
                return `<div><span class="text-purple-400 select-none">[ALL] You: </span>${coloredHtml}</div>`;
            }).join('');
        }

        // Highlight active card
        renderMacroCards();
    }

    function renderHotkeyConfigList() {
        const list = document.getElementById('hotkeyConfigList');
        if (!list) return;

        list.innerHTML = HON_MACRO_LIBRARY.map(m => {
            const currentKey = userMacroKeybindings[m.id] || 'None';

            const optionsHtml = AVAILABLE_HOTKEYS.map(k => {
                const isSelected = k === currentKey ? 'selected' : '';
                return `<option value="${k}" ${isSelected}>${k}</option>`;
            }).join('');

            return `
                <div class="flex items-center justify-between gap-2 py-1 px-2 rounded-xl bg-slate-900/60 border border-slate-800 text-xs">
                    <span class="font-medium text-slate-300 truncate flex items-center gap-1.5 min-w-0">
                        <span>${m.emoji}</span>
                        <span class="truncate">${m.title}</span>
                    </span>
                    <select onchange="onKeybindChanged('${m.id}', this.value)"
                            class="bg-slate-950 border border-slate-800 rounded-lg px-2 py-1 text-xs font-mono font-bold text-amber-300 focus:outline-none focus:border-amber-500/60 cursor-pointer">
                        ${optionsHtml}
                    </select>
                </div>
            `;
        }).join('');
    }

    function onKeybindChanged(macroId, newKey) {
        userMacroKeybindings[macroId] = newKey;
        if (selectedMacroId === macroId) {
            document.getElementById('selectedMacroKeyBadge').textContent = `Key: ${newKey}`;
        }
        renderMacroCards();
    }

    function updateAhkDelay(val) {
        document.getElementById('ahkDelayValue').textContent = `${val}ms`;
    }

    function copySelectedMacroCode() {
        const text = document.getElementById('selectedMacroCodeOutput').value;
        if (!text) return;

        navigator.clipboard.writeText(text).then(() => {
            const btnText = document.getElementById('btnCopyMacroOnlyText');
            const old = btnText.textContent;
            btnText.textContent = "Copied Macro! ✨";
            setTimeout(() => { btnText.textContent = old; }, 2000);
        });
    }

    function sendSelectedMacroToGenerator() {
        const macro = HON_MACRO_LIBRARY.find(m => m.id === selectedMacroId);
        if (!macro) return;

        switchMainTab('generator');
        const rawInput = document.getElementById('rawTextInput');
        rawInput.value = macro.lines.join('\n');
        updateFormattedOutput();
        rawInput.focus();
    }

    function buildAhkScriptContent(singleMacroId = null) {
        const delay = document.getElementById('ahkDelaySlider').value || 65;
        const useWindowGuard = document.getElementById('ahkWindowGuard').checked;

        const targetMacros = singleMacroId
            ? HON_MACRO_LIBRARY.filter(m => m.id === singleMacroId)
            : HON_MACRO_LIBRARY.filter(m => (userMacroKeybindings[m.id] || 'None') !== 'None');

        let script = `; ==============================================================================\n`;
        script += `; Heroes of Newerth - ASCII Kill Macro Assist Suite\n`;
        script += `; Generated by ProjectKongor Dawnbringer Web Portal\n`;
        script += `; ==============================================================================\n`;
        script += `#NoEnv\n`;
        script += `#SingleInstance Force\n`;
        script += `SendMode Input\n`;
        script += `SetWorkingDir %A_ScriptDir%\n\n`;

        if (useWindowGuard) {
            script += `; Only active when Heroes of Newerth is in focus\n`;
            script += `#IfWinActive ahk_exe hon_x64.exe\n\n`;
        }

        script += `; Robust macro sender via Windows clipboard\n`;
        script += `SendHonMacro(lines) {\n`;
        script += `    ClipSaved := ClipboardAll\n`;
        script += `    for index, line in lines {\n`;
        script += `        Clipboard := line\n`;
        script += `        SendInput, {Enter}^v{Enter}\n`;
        script += `        Sleep, ${delay} ; Safe delay to avoid packet flood\n`;
        script += `    }\n`;
        script += `    Clipboard := ClipSaved\n`;
        script += `}\n\n`;

        targetMacros.forEach(m => {
            const key = singleMacroId ? (userMacroKeybindings[m.id] || m.defaultKey || 'Numpad1') : userMacroKeybindings[m.id];
            if (!key || key === 'None') return;

            // Format hotkey for AHK
            let ahkKey = key;
            if (ahkKey.startsWith('Alt+')) {
                ahkKey = '!' + ahkKey.substring(4);
            }

            script += `; ${m.emoji} ${m.title}\n`;
            script += `${ahkKey}::\n`;
            script += `SendHonMacro([ `;

            m.lines.forEach((line, idx) => {
                // Escape quotes inside line for AHK
                const escaped = line.replace(/"/g, '""');
                if (idx === 0) {
                    script += `"${escaped}"\n`;
                } else {
                    script += `             , "${escaped}"\n`;
                }
            });

            script += `             ])\n`;
            script += `return\n\n`;
        });

        if (useWindowGuard) {
            script += `#IfWinActive\n`;
        }

        return script;
    }

    function triggerFileDownload(filename, textContent) {
        const blob = new Blob([textContent], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }

    function downloadFullAhkScript() {
        const ahkContent = buildAhkScriptContent();
        triggerFileDownload('hon_chat_macros.ahk', ahkContent);

        const btnText = document.getElementById('btnDownloadAhkText');
        const old = btnText.textContent;
        btnText.textContent = "Downloaded hon_chat_macros.ahk! ✨";
        setTimeout(() => { btnText.textContent = old; }, 2500);
    }

    function copyFullAhkCode() {
        const ahkContent = buildAhkScriptContent();
        navigator.clipboard.writeText(ahkContent).then(() => {
            const btnText = document.getElementById('btnCopyAhkText');
            const old = btnText.textContent;
            btnText.textContent = "Copied Script! ✨";
            setTimeout(() => { btnText.textContent = old; }, 2500);
        });
    }

    function downloadSelectedMacroAhk() {
        const macro = HON_MACRO_LIBRARY.find(m => m.id === selectedMacroId);
        if (!macro) return;
        const ahkContent = buildAhkScriptContent(macro.id);
        const safeName = macro.id.replace(/[^a-z0-9_]/gi, '_').toLowerCase();
        triggerFileDownload(`hon_macro_${safeName}.ahk`, ahkContent);
    }
</script>
