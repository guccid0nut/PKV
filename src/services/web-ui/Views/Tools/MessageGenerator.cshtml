<!-- Custom Client Script -->
<script>
    // Verified 1-letter HoN colors
    const HON_VERIFIED_LETTER_MAP = {
        'r': '#FF3333', // Red
        'g': '#33FF33', // Green
        'b': '#3388FF', // Blue
        'y': '#FFFF33', // Yellow
        'c': '#33FFFF', // Cyan
        'm': '#FF33FF', // Magenta
        'w': '#FFFFFF', // White
        'k': '#222222', // Black
        'o': '#FF9933', // Orange
        'p': '#FF66AA', // Pink
        '*': '#FFFFFF', // Reset / White
        'n': '#FFFFFF'  // Normal / White
    };

    // Preset palettes for 3-Digit ^RGB mode (native K2 1000-color format)
    const PRESET_PALETTES_NUMERIC = {
        'matrix': ['091', '081', '071', '092', '190', '090'],
        'rainbow': ['900', '950', '990', '090', '099', '009', '509', '909'],
        'fire': ['900', '920', '950', '980', '930', '900'],
        'ice': ['999', '099', '059', '009', '059', '099'],
        'toxic': ['590', '090', '095', '090', '590'],
        'gold': ['990', '980', '960', '940', '970', '990'],
        'void': ['909', '509', '209', '009', '509', '909'],
        'candy': ['947', '907', '905', '959', '999'],
        'monochrome': ['999', '666', '333', '666', '999']
    };

    // Preset palettes for 1-Letter ^x mode
    const PRESET_PALETTES_LETTER = {
        'matrix': ['g', 'c', 'g', 'w', 'g'],
        'rainbow': ['r', 'o', 'y', 'g', 'c', 'b', 'p', 'm'],
        'fire': ['r', 'o', 'y', 'o', 'r'],
        'ice': ['w', 'c', 'b', 'c', 'w'],
        'toxic': ['g', 'c', 'g', 'w'],
        'gold': ['y', 'o', 'm', 'o', 'y'],
        'void': ['m', 'b', 'p', 'b', 'm'],
        'candy': ['p', 'm', 'w', 'm', 'p'],
        'monochrome': ['w', 'k', 'w']
    };

    let currentMode = 'numeric'; // 'numeric' (^RGB 3-digit) or 'letter' (^x classic)
    let activePreset = 'matrix';

    document.addEventListener('DOMContentLoaded', () => {
        const rawInput = document.getElementById('rawTextInput');
        rawInput.value = "MID OR FEED! GL HF ALL!";
        rawInput.addEventListener('input', updateFormattedOutput);
        updateFormattedOutput();
    });

    function setMode(mode) {
        currentMode = mode;
        const btnNum = document.getElementById('btnModeNumeric');
        const btnLet = document.getElementById('btnModeLetter');

        if (mode === 'numeric') {
            btnNum.className = "px-3 py-1.5 rounded-xl text-xs font-bold transition-all border bg-emerald-500/20 text-emerald-300 border-emerald-500/50 shadow-sm cursor-pointer";
            btnLet.className = "px-3 py-1.5 rounded-xl text-xs font-bold transition-all border bg-slate-900 text-slate-400 border-slate-800 hover:text-slate-200 cursor-pointer";
        } else {
            btnLet.className = "px-3 py-1.5 rounded-xl text-xs font-bold transition-all border bg-pink-500/20 text-pink-300 border-pink-500/50 shadow-sm cursor-pointer";
            btnNum.className = "px-3 py-1.5 rounded-xl text-xs font-bold transition-all border bg-slate-900 text-slate-400 border-slate-800 hover:text-slate-200 cursor-pointer";
        }

        updateFormattedOutput();
    }

    function setTemplate(text) {
        const rawInput = document.getElementById('rawTextInput');
        rawInput.value = text;
        updateFormattedOutput();
    }

    function applyPreset(presetKey) {
        activePreset = presetKey;
        updateFormattedOutput();
    }

    function applySolidCode(codeStr) {
        const rawInput = document.getElementById('rawTextInput');
        let text = rawInput.value.replace(/\^\d{3}|\^[a-zA-Z*]/g, ''); // strip existing ^ codes
        if (!text) text = "YOUR MESSAGE";
        rawInput.value = text;

        const formatted = `^${codeStr}${text}`;
        document.getElementById('formattedCodeOutput').value = formatted;
        renderLivePreview(formatted);
        updateCharCount(text.length);
    }

    function updateFormattedOutput() {
        const rawInput = document.getElementById('rawTextInput');
        let text = rawInput.value;

        // If input contains ^ codes already, parse and render directly
        if (text.includes('^')) {
            document.getElementById('formattedCodeOutput').value = text;
            renderLivePreview(text);
            updateCharCount(text.replace(/\^\d{3}|\^[a-zA-Z*]/g, '').length);
            return;
        }

        if (!text) {
            document.getElementById('formattedCodeOutput').value = '';
            document.getElementById('liveChatPreview').innerHTML = '<span class="text-slate-600 italic">Preview will appear here...</span>';
            updateCharCount(0);
            return;
        }

        const palettes = currentMode === 'numeric' ? PRESET_PALETTES_NUMERIC : PRESET_PALETTES_LETTER;
        const codes = palettes[activePreset] || palettes['matrix'];
        let result = '';
        let cleanCharIndex = 0;

        for (let i = 0; i < text.length; i++) {
            const char = text[i];
            if (char === ' ') {
                result += ' ';
            } else {
                const codeIndex = cleanCharIndex % codes.length;
                const code = codes[codeIndex];
                result += `^${code}${char}`;
                cleanCharIndex++;
            }
        }

        document.getElementById('formattedCodeOutput').value = result;
        renderLivePreview(result);
        updateCharCount(text.length);
    }

    function hexToRgb(hex) {
        hex = hex.replace('#', '');
        if (hex.length === 3) {
            hex = hex.split('').map(c => c + c).join('');
        }
        const num = parseInt(hex, 16);
        return {
            r: (num >> 16) & 255,
            g: (num >> 8) & 255,
            b: num & 255
        };
    }

    // Converts RGB (0-255) to 3-digit ^RGB HoN code (^000 to ^999)
    function rgbToHon3DigitCode(rgb) {
        const rDigit = Math.min(9, Math.max(0, Math.round(rgb.r / 255 * 9)));
        const gDigit = Math.min(9, Math.max(0, Math.round(rgb.g / 255 * 9)));
        const bDigit = Math.min(9, Math.max(0, Math.round(rgb.b / 255 * 9)));
        return `${rDigit}${gDigit}${bDigit}`;
    }

    // Converts RGB (0-255) to closest verified 1-letter HoN code
    function findClosestHonLetterCode(rgb) {
        let minDistance = Infinity;
        let bestCode = 'w';

        for (const [code, hexColor] of Object.entries(HON_VERIFIED_LETTER_MAP)) {
            if (code !== '*' && code !== 'n') {
                const targetRgb = hexToRgb(hexColor);
                const dist = Math.pow(rgb.r - targetRgb.r, 2) +
                    Math.pow(rgb.g - targetRgb.g, 2) +
                    Math.pow(rgb.b - targetRgb.b, 2);
                if (dist < minDistance) {
                    minDistance = dist;
                    bestCode = code;
                }
            }
        }
        return bestCode;
    }

    function applyCustomGradient() {
        const rawInput = document.getElementById('rawTextInput');
        let text = rawInput.value.replace(/\^\d{3}|\^[a-zA-Z*]/g, '');
        if (!text) text = "CUSTOM GRADIENT";
        rawInput.value = text;

        const startRgb = hexToRgb(document.getElementById('colorStart').value);
        const midRgb = hexToRgb(document.getElementById('colorMid').value);
        const endRgb = hexToRgb(document.getElementById('colorEnd').value);

        let result = '';
        let cleanChars = text.split('').filter(c => c !== ' ');
        let total = cleanChars.length;
        let charCounter = 0;

        for (let i = 0; i < text.length; i++) {
            const char = text[i];
            if (char === ' ') {
                result += ' ';
            } else {
                let t = total > 1 ? charCounter / (total - 1) : 0;
                let currentRgb;
                if (t <= 0.5) {
                    let factor = t * 2;
                    currentRgb = {
                        r: Math.round(startRgb.r + (midRgb.r - startRgb.r) * factor),
                        g: Math.round(startRgb.g + (midRgb.g - startRgb.g) * factor),
                        b: Math.round(startRgb.b + (midRgb.b - startRgb.b) * factor)
                    };
                } else {
                    let factor = (t - 0.5) * 2;
                    currentRgb = {
                        r: Math.round(midRgb.r + (endRgb.r - midRgb.r) * factor),
                        g: Math.round(midRgb.g + (endRgb.g - midRgb.g) * factor),
                        b: Math.round(midRgb.b + (endRgb.b - midRgb.b) * factor)
                    };
                }

                const code = currentMode === 'numeric' ? rgbToHon3DigitCode(currentRgb) : findClosestHonLetterCode(currentRgb);
                result += `^${code}${char}`;
                charCounter++;
            }
        }

        document.getElementById('formattedCodeOutput').value = result;
        renderLivePreview(result);
        updateCharCount(text.length);
    }

    function randomizeGradient() {
        const randomBrightHex = () => {
            const hue = Math.floor(Math.random() * 360);
            return hslToHex(hue, 85, 55);
        };

        document.getElementById('colorStart').value = randomBrightHex();
        document.getElementById('colorMid').value = randomBrightHex();
        document.getElementById('colorEnd').value = randomBrightHex();
        applyCustomGradient();
    }

    function hslToHex(h, s, l) {
        l /= 100;
        const a = s * Math.min(l, 1 - l) / 100;
        const f = n => {
            const k = (n + h / 30) % 12;
            const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
            return Math.round(255 * color).toString(16).padStart(2, '0');
        };
        return `#${f(0)}${f(8)}${f(4)}`;
    }

    // Full HoN color parser supporting ^RGB (3 digits) and ^x (1 letter)
    function parseHonFormattedString(formattedText) {
        let html = '';
        let currentColor = '#FFFFFF';
        let i = 0;

        while (i < formattedText.length) {
            if (formattedText[i] === '^' && i + 1 < formattedText.length) {
                // Check 3-digit numerical code ^RGB
                if (i + 3 < formattedText.length && /^\d{3}$/.test(formattedText.substring(i + 1, i + 4))) {
                    const r = Math.round(parseInt(formattedText[i + 1]) * 255 / 9);
                    const g = Math.round(parseInt(formattedText[i + 2]) * 255 / 9);
                    const b = Math.round(parseInt(formattedText[i + 3]) * 255 / 9);
                    currentColor = `rgb(${r}, ${g}, ${b})`;
                    i += 4;
                    continue;
                }

                // Check 1-letter code ^x
                const codeChar = formattedText[i + 1].toLowerCase();
                if (HON_VERIFIED_LETTER_MAP[codeChar]) {
                    currentColor = HON_VERIFIED_LETTER_MAP[codeChar];
                    i += 2;
                    continue;
                }

                // Fallback for unhandled ^
                i += 2;
            } else {
                const char = formattedText[i];
                const escapedChar = char === '&' ? '&amp;' : (char === '<' ? '&lt;' : (char === '>' ? '&gt;' : char));
                html += `<span style="color: ${currentColor}">${escapedChar}</span>`;
                i++;
            }
        }
        return html;
    }

    function renderLivePreview(formattedText) {
        const previewContainer = document.getElementById('liveChatPreview');
        if (!formattedText) {
            previewContainer.innerHTML = '';
            return;
        }

        const html = parseHonFormattedString(formattedText);
        previewContainer.innerHTML = html || '<span class="text-slate-600 italic">Empty message</span>';
    }

    function updateCharCount(count) {
        document.getElementById('charCounter').textContent = `${count} characters`;
    }

    function copyFormattedCode() {
        const outputField = document.getElementById('formattedCodeOutput');
        if (!outputField.value) return;

        navigator.clipboard.writeText(outputField.value).then(() => {
            const copyBtnText = document.getElementById('copyBtnText');
            const btn = document.getElementById('btnCopyCode');
            const oldText = copyBtnText.textContent;

            copyBtnText.textContent = "Copied to Clipboard! ✨";
            btn.classList.remove('from-purple-600', 'to-amber-500');
            btn.classList.add('from-emerald-600', 'to-teal-500');

            setTimeout(() => {
                copyBtnText.textContent = oldText;
                btn.classList.remove('from-emerald-600', 'to-teal-500');
                btn.classList.add('from-purple-600', 'to-amber-500');
            }, 2500);
        }).catch(err => {
            console.error("Failed to copy:", err);
        });
    }

    function loadFromDecode() {
        const decodeVal = document.getElementById('decodeInput').value;
        if (!decodeVal) return;

        // Clean plain text without ^ codes
        const plainText = decodeVal.replace(/\^\d{3}|\^[a-zA-Z*]/g, '');

        const resultBox = document.getElementById('decodeResultBox');
        resultBox.classList.remove('hidden');

        document.getElementById('decodedPlainText').value = plainText;

        // Render visual preview inside decode section
        const previewEl = document.getElementById('decodedVisualPreview');
        const html = parseHonFormattedString(decodeVal);
        previewEl.innerHTML = html || '<span class="text-slate-600 italic">Empty string</span>';
    }

    function copyDecodedText() {
        const field = document.getElementById('decodedPlainText');
        if (!field.value) return;

        navigator.clipboard.writeText(field.value).then(() => {
            const btn = document.getElementById('btnCopyDecoded');
            const oldText = btn.textContent;
            btn.textContent = "Copied! ✨";
            setTimeout(() => {
                btn.textContent = oldText;
            }, 2000);
        });
    }

    function loadDecodedToEditor() {
        const decodeVal = document.getElementById('decodeInput').value;
        if (!decodeVal) return;
        document.getElementById('rawTextInput').value = decodeVal;
        updateFormattedOutput();
    }

    // =========================================================================
    // TAB SWITCHING
    // =========================================================================
    function switchMainTab(tab) {
        const btnGen = document.getElementById('tabBtnGenerator');
        const btnMac = document.getElementById('tabBtnMacros');
        const contentGen = document.getElementById('tabContentGenerator');
        const contentMac = document.getElementById('tabContentMacros');

        if (tab === 'generator') {
            btnGen.className = "flex-1 min-w-[240px] px-5 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2.5 bg-gradient-to-r from-purple-600/30 to-pink-600/30 text-white border border-purple-500/50 shadow-md cursor-pointer";
            btnMac.className = "flex-1 min-w-[240px] px-5 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2.5 bg-slate-900/60 text-slate-400 border border-slate-800/80 hover:text-slate-200 cursor-pointer";
            contentGen.classList.remove('hidden');
            contentMac.classList.add('hidden');
        } else {
            btnMac.className = "flex-1 min-w-[240px] px-5 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2.5 bg-gradient-to-r from-amber-500/30 via-orange-500/20 to-red-500/30 text-amber-200 border border-amber-500/50 shadow-md cursor-pointer";
            btnGen.className = "flex-1 min-w-[240px] px-5 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2.5 bg-slate-900/60 text-slate-400 border border-slate-800/80 hover:text-slate-200 cursor-pointer";
            contentMac.classList.remove('hidden');
            contentGen.classList.add('hidden');
            // Ensure cards & preview are rendered
            renderMacroCards();
            selectMacro(selectedMacroId);
        }
    }

