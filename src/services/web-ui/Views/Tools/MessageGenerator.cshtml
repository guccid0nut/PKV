@{
    ViewData["Title"] = "HoN Text Color & Message Generator";
}

<div class="w-full max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Header Banner -->
    <div
        class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-purple-900/60 via-slate-900/80 to-slate-950 p-6 sm:p-8 border border-purple-500/30 shadow-2xl">
        <div
            class="absolute -right-10 -bottom-10 w-72 h-72 bg-gradient-to-tr from-purple-500/20 to-pink-500/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 space-y-3">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/15 border border-purple-500/30 text-purple-300 text-xs font-bold uppercase tracking-wider">
                <span>🎨 Public Tool</span>
                <span class="text-purple-400">•</span>
                <span>HoN ^RGB & ^code Format</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-purple-300 via-pink-300 to-amber-200">
                HoN Text Color & Message Generator
            </h1>
            <p class="text-slate-300 text-sm sm:text-base max-w-3xl leading-relaxed">
                Create fun, eye-catching, colorful messages for Heroes of Newerth in-game chat, match lobbies, and clan
                channels. Supports native 3-digit <code
                    class="text-emerald-300 font-mono font-bold bg-slate-900 px-1.5 py-0.5 rounded">^RGB</code>
                numerical codes (like <code
                    class="text-emerald-400 font-mono font-bold bg-slate-900 px-1.5 py-0.5 rounded">^091</code> Matrix
                Green) and classic <code class="text-pink-300 font-mono font-bold bg-slate-900 px-1.5 py-0.5 rounded">^code</code>
                formats!
            </p>
        </div>
    </div>

    <!-- Main Tool Navigation Tabs -->
    <div class="flex flex-wrap items-center gap-3 p-1.5 bg-slate-950/80 rounded-2xl border border-slate-800 shadow-xl">
        <button type="button" id="tabBtnGenerator" onclick="switchMainTab('generator')"
                class="flex-1 min-w-[240px] px-5 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2.5 bg-gradient-to-r from-purple-600/30 to-pink-600/30 text-white border border-purple-500/50 shadow-md cursor-pointer">
            <i class="fa-solid fa-wand-magic-sparkles text-pink-400"></i>
            <span>Text & Gradient Generator</span>
        </button>
        <button type="button" id="tabBtnMacros" onclick="switchMainTab('macros')"
                class="flex-1 min-w-[240px] px-5 py-3 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2.5 bg-slate-900/60 text-slate-400 border border-slate-800/80 hover:text-slate-200 cursor-pointer">
            <i class="fa-solid fa-skull-crossbones text-amber-400"></i>
            <span>ASCII Kill Macro Studio & AHK Exporter</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-500/20 text-amber-300 border border-amber-500/40 uppercase tracking-wider">
                15 Macros
            </span>
        </button>
    </div>

    <!-- TAB 1: Single-Line Text & Gradient Generator -->
    <div id="tabContentGenerator" class="space-y-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Left Panel: Text & Controls (7 Cols) -->
        <div class="lg:col-span-7 space-y-6">
            <!-- Text Input Card -->
            <div class="glass-panel p-6 rounded-3xl border border-slate-800 space-y-4">
                <div class="flex items-center justify-between">
                    <label for="rawTextInput" class="text-sm font-bold text-slate-200 flex items-center gap-2">
                        <i class="fa-solid fa-pen-to-square text-purple-400"></i>
                        <span>Your Message</span>
                    </label>
                    <span id="charCounter"
                          class="text-xs font-semibold text-slate-400 bg-slate-900/80 px-2.5 py-1 rounded-full border border-slate-800">
                        0 characters
                    </span>
                </div>

                <textarea id="rawTextInput" rows="3"
                          class="w-full bg-slate-950/90 border border-slate-700/80 rounded-2xl p-4 text-white text-base font-medium focus:outline-none focus:border-purple-500/80 focus:ring-2 focus:ring-purple-500/20 transition-all placeholder-slate-500"
                          placeholder="Type your message here..."></textarea>

                <!-- Format Output Mode Toggle -->
                <div
                    class="pt-2 flex items-center justify-between flex-wrap gap-3 bg-slate-950/60 p-3 rounded-2xl border border-slate-800">
                    <span class="text-xs font-bold text-slate-300 flex items-center gap-1.5">
                        <i class="fa-solid fa-sliders text-amber-400"></i>
                        <span>HoN Color Encoding Mode:</span>
                    </span>
                    <div class="flex items-center gap-2">
                        <button type="button" id="btnModeNumeric" onclick="setMode('numeric')"
                                class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all border bg-emerald-500/20 text-emerald-300 border-emerald-500/50 shadow-sm cursor-pointer">
                            <span>^RGB 3-Digit (1000 Colors)</span>
                        </button>
                        <button type="button" id="btnModeLetter" onclick="setMode('letter')"
                                class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all border bg-slate-900 text-slate-400 border-slate-800 hover:text-slate-200 cursor-pointer">
                            <span>^x 1-Letter Classic</span>
                        </button>
                    </div>
                </div>

                <!-- Quick Preset Templates -->
                <div class="space-y-2 pt-1">
                    <span class="text-xs font-semibold text-slate-400">Quick Templates:</span>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" onclick="setTemplate('MID OR FEED!')"
                                class="px-2.5 py-1 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/60 text-xs font-semibold text-slate-300 hover:text-amber-300 transition-all cursor-pointer">
                            🔥 MID OR FEED!
                        </button>
                        <button type="button" onclick="setTemplate('GL HF ALL!')"
                                class="px-2.5 py-1 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/60 text-xs font-semibold text-slate-300 hover:text-cyan-300 transition-all cursor-pointer">
                            🌈 GL HF ALL!
                        </button>
                        <button type="button" onclick="setTemplate('GG WP ALL!')"
                                class="px-2.5 py-1 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/60 text-xs font-semibold text-slate-300 hover:text-emerald-300 transition-all cursor-pointer">
                            ✨ GG WP ALL!
                        </button>
                        <button type="button" onclick="setTemplate('KONGOR IS MINE')"
                                class="px-2.5 py-1 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/60 text-xs font-semibold text-slate-300 hover:text-purple-300 transition-all cursor-pointer">
                            👑 KONGOR IS MINE
                        </button>
                        <button type="button" onclick="setTemplate('PENTAKILL!!!')"
                                class="px-2.5 py-1 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/60 text-xs font-semibold text-slate-300 hover:text-red-400 transition-all cursor-pointer">
                            💀 PENTAKILL!!!
                        </button>
                        <button type="button" onclick="setTemplate('LANECALL: TOP')"
                                class="px-2.5 py-1 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/60 text-xs font-semibold text-slate-300 hover:text-blue-300 transition-all cursor-pointer">
                            🛡️ LANECALL: TOP
                        </button>
                    </div>
                </div>
            </div>

            <!-- Gradient & Style Presets Card -->
            <div class="glass-panel p-6 rounded-3xl border border-slate-800 space-y-5">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <h3 class="text-sm font-bold text-slate-200 flex items-center gap-2">
                        <i class="fa-solid fa-wand-magic-sparkles text-pink-400"></i>
                        <span>Gradient & Color Themes</span>
                    </h3>
                </div>

                <!-- Presets Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
                    <button type="button" onclick="applyPreset('matrix')"
                            class="p-3 rounded-2xl bg-slate-900/90 hover:bg-slate-800 border border-slate-700/70 hover:border-emerald-500/50 flex items-center gap-2.5 text-xs font-bold transition-all text-left group cursor-pointer">
                        <span
                            class="w-4 h-4 rounded-full bg-gradient-to-r from-emerald-600 via-green-400 to-lime-300 flex-shrink-0"></span>
                        <span class="text-slate-200 group-hover:text-emerald-300">Matrix Green (^091)</span>
                    </button>

                    <button type="button" onclick="applyPreset('rainbow')"
                            class="p-3 rounded-2xl bg-slate-900/90 hover:bg-slate-800 border border-slate-700/70 hover:border-purple-500/50 flex items-center gap-2.5 text-xs font-bold transition-all text-left group cursor-pointer">
                        <span
                            class="w-4 h-4 rounded-full bg-gradient-to-r from-red-500 via-green-500 via-cyan-500 to-purple-500 flex-shrink-0"></span>
                        <span class="text-slate-200 group-hover:text-white">Rainbow Spectrum</span>
                    </button>

                    <button type="button" onclick="applyPreset('fire')"
                            class="p-3 rounded-2xl bg-slate-900/90 hover:bg-slate-800 border border-slate-700/70 hover:border-amber-500/50 flex items-center gap-2.5 text-xs font-bold transition-all text-left group cursor-pointer">
                        <span
                            class="w-4 h-4 rounded-full bg-gradient-to-r from-red-600 via-orange-500 to-yellow-400 flex-shrink-0"></span>
                        <span class="text-slate-200 group-hover:text-amber-300">Inferno Fire</span>
                    </button>

                    <button type="button" onclick="applyPreset('ice')"
                            class="p-3 rounded-2xl bg-slate-900/90 hover:bg-slate-800 border border-slate-700/70 hover:border-cyan-500/50 flex items-center gap-2.5 text-xs font-bold transition-all text-left group cursor-pointer">
                        <span
                            class="w-4 h-4 rounded-full bg-gradient-to-r from-blue-500 via-cyan-400 to-white flex-shrink-0"></span>
                        <span class="text-slate-200 group-hover:text-cyan-300">Frost Ice</span>
                    </button>

                    <button type="button" onclick="applyPreset('toxic')"
                            class="p-3 rounded-2xl bg-slate-900/90 hover:bg-slate-800 border border-slate-700/70 hover:border-emerald-500/50 flex items-center gap-2.5 text-xs font-bold transition-all text-left group cursor-pointer">
                        <span
                            class="w-4 h-4 rounded-full bg-gradient-to-r from-lime-400 via-emerald-500 to-teal-400 flex-shrink-0"></span>
                        <span class="text-slate-200 group-hover:text-emerald-300">Toxic Neon</span>
                    </button>

                    <button type="button" onclick="applyPreset('gold')"
                            class="p-3 rounded-2xl bg-slate-900/90 hover:bg-slate-800 border border-slate-700/70 hover:border-amber-500/50 flex items-center gap-2.5 text-xs font-bold transition-all text-left group cursor-pointer">
                        <span
                            class="w-4 h-4 rounded-full bg-gradient-to-r from-yellow-300 via-amber-500 to-orange-600 flex-shrink-0"></span>
                        <span class="text-slate-200 group-hover:text-amber-200">Gold Sunset</span>
                    </button>

                    <button type="button" onclick="applyPreset('void')"
                            class="p-3 rounded-2xl bg-slate-900/90 hover:bg-slate-800 border border-slate-700/70 hover:border-purple-500/50 flex items-center gap-2.5 text-xs font-bold transition-all text-left group cursor-pointer">
                        <span
                            class="w-4 h-4 rounded-full bg-gradient-to-r from-purple-600 via-violet-500 to-blue-600 flex-shrink-0"></span>
                        <span class="text-slate-200 group-hover:text-purple-300">Void Shadow</span>
                    </button>

                    <button type="button" onclick="applyPreset('candy')"
                            class="p-3 rounded-2xl bg-slate-900/90 hover:bg-slate-800 border border-slate-700/70 hover:border-pink-500/50 flex items-center gap-2.5 text-xs font-bold transition-all text-left group cursor-pointer">
                        <span
                            class="w-4 h-4 rounded-full bg-gradient-to-r from-pink-500 via-fuchsia-400 to-purple-400 flex-shrink-0"></span>
                        <span class="text-slate-200 group-hover:text-pink-300">Candy Pink</span>
                    </button>

                    <button type="button" onclick="applyPreset('monochrome')"
                            class="p-3 rounded-2xl bg-slate-900/90 hover:bg-slate-800 border border-slate-700/70 hover:border-slate-500/50 flex items-center gap-2.5 text-xs font-bold transition-all text-left group cursor-pointer">
                        <span
                            class="w-4 h-4 rounded-full bg-gradient-to-r from-slate-100 via-slate-400 to-slate-800 flex-shrink-0"></span>
                        <span class="text-slate-200 group-hover:text-slate-300">Monochrome</span>
                    </button>
                </div>

                <!-- Custom RGB Color Picker Section -->
                <div class="pt-4 border-t border-slate-800 space-y-3">
                    <span class="text-xs font-bold text-slate-300 flex items-center gap-2">
                        <i class="fa-solid fa-palette text-cyan-400"></i>
                        <span>Custom Multi-Color Gradient</span>
                    </span>
                    <div class="flex items-center gap-3 flex-wrap">
                        <div class="flex items-center gap-2 bg-slate-950 p-2 rounded-xl border border-slate-800">
                            <label for="colorStart" class="text-xs text-slate-400 font-semibold">Start:</label>
                            <input type="color" id="colorStart" value="#00FF1C"
                                   class="w-7 h-7 rounded-lg border-0 cursor-pointer bg-transparent"/>
                        </div>
                        <div class="flex items-center gap-2 bg-slate-950 p-2 rounded-xl border border-slate-800">
                            <label for="colorMid" class="text-xs text-slate-400 font-semibold">Mid:</label>
                            <input type="color" id="colorMid" value="#00E5FF"
                                   class="w-7 h-7 rounded-lg border-0 cursor-pointer bg-transparent"/>
                        </div>
                        <div class="flex items-center gap-2 bg-slate-950 p-2 rounded-xl border border-slate-800">
                            <label for="colorEnd" class="text-xs text-slate-400 font-semibold">End:</label>
                            <input type="color" id="colorEnd" value="#FF00A0"
                                   class="w-7 h-7 rounded-lg border-0 cursor-pointer bg-transparent"/>
                        </div>

                        <button type="button" onclick="applyCustomGradient()"
                                class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs shadow-md transition-all flex items-center gap-1.5 cursor-pointer">
                            <i class="fa-solid fa-check"></i>
                            <span>Apply Gradient</span>
                        </button>

                        <button type="button" onclick="randomizeGradient()"
                                class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-bold text-xs shadow-md transition-all flex items-center gap-1.5 cursor-pointer">
                            <i class="fa-solid fa-dice text-amber-300"></i>
                            <span>Randomize Gradient</span>
                        </button>
                    </div>
                </div>

                <!-- Verified Single Color Quick Palette -->
                <div class="pt-4 border-t border-slate-800 space-y-2">
                    <span class="text-xs font-bold text-slate-300">Verified Single Color Palette (Apply Code):</span>
                    <div class="flex flex-wrap gap-1.5">
                        <button type="button" onclick="applySolidCode('091')"
                                class="px-2.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-black shadow cursor-pointer"
                                title="^091 Matrix Green">^091 Matrix
                        </button>
                        <button type="button" onclick="applySolidCode('r')"
                                class="px-2.5 py-1 rounded-lg bg-red-600 hover:bg-red-500 text-white text-xs font-black shadow cursor-pointer"
                                title="^r Red">^r Red
                        </button>
                        <button type="button" onclick="applySolidCode('g')"
                                class="px-2.5 py-1 rounded-lg bg-green-600 hover:bg-green-500 text-white text-xs font-black shadow cursor-pointer"
                                title="^g Green">^g Green
                        </button>
                        <button type="button" onclick="applySolidCode('b')"
                                class="px-2.5 py-1 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-black shadow cursor-pointer"
                                title="^b Blue">^b Blue
                        </button>
                        <button type="button" onclick="applySolidCode('y')"
                                class="px-2.5 py-1 rounded-lg bg-yellow-500 hover:bg-yellow-400 text-slate-950 text-xs font-black shadow cursor-pointer"
                                title="^y Yellow">^y Yellow
                        </button>
                        <button type="button" onclick="applySolidCode('c')"
                                class="px-2.5 py-1 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs font-black shadow cursor-pointer"
                                title="^c Cyan">^c Cyan
                        </button>
                        <button type="button" onclick="applySolidCode('m')"
                                class="px-2.5 py-1 rounded-lg bg-purple-600 hover:bg-purple-500 text-white text-xs font-black shadow cursor-pointer"
                                title="^m Magenta">^m Magenta
                        </button>
                        <button type="button" onclick="applySolidCode('o')"
                                class="px-2.5 py-1 rounded-lg bg-orange-500 hover:bg-orange-400 text-white text-xs font-black shadow cursor-pointer"
                                title="^o Orange">^o Orange
                        </button>
                        <button type="button" onclick="applySolidCode('p')"
                                class="px-2.5 py-1 rounded-lg bg-pink-500 hover:bg-pink-400 text-white text-xs font-black shadow cursor-pointer"
                                title="^p Pink">^p Pink
                        </button>
                        <button type="button" onclick="applySolidCode('w')"
                                class="px-2.5 py-1 rounded-lg bg-white hover:bg-slate-200 text-slate-950 text-xs font-black shadow cursor-pointer"
                                title="^w White">^w White
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Panel: Live Preview & Formatted Output (5 Cols) -->
        <div class="lg:col-span-5 space-y-6">
            <!-- In-Game Chat Visual Preview Card -->
            <div class="glass-panel p-6 rounded-3xl border border-slate-800 space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-bold text-slate-200 flex items-center gap-2">
                        <i class="fa-solid fa-display text-cyan-400"></i>
                        <span>Live In-Game Chat Preview</span>
                    </h3>
                    <span
                        class="text-[11px] font-semibold text-slate-400 bg-slate-900 px-2 py-0.5 rounded-md border border-slate-800">
                        HoN UI Match Style
                    </span>
                </div>

                <!-- Simulated HoN Chat Box -->
                <div
                    class="w-full min-h-[140px] bg-slate-950/95 rounded-2xl p-4 border border-cyan-500/20 shadow-inner flex flex-col justify-end space-y-2 relative overflow-hidden">
                    <div
                        class="absolute top-2 right-2 text-[10px] uppercase tracking-wider font-bold text-slate-600 select-none">
                        ALL CHAT
                    </div>

                    <!-- Chat Message Stream Simulation -->
                    <div class="text-xs text-slate-500 select-none font-mono">
                        [ALL] System: Welcome to Newerth!
                    </div>

                    <div id="liveChatPreview"
                         class="text-sm font-bold leading-relaxed font-sans transition-all break-words"
                         style="text-shadow: 1px 1px 2px #000, 0 0 5px rgba(0,0,0,0.9);">
                        <!-- Rendered colored spans will go here -->
                    </div>
                </div>
            </div>

            <!-- Formatted Code Output Card -->
            <div
                class="glass-panel p-6 rounded-3xl border border-purple-500/30 shadow-xl space-y-4 relative overflow-hidden">
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-bold text-slate-200 flex items-center gap-2">
                        <i class="fa-solid fa-code text-amber-400"></i>
                        <span>Formatted HoN Code</span>
                    </h3>
                </div>

                <textarea id="formattedCodeOutput" readonly rows="4"
                          class="w-full bg-slate-950 font-mono text-xs text-purple-300 border border-purple-500/30 rounded-2xl p-4 focus:outline-none select-all break-all"
                          placeholder="^091M^092I^093D ^094O^095R ^096F..."></textarea>

                <div class="flex items-center gap-3">
                    <button type="button" id="btnCopyCode" onclick="copyFormattedCode()"
                            class="flex-1 py-3 px-4 rounded-2xl bg-gradient-to-r from-purple-600 via-pink-600 to-amber-500 hover:from-purple-500 hover:to-amber-400 text-white font-bold text-sm shadow-lg shadow-purple-950/50 transition-all flex items-center justify-center gap-2 cursor-pointer">
                        <i class="fa-solid fa-copy"></i>
                        <span id="copyBtnText">Copy Formatted Text</span>
                    </button>
                </div>
            </div>

            <!-- Reverse Decoder Card -->
            <div class="glass-panel p-6 rounded-3xl border border-slate-800 space-y-4">
                <h3 class="text-xs font-bold text-slate-300 flex items-center gap-2">
                    <i class="fa-solid fa-code-compare text-emerald-400"></i>
                    <span>Paste & Decode Existing ^code / ^RGB String</span>
                </h3>
                <div class="flex gap-2">
                    <input type="text" id="decodeInput" placeholder="Paste e.g. ^091Matrix^099Cyan or ^rRed^gGreen"
                           class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs font-mono text-slate-200 focus:outline-none focus:border-emerald-500/50"/>
                    <button type="button" onclick="loadFromDecode()"
                            class="px-4 py-2 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/40 text-xs font-bold text-emerald-300 transition-all cursor-pointer">
                        Decode
                    </button>
                </div>

                <!-- Decoded Result Container (Shown when Decode is clicked) -->
                <div id="decodeResultBox" class="hidden space-y-3 pt-3 border-t border-slate-800">
                    <div class="space-y-1">
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Decoded Visual Preview:</span>
                        <div id="decodedVisualPreview"
                             class="p-3 rounded-xl bg-slate-950/90 border border-emerald-500/30 text-sm font-bold break-words"
                             style="text-shadow: 1px 1px 2px #000;"></div>
                    </div>

                    <div class="space-y-1">
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Clean Plain Text (No ^ Codes):</span>
                        <div class="flex gap-2">
                            <input type="text" id="decodedPlainText" readonly
                                   class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs font-medium text-slate-200 focus:outline-none"/>
                            <button type="button" id="btnCopyDecoded" onclick="copyDecodedText()"
                                    class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-slate-200 transition-all cursor-pointer">
                                Copy Plain Text
                            </button>
                        </div>
                    </div>

                    <div class="pt-1">
                        <button type="button" onclick="loadDecodedToEditor()"
                                class="text-xs text-purple-400 hover:text-purple-300 font-semibold underline underline-offset-4 flex items-center gap-1 cursor-pointer">
                            <span>Load raw code into Editor to modify</span>
                            <i class="fa-solid fa-arrow-right text-[10px]"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
    <!-- END TAB 1: Single-Line Text & Gradient Generator -->

    <!-- TAB 2: ASCII Kill Macro Studio & AutoHotkey Exporter -->
    <div id="tabContentMacros" class="space-y-8 hidden">
        <!-- Top Toolbar: Search & Category Filters -->
        <div class="glass-panel p-5 rounded-3xl border border-slate-800 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-1">
                    <i class="fa-solid fa-filter text-amber-400 mr-1"></i> Filter:
                </span>
