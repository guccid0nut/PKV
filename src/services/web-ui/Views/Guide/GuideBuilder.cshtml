    // EXPORT / IMPORT BUILD CODE MODALS
    // =========================================================================
    function openExportModal() {
        const title = document.getElementById('builder-guide-title')?.value.trim() || 'My Hero Build';
        const heroSelect = document.getElementById('builder-hero-select');
        const heroIdentifier = heroSelect ? heroSelect.value : 'Hero_Panda';

        const exportObj = {
            version: "1.0",
            exportedAt: new Date().toISOString(),
            heroIdentifier: heroIdentifier,
            heroName: formatHeroName(heroIdentifier.replace(/^Hero_/i, '')),
            guideName: title,
            targetMap: document.getElementById('builder-target-map')?.value || 'caldavar',
            intro: document.getElementById('builder-intro')?.value.trim() || '',
            detailedDescription: document.getElementById('builder-content')?.value.trim() || '',
            startingItems: buildStartingItems.join(','),
            earlyGameItems: buildLaningItems.join(','),
            coreItems: buildCoreItems.join(','),
            luxuryItems: buildLuxuryItems.join(','),
            abilityQueue: buildAbilityQueue.join(',')
        };

        const jsonStr = JSON.stringify(exportObj);
        const base64Code = btoa(unescape(encodeURIComponent(jsonStr)));
        document.getElementById('export-code-textarea').value = base64Code;
        document.getElementById('export-guide-modal')?.classList.remove('hidden');
    }

    function closeExportModal() {
        document.getElementById('export-guide-modal')?.classList.add('hidden');
    }

    function copyExportCode() {
        const textarea = document.getElementById('export-code-textarea');
        textarea.select();
        document.execCommand('copy');
        const copyBtn = document.getElementById('copy-code-btn');
        if (copyBtn) {
            copyBtn.innerText = "✓ Copied to Clipboard!";
            setTimeout(() => {
                copyBtn.innerText = "📋 Copy Build Code";
            }, 2000);
        }
    }

    function downloadExportJson() {
        const title = document.getElementById('builder-guide-title')?.value.trim() || 'hero-guide';
        const heroSelect = document.getElementById('builder-hero-select');
        const heroIdentifier = heroSelect ? heroSelect.value.replace(/^Hero_/i, '').toLowerCase() : 'hero';

        const jsonStr = decodeURIComponent(escape(atob(document.getElementById('export-code-textarea').value)));
        const blob = new Blob([jsonStr], {type: "application/json"});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `hon-guide-${heroIdentifier}-${title.toLowerCase().replace(/[^a-z0-9]/g, '-')}.json`;
        a.click();
        URL.revokeObjectURL(url);
    }

    function openImportModal() {
        document.getElementById('import-code-textarea').value = '';
        document.getElementById('import-guide-modal')?.classList.remove('hidden');
    }

    function closeImportModal() {
        document.getElementById('import-guide-modal')?.classList.add('hidden');
    }

    function applyImportCode() {
        const raw = document.getElementById('import-code-textarea')?.value.trim();
        if (!raw) {
            alert("Please paste a build code or JSON.");
            return;
        }

        try {
            let data = null;
            if (raw.startsWith('{')) {
                data = JSON.parse(raw);
            } else {
                const decoded = decodeURIComponent(escape(atob(raw)));
                data = JSON.parse(decoded);
            }

            if (data) {
                if (data.guideName) document.getElementById('builder-guide-title').value = data.guideName;
                if (data.heroIdentifier) {
                    const heroSelect = document.getElementById('builder-hero-select');
                    if (heroSelect) {
                        heroSelect.value = data.heroIdentifier;
                        handleHeroChange(data.heroIdentifier);
                    }
                }
                if (data.targetMap) document.getElementById('builder-target-map').value = data.targetMap;
                if (data.intro) document.getElementById('builder-intro').value = data.intro;
                if (data.detailedDescription || data.content) document.getElementById('builder-content').value = data.detailedDescription || data.content;

                buildStartingItems = parseItems(data.startingItems || '');
                buildLaningItems = parseItems(data.earlyGameItems || '');
                buildCoreItems = parseItems(data.coreItems || '');
                buildLuxuryItems = parseItems(data.luxuryItems || '');

                if (buildLaningItems.length > 0) {
                    addLaningSection();
                } else {
                    removeLaningSection();
                }

                if (data.abilityQueue) {
                    const parts = data.abilityQueue.split(',').map(p => parseInt(p.trim()) || 0);
                    for (let i = 0; i < 25; i++) {
                        buildAbilityQueue[i] = parts[i] || 0;
                    }
                }

                renderBuildSlots();
                renderAbilityQueueTree();
                closeImportModal();
                alert("✓ Build loaded into Studio successfully!");
            }
        } catch (e) {
            console.error(e);
            alert("Invalid build code or JSON file.");
        }
    }

    function handleFileUpload(e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function (event) {
            document.getElementById('import-code-textarea').value = event.target.result;
        };
        reader.readAsText(file);
    }

