<div id="studio-floating-tooltip"
     class="fixed z-50 hidden pointer-events-none w-72 p-3.5 rounded-2xl bg-slate-950/95 border border-amber-500/50 shadow-2xl backdrop-blur-xl text-xs space-y-2 transition-opacity duration-150">
    <div class="flex items-start justify-between gap-2 border-b border-slate-800 pb-2">
        <div>
            <h4 id="tt-title" class="font-extrabold text-white text-sm text-amber-300">Item Name</h4>
            <span id="tt-category"
                  class="text-[10px] uppercase tracking-wider font-semibold text-purple-400">Category</span>
