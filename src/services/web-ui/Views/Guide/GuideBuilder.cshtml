@* ReSharper disable All *@
@using System.Text.Json
@using NEXUS.Contracts.Clients
@using HeroOptionDto = ASPIRE.Common.Models.Guides.HeroOptionDto;
@model NEXUS.Contracts.Clients.HeroGuideDto?
@{
    ViewData["Title"] = Model != null ? $"Edit {Model.Name} - Hero Guide Studio" : "Hero Guide Studio & Builder";
    string preselectedHero = ViewBag.PreselectedHero as string ?? ViewBag.SelectedHero as string ?? Model?.HeroIdentifier ?? "Hero_Panda";
    bool isEditing = Model is { ID: > 0 };
    string guideId = isEditing ? Model!.ID.ToString() : "0";
    string guideName = Model?.Name ?? "";
    string targetMap = Model?.TargetMap ?? "caldavar";
    string intro = Model?.Intro ?? "";
    string content = Model?.Content ?? "";
    string startingItems = Model?.StartingItems ?? "";
    string earlyGameItems = Model?.EarlyGameItems ?? "";
    string coreItems = Model?.CoreItems ?? "";
    string luxuryItems = Model?.LuxuryItems ?? "";
    string abilityQueue = Model?.AbilityQueue ?? "";
    bool isPublic = Model?.Public ?? true;
    bool hasLaningSection = !string.IsNullOrWhiteSpace(earlyGameItems);
}

@Html.AntiForgeryToken()

<div class="w-full max-w-[1920px] mx-auto py-4 sm:py-6 px-3 sm:px-6 lg:px-8 xl:px-10 space-y-5 animate-fade-in-up">
    <!-- Top Action & Navigation Bar -->
    <div
        class="glass-panel p-4 sm:p-5 rounded-3xl border border-slate-700/60 shadow-2xl bg-gradient-to-r from-slate-900/90 via-slate-900/80 to-purple-950/40 backdrop-blur-xl flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <a href="/guides"
               class="p-2 rounded-2xl bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white transition-all border border-slate-700 text-xs font-bold flex items-center gap-1.5 shadow-sm">
                <span>←</span>
                <span class="hidden sm:inline">Browse Guides</span>
            </a>
            <div>
                <div class="flex items-center gap-2">
                    <span
                        class="px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-amber-500/10 border border-amber-500/30 text-amber-400">
                        HERO GUIDE STUDIO
                    </span>
                    <span
                        class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-purple-500/10 border border-purple-500/30 text-purple-300">
                        @(isEditing ? $"Editing #{guideId}" : "New Build")
                    </span>
                </div>
                <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight">
                    @(isEditing ? $"Edit Guide: {guideName}" : "Create Hero Guide")
                </h1>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-2 w-full md:w-auto justify-end">
            <!-- Import Modal Trigger -->
            <button onclick="openImportModal()" type="button"
                    class="px-3.5 py-2 rounded-2xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-700 text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm active:scale-95">
                <span>📥</span>
                <span>Import Code</span>
            </button>

            <!-- Export Modal Trigger -->
            <button onclick="openExportModal()" type="button"
                    class="px-3.5 py-2 rounded-2xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-700 text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm active:scale-95">
                <span>📤</span>
                <span>Export Code</span>
            </button>

            <!-- Publish / Save Guide -->
            <button onclick="saveHeroGuide()" type="button" id="save-guide-btn"
                    class="px-5 py-2 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-xs transition-all shadow-lg shadow-amber-500/25 flex items-center gap-2 active:scale-95 border border-amber-300">
                <span>💾</span>
                <span>@(isEditing ? "Update Guide" : "Publish Guide")</span>
            </button>
        </div>
    </div>

    <!-- Main 3-Column Studio Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        <!-- ========================================== -->
        <!-- LEFT COLUMN: ITEM COMPENDIUM PALETTE (4 cols) -->
        <!-- ========================================== -->
        <div class="lg:col-span-4 space-y-4">
            <div
                class="glass-panel p-4 rounded-3xl border border-slate-800 shadow-xl space-y-3 sticky top-4 max-h-[88vh] flex flex-col bg-slate-950/80">
                <div class="flex items-center justify-between border-b border-slate-800/80 pb-2.5 flex-shrink-0">
                    <div class="flex items-center gap-2">
                        <span class="text-base">📦</span>
                        <h2 class="font-extrabold text-white text-sm tracking-wide uppercase">Item Compendium</h2>
                    </div>
                    <span id="palette-item-count"
                          class="text-[11px] font-mono text-slate-400 bg-slate-900 px-2 py-0.5 rounded-full border border-slate-800">
                        Loading...
                    </span>
                </div>

                <!-- Active Target Section Indicator for '+' Click -->
                <div
                    class="p-2.5 rounded-2xl bg-slate-900/90 border border-slate-800 flex items-center justify-between gap-2 flex-shrink-0 shadow-inner">
                    <div class="flex items-center gap-1.5 min-w-0">
                        <span class="text-xs">🎯</span>
                        <span class="text-[11px] text-slate-400">Click <strong>+</strong> adds to:</span>
                    </div>
                    <span id="palette-active-section-label"
                          class="px-2.5 py-0.5 rounded-full text-[11px] font-black bg-amber-500/20 text-amber-300 border border-amber-500/40 shadow-sm truncate">
                        🎒 Starting Items
                    </span>
                </div>

                <!-- Search Input -->
                <div class="relative flex-shrink-0">
                    <input type="text"
                           id="palette-item-search"
                           oninput="filterPaletteItems()"
                           placeholder="Search items, stats, components..."
                           class="w-full bg-slate-900 text-white placeholder-slate-500 text-xs rounded-xl px-3.5 py-2 pl-9 border border-slate-700 focus:outline-none focus:border-amber-400 shadow-inner transition-all"/>
                    <span class="absolute left-3 top-2.5 text-slate-400 text-xs">🔍</span>
                </div>

                <!-- Category Filters (Horizontal Scrollable Pills matching HoN Shop) -->
                <div class="flex items-center gap-1.5 overflow-x-auto pb-1.5 no-scrollbar flex-shrink-0">
                    <button onclick="setPaletteCategory('all')" data-cat="all"
                            class="palette-cat-btn px-2.5 py-1 rounded-lg text-[11px] font-bold transition-all bg-amber-500/20 text-amber-300 border border-amber-500/40 shadow-sm flex-shrink-0">
                        All Items
                    </button>
                    <button onclick="setPaletteCategory('supplies')" data-cat="supplies"
                            class="palette-cat-btn px-2.5 py-1 rounded-lg text-[11px] font-medium transition-all bg-slate-900 text-slate-400 hover:text-white border border-slate-800 flex-shrink-0">
                        🧪 Supplies
                    </button>
                    <button onclick="setPaletteCategory('accessories')" data-cat="accessories"
                            class="palette-cat-btn px-2.5 py-1 rounded-lg text-[11px] font-medium transition-all bg-slate-900 text-slate-400 hover:text-white border border-slate-800 flex-shrink-0">
                        💍 Accessories
                    </button>
                    <button onclick="setPaletteCategory('weapons')" data-cat="weapons"
                            class="palette-cat-btn px-2.5 py-1 rounded-lg text-[11px] font-medium transition-all bg-slate-900 text-slate-400 hover:text-white border border-slate-800 flex-shrink-0">
                        ⚔️ Weapons
                    </button>
                    <button onclick="setPaletteCategory('relics')" data-cat="relics"
                            class="palette-cat-btn px-2.5 py-1 rounded-lg text-[11px] font-medium transition-all bg-slate-900 text-slate-400 hover:text-white border border-slate-800 flex-shrink-0">
                        🔮 Relics
                    </button>
                    <button onclick="setPaletteCategory('initiation')" data-cat="initiation"
                            class="palette-cat-btn px-2.5 py-1 rounded-lg text-[11px] font-medium transition-all bg-slate-900 text-slate-400 hover:text-white border border-slate-800 flex-shrink-0">
                        ⚡ Initiation
                    </button>
                    <button onclick="setPaletteCategory('supportive')" data-cat="supportive"
                            class="palette-cat-btn px-2.5 py-1 rounded-lg text-[11px] font-medium transition-all bg-slate-900 text-slate-400 hover:text-white border border-slate-800 flex-shrink-0">
                        🛡️ Supportive
                    </button>
                    <button onclick="setPaletteCategory('protective')" data-cat="protective"
                            class="palette-cat-btn px-2.5 py-1 rounded-lg text-[11px] font-medium transition-all bg-slate-900 text-slate-400 hover:text-white border border-slate-800 flex-shrink-0">
                        🔰 Protective
                    </button>
                    <button onclick="setPaletteCategory('combative')" data-cat="combative"
                            class="palette-cat-btn px-2.5 py-1 rounded-lg text-[11px] font-medium transition-all bg-slate-900 text-slate-400 hover:text-white border border-slate-800 flex-shrink-0">
                        ⚔️ Combative
                    </button>
                    <button onclick="setPaletteCategory('morph attack')" data-cat="morph attack"
                            class="palette-cat-btn px-2.5 py-1 rounded-lg text-[11px] font-medium transition-all bg-slate-900 text-slate-400 hover:text-white border border-slate-800 flex-shrink-0">
                        ❄️ Morph Attack
                    </button>
                    <button onclick="setPaletteCategory('secret')" data-cat="secret"
                            class="palette-cat-btn px-2.5 py-1 rounded-lg text-[11px] font-medium transition-all bg-slate-900 text-slate-400 hover:text-white border border-slate-800 flex-shrink-0">
                        🗝️ Secret
                    </button>
                </div>

                <!-- Draggable Items Scroll Grid (Clean 2-column layout with full names) -->
                <div id="palette-items-grid"
                     class="grid grid-cols-1 sm:grid-cols-2 gap-2 overflow-y-auto pr-1 flex-1 min-h-[300px]">
                    <div class="col-span-full py-8 text-center text-slate-500 text-xs">
                        Loading item compendium codex...
                    </div>
                </div>

                <div
                    class="p-2.5 rounded-2xl bg-slate-900/60 border border-slate-800/80 text-[11px] text-slate-400 flex items-center justify-between flex-shrink-0">
                    <span class="flex items-center gap-1.5">
                        <span>💡</span>
                        <span>Drag items or click <strong>+</strong> to add</span>
                    </span>
                    <span class="font-mono text-amber-400/80 text-[10px]">Shop Synced</span>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- CENTER COLUMN: BUILD ARCHITECTURE (5 cols) -->
        <!-- ========================================== -->
        <div class="lg:col-span-5 space-y-4">
            <!-- Hero Selection & Guide Header Card -->
            <div class="glass-panel p-4 sm:p-5 rounded-3xl border border-slate-800 shadow-xl space-y-4 bg-slate-900/90">
                <div class="flex items-start gap-3">
                    <div
                        class="w-16 h-16 rounded-2xl overflow-hidden bg-slate-950 border-2 border-amber-500/50 flex-shrink-0 shadow-lg relative">
                        <img id="builder-hero-portrait"
                             src="/images/heroes/hero_panda.png"
                             onError="this.onerror=null;this.src='/images/heroes/default.png';"
                             alt="Hero Portrait"
                             class="w-full h-full object-cover"/>
                    </div>
                    <div class="space-y-2 flex-1 min-w-0">
                        <div class="space-y-1">
                            <label class="text-[10px] font-bold tracking-widest text-slate-400 uppercase">Target
                                Hero</label>
                            <select id="builder-hero-select" onchange="handleHeroChange(this.value)"
                                    class="w-full bg-slate-950 text-white font-bold text-xs border border-slate-700 rounded-xl px-3 py-2 focus:outline-none focus:border-amber-400 cursor-pointer shadow-inner">
                                <!-- Populated dynamically -->
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Guide Title -->
                <div class="space-y-1">
                    <label class="text-[10px] font-bold tracking-widest text-amber-400 uppercase">Guide Title <span
                            class="text-rose-400">*</span></label>
                    <input type="text"
                           id="builder-guide-title"
                           value="@guideName"
                           placeholder="e.g. Aggressive Initiator & Burst Build"
                           class="w-full bg-slate-950 text-white font-bold text-sm rounded-xl px-3.5 py-2.5 border border-slate-700 focus:outline-none focus:border-amber-400 shadow-inner transition-all"/>
                </div>

                <!-- Map Target Selector (Caldavar, Mid Wars, All Maps) -->
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between">
                        <label class="text-[10px] font-bold tracking-widest text-cyan-400 uppercase">Target Game
                            Map</label>
                        <span class="text-[10px] text-slate-400 font-mono">Tailor guide for map mode</span>
                    </div>
                    <select id="builder-target-map"
                            class="w-full bg-slate-950 text-cyan-300 font-bold text-xs border border-slate-700 rounded-xl px-3 py-2 focus:outline-none focus:border-cyan-400 cursor-pointer shadow-inner">
                        <option value="caldavar"
                                selected="@(targetMap != "midwars" && targetMap != "midwars_ranked" && targetMap != "midwars_public")">
                            🌲 Caldavar
                        </option>
                        <option value="midwars"
                                selected="@(targetMap == "midwars" || targetMap == "midwars_ranked" || targetMap == "midwars_public")">
                            ⚔️ Mid Wars
                        </option>
                    </select>
                </div>

                <!-- Visibility Toggle -->
                <div class="flex items-center justify-between pt-1 border-t border-slate-800 text-xs">
                    <span class="text-slate-300 font-medium">Public Community Guide</span>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="builder-is-public" class="sr-only peer" checked="@isPublic">
                        <div
                            class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                    </label>
                </div>
            </div>

            <!-- Item Drop & Selection Containers (Grouped by HoN In-Game Layout) -->
            <div class="space-y-4">
                <!-- Group A: Core Items Box (In-Game Category 1) -->
                <div class="p-3.5 sm:p-4 rounded-3xl bg-slate-950/60 border border-slate-800 space-y-3">
                    <div class="flex items-center justify-between px-1">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-black uppercase tracking-widest text-amber-400">🔷 Core Items (In-Game)</span>
                        </div>
                        <span class="text-[10px] text-slate-500 font-mono">Max 8 items per slot (4x2 Grid)</span>
                    </div>

                    <!-- 1. Starting Items Section -->
                    <div id="section-card-starting"
                         onclick="selectSection('starting')"
                         class="section-card p-4 rounded-2xl bg-slate-900/90 border border-amber-500/50 space-y-2.5 shadow-lg ring-2 ring-amber-500/20 cursor-pointer transition-all hover:border-amber-400"
                         ondragover="handleDragOver(event)"
                         ondrop="handleDrop(event, 'starting')">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-sm">🎒</span>
                                <span
                                    class="text-xs font-bold uppercase tracking-wider text-amber-400">Starting Items</span>
                                <span class="text-[10px] text-slate-400 font-mono hidden sm:inline">(In-Game: Starting Items)</span>
                                <span id="target-pill-starting"
                                      class="section-target-pill px-2 py-0.5 rounded-full text-[9px] font-black bg-amber-500 text-slate-950 shadow-sm">
                                    🎯 ACTIVE TARGET
                                </span>
                            </div>
                            <span id="starting-cost-badge"
                                  class="text-[11px] text-amber-400 font-mono bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">
                                💰 0g
                            </span>
                        </div>
                        <div id="slot-container-starting"
                             class="flex flex-wrap gap-2 min-h-[52px] p-2 rounded-xl bg-slate-950/70 border border-dashed border-slate-700/80 items-center">
                            <!-- Populated by JavaScript -->
                        </div>
                    </div>

                    <!-- 2. Essential / Early Game Items Section (Always Visible) -->
                    <div id="laning-section-container">
                        <div id="section-card-laning"
                             onclick="selectSection('laning')"
                             class="section-card p-4 rounded-2xl bg-slate-900/90 border border-emerald-500/30 space-y-2.5 shadow-lg cursor-pointer transition-all hover:border-emerald-400/80"
                             ondragover="handleDragOver(event)"
                             ondrop="handleDrop(event, 'laning')">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm">🌾</span>
                                    <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Essential / Early Game</span>
                                    <span class="text-[10px] text-slate-400 font-mono hidden sm:inline">(In-Game: Essential Items)</span>
                                    <span id="target-pill-laning"
                                          class="section-target-pill px-2 py-0.5 rounded-full text-[9px] font-bold text-slate-400 bg-slate-950/80 border border-slate-800">
                                        Click to Target
                                    </span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span id="laning-cost-badge"
                                          class="text-[11px] text-emerald-400 font-mono bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">
                                        💰 0g
                                    </span>
                                </div>
                            </div>
                            <div id="slot-container-laning"
                                 class="flex flex-wrap gap-2 min-h-[52px] p-2 rounded-xl bg-slate-950/70 border border-dashed border-slate-700/80 items-center">
                                <!-- Populated by JavaScript -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Group B: Situational Items Box (In-Game Category 2) -->
                <div class="p-3.5 sm:p-4 rounded-3xl bg-slate-950/60 border border-slate-800 space-y-3">
                    <div class="flex items-center justify-between px-1">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-black uppercase tracking-widest text-purple-400">🔶 Situational Items (In-Game)</span>
                        </div>
                        <span class="text-[10px] text-slate-500 font-mono">Max 8 items per slot (4x2 Grid)</span>
                    </div>

                    <!-- 3. Offensive Items Section (In-Game: Core Items) -->
                    <div id="section-card-core"
                         onclick="selectSection('core')"
                         class="section-card p-4 rounded-2xl bg-slate-900/90 border border-purple-500/30 space-y-2.5 shadow-lg cursor-pointer transition-all hover:border-purple-400/80"
                         ondragover="handleDragOver(event)"
                         ondrop="handleDrop(event, 'core')">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-sm">⚔️</span>
                                <span
                                    class="text-xs font-bold uppercase tracking-wider text-purple-400">Offensive Items</span>
                                <span class="text-[10px] text-slate-400 font-mono hidden sm:inline">(In-Game: Offensive Items)</span>
                                <span id="target-pill-core"
                                      class="section-target-pill px-2 py-0.5 rounded-full text-[9px] font-bold text-slate-400 bg-slate-950/80 border border-slate-800">
                                    Click to Target
                                </span>
                            </div>
                            <span id="core-cost-badge"
                                  class="text-[11px] text-purple-400 font-mono bg-purple-500/10 px-2 py-0.5 rounded-full border border-purple-500/20">
                                💰 0g
                            </span>
                        </div>
                        <div id="slot-container-core"
                             class="flex flex-wrap gap-2 min-h-[52px] p-2 rounded-xl bg-slate-950/70 border border-dashed border-slate-700/80 items-center">
                            <!-- Populated by JavaScript -->
                        </div>
                    </div>

                    <!-- 4. Defensive Items Section (In-Game: Luxury Items) -->
                    <div id="section-card-luxury"
                         onclick="selectSection('luxury')"
                         class="section-card p-4 rounded-2xl bg-slate-900/90 border border-pink-500/30 space-y-2.5 shadow-lg cursor-pointer transition-all hover:border-pink-400/80"
                         ondragover="handleDragOver(event)"
                         ondrop="handleDrop(event, 'luxury')">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-sm">🛡️</span>
                                <span
                                    class="text-xs font-bold uppercase tracking-wider text-pink-400">Defensive Items</span>
                                <span class="text-[10px] text-slate-400 font-mono hidden sm:inline">(In-Game: Defensive Items)</span>
                                <span id="target-pill-luxury"
                                      class="section-target-pill px-2 py-0.5 rounded-full text-[9px] font-bold text-slate-400 bg-slate-950/80 border border-slate-800">
                                    Click to Target
                                </span>
                            </div>
                            <span id="luxury-cost-badge"
                                  class="text-[11px] text-pink-400 font-mono bg-pink-500/10 px-2 py-0.5 rounded-full border border-pink-500/20">
                                💰 0g
                            </span>
                        </div>
                        <div id="slot-container-luxury"
                             class="flex flex-wrap gap-2 min-h-[52px] p-2 rounded-xl bg-slate-950/70 border border-dashed border-slate-700/80 items-center">
                            <!-- Populated by JavaScript -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Introduction & Strategy Textareas -->
            <div class="glass-panel p-4 rounded-3xl border border-slate-800 shadow-xl space-y-3 bg-slate-900/90">
                <div class="space-y-1">
                    <label class="text-[10px] font-bold tracking-widest text-amber-400 uppercase">Introduction
                        Summary</label>
                    <textarea id="builder-intro" rows="2"
                              placeholder="Brief overview of this hero build, playstyle role, and power spikes..."
                              class="w-full bg-slate-950 text-slate-200 text-xs rounded-xl p-3 border border-slate-700 focus:outline-none focus:border-amber-400 shadow-inner resize-none">@intro</textarea>
                </div>

                <div class="space-y-1">
                    <label class="text-[10px] font-bold tracking-widest text-purple-400 uppercase">Detailed Description
                        & Strategy</label>
                    <textarea id="builder-content" rows="4"
                              placeholder="Laning phase tips, skill combos, teamfight positioning, and item timing walkthrough..."
                              class="w-full bg-slate-950 text-slate-200 text-xs rounded-xl p-3 border border-slate-700 focus:outline-none focus:border-purple-400 shadow-inner resize-y">@content</textarea>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- RIGHT COLUMN: ABILITY LEVELING TREE (3 cols) -->
        <!-- ========================================== -->
        <div class="lg:col-span-3 space-y-4">
            <div
                class="glass-panel p-4 rounded-3xl border border-slate-800 shadow-xl space-y-3 sticky top-4 max-h-[88vh] flex flex-col bg-slate-950/80">
                <div class="flex items-center justify-between border-b border-slate-800/80 pb-2.5 flex-shrink-0">
                    <div class="flex items-center gap-2">
                        <span class="text-base">⚡</span>
                        <h2 class="font-extrabold text-white text-sm tracking-wide uppercase">Ability Queue</h2>
                    </div>
                    <div id="ability-tree-status-badge">
                        <span
                            class="text-[11px] font-mono text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">
                            25 Levels
                        </span>
                    </div>
                </div>

                <!-- Hero Ability Quick Selector Palette with Real Icons, Counters and Tooltips -->
                <div class="space-y-1.5 flex-shrink-0">
                    <div class="flex items-center justify-between">
                        <span
                            class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Hero Skills & Ult</span>
                        <span class="text-[9px] text-slate-500 font-mono">Click or drag to slot</span>
                    </div>
                    <div class="grid grid-cols-5 gap-1.5" id="hero-ability-icons-container">
                        <!-- Populated by JavaScript with real Codex icons, rank counters, and tooltips -->
                    </div>
                </div>

                <!-- Level 1 to 25 Timeline List -->
                <div id="ability-levels-timeline" class="space-y-1 overflow-y-auto pr-1 flex-1 min-h-[300px]">
                    <!-- Rendered dynamically by JavaScript -->
                </div>

                <!-- Reset / Fill Presets -->
                <div class="flex items-center gap-2 pt-1 border-t border-slate-800 flex-shrink-0">
                    <button onclick="resetAbilityQueue()" type="button"
                            class="flex-1 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-400 hover:text-rose-400 text-[11px] font-semibold transition-colors">
                        Reset Levels
                    </button>
                    <button onclick="autoFillAbilityQueue()" type="button"
                            class="flex-1 py-1.5 rounded-xl bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/30 text-purple-300 text-[11px] font-bold transition-colors">
                        Auto Level
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
