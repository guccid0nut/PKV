                📋 Copy Build Code
            </button>
            <button onclick="downloadExportJson()" type="button"
                    class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold transition-all border border-slate-700">
                💾 Download .JSON
