    function showItemTooltip(e, item) {
        const tooltip = document.getElementById('studio-floating-tooltip');
        if (!tooltip || !item) return;

        document.getElementById('tt-title').innerText = item.name || '';
        document.getElementById('tt-cost').innerText = `💰 ${Number(item.cost || 0).toLocaleString()}g`;
        document.getElementById('tt-category').innerText = item.category || 'Item';
        document.getElementById('tt-desc').innerText = item.description || 'Standard combat equipment.';

        const flavorElem = document.getElementById('tt-flavor');
        if (item.flavor) {
            flavorElem.innerText = `"${item.flavor}"`;
            flavorElem.style.display = 'block';
        } else {
            flavorElem.style.display = 'none';
        }

        tooltip.classList.remove('hidden');
        positionTooltip(e);
    }

    function showAbilityTooltip(e, ability) {
        const tooltip = document.getElementById('studio-floating-tooltip');
        if (!tooltip || !ability) return;

        document.getElementById('tt-title').innerText = `${ability.name} (${ability.key || ''})`;
        document.getElementById('tt-cost').innerText = `⚡ Ability`;
        document.getElementById('tt-category').innerText = `Level Skill`;
        document.getElementById('tt-desc').innerText = ability.description || 'Hero combat skill.';
        document.getElementById('tt-flavor').style.display = 'none';

        tooltip.classList.remove('hidden');
        positionTooltip(e);
    }

    function hideTooltip() {
        const tooltip = document.getElementById('studio-floating-tooltip');
        if (tooltip) tooltip.classList.add('hidden');
    }

    function positionTooltip(e) {
        const tooltip = document.getElementById('studio-floating-tooltip');
        if (!tooltip || tooltip.classList.contains('hidden')) return;

        const x = e.clientX + 16;
        const y = e.clientY + 16;
        const maxX = window.innerWidth - 300;
        const maxY = window.innerHeight - 200;

        tooltip.style.left = `${Math.min(x, maxX)}px`;
        tooltip.style.top = `${Math.min(y, maxY)}px`;
    }

    // =========================================================================
    // SAVE / PUBLISH GUIDE
    // =========================================================================
    async function saveHeroGuide() {
        const title = document.getElementById('builder-guide-title')?.value.trim();
        const heroSelect = document.getElementById('builder-hero-select');
        const heroIdentifier = heroSelect ? heroSelect.value : 'Hero_Panda';
        const targetMap = document.getElementById('builder-target-map')?.value || 'caldavar';
        const intro = document.getElementById('builder-intro')?.value.trim() || '';
        const content = document.getElementById('builder-content')?.value.trim() || '';
        const isPublic = document.getElementById('builder-is-public')?.checked ?? true;

        if (!title) {
            alert("Please enter a Guide Title.");
            document.getElementById('builder-guide-title')?.focus();
            return;
        }

        const payload = {
            id: initialGuideId > 0 ? initialGuideId : null,
            name: title,
            heroIdentifier: heroIdentifier,
            heroName: formatHeroName(heroIdentifier.replace(/^Hero_/i, '')),
            targetMap: targetMap,
            intro: intro,
            content: content,
            startingItems: buildStartingItems.join('|'),
            earlyGameItems: buildLaningItems.join('|'),
            coreItems: buildCoreItems.join('|'),
            luxuryItems: buildLuxuryItems.join('|'),
            abilityQueue: buildAbilityQueue.join('|'),
            isPublic: isPublic
        };

        const saveBtn = document.getElementById('save-guide-btn');
        if (saveBtn) {
            saveBtn.disabled = true;
            saveBtn.innerHTML = `<span>⏳ Saving...</span>`;
        }

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const res = await fetch('/guides/save', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (data.success) {
                alert("🎉 " + data.message);
                window.location.href = `/guides/${data.guideId}`;
            } else {
                alert("⚠️ " + (data.message || "Failed to save guide."));
                if (saveBtn) {
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = `<span>💾 Publish Guide</span>`;
                }
            }
        } catch (e) {
            console.error(e);
            alert("Error communicating with server.");
            if (saveBtn) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = `<span>💾 Publish Guide</span>`;
            }
        }
    }

