@{
    ViewData["Title"] = "AR Mini Games - Donut Mixed Reality Arcade";
    Layout = "_Layout";
}

<div class="relative min-h-[calc(100vh-4rem)] bg-slate-950 text-slate-100 overflow-hidden select-none py-8 px-4 sm:px-6 lg:px-8">
    <!-- Ambient glowing backgrounds -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-pink-600/15 rounded-full blur-3xl pointer-events-none -z-10 animate-pulse"></div>
    <div class="absolute top-1/3 right-1/4 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute bottom-10 left-1/3 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto space-y-8">
        
        <!-- Header Section -->
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 pb-6 border-b border-slate-800/80">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-pink-500/20 text-pink-300 border border-pink-500/40">
                        <i class="fas fa-vr-cardboard mr-1"></i> Donut Augmented Reality Arcade
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 flex items-center gap-1.5">
                        <i class="fab fa-discord text-indigo-400"></i> Discord Verified Access
                    </span>
                </div>
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight font-mono flex flex-wrap items-baseline gap-x-3">
                    <span class="bg-clip-text text-transparent bg-gradient-to-r from-pink-400 via-fuchsia-400 to-rose-400 drop-shadow-[0_0_18px_rgba(244,114,182,0.45)]">
                        DONUT
                    </span>
                    <span class="text-slate-100 tracking-normal inline-flex items-baseline">
                        <span class="relative inline-block">
                            <span class="bg-clip-text text-transparent bg-gradient-to-r from-amber-300 via-yellow-200 to-amber-400 drop-shadow-[0_0_22px_rgba(251,191,36,0.85)] font-black">AR</span>
                            <span class="absolute -bottom-1 left-0 right-0 h-1 bg-gradient-to-r from-amber-400 to-yellow-300 rounded-full shadow-[0_0_8px_rgba(251,191,36,0.8)]"></span>
                        </span>
                        <span class="text-white tracking-wide">CADE</span>
                    </span>
                </h1>
                <p class="text-slate-400 text-sm sm:text-base mt-1 max-w-2xl">
                    Bring Newerth onto your tabletop. Play interactive 3D WebGL minigames with your webcam or phone camera passthrough, real-time SignalR multiplayer, and bots.
                </p>
            </div>

            <!-- Quick Direct Room Jump Card -->
            <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-3 sm:p-4 backdrop-blur-xl shadow-xl flex flex-col gap-2 max-w-md w-full">
                <span class="text-[11px] font-bold uppercase tracking-wider text-amber-400 flex items-center gap-1">
                    <i class="fas fa-bolt"></i> Quick Room Join
                </span>
                <div class="flex flex-wrap sm:flex-nowrap items-center gap-2">
                    <input id="quickRoomCode" type="text" maxlength="8" placeholder="ROOM CODE (e.g. KNG1)" 
                           class="w-full sm:w-auto flex-1 min-w-[100px] bg-slate-950 border border-slate-700 focus:border-amber-400 rounded-xl px-3 py-1.5 text-xs font-mono font-black uppercase text-white outline-none" />
                    <button id="btnQuickJoinChess" type="button" title="Join KONGOR Chess Room" 
                            class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs rounded-xl transition-all shadow-md flex items-center gap-1 whitespace-nowrap">
                        <i class="fas fa-chess-knight"></i> Chess
                    </button>
                    <button id="btnQuickJoinCheckers" type="button" title="Join Checkers Room" 
                            class="px-3 py-1.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs rounded-xl transition-all shadow-md flex items-center gap-1 whitespace-nowrap">
                        <i class="fas fa-chess-board"></i> Checkers
                    </button>
                    <button id="btnQuickJoinDevo" type="button" title="Join DevoWars Room" 
                            class="px-3 py-1.5 bg-rose-600 hover:bg-rose-500 text-white font-black text-xs rounded-xl transition-all shadow-md flex items-center gap-1 whitespace-nowrap">
                        <i class="fas fa-crosshairs"></i> Devo
                    </button>
                </div>
            </div>
        </div>

        <!-- Arcade Game Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            
            <!-- Game: KONGOR AR Chess -->
            <div class="group relative rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/50 backdrop-blur-xl p-6 shadow-2xl transition-all duration-300 hover:shadow-emerald-500/10 flex flex-col justify-between overflow-hidden">
                <div class="absolute -right-8 -top-8 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-colors"></div>
                
                <div>
                    <div class="flex items-center justify-between gap-2 mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center text-xl shadow-inner group-hover:scale-110 transition-transform">
                            ♟️
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">
                            1v1 &amp; Bot Chess
                        </span>
                    </div>

                    <h2 class="text-xl font-black text-white group-hover:text-emerald-300 transition-colors">
                        KONGOR AR Chess
                    </h2>
                    <p class="text-slate-400 text-xs mt-2 leading-relaxed">
                        Grandmaster chess on your tabletop! Legion vs. Hellbourne with walking Creep pawns, Sir Benzington L-leaps, Magmus Lava Surge rooks, Moon Queen, and genuine combat attack/death animations.
                    </p>

                    <!-- Feature Tags -->
                    <div class="flex flex-wrap gap-1.5 mt-4">
                        <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-300 text-[10px] font-mono border border-slate-800">
                            <i class="fas fa-camera text-sky-400 mr-1"></i>Webcam / Phone AR
                        </span>
                        <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-300 text-[10px] font-mono border border-slate-800">
                            <i class="fas fa-chess-clock text-amber-400 mr-1"></i>Chess Clocks
                        </span>
                        <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-300 text-[10px] font-mono border border-slate-800">
                            <i class="fas fa-users text-teal-400 mr-1"></i>Pass &amp; Play
                        </span>
                        <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-300 text-[10px] font-mono border border-slate-800">
                            <i class="fas fa-wifi text-emerald-400 mr-1"></i>SignalR 1v1
                        </span>
                    </div>
                </div>

                <div class="pt-6 mt-6 border-t border-slate-800/80 flex flex-col sm:flex-row gap-2">
                    <a href="/ar-mini-games/chess" 
                       class="flex-1 py-3 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-black text-xs uppercase tracking-wider shadow-lg shadow-emerald-950/40 active:scale-95 transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-play"></i> Play Chess
                    </a>
                    <a href="/ar-mini-games/chess?mode=pass_and_play" title="Play 2-player Pass &amp; Play on this device"
                       class="px-4 py-3 rounded-2xl bg-slate-950 hover:bg-slate-800 border border-emerald-500/40 text-emerald-300 hover:text-emerald-200 font-black text-xs uppercase tracking-wider active:scale-95 transition-all flex items-center justify-center gap-1.5 whitespace-nowrap shadow-md">
                        <i class="fas fa-users text-xs"></i> Pass &amp; Play
                    </a>
                </div>
            </div>

            <!-- Game 1: Monkey King AR Checkers -->
            <div class="group relative rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-amber-500/50 backdrop-blur-xl p-6 shadow-2xl transition-all duration-300 hover:shadow-amber-500/10 flex flex-col justify-between overflow-hidden">
                <div class="absolute -right-8 -top-8 w-32 h-32 bg-amber-500/10 rounded-full blur-2xl group-hover:bg-amber-500/20 transition-colors"></div>
                
                <div>
                    <div class="flex items-center justify-between gap-2 mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-amber-500/20 border border-amber-500/40 text-amber-400 flex items-center justify-center text-xl shadow-inner group-hover:scale-110 transition-transform">
                            👑
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/40">
                            1v1 Online, Pass &amp; Play &amp; Bots
                        </span>
                    </div>

                    <h2 class="text-xl font-black text-white group-hover:text-amber-300 transition-colors">
                        Monkey King AR Checkers
                    </h2>
                    <p class="text-slate-400 text-xs mt-2 leading-relaxed">
                        Classic tabletop checkers reimagined with Monkey King! Pieces leap over rivals with animated flips, bloodlust first-kill announcers, heavenly nimbus clouds for kings, and transparent AR board passthrough.
                    </p>

                    <!-- Feature Tags -->
                    <div class="flex flex-wrap gap-1.5 mt-4">
                        <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-300 text-[10px] font-mono border border-slate-800">
                            <i class="fas fa-camera text-sky-400 mr-1"></i>Phone / Webcam AR
                        </span>
                        <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-300 text-[10px] font-mono border border-slate-800">
                            <i class="fas fa-brain text-purple-400 mr-1"></i>Minimax Bot AI
                        </span>
                        <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-300 text-[10px] font-mono border border-slate-800">
                            <i class="fas fa-users text-amber-400 mr-1"></i>Pass &amp; Play
                        </span>
                        <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-300 text-[10px] font-mono border border-slate-800">
                            <i class="fas fa-wifi text-emerald-400 mr-1"></i>SignalR 1v1
                        </span>
                    </div>
                </div>

                <div class="pt-6 mt-6 border-t border-slate-800/80 flex flex-col sm:flex-row gap-2">
                    <a href="/ar-mini-games/monkey-checkers" 
                       class="flex-1 py-3 rounded-2xl bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 text-slate-950 font-black text-xs uppercase tracking-wider shadow-lg shadow-amber-950/40 active:scale-95 transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-play"></i> Play Checkers
                    </a>
                    <a href="/ar-mini-games/monkey-checkers?mode=pass_and_play" title="Play 2-player Pass &amp; Play on this device"
                       class="px-4 py-3 rounded-2xl bg-slate-950 hover:bg-slate-800 border border-amber-500/40 text-amber-300 hover:text-amber-200 font-black text-xs uppercase tracking-wider active:scale-95 transition-all flex items-center justify-center gap-1.5 whitespace-nowrap shadow-md">
                        <i class="fas fa-users text-xs"></i> Pass &amp; Play
                    </a>
                </div>
            </div>

            <!-- Game 2: DevoWars AR 1v1 -->
            <div class="group relative rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-rose-500/50 backdrop-blur-xl p-6 shadow-2xl transition-all duration-300 hover:shadow-rose-500/10 flex flex-col justify-between overflow-hidden">
                <div class="absolute -right-8 -top-8 w-32 h-32 bg-rose-500/10 rounded-full blur-2xl group-hover:bg-rose-500/20 transition-colors"></div>
                
                <div>
                    <div class="flex items-center justify-between gap-2 mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-rose-500/20 border border-rose-500/40 text-rose-400 flex items-center justify-center text-xl shadow-inner group-hover:scale-110 transition-transform">
                            🥩
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-rose-500/20 text-rose-300 border border-rose-500/40">
                            1v1 Real-Time Duel
                        </span>
                    </div>

                    <h2 class="text-xl font-black text-white group-hover:text-rose-300 transition-colors">
                        DevoWars AR
                    </h2>
                    <p class="text-slate-400 text-xs mt-2 leading-relaxed">
                        The ultimate 1v1 Devourer hook duel on your tabletop! Aim, lead your hooks, dodge incoming meat hooks across the Caldavar river, and battle friends on phone or desktop in augmented reality.
                    </p>

                    <!-- Feature Tags -->
                    <div class="flex flex-wrap gap-1.5 mt-4">
                        <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-300 text-[10px] font-mono border border-slate-800">
                            <i class="fas fa-crosshairs text-rose-400 mr-1"></i>3rd-Person &amp; 3D Tabletop
                        </span>
                        <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-300 text-[10px] font-mono border border-slate-800">
                            <i class="fas fa-bullseye text-amber-400 mr-1"></i>Solo Dummy Mode
                        </span>
                        <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-300 text-[10px] font-mono border border-slate-800">
                            <i class="fas fa-network-wired text-emerald-400 mr-1"></i>Live SignalR
                        </span>
                    </div>
                </div>

                <div class="pt-6 mt-6 border-t border-slate-800/80 flex flex-col gap-2">
                    <a href="/ar-mini-games/devo-wars" 
                       class="w-full py-3 rounded-2xl bg-gradient-to-r from-rose-600 to-red-500 hover:from-rose-500 hover:to-red-400 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-rose-950/40 active:scale-95 transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-play"></i> Enter DevoWars Arena
                    </a>
                </div>
            </div>

            <!-- Game 3: Empath Tabletop AR -->
            <div class="group relative rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-sky-500/50 backdrop-blur-xl p-6 shadow-2xl transition-all duration-300 hover:shadow-sky-500/10 flex flex-col justify-between overflow-hidden">
                <div class="absolute -right-8 -top-8 w-32 h-32 bg-sky-500/10 rounded-full blur-2xl group-hover:bg-sky-500/20 transition-colors"></div>
                
                <div>
                    <div class="flex items-center justify-between gap-2 mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-sky-500/20 border border-sky-500/40 text-sky-400 flex items-center justify-center text-xl shadow-inner group-hover:scale-110 transition-transform">
                            ✨
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-sky-500/20 text-sky-300 border border-sky-500/40">
                            Interactive Companion
                        </span>
                    </div>

                    <h2 class="text-xl font-black text-white group-hover:text-sky-300 transition-colors">
                        Empath Tabletop AR
                    </h2>
                    <p class="text-slate-400 text-xs mt-2 leading-relaxed">
                        Summon Empath onto your desk or floor. Interactive 3D tabletop companion rendered in WebGL with webcam passthrough, ambient particle aura, and audio responses.
                    </p>

                    <!-- Feature Tags -->
                    <div class="flex flex-wrap gap-1.5 mt-4">
                        <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-300 text-[10px] font-mono border border-slate-800">
                            <i class="fas fa-wand-magic-sparkles text-sky-400 mr-1"></i>Original 3D Model
                        </span>
                        <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-300 text-[10px] font-mono border border-slate-800">
                            <i class="fas fa-hand-pointer text-amber-400 mr-1"></i>Touch &amp; Orbit Controls
                        </span>
                        <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-300 text-[10px] font-mono border border-slate-800">
                            <i class="fas fa-music text-pink-400 mr-1"></i>Hero Voicelines
                        </span>
                    </div>
                </div>

                <div class="pt-6 mt-6 border-t border-slate-800/80 flex flex-col gap-2">
                    <a href="/ar-mini-games/empath" 
                       class="w-full py-3 rounded-2xl bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-sky-950/40 active:scale-95 transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-play"></i> Summon Empath AR
                    </a>
                </div>
            </div>

            <!-- Card: Chrono-Pong: Riftbreaker (Parked for Future Development) -->
            <div data-game-status="future-development"
                 class="relative rounded-3xl bg-slate-900/40 border border-slate-800/80 p-6 flex flex-col justify-between overflow-hidden shadow-xl opacity-60 grayscale">
                <div class="space-y-4">
                    <div class="flex items-start justify-between gap-2">
                        <div class="w-12 h-12 rounded-2xl bg-slate-800/80 border border-slate-700 text-slate-400 flex items-center justify-center text-2xl shadow-inner">
                            ⏳
                        </div>
                        <span class="px-2.5 py-1 rounded-full bg-slate-800/90 text-slate-300 border border-slate-700 text-[10px] font-black uppercase tracking-wider flex items-center gap-1">
                            <i class="fas fa-flask text-[9px]"></i> Future Development
                        </span>
                    </div>

                    <div>
                        <h2 class="text-2xl font-black text-slate-300 tracking-tight">Chrono-Pong: Riftbreaker</h2>
                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mt-0.5">Auto-Shift 3D Hero Pong &bull; Planned</p>
                    </div>

                    <p class="text-sm text-slate-400 leading-relaxed">
                        Slated for future development: high-speed autonomous bounce &amp; timer transitions, auto-randomized animated 3D HoN heroes, expressive visible hero skills, and mid-rally Kongor drops.
                    </p>

                    <div class="grid grid-cols-2 gap-2 pt-2 text-[11px] font-medium text-slate-500">
                        <div class="flex items-center gap-1.5"><i class="fas fa-shuffle text-slate-500"></i> Auto Hero Shifts</div>
                        <div class="flex items-center gap-1.5"><i class="fas fa-person-running text-slate-500"></i> Animated Skill Kits</div>
                        <div class="flex items-center gap-1.5"><i class="fas fa-stopwatch text-slate-500"></i> Bounce/Time Events</div>
                        <div class="flex items-center gap-1.5"><i class="fas fa-dragon text-slate-500"></i> Kongor Overdrive</div>
                    </div>
                </div>

                <div class="pt-6 mt-6 border-t border-slate-800/80 flex flex-col gap-2">
                    <button id="btnRiftbreakerFutureDev" type="button" aria-disabled="true"
                            title="Chrono-Pong: Riftbreaker is marked for future development"
                            class="w-full py-3 rounded-2xl bg-slate-800/80 border border-slate-700/80 text-slate-400 font-black text-xs uppercase tracking-wider cursor-not-allowed flex items-center justify-center gap-2">
                        <i class="fas fa-clock"></i> Future Development
                    </button>
                </div>
            </div>

        </div>

        <!-- Discord Gate Callout Banner -->
        <div class="rounded-3xl bg-gradient-to-r from-indigo-950/50 via-slate-900/80 to-purple-950/50 border border-indigo-500/30 p-6 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xl">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-[#5865F2]/20 border border-[#5865F2]/40 text-[#5865F2] flex items-center justify-center text-2xl flex-shrink-0">
                    <i class="fab fa-discord"></i>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-white">Protected Arcade Arena</h3>
                    <p class="text-xs text-slate-400 mt-0.5">
                        All AR Mini Games require an active Project KONGOR account verified through Discord to access rooms, leaderboard tracking, and multiplayer matchmaking.
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2 text-xs font-mono text-emerald-400 bg-emerald-950/50 border border-emerald-500/30 px-3 py-1.5 rounded-xl flex-shrink-0">
                <i class="fas fa-shield-halved"></i>
                <span>Account Verified</span>
            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const inputRoom = document.getElementById('quickRoomCode');
        const btnChess = document.getElementById('btnQuickJoinChess');
        const btnCheckers = document.getElementById('btnQuickJoinCheckers');
        const btnDevo = document.getElementById('btnQuickJoinDevo');
        const btnRiftFuture = document.getElementById('btnRiftbreakerFutureDev');

        function cleanRoom(val) {
            return (val || '').trim().replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
        }

        btnChess?.addEventListener('click', () => {
            const room = cleanRoom(inputRoom.value) || 'KNG1';
            window.location.href = `/ar-mini-games/chess?room=${encodeURIComponent(room)}`;
        });

        btnCheckers?.addEventListener('click', () => {
            const room = cleanRoom(inputRoom.value) || 'MK42';
            window.location.href = `/ar-mini-games/monkey-checkers?room=${encodeURIComponent(room)}`;
        });

        btnDevo?.addEventListener('click', () => {
            const room = cleanRoom(inputRoom.value) || 'HOOK';
            window.location.href = `/ar-mini-games/devo-wars?room=${encodeURIComponent(room)}`;
        });

        btnRiftFuture?.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
        });
        btnRiftFuture?.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                e.stopPropagation();
            }
        });

        inputRoom?.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                const room = cleanRoom(inputRoom.value) || 'KNG1';
                window.location.href = `/ar-mini-games/chess?room=${encodeURIComponent(room)}`;
            }
        });
    });
</script>
