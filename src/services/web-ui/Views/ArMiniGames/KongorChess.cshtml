@{
    ViewData["Title"] = "KONGOR AR Chess - Legion vs Hellbourne";
    Layout = "_Layout";
    string initialRoom = (string)(ViewData["InitialRoom"] ?? "KNG1");
}

<div id="chessGameRoot" data-initial-room="@initialRoom" class="relative w-full h-[calc(100vh-4rem)] overflow-hidden bg-slate-950 select-none">
    
    <!-- Camera Video Feed for Phone / Webcam AR Passthrough -->
    <video id="chessVideo" 
           autoplay 
           playsinline 
           webkit-playsinline="true" 
           muted 
           class="absolute inset-0 w-full h-full object-cover z-0 hidden pointer-events-none"></video>

    <!-- Three.js Interactive WebGL Render Canvas -->
    <div id="chessCanvasContainer" class="absolute inset-0 z-10 w-full h-full cursor-pointer touch-none">
        <canvas id="chessCanvas" class="w-full h-full block" role="region" aria-label="Kongor Chess 3D interactive chessboard">Your browser does not support HTML5 Canvas.</canvas>
    </div>

    <!-- Floating 3D Hover Badge Over Piece Head -->
    <div id="chessHoverPieceBadge" 
         class="hidden pointer-events-none absolute z-20 transition-opacity duration-150 transform -translate-x-1/2 -translate-y-full opacity-0">
        <div id="chessHoverBadgeCard" 
             class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900/95 backdrop-blur-md border border-amber-500/50 shadow-2xl text-xs font-mono font-bold whitespace-nowrap">
            <i id="chessHoverBadgeIcon" class="fas fa-chess-pawn text-sm text-amber-400"></i>
            <div class="flex flex-col leading-tight">
                <span id="chessHoverBadgeTitle" class="uppercase tracking-wider text-amber-300">PAWN</span>
                <span id="chessHoverBadgeHero" class="text-[10px] text-slate-400 font-normal">Legionnaire</span>
            </div>
        </div>
        <!-- Downward Anchor Arrow/Pip -->
        <div id="chessHoverBadgePip" class="w-2 h-2 mx-auto rotate-45 -mt-1 bg-slate-900 border-r border-b border-amber-500/50"></div>
    </div>

    <!-- Top Sleek Glassmorphic Floating HUD -->
    <div class="absolute top-3 left-3 right-3 z-20 flex flex-wrap items-center justify-between gap-2 pointer-events-none">
        
        <!-- Left: Turn Banner, Faction Identity & Clocks -->
        <div class="flex items-center gap-2 pointer-events-auto bg-slate-900/90 backdrop-blur-xl px-3 py-1.5 rounded-2xl border border-amber-500/30 shadow-2xl shadow-amber-950/40">
            <span id="turnStatusDot" class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
            <div class="flex flex-col">
                <div class="flex items-center gap-1.5">
                    <span id="turnTitle" class="text-xs font-black tracking-wider uppercase font-mono text-emerald-300">Legion's Turn</span>
                    <span id="botThinkingIndicator" class="hidden text-[10px] text-amber-400 font-bold animate-bounce">
                        <i class="fas fa-brain mr-1"></i>Thinking...
                    </span>
                    <span id="checkIndicatorBadge" class="hidden px-1.5 py-0.5 rounded text-[10px] font-black bg-rose-600/90 text-white animate-pulse">
                        CHECK!
                    </span>
                </div>
                <!-- Dual Digital Chess Clocks -->
                <div class="flex items-center gap-2 text-[11px] font-mono font-bold">
                    <span id="clockLegion" class="text-emerald-400 bg-emerald-950/50 px-1.5 py-0.5 rounded border border-emerald-500/30">
                        <i class="fas fa-chess-king text-[9px] mr-1"></i>05:00
                    </span>
                    <span class="text-slate-500">&bull;</span>
                    <span id="clockHellbourne" class="text-rose-400 bg-rose-950/50 px-1.5 py-0.5 rounded border border-rose-500/30">
                        <i class="fas fa-fire text-[9px] mr-1"></i>05:00
                    </span>
                </div>
            </div>
        </div>

        <!-- Center: Game Mode, Time Control & Online Room Badge -->
        <div class="pointer-events-auto flex items-center flex-wrap gap-1.5 bg-slate-900/90 backdrop-blur-xl border border-slate-700/70 rounded-xl px-2.5 py-1 shadow-lg">
            <span class="text-[10px] font-black uppercase text-amber-400 font-mono hidden md:inline">Mode:</span>
            <select id="selectGameMode" class="bg-slate-950 text-slate-200 text-xs font-bold rounded-lg px-2 py-1 border border-slate-700 focus:outline-none focus:border-amber-400 cursor-pointer">
                <option value="vs_bot_novice" selected>Player vs Bot (Novice)</option>
                <option value="vs_bot_challenger">Player vs Bot (Challenger)</option>
                <option value="vs_bot_master">Player vs Bot (Grandmaster)</option>
                <option value="pass_and_play">Pass &amp; Play (Local)</option>
                <option value="bot_vs_bot">Bot vs Bot (Spectator)</option>
                <option value="online_1v1">🌐 1v1 Online Match</option>
            </select>

            <select id="selectTimeControl" class="bg-slate-950 text-slate-200 text-xs font-bold rounded-lg px-2 py-1 border border-slate-700 focus:outline-none focus:border-amber-400 cursor-pointer">
                <option value="3m">3 Min Blitz</option>
                <option value="5m" selected>5 Min Rapid</option>
                <option value="10m">10 Min Rapid</option>
                <option value="30m">30 Min Classical</option>
                <option value="unlimited">Unlimited Casual</option>
            </select>

            <button id="btnOpenOnlineLobby" type="button" title="Join or Host 1v1 Online Match" class="px-2 py-1 bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 rounded-lg text-xs font-bold transition-all flex items-center gap-1 cursor-pointer">
                <i class="fas fa-globe"></i>
                <span class="hidden sm:inline">Online 1v1</span>
            </button>
            <div id="chessOnlineBadge" class="hidden items-center gap-1.5 px-2 py-0.5 rounded-lg bg-sky-950/80 border border-sky-500/50 text-sky-300 font-mono text-[11px] font-bold">
                <i class="fas fa-circle text-[7px] text-emerald-400 animate-pulse"></i>
                <span id="chessOnlineRoomLabel">ROOM: KNG1</span>
            </div>
        </div>

        <!-- Right: Camera, Audio & Controls -->
        <div class="flex items-center flex-wrap gap-1.5 pointer-events-auto">
            
            <!-- Camera View Angle Presets Dropdown -->
            <div class="flex items-center bg-slate-900/90 border border-slate-700/70 rounded-xl p-0.5 backdrop-blur-xl shadow-lg">
                <button id="btnViewTabletop" type="button" title="3D Isometric Tabletop" class="px-2 py-1 text-[11px] font-bold rounded-lg bg-sky-600/40 text-sky-200 border border-sky-400/40 hover:bg-sky-600/60 transition-all cursor-pointer">
                    <i class="fas fa-cube mr-1"></i>3D
                </button>
                <button id="btnViewTopDown" type="button" title="2D Top-Down Overhead" class="px-2 py-1 text-[11px] font-bold rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition-all cursor-pointer">
                    <i class="fas fa-border-all mr-1"></i>2D
                </button>
                <button id="btnViewLegion" type="button" title="Legion POV (White)" class="px-2 py-1 text-[11px] font-bold rounded-lg text-emerald-400 hover:bg-slate-800 transition-all cursor-pointer hidden sm:inline-block">
                    Legion
                </button>
                <button id="btnViewHellbourne" type="button" title="Hellbourne POV (Black)" class="px-2 py-1 text-[11px] font-bold rounded-lg text-rose-400 hover:bg-slate-800 transition-all cursor-pointer hidden sm:inline-block">
                    Hellbourne
                </button>
            </div>

            <!-- AR Camera Toggle -->
            <button id="btnChessToggleCamera" 
                    type="button"
                    class="px-3 py-1.5 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-slate-200 border border-slate-700/70 backdrop-blur-xl text-xs font-bold transition-all flex items-center gap-1.5 shadow-lg hover:border-sky-400 active:scale-95 cursor-pointer">
                <i class="fas fa-camera text-sky-400"></i>
                <span id="chessCameraBtnText" class="hidden sm:inline">Enable AR Camera</span>
            </button>

            <!-- Undo Button (Bot/Local) -->
            <button id="btnChessUndo" 
                    type="button"
                    title="Undo Previous Move"
                    class="px-2.5 py-1.5 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-slate-200 border border-slate-700/70 backdrop-blur-xl text-xs font-bold transition-all flex items-center gap-1 shadow-lg active:scale-95 cursor-pointer">
                <i class="fas fa-undo text-amber-400"></i>
                <span class="hidden md:inline">Undo</span>
            </button>

            <!-- Tactical Hint Button -->
            <button id="btnChessHint" 
                    type="button"
                    title="Get Tactical Move Hint from AI"
                    class="p-2 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-slate-200 border border-slate-700/70 backdrop-blur-xl text-xs font-bold transition-all flex items-center shadow-lg active:scale-95 cursor-pointer">
                <i class="fas fa-lightbulb text-yellow-300"></i>
            </button>

            <!-- Audio Toggle -->
            <button id="btnChessToggleAudio" 
                    type="button"
                    title="Toggle Audio FX & Announcers"
                    class="p-2 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-slate-200 border border-slate-700/70 backdrop-blur-xl text-xs font-bold transition-all flex items-center shadow-lg active:scale-95 cursor-pointer">
                <i id="chessAudioIcon" class="fas fa-volume-up text-emerald-400"></i>
            </button>

            <!-- Reset / New Game Button -->
            <button id="btnChessReset" 
                    type="button"
                    title="Restart Match"
                    class="px-2.5 py-1.5 rounded-xl bg-rose-950/80 hover:bg-rose-900/90 text-rose-200 border border-rose-600/50 backdrop-blur-xl text-xs font-black transition-all flex items-center gap-1 shadow-lg active:scale-95 cursor-pointer">
                <i class="fas fa-rotate-right"></i>
                <span class="hidden sm:inline">New Game</span>
            </button>
        </div>
    </div>

    <!-- Dynamic Combo & Announcer Banner (Centered) -->
    <div class="absolute top-20 left-1/2 -translate-x-1/2 z-20 pointer-events-none">
        <div id="chessAnnouncerBanner" 
             class="hidden opacity-0 transform scale-90 transition-all duration-300 bg-gradient-to-r from-amber-600/95 via-yellow-500 to-amber-600/95 text-slate-950 font-black px-6 py-2.5 rounded-2xl shadow-2xl border-2 border-yellow-300 tracking-wider text-sm font-mono flex items-center gap-2 uppercase">
            <i id="announcerIcon" class="fas fa-bolt text-slate-950"></i>
            <span id="chessAnnouncerText">Surprise MOTHAF*CKA!</span>
        </div>
    </div>

    <!-- Bottom Interaction Guidance Hint Pill -->
    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 pointer-events-none max-w-[90vw]">
        <div id="chessInstructionPill" 
             class="bg-slate-900/90 backdrop-blur-md px-4 py-2 rounded-full border border-amber-500/30 text-slate-200 text-xs font-medium shadow-2xl flex items-center gap-2 text-center">
            <i class="fas fa-hand-pointer text-amber-400 text-xs flex-shrink-0"></i>
            <span id="chessInstructionText">Select your pieces &bull; L-leap with Sir Benzington &bull; Magmus Lava Surges straight &bull; Castle to tag-team vault!</span>
        </div>
    </div>

    <!-- Pawn Promotion Holographic Modal -->
    <div id="pawnPromotionModal" class="hidden absolute inset-0 z-40 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4">
        <div class="max-w-md w-full bg-slate-900/95 border-2 border-amber-500/60 rounded-3xl p-6 shadow-2xl shadow-amber-950/60 flex flex-col items-center text-center space-y-4">
            <div class="w-14 h-14 rounded-full bg-amber-500/20 border-2 border-amber-400 flex items-center justify-center text-2xl text-amber-400">
                <i class="fas fa-arrow-up-from-bracket animate-bounce"></i>
            </div>
            <div>
                <h3 class="text-lg font-black text-amber-300 tracking-wide">PAWN PROMOTION</h3>
                <p class="text-xs text-slate-300 mt-1">Your Creep reached the 8th rank! Choose a hero to summon:</p>
            </div>
            <div class="grid grid-cols-2 gap-3 w-full">
                <button type="button" data-piece="q" class="btnPromotionChoice flex flex-col items-center p-3 rounded-2xl bg-slate-800/90 hover:bg-amber-600/30 border border-slate-700 hover:border-amber-400 transition-all text-white font-bold cursor-pointer group">
                    <i class="fas fa-chess-queen text-2xl text-amber-400 group-hover:scale-110 transition-transform mb-1"></i>
                    <span class="text-xs">Moon Queen</span>
                    <span class="text-[10px] text-slate-400 font-normal">Queen (Rank/File/Diag)</span>
                </button>
                <button type="button" data-piece="r" class="btnPromotionChoice flex flex-col items-center p-3 rounded-2xl bg-slate-800/90 hover:bg-amber-600/30 border border-slate-700 hover:border-amber-400 transition-all text-white font-bold cursor-pointer group">
                    <i class="fas fa-chess-rook text-2xl text-rose-400 group-hover:scale-110 transition-transform mb-1"></i>
                    <span class="text-xs">Magmus</span>
                    <span class="text-[10px] text-slate-400 font-normal">Rook (Straight Surges)</span>
                </button>
                <button type="button" data-piece="b" class="btnPromotionChoice flex flex-col items-center p-3 rounded-2xl bg-slate-800/90 hover:bg-amber-600/30 border border-slate-700 hover:border-amber-400 transition-all text-white font-bold cursor-pointer group">
                    <i class="fas fa-chess-bishop text-2xl text-sky-400 group-hover:scale-110 transition-transform mb-1"></i>
                    <span class="text-xs">Jeraziah</span>
                    <span class="text-[10px] text-slate-400 font-normal">Bishop (Diagonals)</span>
                </button>
                <button type="button" data-piece="n" class="btnPromotionChoice flex flex-col items-center p-3 rounded-2xl bg-slate-800/90 hover:bg-amber-600/30 border border-slate-700 hover:border-amber-400 transition-all text-white font-bold cursor-pointer group">
                    <i class="fas fa-chess-knight text-2xl text-emerald-400 group-hover:scale-110 transition-transform mb-1"></i>
                    <span class="text-xs">Sir Benzington</span>
                    <span class="text-[10px] text-slate-400 font-normal">Knight (L-Shape Leap)</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Victory / Game Over Modal Overlay -->
    <div id="chessVictoryModal" class="hidden absolute inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex flex-col items-center justify-center p-4">
        <div class="max-w-md w-full bg-slate-900/95 border border-amber-500/50 rounded-3xl p-6 shadow-2xl shadow-amber-950/60 flex flex-col items-center text-center space-y-4">
            <div id="victoryIconContainer" class="w-16 h-16 rounded-full bg-amber-500/20 border-2 border-amber-400 flex items-center justify-center text-2xl text-amber-400 animate-bounce shadow-lg shadow-amber-500/30">
                <i class="fas fa-trophy"></i>
            </div>
            <div>
                <h2 id="victoryTitle" class="text-2xl font-black text-amber-300 font-mono tracking-wider">CHECKMATE!</h2>
                <p id="victorySubtitle" class="text-sm font-semibold text-slate-300 mt-1">Legion claims total victory over Newerth!</p>
                <p id="victoryDetails" class="text-xs text-slate-400 mt-0.5">Won by checkmate in 28 moves</p>
            </div>
            <div class="w-full flex gap-3 pt-2">
                <button id="btnModalPlayAgain" type="button" class="flex-1 py-2.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-xs uppercase tracking-wider shadow-lg transition-all active:scale-95 cursor-pointer">
                    <i class="fas fa-play mr-1"></i> Play Again
                </button>
                <button id="btnModalDismiss" type="button" class="py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs transition-all active:scale-95 cursor-pointer">
                    Review Board
                </button>
            </div>
        </div>
    </div>

    <!-- Online 1v1 Lobby / Room Modal -->
    <div id="chessOnlineLobbyModal" class="hidden absolute inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex items-center justify-center p-4">
        <div class="max-w-md w-full bg-slate-900/95 border border-sky-500/40 rounded-3xl p-6 shadow-2xl shadow-sky-950/60 space-y-5">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="w-9 h-9 rounded-xl bg-sky-500/20 border border-sky-400/40 flex items-center justify-center text-sky-400">
                        <i class="fas fa-chess text-lg"></i>
                    </div>
                    <div>
                        <h3 class="font-mono font-black text-sm text-sky-300 uppercase tracking-wide">1v1 KONGOR AR Chess</h3>
                        <p class="text-[11px] text-slate-400 font-medium">Real-time SignalR Tabletop Duel</p>
                    </div>
                </div>
                <button id="btnCloseOnlineLobby" type="button" aria-label="Close online matchmaking lobby" title="Close lobby" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 cursor-pointer">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Join or Host Room Form -->
            <div class="space-y-3">
                <div>
                    <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1 font-mono">Room Code (4-8 chars)</label>
                    <div class="flex gap-2">
                        <input id="inputChessRoomCode" 
                               type="text" 
                               maxlength="8" 
                               placeholder="e.g. KNG1" 
                               class="flex-1 bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm font-mono font-bold text-amber-300 uppercase placeholder-slate-600 focus:outline-none focus:border-amber-400" />
                        <button id="btnGenerateRandomCode" type="button" title="Generate random code" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold transition-all cursor-pointer">
                            <i class="fas fa-dice"></i>
                        </button>
                    </div>
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1 font-mono">Your Commander Name</label>
                    <input id="inputChessPlayerName" 
                           type="text" 
                           maxlength="20" 
                           value="@(User.Identity?.Name ?? "")"
                           placeholder="KongorCommander" 
                           class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm font-mono font-bold text-slate-200 placeholder-slate-600 focus:outline-none focus:border-amber-400" />
                </div>

                <div>
                    <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1 font-mono">Time Control</label>
                    <select id="selectLobbyTimeControl" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm font-mono font-bold text-slate-200 focus:outline-none focus:border-amber-400 cursor-pointer">
                        <option value="3m">3 Min Blitz</option>
                        <option value="5m" selected>5 Min Rapid</option>
                        <option value="10m">10 Min Rapid</option>
                        <option value="30m">30 Min Classical</option>
                        <option value="unlimited">Unlimited Casual</option>
                    </select>
                </div>

                <button id="btnJoinOnlineRoom" type="button" class="w-full py-3 rounded-xl bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-400 hover:to-sky-500 text-slate-950 font-black text-xs uppercase tracking-wider shadow-lg shadow-sky-600/30 transition-all active:scale-95 flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fas fa-network-wired"></i> Enter Room / Host Duel
                </button>
            </div>
        </div>
    </div>

    <!-- Waiting for Opponent Overlay Modal -->
    <div id="chessWaitingOverlay" class="hidden absolute inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex items-center justify-center p-4">
        <div class="max-w-md w-full bg-slate-900/95 border border-amber-500/40 rounded-3xl p-6 shadow-2xl text-center space-y-4">
            <div class="w-14 h-14 rounded-full bg-amber-500/20 border-2 border-amber-400 flex items-center justify-center text-xl text-amber-400 mx-auto animate-pulse">
                <i class="fas fa-hourglass-half animate-spin"></i>
            </div>
            <div>
                <h3 class="text-base font-black text-amber-300 font-mono tracking-wider uppercase">Waiting for Challenger...</h3>
                <p class="text-xs text-slate-400 mt-1">Share this Room Code or link with an opponent to start playing:</p>
            </div>
            <div class="bg-slate-950 border border-slate-800 rounded-2xl p-3 flex items-center justify-between gap-2">
                <span id="chessWaitingRoomCodeText" class="font-mono text-lg font-black text-amber-400 tracking-widest">KNG1</span>
                <button id="btnCopyChessShareLink" type="button" class="px-3 py-1.5 bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 rounded-xl text-xs font-bold transition-all flex items-center gap-1 cursor-pointer">
                    <i class="fas fa-copy"></i>
                    <span>Copy Link</span>
                </button>
            </div>
            <div class="text-[11px] text-slate-500 font-mono break-all" id="chessShareUrlText">
                Generating link...
            </div>
            <button id="btnCancelWaiting" type="button" class="py-2 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs transition-all cursor-pointer">
                Cancel &amp; Leave Room
            </button>
        </div>
    </div>

    <!-- Pre-Match Ready Prompt Modal (When 2/2 players in room) -->
    <div id="chessArReadyModal" class="hidden absolute inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex items-center justify-center p-4">
        <div class="max-w-md w-full bg-slate-900/95 border-2 border-emerald-500/50 rounded-3xl p-6 shadow-2xl space-y-4 text-center">
            <div class="w-14 h-14 rounded-full bg-emerald-500/20 border-2 border-emerald-400 flex items-center justify-center text-xl text-emerald-400 mx-auto">
                <i class="fas fa-swords"></i>
            </div>
            <div>
                <h3 class="text-lg font-black text-emerald-300 font-mono tracking-wider">CHALLENGER CONNECTED!</h3>
                <p class="text-xs text-slate-300 mt-0.5">Both commanders are in the room. Confirm your battle stance:</p>
            </div>
            
            <div class="grid grid-cols-2 gap-3 text-left">
                <div class="bg-slate-950 border border-emerald-600/40 rounded-xl p-3">
                    <div class="text-[10px] font-mono text-emerald-400 font-bold uppercase">White (Slot 1)</div>
                    <div id="chessP1ReadyName" class="text-xs font-bold text-white mt-0.5 truncate">Legion Commander</div>
                    <div id="chessP1ReadyStatus" class="mt-2 text-[10px] font-bold text-amber-400 flex items-center gap-1">
                        <i class="fas fa-clock"></i> Not Ready
                    </div>
                </div>
                <div class="bg-slate-950 border border-rose-600/40 rounded-xl p-3">
                    <div class="text-[10px] font-mono text-rose-400 font-bold uppercase">Black (Slot 2)</div>
                    <div id="chessP2ReadyName" class="text-xs font-bold text-white mt-0.5 truncate">Hellbourne Overlord</div>
                    <div id="chessP2ReadyStatus" class="mt-2 text-[10px] font-bold text-amber-400 flex items-center gap-1">
                        <i class="fas fa-clock"></i> Not Ready
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-center gap-2 pt-1">
                <input id="cbReadyWantsAr" type="checkbox" class="w-4 h-4 rounded text-emerald-500 focus:ring-0 bg-slate-950 border-slate-700 cursor-pointer" />
                <label for="cbReadyWantsAr" class="text-xs font-bold text-slate-300 cursor-pointer select-none">
                    Enable Camera AR Passthrough
                </label>
            </div>

            <button id="btnConfirmReady" type="button" class="w-full py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-slate-950 font-black text-xs uppercase tracking-wider shadow-lg shadow-emerald-600/30 transition-all active:scale-95 cursor-pointer">
                <i class="fas fa-check-circle mr-1"></i> I am Ready for Battle!
            </button>
        </div>
    </div>

</div>

