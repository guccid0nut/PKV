                    p2Badge.innerHTML = `<i class="fas fa-check-circle text-xs text-emerald-400"></i><span>${label2}: ${p2WantsAr ? "AR Ready" : "3D Ready"}</span>`;
                } else {
                    p2Badge.className = "p-2.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-center gap-1.5 text-xs font-bold text-slate-500";
                    p2Badge.innerHTML = `<i class="fas fa-clock text-xs"></i><span>${label2} (Waiting)</span>`;
