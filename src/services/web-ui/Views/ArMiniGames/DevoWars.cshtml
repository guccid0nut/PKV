        // --- 10. Main Animation Render Loop ---
        function renderLoop() {
            const delta = Math.min(clock.getDelta(), 0.05); // Cap to 50ms per frame to prevent tunneling
            const time = clock.getElapsedTime();

            // Animate Realistic River Surface & Caustics
            if (riverMaterial && riverMaterial.uniforms && riverMaterial.uniforms.uTime) {
                riverMaterial.uniforms.uTime.value = time;
            }

            // Animate Drifting River Lily Pads
            if (riverLilyPads && riverLilyPads.length > 0) {
                riverLilyPads.forEach(lp => {
                    lp.position.x += lp.userData.speed * delta;
                    if (lp.position.x > 1.8) lp.position.x = -1.8;
                    lp.position.y = 0.007 + Math.sin(time * 3.0 + lp.userData.phase) * 0.002;
                    lp.rotation.z = Math.sin(time * 1.5 + lp.userData.phase) * 0.04;
                });
            }

            // Update Mixers
            if (localMixer) localMixer.update(delta);
            if (oppMixer) oppMixer.update(delta);

            // Update Flying Hooks
            updateHooks(delta);

            // Update Cooldowns
            if (hookCooldown) {
                hookCooldownTimer -= delta;
                cooldownTimeText.textContent = `RELOADING HOOK (${Math.max(0, hookCooldownTimer).toFixed(1)}s)`;
                if (hookCooldownTimer <= 0) {
                    hookCooldown = false;
                    cooldownBanner.classList.add('opacity-0');
                    // Sound removed per user request: only play noMana when trying to hook while on cooldown
                }
            }

            // Update Move Click Marker
            if (moveMarkerMesh && moveMarkerMesh.visible) {
                moveMarkerMesh._life -= delta;
                const progress = 1.0 - Math.max(0, moveMarkerMesh._life / 0.35);
                moveMarkerMesh.scale.setScalar(1.0 + progress * 0.5);
                moveMarkerMesh.material.opacity = Math.max(0, 0.9 * (1.0 - progress));
                if (moveMarkerMesh._life <= 0) {
                    moveMarkerMesh.visible = false;
                }
            }

            // Local Devourer Multi-Input Movement (Keyboard WASD + Phone Tilt + Touch Waypoints)
            if (localDevo && !isLocalHookStunned) {
                let moveX = 0;
                let moveZ = 0;

                // A) Keyboard Input (PC WASD / Arrow Keys)
                const isLeft = keysDown['KeyA'] || keysDown['ArrowLeft'] || keysDown['a'] || keysDown['A'];
                const isRight = keysDown['KeyD'] || keysDown['ArrowRight'] || keysDown['d'] || keysDown['D'];
                const isUp = keysDown['KeyW'] || keysDown['ArrowUp'] || keysDown['w'] || keysDown['W'];
                const isDown = keysDown['KeyS'] || keysDown['ArrowDown'] || keysDown['s'] || keysDown['S'];

                if (isLeft) moveX -= 1;
                if (isRight) moveX += 1;
                if (isUp) moveZ -= 1; // Forward toward river
                if (isDown) moveZ += 1; // Back away from river

                // B) Phone Gyroscope Tilt Input (Active strictly when mobile hardware sensor is confirmed & calibrated)
                if (isTiltEnabled && hasDeviceOrientation && isTiltCalibrated) {
                    // Roll: left / right (deadzone ±3.5 deg)
                    if (tiltGamma < -3.5) moveX += Math.max(-1.0, (tiltGamma + 3.5) / 18.0);
                    else if (tiltGamma > 3.5) moveX += Math.min(1.0, (tiltGamma - 3.5) / 18.0);

                    // Pitch: forward / back relative to neutralBeta (deadzone ±5 deg)
                    const pitchDiff = tiltBeta - neutralBeta;
                    if (pitchDiff < -5.0) moveZ += Math.max(-1.0, (pitchDiff + 5.0) / 18.0);
                    else if (pitchDiff > 5.0) moveZ += Math.min(1.0, (pitchDiff - 5.0) / 18.0);
                }

                const inputMag = Math.hypot(moveX, moveZ);
                if (inputMag > 0.08) {
                    // Direct analog control overrides waypoint pathing
                    isLocalMoving = false;
                    const speed = 2.4;
                    const normFactor = Math.min(1.0, inputMag);
                    const dirX = (moveX / inputMag) * normFactor;
                    const dirZ = (moveZ / inputMag) * normFactor;

                    const newX = Math.max(BOUNDS.minX, Math.min(BOUNDS.maxX, localDevo.position.x + dirX * speed * delta));
                    const newZ = Math.max(BOUNDS.minZ, Math.min(BOUNDS.maxZ, localDevo.position.z + dirZ * speed * delta));
                    localDevo.position.x = newX;
                    localDevo.position.z = newZ;

                    // Facing direction:
                    if (cameraMode === 'pov') {
                        localDevo.rotation.y = Math.PI; // In POV, always face forward across the river
                    } else {
                        // Subtle facing angle towards lateral movement
                        localDevo.rotation.y = Math.PI + (dirX * 0.35);
                    }

                    isLocalWalking = true;
                    playDevoAction(true, 'walk_1', 0.15, true);

                    // Send 20Hz position update
                    if (!isSoloPractice && hub && (time - lastSyncTime > 0.05)) {
                        lastSyncTime = time;
                        hub.invoke("SendPosition", roomCode, localDevo.position.x, localDevo.position.z, localDevo.rotation.y, true)
                            .catch(() => {});
                    }
                } else if (isLocalMoving) {
                    // C) Touch Waypoint Movement
                    isLocalWalking = true;
                    const step = 2.4 * delta;
                    const toTarget = new THREE.Vector3().subVectors(localTarget, localDevo.position);
                    toTarget.y = 0;
                    const dist = toTarget.length();

                    if (dist < 0.06) {
                        localDevo.position.copy(localTarget);
                        isLocalMoving = false;
                        isLocalWalking = false;
                        if (currentLocalActionName !== 'ability_1' && currentLocalActionName !== 'knock_1') {
                            playDevoAction(true, 'idle', 0.2, true);
                            localDevo.rotation.y = Math.PI; // Face back North across river
                        }
                    } else {
                        toTarget.normalize();
                        localDevo.position.addScaledVector(toTarget, step);
                        const targetAngle = Math.atan2(toTarget.x, toTarget.z);
                        localDevo.rotation.y = targetAngle;
                    }

                    if (!isSoloPractice && hub && (time - lastSyncTime > 0.05)) {
                        lastSyncTime = time;
                        hub.invoke("SendPosition", roomCode, localDevo.position.x, localDevo.position.z, localDevo.rotation.y, isLocalMoving)
                            .catch(() => {});
                    }
                } else {
                    // Standstill: only transition back to idle if we were walking, and not in the middle of casting ability_1 or knock_1
                    if (isLocalWalking) {
                        isLocalWalking = false;
                        if (currentLocalActionName !== 'ability_1' && currentLocalActionName !== 'knock_1') {
                            playDevoAction(true, 'idle', 0.2, true);
                            localDevo.rotation.y = Math.PI;
                        }
                    }
                }
            }

            // Update POV Camera tracking
            if (cameraMode === 'pov') {
                updatePovCamera();
            }

            // Opponent Devourer: Multiplayer Interpolation OR Practice Mode Sparring Bot
            if (oppDevo) {
                if (isSoloPractice && matchActive && !isDummyRespawning) {
                    // 1. Sparring Bot Patrol Movement (North bank)
                    if (dummyPauseTimer > 0) {
                        dummyPauseTimer -= delta;
                        playDevoAction(false, 'idle', 0.2, true);
                        oppDevo.rotation.y = 0; // Face South toward player
                    } else {
                        oppDevo.position.x += dummyPatrolDir * dummyPatrolSpeed * delta;

                        // Reverse direction at boundaries
                        if (oppDevo.position.x >= BOUNDS.maxX - 0.2) {
                            oppDevo.position.x = BOUNDS.maxX - 0.2;
                            dummyPatrolDir = -1;
                            if (Math.random() < 0.35) dummyPauseTimer = 0.5 + Math.random() * 0.7;
                        } else if (oppDevo.position.x <= BOUNDS.minX + 0.2) {
                            oppDevo.position.x = BOUNDS.minX + 0.2;
                            dummyPatrolDir = 1;
                            if (Math.random() < 0.35) dummyPauseTimer = 0.5 + Math.random() * 0.7;
                        }

                        // Tilt rotation slightly towards walking direction
                        oppDevo.rotation.y = (dummyPatrolDir > 0) ? 0.35 : -0.35;
                        playDevoAction(false, 'walk_1', 0.15, true);
                    }

                    // 2. Sparring Bot Automated Hook Flinging (Every 4.0 - 6.5s)
                    dummyNextHookTimer -= delta;
                    if (dummyNextHookTimer <= 0) {
                        dummyNextHookTimer = 4.0 + Math.random() * 2.5;
                        if (localDevo) {
                            oppDevo.rotation.y = 0; // Face player
                            const targetX = localDevo.position.x + (Math.random() - 0.5) * 0.18;
                            const targetZ = localDevo.position.z;
                            const dirX = targetX - oppDevo.position.x;
                            const dirZ = targetZ - oppDevo.position.z;
                            const len = Math.hypot(dirX, dirZ);
                            if (len > 0.1) {
                                const normDirX = dirX / len;
                                const normDirZ = dirZ / len;
                                log(`Sparring bot throwing hook towards (${targetX.toFixed(2)}, ${targetZ.toFixed(2)})`);
                                spawnHook(oppDevo.position.x, oppDevo.position.z, normDirX, normDirZ, false);
                            }
                        }
                    }
                } else if (isOppMoving) {
                    const step = 2.4 * delta;
                    const toTarget = new THREE.Vector3().subVectors(oppTarget, oppDevo.position);
                    toTarget.y = 0;
                    const dist = toTarget.length();

                    if (dist < 0.06) {
                        oppDevo.position.copy(oppTarget);
                        isOppMoving = false;
                        if (currentOppActionName !== 'ability_1' && currentOppActionName !== 'knock_1') {
                            playDevoAction(false, 'idle', 0.2, true);
                            oppDevo.rotation.y = 0; // Face South toward local player
                        }
                    } else {
                        toTarget.normalize();
                        oppDevo.position.addScaledVector(toTarget, step);
                        const targetAngle = Math.atan2(toTarget.x, toTarget.z);
                        oppDevo.rotation.y = targetAngle;
                    }
                }
            }

            if (controls) controls.update();
            renderer.render(scene, camera);
        }

        function onWindowResize() {
            if (!camera || !renderer) return;
            const w = container.clientWidth;
            const h = container.clientHeight;
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
            renderer.setSize(w, h);
            checkOrientation();
        }

