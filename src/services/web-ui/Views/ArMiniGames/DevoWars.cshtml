        // --- 9. Camera Passthrough (AR Tabletop) ---
        async function toggleCamera() {
            log("toggleCamera requested. Current state:", isCameraActive);
            if (isCameraActive) {
                // Turn Off Camera
                if (mediaStream) {
                    mediaStream.getTracks().forEach(t => t.stop());
                    mediaStream = null;
                }
                video.srcObject = null;
                video.classList.add('hidden');
                if (studioGrid) studioGrid.visible = true;
                if (controls) controls.enableRotate = true;
                isCameraActive = false;
                updateCameraUi(false);
                showToast("Camera disabled. 3D Studio active.");
                return;
            }

            // Turn On Camera
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                log("navigator.mediaDevices.getUserMedia not available");
                showToast("Camera access requires HTTPS. Playing in 3D Stadium.", "fa-triangle-exclamation");
                return;
            }

            try {
                showToast("Activating phone camera...", "fa-camera");
                let stream = null;
                try {
                    // Try high-res rear environment camera first
                    stream = await navigator.mediaDevices.getUserMedia({
                        video: {
                            facingMode: { ideal: 'environment' },
                            width: { ideal: 1920 },
                            height: { ideal: 1080 }
                        },
                        audio: false
                    });
                } catch (err1) {
                    log("Ideal environment constraints failed, trying facingMode environment:", err1);
                    try {
                        stream = await navigator.mediaDevices.getUserMedia({
                            video: { facingMode: 'environment' },
                            audio: false
                        });
                    } catch (err2) {
                        log("facingMode environment failed, trying fallback video:", err2);
                        stream = await navigator.mediaDevices.getUserMedia({
                            video: true,
                            audio: false
                        });
                    }
                }

                if (!stream) throw new Error("Could not acquire video stream");

                mediaStream = stream;
                video.srcObject = stream;
                video.classList.remove('hidden');

                // Explicit play for iOS Safari and mobile Chrome
                try {
                    await video.play();
                } catch (playErr) {
                    console.warn("video.play() caught:", playErr);
                }

                if (studioGrid) studioGrid.visible = false;
                if (controls) {
                    controls.enableRotate = false; // Lock orbit rotation in AR mode so table stays flat
                    resetCamera();
                }

                isCameraActive = true;
                updateCameraUi(true);
                showToast("AR Tabletop Active!", "fa-camera");
            } catch (err) {
                console.warn("Camera access denied or unavailable:", err);
                showToast(`Camera unavailable (${err.name || 'Denied'}). Playing in 3D.`, "fa-triangle-exclamation");
                updateCameraUi(false);
            }
        }

        async function enableCamera(turnOn) {
            if (turnOn && !isCameraActive) {
                await toggleCamera();
            } else if (!turnOn && isCameraActive) {
                await toggleCamera();
            }
        }

