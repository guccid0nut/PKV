                <!-- Recenter / Calibrate -->
                <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-950/60 border border-slate-800">
                    <div class="flex items-center gap-2.5">
                        <i class="fas fa-crosshairs text-amber-400 text-sm"></i>
                        <div>
                            <div class="text-xs font-bold text-white">Recenter & Level</div>
                            <div class="text-[10px] text-slate-400">Reset view angle & tilt zero-point</div>
                        </div>
                    </div>
                    <button id="btnModalResetCenter" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-amber-300 transition-colors cursor-pointer">
                        Recenter
                    </button>
