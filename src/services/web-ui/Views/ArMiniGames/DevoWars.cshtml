            <!-- Resume Button -->
            <button id="btnResumeSettings" class="w-full py-3 rounded-2xl bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 text-white font-black text-xs uppercase tracking-wider shadow-lg active:scale-95 transition-transform cursor-pointer">
                Resume Match
