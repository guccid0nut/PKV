@{
    Layout = null;
    string initialRoom = (ViewData["InitialRoom"] as string) ?? "HOOK";
    if (string.IsNullOrWhiteSpace(initialRoom)) initialRoom = "HOOK";
}
<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>DevoWarsAR - 1v1 Tabletop AR Hook Duel</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        hon: {
                            gold: '#fbbf24',
                            blood: '#ef4444',
                            mana: '#0284c7',
                            dark: '#090d16'
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        * {
            -webkit-tap-highlight-color: transparent;
            user-select: none;
            -webkit-user-select: none;
            touch-action: none;
        }
        body {
            overflow: hidden;
            background-color: #020617;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        /* Mobile Safe Area Insets */
        .safe-top { padding-top: max(0.75rem, env(safe-area-inset-top)); }
        .safe-bottom { padding-bottom: max(0.75rem, env(safe-area-inset-bottom)); }

        @@keyframes pulseGlow {
            0%, 100% { opacity: 0.6; transform: scale(1); }
            50% { opacity: 1.0; transform: scale(1.05); }
        }
        .glow-pulse { animation: pulseGlow 2s infinite ease-in-out; }

        @@keyframes floatText {
            0% { opacity: 1; transform: translateY(0) scale(1); }
            100% { opacity: 0; transform: translateY(-70px) scale(1.3); }
        }
        .float-score {
            animation: floatText 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        }
    </style>
</head>
<body class="h-full w-full relative select-none overflow-hidden bg-slate-950 text-slate-100">

    <!-- CAMERA PASSTHROUGH (Underneath WebGL Canvas) -->
    <video id="cameraFeed" autoplay playsinline webkit-playsinline="true" muted class="absolute inset-0 w-full h-full object-cover z-0 hidden pointer-events-none"></video>

    <!-- THREE.JS WEBGL RENDER CANVAS -->
    <div id="canvasContainer" class="absolute inset-0 z-10 w-full h-full cursor-crosshair">
        <canvas id="gameCanvas" class="w-full h-full block" role="region" aria-label="Devo Wars 3D WebGL arena battlefield">Your browser does not support HTML5 Canvas.</canvas>
    </div>

    <!-- POV CENTER TARGETING CROSSHAIR (Active only in 3rd-Person Devo POV Mode) -->
    <div id="povCrosshair" class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 pointer-events-none hidden flex flex-col items-center justify-center">
        <div class="relative w-12 h-12 flex items-center justify-center">
            <div class="absolute w-12 h-12 rounded-full border border-sky-400/50 animate-pulse"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-rose-500 shadow-lg shadow-rose-500/80"></div>
            <div class="absolute w-7 h-[1.5px] bg-sky-400/80"></div>
            <div class="absolute h-7 w-[1.5px] bg-sky-400/80"></div>
        </div>
        <div class="mt-2 text-[10px] font-black uppercase tracking-widest text-sky-300 bg-slate-950/80 px-2.5 py-0.5 rounded-full border border-sky-500/30 whitespace-nowrap shadow-lg">
            TAP SCREEN TO HOOK
        </div>
    </div>

    <!-- FLOATING DAMAGE / HIT COMBAT TEXT LAYER -->
    <div id="combatTextLayer" class="absolute inset-0 z-20 pointer-events-none overflow-hidden"></div>

    <!-- MINIMAL SLEEK TOP HUD (NO BUTTONS AT BOTTOM!) -->
    <div class="absolute top-0 left-0 right-0 z-30 safe-top px-3 py-2 flex items-center justify-between pointer-events-none">
        <!-- Room Info Pill -->
        <div class="flex items-center gap-1.5 pointer-events-auto bg-slate-900/85 backdrop-blur-md px-3 py-1.5 rounded-full border border-slate-700/60 shadow-xl">
            <span id="roomStatusDot" class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
            <span id="roomCodeDisplay" class="text-xs font-black tracking-wider font-mono text-white">ROOM: ----</span>
            <button id="btnCopyRoom" class="ml-1 text-slate-400 hover:text-white transition-colors p-1" title="Copy Room Link">
                <i class="fas fa-copy text-xs"></i>
            </button>
        </div>

        <!-- Central Scoreboard -->
        <div id="scoreboardPill" class="flex items-center gap-3 pointer-events-auto bg-slate-900/90 backdrop-blur-xl px-4 py-1.5 rounded-full border border-slate-700/80 shadow-2xl">
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-sky-400"></span>
                <span id="scoreP1" class="text-lg font-black font-mono text-sky-400">0</span>
            </div>
            <div class="text-[11px] font-bold uppercase tracking-widest text-slate-500">VS</div>
            <div class="flex items-center gap-2">
                <span id="scoreP2" class="text-lg font-black font-mono text-rose-500">0</span>
                <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            </div>
        </div>

        <!-- Top Right Share Button -->
        <div class="flex items-center gap-1.5 pointer-events-auto">
            <button id="btnCopyRoom" class="h-10 px-3 rounded-2xl bg-slate-900/90 hover:bg-slate-800 text-slate-200 border border-slate-700/70 backdrop-blur-xl text-xs font-bold transition-all flex items-center gap-1.5 shadow-lg active:scale-95 touch-manipulation cursor-pointer" title="Copy Room Invite Link">
                <i class="fas fa-share-nodes text-xs text-sky-400"></i>
                <span class="text-[11px] font-bold">Share</span>
            </button>
        </div>
    </div>

    <!-- PC CONTROLS HINT (Desktop only) -->
    <div id="desktopControlsHint" class="fixed bottom-4 left-4 z-20 hidden md:flex items-center gap-2.5 bg-slate-900/85 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-slate-700/60 text-[11px] font-bold text-slate-300 shadow-xl pointer-events-none transition-opacity duration-300">
        <span class="flex items-center gap-1.5"><kbd class="px-1.5 py-0.5 rounded bg-slate-800 border border-slate-600 text-sky-400 font-mono text-[10px]">WASD</kbd> or <span class="text-emerald-400">Right-Click</span> Move</span>
        <span class="text-slate-600">|</span>
        <span class="flex items-center gap-1.5"><span class="text-rose-400">Left-Click</span> or <kbd class="px-1.5 py-0.5 rounded bg-slate-800 border border-slate-600 text-sky-400 font-mono text-[10px]">Space</kbd> Hook</span>
        <span class="text-slate-600">|</span>
        <span class="text-slate-400">Middle-Drag Rotate</span>
    </div>

    <!-- HOOK COOLDOWN / AIM GUIDE BANNER (Appears only while aiming or reloading) -->
    <div id="aimHintBanner" class="absolute top-16 left-1/2 -translate-x-1/2 z-20 pointer-events-none transition-opacity duration-300 opacity-0 bg-slate-900/90 backdrop-blur-md px-4 py-1 rounded-full border border-sky-500/40 text-xs font-bold text-sky-300 flex items-center gap-2 shadow-xl">
        <i class="fas fa-crosshairs animate-spin text-[10px]"></i>
        <span>RELEASE TO FLING HOOK!</span>
    </div>

    <div id="cooldownBanner" class="absolute top-16 left-1/2 -translate-x-1/2 z-20 pointer-events-none transition-opacity duration-200 opacity-0 bg-rose-950/80 backdrop-blur-md px-4 py-1 rounded-full border border-rose-500/40 text-xs font-bold text-rose-300 flex items-center gap-2 shadow-xl">
        <i class="fas fa-hourglass-half text-[10px] animate-pulse"></i>
        <span id="cooldownTimeText">RELOADING HOOK (1.5s)</span>
    </div>

    <!-- ROOM LOBBY / SETUP MODAL OVERLAY -->
    <div id="lobbyModal" class="fixed inset-0 z-40 bg-slate-950/90 backdrop-blur-xl flex items-center justify-center p-4">
        <div class="w-full max-w-sm bg-slate-900 border border-slate-700/80 rounded-3xl p-6 shadow-2xl flex flex-col space-y-5">
            <!-- Header Title -->
            <div class="text-center space-y-1">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-black tracking-widest uppercase">
                    <i class="fas fa-skull"></i> 1v1 Tabletop AR Duel
                </div>
                <h1 class="text-2xl font-black tracking-wider text-white uppercase">DevoWarsAR</h1>
                <p class="text-slate-400 text-xs">Fling Guttling Hooks across the river! First to 10 points wins.</p>
            </div>

            <!-- Form -->
            <div class="space-y-4">
                <div>
                    <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Your Name</label>
                    <input id="inputPlayerName" type="text" maxlength="16" value="Devourer" class="w-full bg-slate-950 border border-slate-700 focus:border-sky-500 rounded-xl px-3.5 py-2.5 text-sm font-bold text-white outline-none transition-colors" placeholder="e.g. MoonMeander" />
                </div>

                <div>
                    <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Room Code (4-8 chars)</label>
                    <div class="flex items-center gap-2">
                        <input id="inputRoomCode" type="text" maxlength="8" value="@initialRoom" class="w-full bg-slate-950 border border-slate-700 focus:border-sky-500 rounded-xl px-3.5 py-2.5 text-sm font-black tracking-widest uppercase font-mono text-white outline-none transition-colors" placeholder="HOOK" />
                        <button id="btnRandomRoom" type="button" aria-label="Generate random room code" title="Random room code" class="px-3 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-bold transition-colors">
                            <i class="fas fa-dice"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="pt-2 flex flex-col gap-2.5">
                <button id="btnEnterGame" class="w-full py-3.5 rounded-2xl bg-gradient-to-r from-red-600 via-rose-600 to-amber-600 hover:from-red-500 hover:to-amber-500 text-white font-black text-sm uppercase tracking-wider shadow-lg shadow-rose-900/40 active:scale-95 transition-all flex items-center justify-center gap-2">
                    <i class="fas fa-play"></i> Enter Arena
                </button>
                <button id="btnPracticeSolo" class="w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs uppercase tracking-wider active:scale-95 transition-all">
                    Practice Mode (Solo Target Dummy)
                </button>
            </div>
        </div>
    </div>

    <!-- WAITING FOR OPPONENT OVERLAY -->
    <div id="waitingOverlay" class="fixed inset-0 z-45 bg-slate-950/90 backdrop-blur-xl flex flex-col items-center justify-center p-6 text-center hidden pointer-events-auto" style="z-index: 45;">
        <div class="w-16 h-16 mb-4 relative flex items-center justify-center">
            <div class="absolute inset-0 border-4 border-sky-500/20 rounded-full"></div>
            <div class="absolute inset-0 border-4 border-sky-400 border-t-transparent rounded-full animate-spin"></div>
            <i class="fas fa-satellite-dish text-sky-400 text-lg"></i>
        </div>
        <h3 class="text-xl font-black text-white uppercase tracking-wider mb-1">Waiting for Opponent</h3>
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-sky-500/15 border border-sky-500/30 text-sky-400 font-mono text-xs font-black mb-3">
            ROOM: <span id="waitingRoomCodeText">@initialRoom</span>
        </div>
        <p class="text-slate-400 text-xs max-w-xs mb-4">Share this link with your friend so they can join on their phone:</p>
        
        <div class="flex items-center gap-2 bg-slate-900 border border-slate-700 px-4 py-2.5 rounded-2xl text-xs font-mono text-amber-300 mb-4 shadow-xl">
            <span id="shareUrlText">https://newbs.io/ar-mini-games/devo-wars?room=----</span>
            <button id="btnShareCopy" type="button" aria-label="Copy room invite link" title="Copy link" class="p-1 text-slate-400 hover:text-white transition-colors">
                <i class="fas fa-copy"></i>
            </button>
        </div>

        <button id="btnCancelWaiting" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-400 text-xs font-bold rounded-xl transition-colors">
            Cancel & Return
        </button>
    </div>

    <!-- MATCH OVERLAY / VICTORY MODAL -->
    <div id="matchOverModal" class="fixed inset-0 z-40 bg-slate-950/90 backdrop-blur-xl flex items-center justify-center p-6 hidden pointer-events-auto">
        <div class="w-full max-w-sm bg-slate-900 border border-slate-700 rounded-3xl p-6 text-center space-y-4 shadow-2xl">
            <div id="victoryIconWrap" class="w-20 h-20 mx-auto rounded-full flex items-center justify-center bg-amber-500/20 border-2 border-amber-400 text-amber-400 text-3xl glow-pulse">
                <i id="victoryIcon" class="fas fa-trophy"></i>
            </div>
            <div>
                <h2 id="victoryTitle" class="text-3xl font-black tracking-wider uppercase text-white">VICTORY!</h2>
                <p id="victorySub" class="text-slate-400 text-xs mt-1">You hooked Devourer 10 times to claim supremacy.</p>
            </div>
            <div class="py-2 bg-slate-950/70 rounded-2xl border border-slate-800 font-mono text-2xl font-black flex items-center justify-center gap-3">
                <span id="finalScoreP1" class="text-sky-400">10</span>
                <span class="text-slate-600 text-lg">-</span>
                <span id="finalScoreP2" class="text-rose-500">6</span>
            </div>
            <button id="btnPlayAgain" class="w-full py-3.5 rounded-2xl bg-gradient-to-r from-sky-500 to-indigo-600 text-white font-black text-sm uppercase tracking-wider active:scale-95 transition-transform shadow-xl">
                Play Again (Rematch)
            </button>
        </div>
    </div>

    <!-- ROOM FULL REJECTION MODAL -->
    <div id="roomFullModal" class="fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-2xl flex items-center justify-center p-4 hidden pointer-events-auto">
        <div class="w-full max-w-sm bg-slate-900 border border-rose-500/50 rounded-3xl p-6 shadow-2xl flex flex-col space-y-5 text-center">
            <div class="w-16 h-16 mx-auto rounded-3xl bg-rose-500/20 border border-rose-500/50 flex items-center justify-center text-rose-400 text-2xl shadow-inner">
                <i class="fas fa-users-slash"></i>
            </div>
            <div>
                <h3 class="text-xl font-black uppercase tracking-wider text-white">Room Is Full (2/2)</h3>
                <p id="roomFullDescription" class="text-slate-300 text-xs mt-2 leading-relaxed">
                    Room <span id="fullRoomCodeText" class="font-mono font-bold text-rose-400">HOOK</span> already has 2 gladiators dueling. More than 2 players are not allowed in the same room.
                </p>
            </div>

            <!-- New Room Suggestion Card -->
            <div class="p-3 rounded-2xl bg-slate-950 border border-slate-800 flex flex-col gap-1.5">
                <div class="text-[10px] uppercase font-bold text-slate-400">Create New Room Instead</div>
                <div class="flex items-center justify-center gap-2">
                    <span class="text-xs text-slate-400 font-semibold">Suggested Code:</span>
                    <span id="suggestedNewRoomCode" class="font-mono font-black text-sm text-sky-400 px-2 py-0.5 rounded-lg bg-sky-950/60 border border-sky-500/40">WAR42</span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col gap-2.5 pt-1">
                <button id="btnCreateNewRoomFromFull" class="w-full py-3.5 rounded-2xl bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-sky-900/40 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fas fa-plus-circle"></i> Create Room & Enter
                </button>
                <button id="btnCloseRoomFull" class="w-full py-3 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-black text-xs uppercase tracking-wider border border-slate-700 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fas fa-arrow-left"></i> Change Code in Lobby
                </button>
            </div>
        </div>
    </div>

    <!-- PRE-MATCH AR PROMPT & READY CHECK MODAL -->
    <div id="arReadyModal" class="fixed inset-0 z-40 bg-slate-950/90 backdrop-blur-xl flex items-center justify-center p-4 hidden pointer-events-auto">
        <div class="w-full max-w-sm bg-slate-900 border border-slate-700/80 rounded-3xl p-6 shadow-2xl flex flex-col space-y-5 text-center">
            <div class="w-16 h-16 mx-auto rounded-3xl bg-gradient-to-br from-sky-500/20 to-purple-500/20 border border-sky-500/40 flex items-center justify-center text-sky-400 text-2xl shadow-inner">
                <i class="fas fa-vr-cardboard"></i>
            </div>
            <div>
                <h3 class="text-xl font-black uppercase tracking-wider text-white">Play in Augmented Reality?</h3>
                <p class="text-slate-400 text-xs mt-1">Enable your phone camera to battle Devourer in your room, or duel in the neon 3D stadium!</p>
            </div>

            <!-- Choices -->
            <div class="flex flex-col gap-2.5 pt-1">
                <button id="btnChooseArYes" class="w-full py-3.5 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-emerald-900/40 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fas fa-camera"></i> Yes - Turn On AR Camera
                </button>
                <button id="btnChooseArNo" class="w-full py-3 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-black text-xs uppercase tracking-wider border border-slate-700 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fas fa-cube"></i> No - 3D Stadium Mode
                </button>
            </div>

            <!-- Multiplayer Ready Status Indicators -->
            <div id="readyStatusContainer" class="pt-2 border-t border-slate-800 flex flex-col gap-2">
                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 flex items-center justify-between px-1">
                    <span>Duel Readiness</span>
                    <span id="readyCountText" class="text-sky-400 font-mono">0 / 2 Ready</span>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div id="p1ReadyBadge" class="p-2.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-center gap-1.5 text-xs font-bold text-slate-500">
                        <i class="fas fa-clock text-xs"></i>
                        <span id="p1ReadyName">Player 1</span>
                    </div>
                    <div id="p2ReadyBadge" class="p-2.5 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-center gap-1.5 text-xs font-bold text-slate-500">
                        <i class="fas fa-clock text-xs"></i>
                        <span id="p2ReadyName">Player 2</span>
                    </div>
                </div>
                <div id="waitingForOpponentReadyText" class="text-[11px] text-amber-400/90 font-medium hidden">
                    <i class="fas fa-spinner animate-spin mr-1"></i> Waiting for opponent to ready up...
                </div>
            </div>
        </div>
    </div>

    <!-- FLOATING SETTINGS BUTTON (Bottom-Right, safe from phone swipe-down gestures) -->
    <button id="btnOpenSettings" class="fixed bottom-4 right-4 z-30 w-12 h-12 rounded-full bg-slate-900/95 hover:bg-slate-800 text-amber-400 border border-slate-700/80 backdrop-blur-xl flex items-center justify-center shadow-2xl active:scale-90 transition-all touch-manipulation cursor-pointer pointer-events-auto" title="Open Settings">
        <i class="fas fa-gear text-lg"></i>
    </button>

    <!-- SETTINGS MODAL (Centered popup) -->
    <div id="settingsModal" class="fixed inset-0 z-40 bg-slate-950/80 backdrop-blur-xl flex items-center justify-center p-4 hidden pointer-events-auto">
        <div class="w-full max-w-sm bg-slate-900 border border-slate-700/90 rounded-3xl p-6 shadow-2xl flex flex-col space-y-5">
            <!-- Header -->
            <div class="flex items-center justify-between pb-2 border-b border-slate-800">
                <div class="flex items-center gap-2">
                    <i class="fas fa-gear text-amber-400 text-base"></i>
                    <h3 class="text-base font-black uppercase tracking-wider text-white">Match Settings</h3>
                </div>
                <button id="btnCloseSettings" type="button" aria-label="Close settings modal" title="Close" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>

            <!-- Settings Options -->
            <div class="space-y-3">
                <!-- Camera View Mode Toggle -->
                <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-950/60 border border-slate-800">
                    <div class="flex items-center gap-2.5">
                        <i id="modalViewIcon" class="fas fa-eye text-amber-400 text-sm"></i>
                        <div>
                            <div class="text-xs font-bold text-white">Camera View</div>
                            <div class="text-[10px] text-slate-400">Tabletop vs 3rd-Person POV</div>
                        </div>
                    </div>
                    <button id="btnModalToggleView" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-amber-400 transition-colors cursor-pointer">
                        <span id="btnModalViewText">Tabletop</span>
                    </button>
                </div>

                <!-- Phone Camera AR Toggle -->
                <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-950/60 border border-slate-800">
                    <div class="flex items-center gap-2.5">
                        <i id="modalCameraIcon" class="fas fa-camera text-sky-400 text-sm"></i>
                        <div>
                            <div class="text-xs font-bold text-white">AR Camera Feed</div>
                            <div class="text-[10px] text-slate-400">Real-world room background</div>
                        </div>
                    </div>
                    <button id="btnModalToggleCamera" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-sky-400 transition-colors cursor-pointer">
                        <span id="btnModalCameraText">AR: OFF</span>
                    </button>
                </div>

                <!-- Phone Tilt Toggle -->
                <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-950/60 border border-slate-800">
                    <div class="flex items-center gap-2.5">
                        <i id="modalTiltIcon" class="fas fa-mobile-screen-button text-emerald-400 text-sm"></i>
                        <div>
                            <div class="text-xs font-bold text-white">Phone Tilt Steer</div>
                            <div class="text-[10px] text-slate-400">Gyroscope dodging & movement</div>
                        </div>
                    </div>
                    <button id="btnModalToggleTilt" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-emerald-400 transition-colors cursor-pointer">
                        <span id="btnModalTiltText">Tilt: ON</span>
                    </button>
                </div>

                <!-- Audio Toggle -->
                <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-950/60 border border-slate-800">
                    <div class="flex items-center gap-2.5">
                        <i id="modalAudioIcon" class="fas fa-volume-up text-emerald-400 text-sm"></i>
                        <div>
                            <div class="text-xs font-bold text-white">Audio & Voice</div>
