        function onDeviceOrientation(event) {
            if (!isTiltEnabled) return;
            if (event.gamma === null || event.beta === null) return;
            if (event.gamma === undefined || event.beta === undefined) return;
            // Ignore desktop browsers that fire empty 0,0 dummy events
            if (event.gamma === 0 && event.beta === 0) return;

            hasDeviceOrientation = true;
            tiltGamma = event.gamma;
            tiltBeta = event.beta;
            if (!isTiltCalibrated && Math.abs(tiltBeta) > 10) {
                neutralBeta = tiltBeta;
                isTiltCalibrated = true;
                log(`Calibrated neutral tilt pitch: ${neutralBeta.toFixed(1)}°`);
            }
        }

        async function requestDeviceOrientationPermission() {
            if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
                try {
                    const state = await DeviceOrientationEvent.requestPermission();
                    if (state === 'granted') {
                        window.addEventListener('deviceorientation', onDeviceOrientation, true);
                        isTiltEnabled = true;
                        updateTiltUi(true);
                        showToast("Tilt steer active! Tilt phone to dodge.", "fa-mobile-screen");
                    } else {
                        isTiltEnabled = false;
                        updateTiltUi(false);
                        showToast("Tilt permission denied. Use touch/WASD.", "fa-ban");
                    }
                } catch (e) {
                    console.warn("DeviceOrientation permission error:", e);
                }
            } else {
                window.addEventListener('deviceorientation', onDeviceOrientation, true);
                isTiltEnabled = true;
                updateTiltUi(true);
            }
        }

        // --- 12. UI Buttons & Event Bindings ---
        function bindUiEvents() {
            // Lobby: Enter Arena (Instant single-click response & debounce)
            const btnEnterGame = document.getElementById('btnEnterGame');
            btnEnterGame.addEventListener('click', () => {
                if (btnEnterGame.disabled) return;
                btnEnterGame.disabled = true;
                btnEnterGame.innerHTML = '<i class="fas fa-spinner animate-spin"></i> Entering Arena...';

                // Request orientation permissions non-blockingly without delaying network join
                requestDeviceOrientationPermission().catch(e => console.warn("Orientation error:", e));

                playerName = document.getElementById('inputPlayerName').value.trim() || 'Devourer';
                const codeInput = document.getElementById('inputRoomCode').value.trim().toUpperCase();
                roomCode = codeInput || 'HOOK';
                isSoloPractice = false;

                roomCodeDisplay.textContent = `ROOM: ${roomCode}`;
                shareUrlText.textContent = `${window.location.origin}/ar-mini-games/devo-wars?room=${roomCode}`;
                const waitingRoomEl = document.getElementById('waitingRoomCodeText');
                if (waitingRoomEl) waitingRoomEl.textContent = roomCode;

                // Instant UI feedback on single click: hide lobby, show waiting overlay
                lobbyModal.classList.add('hidden');
                waitingOverlay.classList.remove('hidden');

                connectSignalR().catch(err => {
                    console.error("connectSignalR error:", err);
                    btnEnterGame.disabled = false;
                    btnEnterGame.innerHTML = '<i class="fas fa-play"></i> Enter Arena';
                });
            });

            // Lobby: Practice Mode (Instant single-click response)
            const btnPracticeSolo = document.getElementById('btnPracticeSolo');
            btnPracticeSolo.addEventListener('click', () => {
                if (btnPracticeSolo.disabled) return;
                btnPracticeSolo.disabled = true;
                btnPracticeSolo.innerHTML = '<i class="fas fa-spinner animate-spin"></i> Starting Practice...';

                // Request orientation permissions non-blockingly
                requestDeviceOrientationPermission().catch(e => console.warn("Orientation error:", e));

                playerName = document.getElementById('inputPlayerName').value.trim() || 'Devourer';
                isSoloPractice = true;
                roomCode = 'SOLO';
                roomCodeDisplay.textContent = 'MODE: SOLO PRACTICE';

                lobbyModal.classList.add('hidden');
                promptMatchReady();

                setTimeout(() => {
                    btnPracticeSolo.disabled = false;
                    btnPracticeSolo.innerHTML = 'Practice Mode (Solo Target Dummy)';
                }, 500);
            });

            // Lobby: Random Room Generator
            document.getElementById('btnRandomRoom').addEventListener('click', () => {
                const words = ['HOOK', 'PUDG', 'DEVO', 'GUTT', 'DUEL', 'WAR1', 'WAR2', 'BITE'];
                const rand = words[Math.floor(Math.random() * words.length)];
                document.getElementById('inputRoomCode').value = rand;
            });

            // Copy Room Link
            const copyHandler = () => {
                const url = `${window.location.origin}/ar-mini-games/devo-wars?room=${roomCode}`;
                navigator.clipboard.writeText(url).then(() => {
                    showToast("Room link copied to clipboard!", "fa-check");
                }).catch(() => {
                    showToast(url);
                });
            };
            document.getElementById('btnCopyRoom').addEventListener('click', copyHandler);
            document.getElementById('btnShareCopy').addEventListener('click', copyHandler);

            // Cancel Waiting: restore Enter button and re-show lobby
            document.getElementById('btnCancelWaiting').addEventListener('click', () => {
                waitingOverlay.classList.add('hidden');
                lobbyModal.classList.remove('hidden');
                if (btnEnterGame) {
                    btnEnterGame.disabled = false;
                    btnEnterGame.innerHTML = '<i class="fas fa-play"></i> Enter Arena';
                }
                if (hub) {
                    try { hub.stop(); } catch (e) {}
                }
            });

            // Play Again (Rematch)
            document.getElementById('btnPlayAgain').addEventListener('click', () => {
                matchOverModal.classList.add('hidden');
                if (isSoloPractice) {
                    scoreLocal = 0;
                    scoreRemote = 0;
                    updateScoreboard();
                    promptMatchReady();
                } else if (hub) {
                    hub.invoke("ResetMatch", roomCode).catch(err => log("ResetMatch error:", err));
                }
            });

            // AR Pre-Match Ready Prompt Choices
            document.getElementById('btnChooseArYes').addEventListener('click', async () => {
                await handleReadyChoice(true);
            });
            document.getElementById('btnChooseArNo').addEventListener('click', async () => {
                await handleReadyChoice(false);
            });

            // Room Full: Create Suggested New Room & Enter
            document.getElementById('btnCreateNewRoomFromFull')?.addEventListener('click', async () => {
                const suggestedCode = document.getElementById('suggestedNewRoomCode')?.textContent.trim() || `WAR${Math.floor(10 + Math.random() * 89)}`;
                if (roomFullModal) roomFullModal.classList.add('hidden');
                const inputEl = document.getElementById('inputRoomCode');
                if (inputEl) inputEl.value = suggestedCode;
                roomCode = suggestedCode;

                try {
                    const newUrl = `${window.location.origin}/ar-mini-games/devo-wars?room=${suggestedCode}`;
                    window.history.replaceState({ path: newUrl }, '', newUrl);
                } catch (e) {}

                isSoloPractice = false;
                waitingOverlay.classList.remove('hidden');
                lobbyModal.classList.add('hidden');
                await connectSignalR();
            });

            // Room Full: Change Code in Lobby
            document.getElementById('btnCloseRoomFull')?.addEventListener('click', () => {
                if (roomFullModal) roomFullModal.classList.add('hidden');
                if (lobbyModal) lobbyModal.classList.remove('hidden');
                const inputEl = document.getElementById('inputRoomCode');
                if (inputEl) {
                    inputEl.focus();
                    inputEl.select();
                }
            });

            // Floating Settings Button & Modal
            const openSettings = () => {
                settingsModal.classList.remove('hidden');
            };
            const closeSettings = () => {
                settingsModal.classList.add('hidden');
            };

            btnOpenSettings.addEventListener('click', (e) => {
                e.stopPropagation();
                openSettings();
            });
            btnCloseSettings.addEventListener('click', (e) => {
                e.stopPropagation();
                closeSettings();
            });
            btnResumeSettings.addEventListener('click', (e) => {
                e.stopPropagation();
                closeSettings();
            });

            // Modal: View Mode Toggle
            document.getElementById('btnModalToggleView').addEventListener('click', (e) => {
                e.stopPropagation();
                toggleViewMode();
            });

            // Modal: Camera AR Toggle
            document.getElementById('btnModalToggleCamera').addEventListener('click', async (e) => {
                e.stopPropagation();
                await toggleCamera();
            });

            // Modal: Tilt Steer Toggle
            document.getElementById('btnModalToggleTilt').addEventListener('click', async (e) => {
                e.stopPropagation();
                await toggleTiltMode();
            });

            // Modal: Audio Toggle
            document.getElementById('btnModalToggleAudio').addEventListener('click', (e) => {
                e.stopPropagation();
                isAudioMuted = !isAudioMuted;
                updateAudioUi(isAudioMuted);
                showToast(isAudioMuted ? "Audio Muted" : "Audio Active", isAudioMuted ? "fa-volume-xmark" : "fa-volume-up");
            });

            // Modal: Recenter & Calibrate
            document.getElementById('btnModalResetCenter').addEventListener('click', (e) => {
                e.stopPropagation();
                neutralBeta = tiltBeta || 45;
                isTiltCalibrated = true;
                resetCamera();
                showToast("View & Tilt Calibrated!", "fa-crosshairs");
            });

            // Legacy / Top Header buttons if present
            const btnView = document.getElementById('btnToggleView');
            if (btnView) {
                ['pointerdown', 'touchstart', 'mousedown'].forEach(evt => {
                    btnView.addEventListener(evt, (e) => e.stopPropagation(), { passive: false });
                });
                btnView.addEventListener('click', (e) => {
                    e.stopPropagation();
                    toggleViewMode();
                });
            }

            const btnTilt = document.getElementById('btnToggleTilt');
            if (btnTilt) {
                ['pointerdown', 'touchstart', 'mousedown'].forEach(evt => {
                    btnTilt.addEventListener(evt, (e) => e.stopPropagation(), { passive: false });
                });
                btnTilt.addEventListener('click', async (e) => {
                    e.stopPropagation();
                    await toggleTiltMode();
                });
            }

            const btnCam = document.getElementById('btnToggleCamera');
            if (btnCam) {
                ['pointerdown', 'touchstart', 'mousedown'].forEach(evt => {
                    btnCam.addEventListener(evt, (e) => e.stopPropagation(), { passive: false });
                });
                btnCam.addEventListener('click', (e) => {
                    e.stopPropagation();
                    toggleCamera();
                });
            }

            const btnAud = document.getElementById('btnToggleAudio');
            if (btnAud) {
                ['pointerdown', 'touchstart', 'mousedown'].forEach(evt => {
                    btnAud.addEventListener(evt, (e) => e.stopPropagation(), { passive: false });
                });
                btnAud.addEventListener('click', (e) => {
                    e.stopPropagation();
                    isAudioMuted = !isAudioMuted;
                    updateAudioUi(isAudioMuted);
                    showToast(isAudioMuted ? "Audio Muted" : "Audio Active", isAudioMuted ? "fa-volume-xmark" : "fa-volume-up");
                });
            }

            const btnRst = document.getElementById('btnResetCenter');
            if (btnRst) {
                ['pointerdown', 'touchstart', 'mousedown'].forEach(evt => {
                    btnRst.addEventListener(evt, (e) => e.stopPropagation(), { passive: false });
                });
                btnRst.addEventListener('click', (e) => {
                    e.stopPropagation();
                    neutralBeta = tiltBeta || 45;
                    isTiltCalibrated = true;
                    resetCamera();
                    showToast("View & Tilt Calibrated!", "fa-crosshairs");
                });
            }

            // Check Orientation on start
            checkOrientation();
        }

        // --- Bootstrap Game ---
        window.addEventListener('DOMContentLoaded', () => {
            log("Initializing DevoWarsAR 1v1...");
            if (video) {
                video.setAttribute('autoplay', '');
                video.setAttribute('muted', '');
                video.setAttribute('playsinline', '');
                video.setAttribute('webkit-playsinline', 'true');
            }
            preloadSounds();
            initThreeEngine();
            setupInteractionHandlers();
            bindUiEvents();
            loadDevourerModels();

            // Auto-join if room param in URL
            if (roomCode.length >= 2) {
                document.getElementById('inputRoomCode').value = roomCode;
            }
        });

        // Test & Inspection Interface
        window.__devoWarsTest = {
            getLocalDevo: () => localDevo,
            getOppDevo: () => oppDevo,
            getLocalTarget: () => localTarget,
            getKeysDown: () => keysDown,
            getActiveHooks: () => activeHooks,
            getHookCooldown: () => ({ active: hookCooldown, timer: hookCooldownTimer }),
            getMoveMarker: () => moveMarkerMesh,
            getBounds: () => BOUNDS,
            isMatchActive: () => matchActive,
            isLocalMoving: () => isLocalMoving,
            isStunned: () => isLocalHookStunned,
            getCurrentLocalAction: () => currentLocalActionName
        };

    })();
    </script>
</body>
</html>
