    <!-- TOAST NOTIFICATION POPUP -->
    <div id="toastNotification" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-slate-900/95 border border-sky-500/40 backdrop-blur-xl px-4 py-2 rounded-full text-xs font-bold text-white shadow-2xl opacity-0 transition-opacity duration-300 pointer-events-none flex items-center gap-2">
        <i id="toastIcon" class="fas fa-info-circle text-sky-400"></i>
        <span id="toastText">Notification message</span>
    </div>

    <!-- EXTERNAL JS DEPENDENCIES -->
    <script src="/lib/three/three.r16x.bundle.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <!-- CORE DEVOWARSAR REAL-TIME SCRIPT -->
    <script>
    (function () {
        'use strict';

        // --- Logging Utility ---
        const log = (msg, ...args) => console.log(`[DevoWarsAR] ${msg}`, ...args);

        // --- Game Arena Boundaries (Meters) ---
        // Player 1 / Local is on South Bank (Z: +0.35 to +1.15)
        // Opponent is on North Bank (Z: -1.15 to -0.35)
        // River runs at Z: -0.25 to +0.25
        const BOUNDS = {
            minX: -1.35,
            maxX: 1.35,
            minZ: 0.38,
            maxZ: 1.25,
            defaultSpawnZ: 0.85,
            oppSpawnZ: -0.85
        };

        // --- State Management ---
        let roomCode = '@initialRoom'.trim().toUpperCase() || 'HOOK';
        let playerName = 'Devourer';
        let playerId = sessionStorage.getItem('devo_player_id');
        if (!playerId) {
            playerId = 'p_' + Math.random().toString(36).substring(2, 11) + Date.now().toString(36);
            try { sessionStorage.setItem('devo_player_id', playerId); } catch (e) {}
        }
        let playerSlot = 1; // 1 = Host (South), 2 = Challenger (North, flipped)
        let isSoloPractice = false;
        let matchActive = false;
        let scoreLocal = 0;
        let scoreRemote = 0;

        // Three.js Scene Variables
        let scene, camera, renderer, controls, clock;
        let groundPlane, shadowPlane, riverMesh, riverMaterial, studioGrid;
        let riverBedMesh = null, riverStones = [], riverLilyPads = [];

        // Devourer Character Meshes & Mixers
        let localDevo = null, localMixer = null, localActions = {}, currentLocalAction = null;
        let oppDevo = null, oppMixer = null, oppActions = {}, currentOppAction = null;
        let currentLocalActionName = 'idle', currentOppActionName = 'idle';
        let isLocalMoving = false, isLocalWalking = false;
        let localTarget = new THREE.Vector3(0, 0, BOUNDS.defaultSpawnZ);
        let oppTarget = new THREE.Vector3(0, 0, BOUNDS.oppSpawnZ);
        let isOppMoving = false;

        // Aiming & Hook Projectile System
        let isAiming = false;
        let aimStartTouch = new THREE.Vector2();
        let aimWorldPoint = new THREE.Vector3();
        let trajectoryLine = null;
        let aimCrosshair = null;
        let hookCooldown = false;
        let hookCooldownTimer = 0;
        const HOOK_COOLDOWN_SEC = 2.8;
        const HOOK_SPEED = 6.2; // units per second
        const HOOK_RANGE = 2.4; // Reach far across river

        // Active Flying Hooks Collection
        // hook = { mesh, chainMesh, startPos, dir, distTraveled, maxDist, state: 'flying'|'reeling', isLocal, targetDevo }
        let activeHooks = [];

        // Practice Mode Sparring Bot State
        let dummyPatrolDir = 1; // 1 = right (+X), -1 = left (-X)
        let dummyPatrolSpeed = 1.3;
        let dummyPauseTimer = 0;
        let dummyNextHookTimer = 3.5;
        let isDummyRespawning = false;

        // Audio System
        let isAudioMuted = false;
        const audioCache = {};
        const SOUND_FILES = {
            hookCast: '/sounds/devourer/hook_cast.ogg',
            hookImpact: '/sounds/devourer/hook_impact.ogg',
            hookAbility: '/sounds/devourer/hook_ability.ogg',
            noMana: '/sounds/devourer/no_mana.ogg',
            death: '/sounds/devourer/death.ogg',
            fart: '/sounds/devourer/fart.ogg',
            move1: '/sounds/devourer/move_1.ogg',
            move2: '/sounds/devourer/move_2.ogg',
            move3: '/sounds/devourer/move_3.ogg',
            move4: '/sounds/devourer/move_4.ogg',
            tauntPrior: '/sounds/devourer/taunt_prior.ogg',
            tauntAfter: '/sounds/devourer/taunt_after.ogg',
            select1: '/sounds/devourer/select_1.ogg',
            heroSelect: '/sounds/devourer/hero_select.ogg'
        };

        // Camera Feed AR
        let isCameraActive = false;
        let mediaStream = null;

        // Camera Perspective Mode: 'tabletop' | 'pov'
        let cameraMode = 'tabletop';

        // Input & Motion State (Phone Tilt & PC Keyboard)
        let isTiltEnabled = true;
        let hasDeviceOrientation = false; // Only true when genuine mobile hardware sensor sends non-zero pitch/roll
        let tiltGamma = 0;
        let tiltBeta = 0;
        let neutralBeta = 45;
        let isTiltCalibrated = false;
        let keysDown = {};
        let moveMarkerMesh = null; // Visual 3D pulse ring on Right-Click move
        let isLocalHookStunned = false; // Incapacitated while being hooked and reeled across river
        let localRespawnTimeout = null;
        let oppRespawnTimeout = null;

        // SignalR Hub Connection
        let hub = null;
        let lastSyncTime = 0;

        // DOM Elements
        const canvas = document.getElementById('gameCanvas');
        const container = document.getElementById('canvasContainer');
        const video = document.getElementById('cameraFeed');
        const lobbyModal = document.getElementById('lobbyModal');
        const waitingOverlay = document.getElementById('waitingOverlay');
        const matchOverModal = document.getElementById('matchOverModal');
        const arReadyModal = document.getElementById('arReadyModal');
        const roomFullModal = document.getElementById('roomFullModal');
        const settingsModal = document.getElementById('settingsModal');
        const btnOpenSettings = document.getElementById('btnOpenSettings');
        const btnCloseSettings = document.getElementById('btnCloseSettings');
        const btnResumeSettings = document.getElementById('btnResumeSettings');
        const aimHintBanner = document.getElementById('aimHintBanner');
        const cooldownBanner = document.getElementById('cooldownBanner');
        const cooldownTimeText = document.getElementById('cooldownTimeText');
        const combatTextLayer = document.getElementById('combatTextLayer');
        const scoreP1El = document.getElementById('scoreP1');
        const scoreP2El = document.getElementById('scoreP2');
        const roomCodeDisplay = document.getElementById('roomCodeDisplay');
        const shareUrlText = document.getElementById('shareUrlText');
        const toastEl = document.getElementById('toastNotification');
        const toastText = document.getElementById('toastText');

        // Preload Audio Buffers
        function preloadSounds() {
            Object.entries(SOUND_FILES).forEach(([key, path]) => {
                const audio = new Audio(path);
                audio.preload = 'auto';
                audioCache[key] = audio;
            });
        }

        function playSound(soundKey, volume = 0.8) {
            if (isAudioMuted) return;
            try {
                const baseAudio = audioCache[soundKey];
                if (baseAudio) {
                    const clone = baseAudio.cloneNode();
                    clone.volume = volume;
                    clone.play().catch(() => {});
                }
            } catch (e) {
                console.warn('Audio play error:', e);
            }
        }

        function playRandomMoveSound() {
            // Silenced per user request: camera rotation & movement should not play voicelines
        }

        function showToast(msg, iconClass = 'fa-info-circle') {
            toastText.textContent = msg;
            document.getElementById('toastIcon').className = `fas ${iconClass} text-sky-400`;
            toastEl.classList.remove('opacity-0');
            clearTimeout(toastEl._timer);
            toastEl._timer = setTimeout(() => toastEl.classList.add('opacity-0'), 2600);
        }

        // --- Orientation Guard & Fullscreen (Orientation Restriction Lifted!) ---
        function checkOrientation() {
            // Unrestricted orientation: players can freely play in landscape or portrait!
        }

        function requestFullscreenIfNeeded() {
            const el = document.documentElement;
            if (!document.fullscreenElement && !document.webkitFullscreenElement) {
                if (el.requestFullscreen) {
                    el.requestFullscreen().catch(() => {});
                } else if (el.webkitRequestFullscreen) {
                    el.webkitRequestFullscreen();
                }
            }
        }

        // --- 1. Three.js Engine Setup ---
        function initThreeEngine() {
            clock = new THREE.Clock();
            scene = new THREE.Scene();

            const aspect = container.clientWidth / container.clientHeight;
            // 52-degree FOV tilted down at the table
            camera = new THREE.PerspectiveCamera(52, aspect, 0.1, 100);
            resetCamera();

            renderer = new THREE.WebGLRenderer({
                canvas: canvas,
                alpha: true,
                antialias: true,
                powerPreference: 'high-performance'
            });
            renderer.setSize(container.clientWidth, container.clientHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            if (window.KongorViewerCore) {
                window.KongorViewerCore.configureRendererColorSpace(renderer);
            } else if ('outputColorSpace' in renderer && THREE.SRGBColorSpace) {
                renderer.outputColorSpace = THREE.SRGBColorSpace;
            }

            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.08;
            controls.maxPolarAngle = Math.PI / 2 - 0.05;
            controls.minDistance = 0.8;
            controls.maxDistance = 5.0;
            controls.enablePan = false;
            controls.target.set(0, 0.25, 0); // Table origin

            // Configure OrbitControls to avoid intercepting Left-Click Hook & Right-Click Move
            controls.mouseButtons = {
                LEFT: null, // Left click reserved for Hooking (or Alt/Shift + Left drag for camera orbit)
                MIDDLE: THREE.MOUSE.ROTATE, // Middle click & drag rotates camera
                RIGHT: null // Right click reserved for Movement
            };
            controls.touches = {
                ONE: THREE.TOUCH.NONE, // Single touch reserved for in-game movement & hooking
                TWO: THREE.TOUCH.DOLLY_ROTATE // Two-finger touch pinches & rotates
            };

            // Lighting Setup
            const hemiLight = new THREE.HemisphereLight(0xffffff, 0x334155, 1.1);
            hemiLight.position.set(0, 10, 0);
            scene.add(hemiLight);

            const sunLight = new THREE.DirectionalLight(0xffffff, 1.4);
            sunLight.position.set(3, 7, 4);
            sunLight.castShadow = true;
            sunLight.shadow.mapSize.width = 1024;
            sunLight.shadow.mapSize.height = 1024;
            sunLight.shadow.camera.near = 0.2;
            sunLight.shadow.camera.far = 15;
            scene.add(sunLight);

            // Ambient River Glow
            const riverLight = new THREE.PointLight(0x0284c7, 1.5, 3);
            riverLight.position.set(0, 0.3, 0);
            scene.add(riverLight);

            setupArenaEnvironment();
            setupAimVisualizer();

            window.addEventListener('resize', onWindowResize);
            window.addEventListener('orientationchange', () => setTimeout(onWindowResize, 100));

            renderer.setAnimationLoop(renderLoop);
            document.addEventListener('visibilitychange', () => {
                if (!renderer) return;
                if (document.hidden && (!renderer.xr || !renderer.xr.isPresenting)) {
                    renderer.setAnimationLoop(null);
                } else if (!document.hidden) {
                    if (clock) clock.getDelta();
                    renderer.setAnimationLoop(renderLoop);
                }
            });
        }

        function resetCamera() {
            if (cameraMode === 'pov') {
                updatePovCamera();
                return;
            }
            const isLandscape = window.innerWidth > window.innerHeight;
            if (isLandscape) {
                // Wider lateral stadium perspective for landscape
                camera.position.set(0, 2.2, 2.0);
            } else {
                // High-angle portrait tabletop perspective looking directly across the river
                camera.position.set(0, 2.7, 2.4);
            }
            camera.lookAt(0, 0.05, 0);
            if (controls) {
                controls.target.set(0, 0.05, 0);
                controls.enabled = (cameraMode === 'tabletop' && !isCameraActive);
            }
        }

        function updatePovCamera() {
            if (!localDevo) return;
            // Over-the-shoulder POV: Offsets camera over right shoulder with clear forward line of sight
            camera.position.set(
                localDevo.position.x + 0.36,
                localDevo.position.y + 0.46,
                localDevo.position.z + 0.72
            );
            camera.lookAt(
                localDevo.position.x + 0.12,
                0.16,
                -1.2
            );
        }

        // --- 2. Arena Environment (River + Banks) ---
        function createRiverbedTexture() {
            const cvs = document.createElement('canvas');
            cvs.width = 512;
            cvs.height = 128;
            const ctx = cvs.getContext('2d');

            // Dark aquatic sediment base with subtle channel depth gradient
            const grad = ctx.createLinearGradient(0, 0, 0, 128);
            grad.addColorStop(0.0, '#081e2b');
            grad.addColorStop(0.5, '#030f17');
            grad.addColorStop(1.0, '#081e2b');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 512, 128);

            // Natural fine river pebbles, silt & gravel (400 fine stones)
            const pebbleColors = [
                '#0f2838', '#153549', '#1c425a', '#0b1d28', '#173630', 
                '#253a4b', '#182f3d', '#1f3c4c', '#122623', '#234454'
            ];
            for (let i = 0; i < 400; i++) {
                const px = Math.random() * 512;
                const py = Math.random() * 128;
                const rx = 1.2 + Math.random() * 3.2;
                const ry = 0.9 + Math.random() * 2.2;
                const rot = Math.random() * Math.PI;

                ctx.save();
                ctx.translate(px, py);
                ctx.rotate(rot);
                ctx.fillStyle = pebbleColors[Math.floor(Math.random() * pebbleColors.length)];
                ctx.beginPath();
                ctx.ellipse(0, 0, rx, ry, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            const texture = new THREE.CanvasTexture(cvs);
            texture.wrapS = THREE.RepeatWrapping;
            texture.wrapT = THREE.RepeatWrapping;
            texture.repeat.set(6, 1);
            return texture;
        }

        function setupRiverBanksAndStones(targetScene) {
            const stoneGeo = new THREE.DodecahedronGeometry(1, 1);
            const slateMat = new THREE.MeshStandardMaterial({
                color: 0x334155, // River slate
                roughness: 0.8,
                metalness: 0.1
            });

            const mossStoneMat = new THREE.MeshStandardMaterial({
                color: 0x1e3a34, // Moss-covered river stone
                roughness: 0.85,
                metalness: 0.1
            });

            const graniteMat = new THREE.MeshStandardMaterial({
                color: 0x475569, // Smooth granite boulder
                roughness: 0.7,
                metalness: 0.15
            });

            // Naturally clustered river rocks along South Bank (Z = +0.27)
            for (let i = 0; i < 20; i++) {
                const x = -1.65 + (i / 19) * 3.3 + (Math.random() - 0.5) * 0.08;
                const z = 0.272 + (Math.random() - 0.5) * 0.02;
                const s = 0.014 + Math.random() * 0.024;
                const mat = (i % 3 === 0) ? mossStoneMat : ((i % 2 === 0) ? graniteMat : slateMat);
                const stone = new THREE.Mesh(stoneGeo, mat);
                stone.scale.set(s * (0.8 + Math.random() * 0.5), s * 0.5, s * (0.8 + Math.random() * 0.5));
                stone.position.set(x, s * 0.3, z);
                stone.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
                stone.castShadow = false;
                stone.receiveShadow = true;
                targetScene.add(stone);
                riverStones.push(stone);
            }

            // Naturally clustered river rocks along North Bank (Z = -0.27)
            for (let i = 0; i < 20; i++) {
                const x = -1.65 + (i / 19) * 3.3 + (Math.random() - 0.5) * 0.08;
                const z = -0.272 + (Math.random() - 0.5) * 0.02;
                const s = 0.014 + Math.random() * 0.024;
                const mat = (i % 3 === 1) ? mossStoneMat : ((i % 2 === 1) ? graniteMat : slateMat);
                const stone = new THREE.Mesh(stoneGeo, mat);
                stone.scale.set(s * (0.8 + Math.random() * 0.5), s * 0.5, s * (0.8 + Math.random() * 0.5));
                stone.position.set(x, s * 0.3, z);
                stone.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
                stone.castShadow = false;
                stone.receiveShadow = true;
                targetScene.add(stone);
                riverStones.push(stone);
            }
        }

        function setupLilyPads(targetScene) {
            const padGeo = new THREE.CircleGeometry(0.04, 20);
            const padMat = new THREE.MeshStandardMaterial({
                color: 0x15803d, // Emerald river lily pad
                roughness: 0.35,
                metalness: 0.1,
                side: THREE.DoubleSide
            });

            const budGeo = new THREE.ConeGeometry(0.009, 0.018, 6);
            const budMat = new THREE.MeshStandardMaterial({
                color: 0xf472b6, // Lotus blossom flower
                roughness: 0.3
            });

            for (let i = 0; i < 6; i++) {
                const padGroup = new THREE.Group();
                const pad = new THREE.Mesh(padGeo, padMat);
                pad.rotation.x = -Math.PI / 2;
                pad.receiveShadow = true;
                padGroup.add(pad);

                if (i % 2 === 0) {
                    const bud = new THREE.Mesh(budGeo, budMat);
                    bud.position.set(0.01, 0.01, 0.01);
                    padGroup.add(bud);
                }

                const startX = -1.5 + Math.random() * 3.0;
                const startZ = -0.16 + Math.random() * 0.32;
                padGroup.position.set(startX, 0.007, startZ);

                padGroup.userData = {
                    speed: 0.06 + Math.random() * 0.05,
                    phase: Math.random() * Math.PI * 2
                };

                targetScene.add(padGroup);
                riverLilyPads.push(padGroup);
            }
        }

        function setupArenaEnvironment() {
            // Invisible shadow receiver planes for camera passthrough (flanking the river)
            const shadowMat = new THREE.ShadowMaterial({ opacity: 0.35 });
            
            // South Bank Shadow Receiver (Local Player side)
            const shadowSouthGeo = new THREE.PlaneGeometry(12, 6);
            const shadowSouth = new THREE.Mesh(shadowSouthGeo, shadowMat);
            shadowSouth.rotation.x = -Math.PI / 2;
            shadowSouth.position.set(0, -0.0005, 3.28);
            shadowSouth.receiveShadow = true;
            scene.add(shadowSouth);

            // North Bank Shadow Receiver (Opponent side)
            const shadowNorthGeo = new THREE.PlaneGeometry(12, 6);
            const shadowNorth = new THREE.Mesh(shadowNorthGeo, shadowMat);
            shadowNorth.rotation.x = -Math.PI / 2;
            shadowNorth.position.set(0, -0.0005, -3.28);
            shadowNorth.receiveShadow = true;
            scene.add(shadowNorth);
            shadowPlane = shadowSouth; // Maintain reference for camera toggle visibility

            // Infinite raycast plane for touches
            const rayGeo = new THREE.PlaneGeometry(50, 50);
            const rayMat = new THREE.MeshBasicMaterial({ transparent: true, opacity: 0 });
            groundPlane = new THREE.Mesh(rayGeo, rayMat);
            groundPlane.rotation.x = -Math.PI / 2;
            scene.add(groundPlane);

            // Studio Neon Grid (shown when camera is off)
            studioGrid = new THREE.GridHelper(4.5, 18, 0x0284c7, 0x1e293b);
            studioGrid.position.y = -0.001;
            scene.add(studioGrid);

            // 1. Submerged Riverbed Depth Channel (with underwater gravel & pebbles)
            const riverBedGeo = new THREE.PlaneGeometry(3.6, 0.52, 32, 8);
            const riverBedTexture = createRiverbedTexture();
            const riverBedMat = new THREE.MeshStandardMaterial({
                map: riverBedTexture,
                roughness: 0.9,
                metalness: 0.1
            });
            riverBedMesh = new THREE.Mesh(riverBedGeo, riverBedMat);
            riverBedMesh.rotation.x = -Math.PI / 2;
            riverBedMesh.position.set(0, -0.012, 0);
            scene.add(riverBedMesh);

            // 2. Realistic Animated Water Surface (Physical Waves + Flowing Caustics + Shore Foam)
            const riverGeo = new THREE.PlaneGeometry(3.6, 0.52, 128, 32);
            riverMaterial = new THREE.ShaderMaterial({
                uniforms: {
                    uTime: { value: 0 }
                },
                vertexShader: `
                    uniform float uTime;
                    varying vec2 vUv;
                    varying vec3 vWorldPos;
                    varying vec3 vNormal;

                    void main() {
                        vUv = uv;
                        vec3 pos = position;
                        
                        // Wave displacement in world units
                        float w1 = sin(pos.x * 12.0 - uTime * 3.0) * 0.003;
                        float w2 = cos(pos.y * 24.0 + uTime * 2.2) * 0.002;
                        float w3 = sin((pos.x * 8.0 + pos.y * 14.0) - uTime * 2.5) * 0.0025;
                        pos.z += (w1 + w2 + w3);
                        
                        vec4 worldPosition = modelMatrix * vec4(pos, 1.0);
                        vWorldPos = worldPosition.xyz;
                        
                        // Analytical wave normal
                        float dwdx = cos(pos.x * 12.0 - uTime * 3.0) * 0.036 + cos((pos.x * 8.0 + pos.y * 14.0) - uTime * 2.5) * 0.02;
                        float dwdy = -sin(pos.y * 24.0 + uTime * 2.2) * 0.048 + cos((pos.x * 8.0 + pos.y * 14.0) - uTime * 2.5) * 0.035;
                        vec3 displacedNormal = normalize(vec3(-dwdx, -dwdy, 1.0));
                        vNormal = normalize((modelMatrix * vec4(displacedNormal, 0.0)).xyz);
                        
                        gl_Position = projectionMatrix * viewMatrix * worldPosition;
                    }
                `,
                fragmentShader: `
                    uniform float uTime;
                    varying vec2 vUv;
                    varying vec3 vWorldPos;
                    varying vec3 vNormal;

                    // Isotropic fine cellular caustic network
                    float getCaustic(vec2 p, float t) {
                        vec2 p1 = p * 18.0;
                        float c1 = sin(p1.x * 1.5 + sin(p1.y * 1.3 + t * 2.8));
                        float c2 = cos(p1.y * 1.5 + sin(p1.x * 1.3 - t * 2.8));
                        float c3 = sin((p1.x + p1.y) * 1.3 + t * 3.2);
                        float net = abs(c1 + c2 + c3);
                        return pow(clamp(1.0 - net * 0.38, 0.0, 1.0), 3.5);
                    }

                    void main() {
                        // Isotropic downstream water flow using world-space coordinates
                        vec2 flow1 = vec2(vWorldPos.x - uTime * 0.16, vWorldPos.z);
                        vec2 flow2 = vec2(vWorldPos.x * 1.25 - uTime * 0.22 + 0.35, vWorldPos.z * 1.2);

                        float c1 = getCaustic(flow1, uTime);
                        float c2 = getCaustic(flow2, uTime * 1.12);
                        float caustics = clamp(c1 * 0.65 + c2 * 0.55, 0.0, 1.0);

                        // River depth gradient (deep sapphire center, turquoise shores)
                        float edgeDist = min(vUv.y, 1.0 - vUv.y) * 2.0;
                        vec3 deepWater = vec3(0.012, 0.24, 0.44);
                        vec3 shallowWater = vec3(0.05, 0.54, 0.70);
                        vec3 waterColor = mix(shallowWater, deepWater, smoothstep(0.08, 0.65, edgeDist));

                        // Dynamic shoreline lapping foam
                        float foamWave = sin(vWorldPos.x * 22.0 - uTime * 3.8) * 0.5 + 0.5;
                        float foamLimit = 0.05 + foamWave * 0.035;
                        float foam = smoothstep(foamLimit, 0.005, edgeDist);
                        vec3 foamColor = vec3(0.92, 0.97, 1.0);

                        // Downstream current streaks in middle channel
                        float currentStreak = pow(sin(vWorldPos.z * 40.0 + sin(vWorldPos.x * 14.0 - uTime * 4.2) * 1.6) * 0.5 + 0.5, 4.0);
                        float centerMask = smoothstep(0.25, 0.8, edgeDist);
                        vec3 currentGlint = vec3(0.2, 0.75, 0.95) * currentStreak * centerMask * 0.22;

                        // Specular sunlight sparkle
                        vec3 viewDir = normalize(cameraPosition - vWorldPos);
                        vec3 lightDir = normalize(vec3(0.6, 1.4, 0.8));
                        vec3 halfVec = normalize(lightDir + viewDir);
                        float spec = pow(max(dot(vNormal, halfVec), 0.0), 36.0) * 0.85;

                        // Fresnel reflection & gentle transparency
                        float fresnel = pow(1.0 - max(dot(vNormal, viewDir), 0.0), 2.8);
                        float alpha = mix(0.72, 0.94, fresnel + foam * 0.22);

                        vec3 col = mix(waterColor, foamColor, foam * 0.75);
                        col += caustics * vec3(0.32, 0.80, 0.96) * (1.0 - foam * 0.5);
                        col += currentGlint;
                        col += spec * vec3(1.0, 1.0, 0.92);

                        gl_FragColor = vec4(col, alpha);
                    }
                `,
                transparent: true,
                side: THREE.DoubleSide,
                depthWrite: false
            });

            riverMesh = new THREE.Mesh(riverGeo, riverMaterial);
            riverMesh.rotation.x = -Math.PI / 2;
            riverMesh.position.set(0, 0.005, 0);
            scene.add(riverMesh);

            // 3. Subtle Glowing River Shorelines (Blue South Shore, Red North Shore)
            const shoreSouthGeo = new THREE.BoxGeometry(3.6, 0.006, 0.014);
            const shoreSouthMat = new THREE.MeshStandardMaterial({
                color: 0x0284c7,
                emissive: 0x0369a1,
                emissiveIntensity: 0.5,
                roughness: 0.5
            });
            const shoreSouth = new THREE.Mesh(shoreSouthGeo, shoreSouthMat);
            shoreSouth.position.set(0, 0.004, 0.262);
            scene.add(shoreSouth);

            const shoreNorthGeo = new THREE.BoxGeometry(3.6, 0.006, 0.014);
            const shoreNorthMat = new THREE.MeshStandardMaterial({
                color: 0xb91c1c,
                emissive: 0x991b1b,
                emissiveIntensity: 0.5,
                roughness: 0.5
            });
            const shoreNorth = new THREE.Mesh(shoreNorthGeo, shoreNorthMat);
            shoreNorth.position.set(0, 0.004, -0.262);
            scene.add(shoreNorth);

            // 4. Natural River Stones & Boulders along Banks
            setupRiverBanksAndStones(scene);

            // 5. Drifting River Lily Pads & Water Blossoms
            setupLilyPads(scene);
        }

        // --- 3. Aiming Trajectory Visualizer ---
        function setupAimVisualizer() {
            const lineGeo = new THREE.BufferGeometry();
            lineGeo.setFromPoints([new THREE.Vector3(), new THREE.Vector3()]);
            const lineMat = new THREE.LineDashedMaterial({
                color: 0x4ade80, // Neon Lime Green aiming line
                dashSize: 0.08,
                gapSize: 0.04,
                linewidth: 4,
                transparent: true,
                opacity: 0.9
            });
            trajectoryLine = new THREE.Line(lineGeo, lineMat);
            trajectoryLine.visible = false;
            trajectoryLine.position.y = 0.08;
            scene.add(trajectoryLine);

            // Reticle Target Ring
            const ringGeo = new THREE.RingGeometry(0.12, 0.16, 24);
            const ringMat = new THREE.MeshBasicMaterial({
                color: 0xef4444,
                side: THREE.DoubleSide,
                transparent: true,
                opacity: 0.85
            });
            aimCrosshair = new THREE.Mesh(ringGeo, ringMat);
            aimCrosshair.rotation.x = -Math.PI / 2;
            aimCrosshair.visible = false;
            aimCrosshair.position.y = 0.01;
            scene.add(aimCrosshair);
        }

        function updateAimTrajectory(targetPoint) {
            if (!localDevo || !isAiming) {
                trajectoryLine.visible = false;
                aimCrosshair.visible = false;
                return;
            }

            const isCancelling = (targetPoint.z >= 0.05);

            const origin = localDevo.position.clone();
            origin.y = 0.25; // Hook hand height

            // Calculate direction and clamp to max hook range
            const dir = new THREE.Vector3().subVectors(targetPoint, localDevo.position);
            dir.y = 0;
            const dist = Math.min(dir.length(), HOOK_RANGE);
            dir.normalize();

            const endPoint = localDevo.position.clone().addScaledVector(dir, dist);
            endPoint.y = 0.25;

            const pts = [origin, endPoint];
            trajectoryLine.geometry.setFromPoints(pts);
            trajectoryLine.computeLineDistances();

            if (isCancelling) {
                trajectoryLine.material.color.setHex(0xef4444); // Red when cancelling
                aimCrosshair.material.color.setHex(0xef4444);
                aimHintBanner.innerHTML = '<i class="fas fa-ban text-[10px] text-rose-400"></i><span class="text-rose-300">RELEASE TO CANCEL HOOK</span>';
            } else {
                trajectoryLine.material.color.setHex(0x4ade80); // Neon Lime Green when aiming across river
                aimCrosshair.material.color.setHex(0x38bdf8);
                aimHintBanner.innerHTML = '<i class="fas fa-crosshairs animate-spin text-[10px] text-sky-400"></i><span>RELEASE TO FLING HOOK!</span>';
            }

            trajectoryLine.visible = true;
            aimCrosshair.position.set(endPoint.x, 0.015, endPoint.z);
            aimCrosshair.visible = true;
        }

        // --- 4. Devourer 3D Model Loading ---
        async function loadDevourerModels() {
            log("Streaming Oni Devourer 3D assets...");
            const loader = new THREE.GLTFLoader();

            let buffer = null;
            const candidateUrls = [
                '/assets/prebaked/models/devourer_oni.glb',
                '/api/v1/assets/3d/hero/devourer/alt2'
            ];

            for (const url of candidateUrls) {
                try {
                    const res = await fetch(url);
                    if (res.ok) {
                        buffer = await res.arrayBuffer();
                        log(`Loaded model buffer from ${url} (${buffer.byteLength} bytes)`);
                        break;
                    }
                } catch (e) {
                    console.warn(`Failed fetching ${url}:`, e);
                }
            }

            if (!buffer) {
                log("Failed to load model from any candidate URL.");
                showToast("Failed to load 3D model. Check network.", "fa-triangle-exclamation");
                return;
            }

            loader.parse(buffer, '', (gltf) => {
                // Setup Local Devourer (Blue Team)
                localDevo = gltf.scene;
                setupDevoAppearance(localDevo, 0x0284c7);
                localDevo.position.set(0, 0, BOUNDS.defaultSpawnZ);
                localDevo.rotation.y = Math.PI; // Face North toward the river
                scene.add(localDevo);

                localMixer = new THREE.AnimationMixer(localDevo);
                gltf.animations.forEach(clip => {
                    localActions[clip.name] = localMixer.clipAction(clip);
                });

                // Auto return to idle/walk after one-shot action (ability_1, knock_1) finishes
                localMixer.addEventListener('finished', (e) => {
                    if (!isLocalHookStunned) {
                        const isWalking = (isLocalMoving || isLocalWalking || (keysDown['KeyW'] || keysDown['KeyS'] || keysDown['KeyA'] || keysDown['KeyD']));
                        playDevoAction(true, isWalking ? 'walk_1' : 'idle', 0.25, true);
                        if (!isWalking && localDevo) localDevo.rotation.y = Math.PI;
                    }
                });

                playDevoAction(true, 'idle');

                // Parse fresh independent GLTF instance for Opponent Devourer (Red Team)
                loader.parse(buffer.slice(0), '', (gltf2) => {
                    oppDevo = gltf2.scene;
                    setupDevoAppearance(oppDevo, 0xef4444);
                    oppDevo.position.set(0, 0, BOUNDS.oppSpawnZ);
                    oppDevo.rotation.y = 0; // Face South toward local player
                    scene.add(oppDevo);

                    oppMixer = new THREE.AnimationMixer(oppDevo);
                    gltf2.animations.forEach(clip => {
                        oppActions[clip.name] = oppMixer.clipAction(clip);
                    });

                    oppMixer.addEventListener('finished', (e) => {
                        playDevoAction(false, isOppMoving ? 'walk_1' : 'idle', 0.25, true);
                        if (!isOppMoving && oppDevo) oppDevo.rotation.y = 0;
                    });

                    playDevoAction(false, 'idle');

                    // Expose debug handle
                    window.__devo = {
                        getLocal: () => localDevo,
                        getOpp: () => oppDevo,
                        playAction: (isLocal, name, loop) => playDevoAction(isLocal, name, 0.2, loop),
                        launchHook: (tx = 0, tz = -0.85) => attemptLaunchHook(new THREE.Vector3(tx, 0, tz)),
                        moveTo: (x, z) => moveLocalDevourerTo(x, z)
                    };

                    log("Both Oni Devourer gladiators placed with full morph target animations.");
                });
            });
        }

        function setupDevoAppearance(model, teamGlowColor) {
            model.scale.set(0.007, 0.007, 0.007); // Figurine scale ~35cm tall
            model.traverse((node) => {
                if (node.isMesh) {
                    node.castShadow = true;
                    node.receiveShadow = true;
                    if (node.material) {
                        node.material.side = THREE.DoubleSide;
                        node.material.roughness = 0.45;
                        node.material.metalness = 0.25;
                        node.material.morphTargets = true;
                        if (node.material.map) {
                            if (window.KongorViewerCore) {
                                window.KongorViewerCore.configureTextureColorSpace(node.material.map);
                            } else if ('colorSpace' in node.material.map && THREE.SRGBColorSpace) {
                                node.material.map.colorSpace = THREE.SRGBColorSpace;
                            }
                            node.material.map.needsUpdate = true;
                        }
                        node.material.needsUpdate = true;
                    }
                }
            });

            // Glowing team ring pedestal under feet
            const ringGeo = new THREE.RingGeometry(36, 44, 32);
            const ringMat = new THREE.MeshBasicMaterial({
                color: teamGlowColor,
                side: THREE.DoubleSide,
                transparent: true,
                opacity: 0.85
            });
            const pedestal = new THREE.Mesh(ringGeo, ringMat);
            pedestal.rotation.x = -Math.PI / 2;
            pedestal.position.y = 0.5;
            model.add(pedestal);
        }

        function playDevoAction(isLocal, name, crossFadeDuration = 0.2, loop = true) {
            const actions = isLocal ? localActions : oppActions;
            const mixer = isLocal ? localMixer : oppMixer;
            const current = isLocal ? currentLocalAction : currentOppAction;

            if (!mixer || !actions || !actions[name]) return;
            const newAction = actions[name];

            if (current === newAction && loop && newAction.isRunning()) return;

            newAction.reset();
            newAction.setLoop(loop ? THREE.LoopRepeat : THREE.LoopOnce, loop ? Infinity : 1);
            newAction.clampWhenFinished = !loop;

            if (current && current !== newAction) {
                newAction.crossFadeFrom(current, crossFadeDuration, true);
            }
            newAction.play();

            if (isLocal) {
                currentLocalAction = newAction;
                currentLocalActionName = name;
            } else {
                currentOppAction = newAction;
                currentOppActionName = name;
            }
        }

        function playAnim(actionMap, animName, loopOnce = false) {
            const isLocal = (actionMap === localActions);
            playDevoAction(isLocal, animName, 0.2, !loopOnce);
        }

        // --- 5. 3D Guttling Hook Creation & Chain Physics ---
        function createHookHeadMesh(isLocal) {
            const hookGroup = new THREE.Group();

            // Authentic Guttling Talon & Barb (Forged Dark Iron)
            const curve = new THREE.CatmullRomCurve3([
                new THREE.Vector3(0, 0, 0),
                new THREE.Vector3(0.04, 0.02, 0.08),
                new THREE.Vector3(0.10, 0, 0.16),
                new THREE.Vector3(0.06, -0.02, 0.24),
                new THREE.Vector3(-0.02, 0, 0.22)
            ]);
            const tubeGeo = new THREE.TubeGeometry(curve, 16, 0.025, 8, false);
            const hookMat = new THREE.MeshStandardMaterial({
                color: 0x475569, // Heavy slate/iron
                metalness: 0.85,
                roughness: 0.35
            });
            const mainBlade = new THREE.Mesh(tubeGeo, hookMat);
            hookGroup.add(mainBlade);

            // Sharp Barb Tip
            const coneGeo = new THREE.ConeGeometry(0.035, 0.1, 8);
            const tipMesh = new THREE.Mesh(coneGeo, hookMat);
            tipMesh.position.set(-0.02, 0, 0.25);
            tipMesh.rotation.x = Math.PI / 2;
            hookGroup.add(tipMesh);

            // Base Chain Collar Ring
            const torusGeo = new THREE.TorusGeometry(0.032, 0.012, 8, 16);
            const ringMesh = new THREE.Mesh(torusGeo, hookMat);
            ringMesh.position.set(0, 0, -0.01);
            hookGroup.add(ringMesh);

            hookGroup.userData = { isAuthentic: true };
            return hookGroup;
        }

        function spawnHook(startX, startZ, dirX, dirZ, isLocal) {
            const hookHead = createHookHeadMesh(isLocal);
            hookHead.position.set(startX, 0.25, startZ);

            const dir = new THREE.Vector3(dirX, 0, dirZ).normalize();
            hookHead.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), dir);
            scene.add(hookHead);

            // Chain visual line connecting Devourer's hand to hook
            const chainGeo = new THREE.BufferGeometry();
            chainGeo.setFromPoints([new THREE.Vector3(startX, 0.25, startZ), hookHead.position]);
            const chainMat = new THREE.LineDashedMaterial({
                color: 0x94a3b8,
                dashSize: 0.05,
                gapSize: 0.03,
                linewidth: 3
            });
            const chainLine = new THREE.Line(chainGeo, chainMat);
            scene.add(chainLine);

            const targetDevo = isLocal ? oppDevo : localDevo;

            const hookObj = {
                mesh: hookHead,
                chain: chainLine,
                origin: new THREE.Vector3(startX, 0.25, startZ),
                dir: dir,
                distTraveled: 0,
                maxDist: HOOK_RANGE,
                speed: HOOK_SPEED,
                state: 'flying', // 'flying' | 'reeling' | 'done'
                isLocal: isLocal,
                targetDevo: targetDevo,
                caughtVictim: false
            };

            activeHooks.push(hookObj);
            playSound('hookCast', 0.9);

            if (isLocal) {
                playDevoAction(true, 'ability_1', 0.1, false);
            } else {
                playDevoAction(false, 'ability_1', 0.1, false);
            }
        }

        function distPointToSegment(px, pz, ax, az, bx, bz) {
            const abx = bx - ax;
            const abz = bz - az;
            const apx = px - ax;
            const apz = pz - az;
            const ab2 = abx * abx + abz * abz;
            let t = 0;
            if (ab2 > 0.00001) {
                t = Math.max(0, Math.min(1, (apx * abx + apz * abz) / ab2));
            }
            const closeX = ax + t * abx;
            const closeZ = az + t * abz;
            return Math.hypot(px - closeX, pz - closeZ);
        }

        function updateHooks(delta) {
            for (let i = activeHooks.length - 1; i >= 0; i--) {
                const h = activeHooks[i];
                const casterPos = h.isLocal ? (localDevo ? localDevo.position : { x: 0, z: BOUNDS.defaultSpawnZ }) : (oppDevo ? oppDevo.position : { x: 0, z: BOUNDS.oppSpawnZ });
                const handPos = new THREE.Vector3(casterPos.x, 0.25, casterPos.z);

                if (h.state === 'flying') {
                    const prevX = h.mesh.position.x;
                    const prevZ = h.mesh.position.z;

                    const step = h.speed * delta;
                    h.mesh.position.addScaledVector(h.dir, step);
                    h.distTraveled += step;

                    const newX = h.mesh.position.x;
                    const newZ = h.mesh.position.z;

                    // Update chain geometry
                    h.chain.geometry.setFromPoints([handPos, h.mesh.position]);
                    h.chain.computeLineDistances();

                    // Continuous swept-volume collision detection with target Devourer
                    if (h.targetDevo) {
                        const sweptDist = distPointToSegment(
                            h.targetDevo.position.x, h.targetDevo.position.z,
                            prevX, prevZ,
                            newX, newZ
                        );

                        if (sweptDist < 0.40) {
                            // HIT REGISTERED!
                            log(`HOOK CONNECTED! Caster isLocal=${h.isLocal}, Swept dist=${sweptDist.toFixed(2)}`);
                            h.mesh.position.x = h.targetDevo.position.x;
                            h.mesh.position.z = h.targetDevo.position.z;
                            h.state = 'reeling';
                            h.caughtVictim = true;
                            onHookHit(h);
                        }
                    }

                    if (h.distTraveled >= h.maxDist && h.state === 'flying') {
                        // Reached max range without hit -> Retract
                        h.state = 'reeling';
                        if (h.isLocal) playDevoAction(true, isLocalMoving ? 'walk_1' : 'idle', 0.2, true);
                        else playDevoAction(false, isOppMoving ? 'walk_1' : 'idle', 0.2, true);
                    }
                } else if (h.state === 'reeling') {
                    // Pull hook back toward caster
                    const returnDir = new THREE.Vector3().subVectors(handPos, h.mesh.position);
                    const distToHand = returnDir.length();

                    if (distToHand < 0.15) {
                        // Hook successfully reeled back in
                        if (h.caughtVictim && h.targetDevo) {
                            if (h.targetDevo === oppDevo) {
                                oppDevo.position.set(0, 0, BOUNDS.oppSpawnZ);
                                oppTarget.set(0, 0, BOUNDS.oppSpawnZ);
                                oppDevo.rotation.y = 0;
                                playDevoAction(false, 'idle', 0.2, true);
                            } else if (h.targetDevo === localDevo) {
                                localDevo.position.set(0, 0, BOUNDS.defaultSpawnZ);
                                localTarget.set(0, 0, BOUNDS.defaultSpawnZ);
                                localDevo.rotation.y = Math.PI;
                                isLocalHookStunned = false;
                                playDevoAction(true, 'idle', 0.2, true);
                                showToast("Respawned on your bank!", "fa-shield-halved");
                            }
                        }

                        scene.remove(h.mesh);
                        scene.remove(h.chain);
                        activeHooks.splice(i, 1);

                        if (h.isLocal) playDevoAction(true, isLocalMoving ? 'walk_1' : 'idle', 0.2, true);
                        else playDevoAction(false, isOppMoving ? 'walk_1' : 'idle', 0.2, true);
                        continue;
                    }

                    returnDir.normalize();
                    const returnStep = (HOOK_SPEED * 1.3) * delta;
                    h.mesh.position.addScaledVector(returnDir, returnStep);

                    // If victim was caught, drag victim across river toward caster!
                    if (h.caughtVictim && h.targetDevo) {
                        h.targetDevo.position.set(h.mesh.position.x, 0, h.mesh.position.z);
                        if (h.targetDevo === localDevo) {
                            localTarget.set(h.mesh.position.x, 0, h.mesh.position.z);
                        } else if (h.targetDevo === oppDevo) {
                            oppTarget.set(h.mesh.position.x, 0, h.mesh.position.z);
                        }
                    }

                    h.chain.geometry.setFromPoints([handPos, h.mesh.position]);
                    h.chain.computeLineDistances();
                }
            }
        }

        // --- 6. Hook Collision & Score Event ---
        function onHookHit(hookObj) {
            playSound('hookImpact', 1.0);
            playSound('death', 0.9);

            // Screen Shake Effect
            triggerCameraShake();

            // Victim animation & floating combat text
            if (hookObj.targetDevo === oppDevo) {
                playDevoAction(false, 'knock_1', 0.1, false);
                spawnFloatingScore(oppDevo.position, "+1 HOOKED!", "text-amber-400");

                if (isSoloPractice) {
                    scoreLocal++;
                    updateScoreboard();
                    respawnDummy();
                    if (scoreLocal >= 10) {
                        showVictoryModal(true, scoreLocal, scoreRemote);
                    }
                } else if (hookObj.isLocal && hub) {
                    // Send score update to SignalR hub with hit impact coordinates
                    hub.invoke("ReportHit", roomCode, playerSlot, hookObj.mesh.position.x, hookObj.mesh.position.z)
                        .catch(err => log("ReportHit error:", err));
                }
            } else {
                playDevoAction(true, 'knock_1', 0.1, false);
                spawnFloatingScore(localDevo.position, "HOOKED!", "text-rose-500");
                isLocalHookStunned = true;

                if (isSoloPractice) {
                    scoreRemote++;
                    updateScoreboard();
                    setTimeout(() => {
                        if (localDevo) {
                            localDevo.position.set(0, 0, BOUNDS.defaultSpawnZ);
                            localTarget.set(0, 0, BOUNDS.defaultSpawnZ);
                            isLocalHookStunned = false;
                            playDevoAction(true, 'idle', 0.2, true);
                        }
                    }, 1200);
                    if (scoreRemote >= 10) {
                        showVictoryModal(false, scoreLocal, scoreRemote);
                    }
                }
            }
        }

        function triggerCameraShake() {
            const originalPos = camera.position.clone();
            let elapsed = 0;
            const shakeInterval = setInterval(() => {
                elapsed += 0.04;
                if (elapsed > 0.25) {
                    clearInterval(shakeInterval);
                    camera.position.copy(originalPos);
                    return;
                }
                const offset = (Math.random() - 0.5) * 0.06;
                camera.position.x = originalPos.x + offset;
                camera.position.y = originalPos.y + offset;
            }, 30);
        }

        function spawnFloatingScore(worldPos, text, colorClass) {
            // Project 3D coordinate to 2D screen coordinate
            const pos = worldPos.clone();
            pos.y += 0.5;
            pos.project(camera);

            const x = (pos.x * 0.5 + 0.5) * container.clientWidth;
            const y = (-(pos.y * 0.5) + 0.5) * container.clientHeight;

            const el = document.createElement('div');
            el.className = `absolute text-xl font-black font-mono tracking-widest ${colorClass} float-score drop-shadow-lg`;
            el.style.left = `${x}px`;
            el.style.top = `${y}px`;
            el.textContent = text;
            combatTextLayer.appendChild(el);

            setTimeout(() => el.remove(), 1400);
        }

        function respawnDummy() {
            isDummyRespawning = true;
            setTimeout(() => {
                if (oppDevo) {
                    oppDevo.position.set((Math.random() - 0.5) * 1.5, 0, BOUNDS.oppSpawnZ);
                    playAnim(oppActions, 'idle');
                    playSound('tauntPrior', 0.8);
                }
                dummyPatrolDir = Math.random() < 0.5 ? 1 : -1;
                dummyPauseTimer = 0.5;
                dummyNextHookTimer = 3.5 + Math.random() * 2.0;
                isDummyRespawning = false;
            }, 1200);
        }

        function showMoveMarker(x, z) {
            if (!scene) return;
            if (!moveMarkerMesh) {
                const ringGeo = new THREE.RingGeometry(0.04, 0.09, 24);
                ringGeo.rotateX(-Math.PI / 2);
                const ringMat = new THREE.MeshBasicMaterial({
                    color: 0x10b981, // Emerald green
                    transparent: true,
                    opacity: 0.9,
                    side: THREE.DoubleSide,
                    depthWrite: false
                });
                moveMarkerMesh = new THREE.Mesh(ringGeo, ringMat);
                scene.add(moveMarkerMesh);
            }
            moveMarkerMesh.position.set(x, 0.02, z);
            moveMarkerMesh.scale.set(1, 1, 1);
            moveMarkerMesh.material.opacity = 0.9;
            moveMarkerMesh.visible = true;
            moveMarkerMesh._life = 0.35;
        }

        // --- 7. Multi-Input Controls (Right-Click Move, Left-Click Hook, WASD, Mobile Touch & Tilt) ---
        function setupInteractionHandlers() {
            let activeTouchMode = 'none'; // 'move' | 'aim_hook' | 'none'
            const raycaster = new THREE.Raycaster();
            const mouse = new THREE.Vector2();

            function getIntersection(event) {
                const rect = renderer.domElement.getBoundingClientRect();
                const clientX = event.clientX !== undefined ? event.clientX : (event.touches && event.touches[0] ? event.touches[0].clientX : 0);
                const clientY = event.clientY !== undefined ? event.clientY : (event.touches && event.touches[0] ? event.touches[0].clientY : 0);

                mouse.x = ((clientX - rect.left) / rect.width) * 2 - 1;
                mouse.y = -((clientY - rect.top) / rect.height) * 2 + 1;

                raycaster.setFromCamera(mouse, camera);
                const hits = raycaster.intersectObject(groundPlane);
                return hits.length > 0 ? hits[0].point : null;
            }

            // Keyboard Controls (PC WASD / Arrow Keys + Space to Hook)
            window.addEventListener('keydown', (e) => {
                keysDown[e.code] = true;
                if (e.key) {
                    keysDown[e.key] = true;
                    keysDown[e.key.toLowerCase()] = true;
                }
                if (e.code === 'Space') {
                    e.preventDefault();
                    if (localDevo) {
                        const targetPoint = new THREE.Vector3(localDevo.position.x, 0, BOUNDS.oppSpawnZ);
                        attemptLaunchHook(targetPoint);
                    }
                }
            });

            window.addEventListener('keyup', (e) => {
                keysDown[e.code] = false;
                if (e.key) {
                    keysDown[e.key] = false;
                    keysDown[e.key.toLowerCase()] = false;
                }
            });

            window.addEventListener('blur', () => {
                keysDown = {};
            });

            // Prevent default right-click context menu on arena
            container.addEventListener('contextmenu', (e) => {
                e.preventDefault();
            });

            // Helper to project a target point across the river when clicking near bank
            function computeHookTarget(hitPoint) {
                if (hitPoint.z < 0.05) {
                    return hitPoint.clone();
                }
                const originX = localDevo ? localDevo.position.x : 0;
                const originZ = localDevo ? localDevo.position.z : BOUNDS.defaultSpawnZ;
                const dx = hitPoint.x - originX;
                const dz = hitPoint.z - originZ;
                let targetX = hitPoint.x;
                if (dz < -0.01) {
                    const scale = Math.abs((BOUNDS.oppSpawnZ - originZ) / dz);
                    targetX = originX + dx * scale;
                }
                return new THREE.Vector3(Math.max(BOUNDS.minX, Math.min(BOUNDS.maxX, targetX)), 0, BOUNDS.oppSpawnZ);
            }

            // Pointer Down (Mouse & Touch)
            container.addEventListener('pointerdown', (e) => {
                requestFullscreenIfNeeded();
                if (isLocalHookStunned) return;

                // Camera Orbit: Allow Middle-Click or Alt/Shift+Left Click to orbit the camera freely
                if (e.button === 1 || (e.button === 0 && (e.altKey || e.shiftKey))) {
                    if (controls) controls.mouseButtons.LEFT = THREE.MOUSE.ROTATE;
                    return;
                } else if (controls) {
                    controls.mouseButtons.LEFT = null;
                }

                // 1. RIGHT CLICK (Mouse button 2): MOVE TO TARGET
                if (e.button === 2) {
                    e.preventDefault();
                    e.stopPropagation();
                    const hitPoint = getIntersection(e);
                    if (!hitPoint) return;

                    const targetX = Math.max(BOUNDS.minX, Math.min(BOUNDS.maxX, hitPoint.x));
                    const targetZ = Math.max(BOUNDS.minZ, Math.min(BOUNDS.maxZ, hitPoint.z));

                    activeTouchMode = 'move';
                    moveLocalDevourerTo(targetX, targetZ);
                    showMoveMarker(targetX, targetZ);
                    return;
                }

                // 2. POV MODE: Left click or touch flings hook down center crosshair!
                if (cameraMode === 'pov') {
                    if (hookCooldown) {
                        playSound('noMana', 0.6);
                        showToast(`Hook on cooldown (${Math.max(0, hookCooldownTimer).toFixed(1)}s remaining)`, "fa-clock");
                        cooldownBanner.classList.remove('opacity-0');
                        return;
                    }
                    const centerRay = new THREE.Raycaster();
                    centerRay.setFromCamera(new THREE.Vector2(0, 0), camera);
                    const hits = centerRay.intersectObject(groundPlane);
                    const targetPoint = (hits.length > 0 && hits[0].point.z < 0.05)
                        ? hits[0].point
                        : new THREE.Vector3(localDevo ? localDevo.position.x : 0, 0, BOUNDS.oppSpawnZ);
                    attemptLaunchHook(targetPoint);
                    return;
                }

                const hitPoint = getIntersection(e);
                if (!hitPoint) return;

                // 3. DESKTOP MOUSE LEFT-CLICK: HOOK ONLY
                if (e.pointerType === 'mouse' && e.button === 0) {
                    e.stopPropagation();
                    if (hookCooldown) {
                        activeTouchMode = 'none';
                        playSound('noMana', 0.6);
                        showToast(`Hook on cooldown (${Math.max(0, hookCooldownTimer).toFixed(1)}s remaining)`, "fa-clock");
                        cooldownBanner.classList.remove('opacity-0');
                        return;
                    }

                    const targetPoint = computeHookTarget(hitPoint);
                    activeTouchMode = 'aim_hook';
                    isAiming = true;
                    aimWorldPoint.copy(targetPoint);
                    updateAimTrajectory(targetPoint);
                    aimHintBanner.classList.remove('opacity-0');
                    return;
                }

                // 4. MOBILE TOUCH: Bank Partition (Near Bank = Move, Across River = Hook)
                if (hitPoint.z >= 0.0) {
                    activeTouchMode = 'move';
                    moveLocalDevourerTo(hitPoint.x, hitPoint.z);
                    return;
                }

                // Across River on Touch -> Hook
                if (hookCooldown) {
                    activeTouchMode = 'none';
                    playSound('noMana', 0.6);
                    showToast(`Hook on cooldown (${Math.max(0, hookCooldownTimer).toFixed(1)}s remaining)`, "fa-clock");
                    cooldownBanner.classList.remove('opacity-0');
                    return;
                }

                activeTouchMode = 'aim_hook';
                isAiming = true;
                aimWorldPoint.copy(hitPoint);
                updateAimTrajectory(hitPoint);
                aimHintBanner.classList.remove('opacity-0');
            });

            // Pointer Move
            container.addEventListener('pointermove', (e) => {
                if (cameraMode === 'pov') return;

                const hitPoint = getIntersection(e);
                if (!hitPoint) return;

                if (activeTouchMode === 'move') {
                    // Continuous dodging follow: right mouse held OR mobile touch on near bank
                    if ((e.buttons & 2) || (e.pointerType === 'touch' && hitPoint.z >= 0.0)) {
                        const targetX = Math.max(BOUNDS.minX, Math.min(BOUNDS.maxX, hitPoint.x));
                        const targetZ = Math.max(BOUNDS.minZ, Math.min(BOUNDS.maxZ, hitPoint.z));
                        moveLocalDevourerTo(targetX, targetZ);
                    }
                } else if (activeTouchMode === 'aim_hook') {
                    const targetPoint = (e.pointerType === 'mouse') ? computeHookTarget(hitPoint) : hitPoint;
                    aimWorldPoint.copy(targetPoint);
                    updateAimTrajectory(targetPoint);
                }
            });

            // Pointer Up
            container.addEventListener('pointerup', (e) => {
                if (cameraMode === 'pov') return;

                if (e.button === 2) {
                    if (activeTouchMode === 'move') activeTouchMode = 'none';
                    return;
                }

                aimHintBanner.classList.add('opacity-0');
                if (trajectoryLine) trajectoryLine.visible = false;
                if (aimCrosshair) aimCrosshair.visible = false;

                if (activeTouchMode === 'aim_hook') {
                    isAiming = false;
                    const hitPoint = getIntersection(e);

                    if (e.pointerType === 'mouse') {
                        // Mouse left-click flings hook toward the targeted direction
                        attemptLaunchHook(aimWorldPoint);
                    } else {
                        // Mobile touch: if released across river -> fling hook; if dragged back to own bank -> cancel
                        const finalTarget = hitPoint || aimWorldPoint;
                        if (finalTarget.z < 0.05) {
                            attemptLaunchHook(finalTarget);
                        } else {
                            showToast("Hook cancelled", "fa-ban");
                        }
                    }
                }

                activeTouchMode = 'none';
                isAiming = false;
            });

            container.addEventListener('pointercancel', () => {
                activeTouchMode = 'none';
                isAiming = false;
                aimHintBanner.classList.add('opacity-0');
                if (trajectoryLine) trajectoryLine.visible = false;
                if (aimCrosshair) aimCrosshair.visible = false;
            });
        }

        function attemptLaunchHook(targetWorldPos) {
            if (isLocalHookStunned) return;

            if (hookCooldown) {
                playSound('noMana', 0.6);
                showToast(`Hook on cooldown (${Math.max(0, hookCooldownTimer).toFixed(1)}s)`, "fa-clock");
                cooldownBanner.classList.remove('opacity-0');
                return;
            }

            if (!localDevo) return;

            const originX = localDevo.position.x;
            const originZ = localDevo.position.z;

            // Calculate direction vector across river
            const dirX = targetWorldPos.x - originX;
            const dirZ = targetWorldPos.z - originZ;
            const len = Math.hypot(dirX, dirZ);
            if (len < 0.1) return;

            const normDirX = dirX / len;
            const normDirZ = dirZ / len;

            // Trigger Cooldown
            hookCooldown = true;
            hookCooldownTimer = HOOK_COOLDOWN_SEC;
            cooldownBanner.classList.remove('opacity-0');

            // Spawn local hook projectile
            spawnHook(originX, originZ, normDirX, normDirZ, true);

            // Broadcast to SignalR if in multiplayer duel
            if (!isSoloPractice && hub) {
                hub.invoke("SendHook", roomCode, playerSlot, originX, originZ, normDirX, normDirZ, HOOK_SPEED)
                    .catch(err => log("SendHook error:", err));
            }
        }

        function moveLocalDevourerTo(x, z) {
            if (isLocalHookStunned) return;

            // Clamp within player's South bank (our side)
            const clampedX = Math.max(BOUNDS.minX, Math.min(BOUNDS.maxX, x));
            const clampedZ = Math.max(BOUNDS.minZ, Math.min(BOUNDS.maxZ, z));

            localTarget.set(clampedX, 0, clampedZ);
            isLocalMoving = true;
            playDevoAction(true, 'walk_1', 0.15, true);

            log(`Local Devourer moving to (${clampedX.toFixed(2)}, ${clampedZ.toFixed(2)})`);
        }

        // --- 8. SignalR Multiplayer Synchronization ---
        async function connectSignalR() {
            log("Connecting to SignalR hub /hubs/devo-wars...");
            if (hub && hub.state === signalR.HubConnectionState.Connected) {
                log(`Hub already connected. Invoking JoinRoom ${roomCode}...`);
                await hub.invoke("JoinRoom", roomCode, playerName, playerId);
                return;
            }
            if (hub) {
                try { await hub.stop(); } catch (e) {}
            }

            hub = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/devo-wars")
                .withAutomaticReconnect([0, 1000, 2500, 5000])
                .configureLogging(signalR.LogLevel.Information)
                .build();

            // Client RPC Listeners
            hub.onreconnected(async (connectionId) => {
                log(`SignalR reconnected with ID ${connectionId}. Rejoining room ${roomCode}...`);
                try {
                    await hub.invoke("JoinRoom", roomCode, playerName, playerId);
                    if (isLocalReady && !matchActive) {
                        await hub.invoke("SetReady", roomCode, isCameraActive);
                    }
                } catch (e) {
                    console.error("Rejoin on reconnect error:", e);
                }
            });

            hub.on("OnRoomFull", (code, message) => {
                log(`Room ${code} is full: ${message}`);
                waitingOverlay.classList.add('hidden');
                arReadyModal.classList.add('hidden');
                matchActive = false;

                const btnEnter = document.getElementById('btnEnterGame');
                if (btnEnter) {
                    btnEnter.disabled = false;
                    btnEnter.innerHTML = '<i class="fas fa-play"></i> Enter Arena';
                }

                // Stop signalR connection for this rejected join attempt
                try {
                    hub.stop();
                } catch (e) {}

                // Generate fresh suggested code
                const words = ['HOOK', 'PUDG', 'DEVO', 'GUTT', 'DUEL', 'WAR1', 'WAR2', 'BITE', 'ARENA'];
                const randCode = words[Math.floor(Math.random() * words.length)] + Math.floor(10 + Math.random() * 89);

                const fullRoomEl = document.getElementById('fullRoomCodeText');
                if (fullRoomEl) fullRoomEl.textContent = code;

                const suggestedEl = document.getElementById('suggestedNewRoomCode');
                if (suggestedEl) suggestedEl.textContent = randCode;

                const inputEl = document.getElementById('inputRoomCode');
                if (inputEl) inputEl.value = randCode;

                if (roomFullModal) roomFullModal.classList.remove('hidden');

                showToast(`Room ${code} is full (2/2)! Please use another code.`, "fa-users-slash");

                // Prominently alert the user per requirement
                setTimeout(() => {
                    alert(`Room "${code}" is currently FULL (2/2 players dueling)!\n\nPlease create another room with a new room code to duel.`);
                }, 100);
            });

            hub.on("OnRoomJoined", (code, slot, p1, p2, score1, score2, status) => {
                log(`Joined room ${code} as Slot ${slot}. Status: ${status}`);
                playerSlot = slot;
                roomCode = code;
                roomCodeDisplay.textContent = `ROOM: ${code}`;
                shareUrlText.textContent = `${window.location.origin}/ar-mini-games/devo-wars?room=${code}`;
                const waitingRoomEl = document.getElementById('waitingRoomCodeText');
                if (waitingRoomEl) waitingRoomEl.textContent = code;

                scoreLocal = (slot === 1) ? score1 : score2;
                scoreRemote = (slot === 1) ? score2 : score1;
                updateScoreboard();

                // Unconditionally dismiss lobby and restore Enter button
                lobbyModal.classList.add('hidden');
                const btnEnter = document.getElementById('btnEnterGame');
                if (btnEnter) {
                    btnEnter.disabled = false;
                    btnEnter.innerHTML = '<i class="fas fa-play"></i> Enter Arena';
                }

                if (!p1 || !p2 || status === 'WaitingForOpponent') {
                    waitingOverlay.classList.remove('hidden');
                } else if (status === 'WaitingForReady') {
                    waitingOverlay.classList.add('hidden');
                    promptMatchReady();
                } else {
                    waitingOverlay.classList.add('hidden');
                    startMatch();
                }
            });

            hub.on("OnOpponentJoined", (slot, oppName) => {
                log(`Opponent ${oppName} joined as Slot ${slot}!`);
                waitingOverlay.classList.add('hidden');
                showToast(`${oppName} entered the arena!`, "fa-swords");
                playSound('heroSelect', 1.0);
                promptMatchReady();
            });

            hub.on("OnMatchPromptReady", () => {
                log("OnMatchPromptReady received from server.");
                waitingOverlay.classList.add('hidden');
                promptMatchReady();
            });

            hub.on("OnPlayerReadyStatus", (slot, isReady, wantsAr) => {
                log(`OnPlayerReadyStatus received: Slot ${slot}, ready=${isReady}, wantsAr=${wantsAr}`);
                if (slot === playerSlot && isReady) {
                    isLocalReady = true;
                    const btnYes = document.getElementById('btnChooseArYes');
                    const btnNo = document.getElementById('btnChooseArNo');
                    if (btnYes) {
                        btnYes.disabled = true;
                        btnYes.classList.add('opacity-50', 'pointer-events-none');
                    }
                    if (btnNo) {
                        btnNo.disabled = true;
                        btnNo.classList.add('opacity-50', 'pointer-events-none');
                    }
                }
                updateReadyBadge(slot, isReady, wantsAr);
            });

            hub.on("OnOpponentLeft", (vacatedSlot) => {
                log(`Opponent left (Slot ${vacatedSlot})`);
                showToast("Opponent left the duel.", "fa-user-slash");
                waitingOverlay.classList.remove('hidden');
            });

            hub.on("OnMatchStarted", (p1, p2) => {
                log(`Match officially started between ${p1} and ${p2}!`);
                waitingOverlay.classList.add('hidden');
                arReadyModal.classList.add('hidden');
                showToast("DUEL STARTED! First to 10 points wins!", "fa-play");
                startMatch();
            });

            // Symmetric Remote Position Ingestion
            hub.on("OnOpponentPosition", (x, z, rotY, isMoving) => {
                if (!oppDevo) return;

                // Symmetric coordinate transformation:
                // Remote (x, z) mirrors to (-x, -z) on local screen!
                const mirroredX = -x;
                const mirroredZ = -z;

                oppTarget.set(mirroredX, 0, mirroredZ);
                isOppMoving = isMoving;

                if (isMoving) playAnim(oppActions, 'walk_1');
                else playAnim(oppActions, 'idle');
            });

            // Symmetric Remote Hook Ingestion
            hub.on("OnHookThrown", (throwerSlot, startX, startZ, dirX, dirZ, speed) => {
                if (throwerSlot === playerSlot) return; // Ignore own echoes

                // Mirror hook start & direction
                const mirroredStartX = -startX;
                const mirroredStartZ = -startZ;
                const mirroredDirX = -dirX;
                const mirroredDirZ = -dirZ;

                log(`Opponent flung hook from (${mirroredStartX.toFixed(2)}, ${mirroredStartZ.toFixed(2)}) dir (${mirroredDirX.toFixed(2)}, ${mirroredDirZ.toFixed(2)})`);
                spawnHook(mirroredStartX, mirroredStartZ, mirroredDirX, mirroredDirZ, false);
            });

            // Synchronized Hook Hit & Victim Reel Event
            hub.on("OnPlayerHooked", (throwerSlot, victimSlot, impactX, impactZ) => {
                log(`OnPlayerHooked: Thrower Slot ${throwerSlot}, Victim Slot ${victimSlot} at (${impactX.toFixed(2)}, ${impactZ.toFixed(2)})`);

                playSound('hookImpact', 1.0);
                playSound('death', 0.9);
                triggerCameraShake();

                if (victimSlot === playerSlot) {
                    // Local player is the victim!
                    log("Local player hooked by opponent! Stunned and reeled in.");
                    isLocalHookStunned = true;
                    isLocalMoving = false;
                    playDevoAction(true, 'knock_1', 0.1, false);
                    if (localDevo) {
                        spawnFloatingScore(localDevo.position, "HOOKED!", "text-rose-500");
                    }

                    // Attach to incoming remote hook if present
                    let incomingHook = activeHooks.find(h => !h.isLocal);
                    if (incomingHook) {
                        incomingHook.state = 'reeling';
                        incomingHook.caughtVictim = true;
                        if (localDevo) {
                            incomingHook.mesh.position.set(localDevo.position.x, 0.25, localDevo.position.z);
                        }
                    } else if (localDevo && oppDevo) {
                        // Create immediate visual reel hook from opponent's hand
                        const oppHand = new THREE.Vector3(oppDevo.position.x, 0.25, oppDevo.position.z);
                        const hookHead = createHookHeadMesh(false);
                        hookHead.position.set(localDevo.position.x, 0.25, localDevo.position.z);
                        scene.add(hookHead);

                        const chainGeo = new THREE.BufferGeometry();
                        chainGeo.setFromPoints([oppHand, hookHead.position]);
                        const chainMat = new THREE.LineDashedMaterial({
                            color: 0x94a3b8,
                            dashSize: 0.05,
                            gapSize: 0.03,
                            linewidth: 3
                        });
                        const chainLine = new THREE.Line(chainGeo, chainMat);
                        scene.add(chainLine);

                        activeHooks.push({
                            mesh: hookHead,
                            chain: chainLine,
                            origin: oppHand,
                            dir: new THREE.Vector3(0, 0, 1),
                            distTraveled: 0,
                            maxDist: HOOK_RANGE,
                            speed: HOOK_SPEED,
                            state: 'reeling',
                            isLocal: false,
                            targetDevo: localDevo,
                            caughtVictim: true
                        });
                    }

                    // Guaranteed respawn after reel
                    if (localRespawnTimeout) clearTimeout(localRespawnTimeout);
                    localRespawnTimeout = setTimeout(() => {
                        if (localDevo) {
                            localDevo.position.set(0, 0, BOUNDS.defaultSpawnZ);
                            localTarget.set(0, 0, BOUNDS.defaultSpawnZ);
                            localDevo.rotation.y = Math.PI;
                            isLocalHookStunned = false;
                            playDevoAction(true, 'idle', 0.2, true);
                            showToast("Respawned on your bank!", "fa-shield-halved");
                        }
                    }, 1300);

                } else {
                    // Local player threw the hook and latched the opponent!
                    log("Local player latched opponent!");
                    playDevoAction(false, 'knock_1', 0.1, false);
                    if (oppDevo) {
                        spawnFloatingScore(oppDevo.position, "+1 HOOKED!", "text-amber-400");
                    }

                    let outgoingHook = activeHooks.find(h => h.isLocal);
                    if (outgoingHook) {
                        outgoingHook.state = 'reeling';
                        outgoingHook.caughtVictim = true;
                        if (oppDevo) {
                            outgoingHook.mesh.position.set(oppDevo.position.x, 0.25, oppDevo.position.z);
                        }
                    }

                    if (oppRespawnTimeout) clearTimeout(oppRespawnTimeout);
                    oppRespawnTimeout = setTimeout(() => {
                        if (oppDevo) {
                            oppDevo.position.set(0, 0, BOUNDS.oppSpawnZ);
                            oppTarget.set(0, 0, BOUNDS.oppSpawnZ);
                            oppDevo.rotation.y = 0;
                            playDevoAction(false, 'idle', 0.2, true);
                        }
                    }, 1300);
                }
            });

            // Score Updates
            hub.on("OnScoreUpdated", (score1, score2, scorerSlot) => {
                log(`Score update: P1=${score1}, P2=${score2} (Scored by Slot ${scorerSlot})`);
                scoreLocal = (playerSlot === 1) ? score1 : score2;
                scoreRemote = (playerSlot === 1) ? score2 : score1;
                updateScoreboard();

                if (scorerSlot === playerSlot) {
                    showToast("YOU SCORED A POINT!", "fa-trophy");
                } else {
                    showToast("OPPONENT SCORED!", "fa-skull");
                }
            });

            // Match Won
            hub.on("OnMatchWon", (winnerSlot, finalP1, finalP2) => {
                log(`Match Won by Slot ${winnerSlot}!`);
                const isLocalWinner = (winnerSlot === playerSlot);
                const s1 = (playerSlot === 1) ? finalP1 : finalP2;
                const s2 = (playerSlot === 1) ? finalP2 : finalP1;
                showVictoryModal(isLocalWinner, s1, s2);
            });

            hub.on("OnMatchReset", () => {
                matchOverModal.classList.add('hidden');
                scoreLocal = 0;
                scoreRemote = 0;
                updateScoreboard();
                showToast("Rematch requested! Set ready status.", "fa-rotate-right");
            });

            try {
                await hub.start();
                log("SignalR Connected!");
                await hub.invoke("JoinRoom", roomCode, playerName, playerId);
            } catch (err) {
                console.error("SignalR Connection Failed:", err);
                showToast("Connection failed. Playing in Solo mode.", "fa-wifi");
                waitingOverlay.classList.add('hidden');
                const btnEnter = document.getElementById('btnEnterGame');
                if (btnEnter) {
                    btnEnter.disabled = false;
                    btnEnter.innerHTML = '<i class="fas fa-play"></i> Enter Arena';
                }
                isSoloPractice = true;
                promptMatchReady();
            }
        }

        function updateScoreboard() {
            scoreP1El.textContent = scoreLocal;
            scoreP2El.textContent = scoreRemote;
        }

        function showVictoryModal(isLocalWinner, s1, s2) {
            matchActive = false;
            document.getElementById('victoryTitle').textContent = isLocalWinner ? "VICTORY!" : "DEFEATED!";
            document.getElementById('victoryTitle').className = `text-3xl font-black tracking-wider uppercase ${isLocalWinner ? 'text-amber-400' : 'text-rose-500'}`;
            document.getElementById('victoryIcon').className = `fas ${isLocalWinner ? 'fa-trophy' : 'fa-skull'}`;
            document.getElementById('finalScoreP1').textContent = s1;
            document.getElementById('finalScoreP2').textContent = s2;
            matchOverModal.classList.remove('hidden');

            if (isLocalWinner) playSound('tauntAfter', 1.0);
            else playSound('death', 1.0);
        }

        let isLocalReady = false;
        let p1ReadyState = false;
        let p1WantsAr = false;
        let p2ReadyState = false;
        let p2WantsAr = false;

        function promptMatchReady() {
            log("promptMatchReady called.");
            isLocalReady = false;
            p1ReadyState = false;
            p2ReadyState = false;

            arReadyModal.classList.remove('hidden');
            waitingOverlay.classList.add('hidden');
            lobbyModal.classList.add('hidden');

            const btnYes = document.getElementById('btnChooseArYes');
            const btnNo = document.getElementById('btnChooseArNo');
            if (btnYes) {
                btnYes.disabled = false;
                btnYes.classList.remove('opacity-50', 'pointer-events-none');
            }
            if (btnNo) {
                btnNo.disabled = false;
                btnNo.classList.remove('opacity-50', 'pointer-events-none');
            }

            if (isSoloPractice) {
                document.getElementById('readyStatusContainer').classList.add('hidden');
            } else {
                document.getElementById('readyStatusContainer').classList.remove('hidden');
                updateReadyBadge(1, false, false);
                updateReadyBadge(2, false, false);
            }
        }

        async function handleReadyChoice(wantsAr) {
            if (isLocalReady) return;
            isLocalReady = true;

            log(`handleReadyChoice: Local player (Slot ${playerSlot}) selected ${wantsAr ? 'AR Camera' : '3D Stadium'}`);

            // 1. Optimistically update local ready badge immediately
            updateReadyBadge(playerSlot, true, wantsAr);

            // 2. Disable choice buttons immediately to prevent duplicate taps
            const btnYes = document.getElementById('btnChooseArYes');
            const btnNo = document.getElementById('btnChooseArNo');
            if (btnYes) {
                btnYes.disabled = true;
                btnYes.classList.add('opacity-50', 'pointer-events-none');
            }
            if (btnNo) {
                btnNo.disabled = true;
                btnNo.classList.add('opacity-50', 'pointer-events-none');
            }

            // 3. If solo practice mode, start immediately
            if (isSoloPractice) {
                arReadyModal.classList.add('hidden');
                startMatch();
                enableCamera(wantsAr).catch(e => log("Practice camera error:", e));
                return;
            }

            // 4. Send SetReady to SignalR IMMEDIATELY (NON-BLOCKING!)
            if (hub) {
                log(`Invoking SetReady for room ${roomCode}, wantsAr=${wantsAr}`);
                hub.invoke("SetReady", roomCode, wantsAr)
                    .then(() => log("SetReady invoked successfully"))
                    .catch(err => {
                        console.error("SetReady invoke error:", err);
                        showToast("Registering ready status...", "fa-circle-notch");
                        setTimeout(() => {
                            if (hub && isLocalReady && !matchActive) {
                                hub.invoke("SetReady", roomCode, wantsAr).catch(e => log("SetReady retry error:", e));
                            }
                        }, 1000);
                    });
            } else {
                console.warn("handleReadyChoice: hub is null!");
            }

            // 5. Turn camera on or off asynchronously in background without blocking network or UI
            enableCamera(wantsAr).catch(err => {
                log("enableCamera error caught:", err);
