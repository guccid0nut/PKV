                    waitingText.innerHTML = `<i class="fas fa-check-double mr-1"></i> Both gladiators ready! Starting duel...`;
                    waitingText.classList.remove('hidden');
                } else if (isLocalReady) {
                    waitingText.className = "text-[11px] text-amber-400/90 font-medium";
                    waitingText.innerHTML = `<i class="fas fa-spinner animate-spin mr-1"></i> Waiting for opponent to ready up...`;
                    waitingText.classList.remove('hidden');
                } else {
