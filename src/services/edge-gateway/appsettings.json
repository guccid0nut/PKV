{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "EdgeGateway": {
    "RateLimit": {
      "Enabled": true,
      "PermitLimit": 240,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0,
      "MaxTrackedPartitions": 4096,
      "OverflowShardCount": 256
    }
  },
  "ReverseProxy": {
    "Routes": {
      "master-server-route": {
        "ClusterId": "master-server",
        "RateLimiterPolicy": "edge-ip",
        "Match": {
          "Path": "/api/master/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/master"
          },
          {
            "X-Forwarded": "Set"
          },
          {
            "RequestHeaderRemove": "CF-Connecting-IP"
          },
          {
            "RequestHeaderRemove": "CF-Visitor"
          }
        ]
      },
      "presence-hub-route": {
        "ClusterId": "master-server",
        "RateLimiterPolicy": "edge-ip",
        "Match": {
          "Path": "/hubs/presence/{**catch-all}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          },
          {
            "RequestHeaderRemove": "CF-Connecting-IP"
          },
          {
            "RequestHeaderRemove": "CF-Visitor"
          }
        ]
      },
      "web-api-route": {
        "ClusterId": "web-api",
        "RateLimiterPolicy": "edge-ip",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          },
          {
            "RequestHeaderRemove": "CF-Connecting-IP"
          },
          {
            "RequestHeaderRemove": "CF-Visitor"
          }
        ]
      },
      "web-ui-route": {
        "ClusterId": "web-ui",
        "RateLimiterPolicy": "edge-ip",
        "Match": {
          "Path": "/{**catch-all}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          },
          {
            "RequestHeaderRemove": "CF-Connecting-IP"
          },
          {
            "RequestHeaderRemove": "CF-Visitor"
          }
        ]
      }
    },
    "Clusters": {
      "master-server": {
        "HttpRequest": {
          "ActivityTimeout": "00:10:00"
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Metadata": {
          "TransportFailureRateHealthPolicy.RateLimit": "0.5",
          "TransportFailureRateHealthPolicy.DetectionWindowSize": "00:01:00",
          "TransportFailureRateHealthPolicy.MinimalTotalCountThreshold": "5"
        },
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:55555/"
          }
        }
      },
      "web-api": {
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Metadata": {
          "TransportFailureRateHealthPolicy.RateLimit": "0.5",
          "TransportFailureRateHealthPolicy.DetectionWindowSize": "00:01:00",
          "TransportFailureRateHealthPolicy.MinimalTotalCountThreshold": "5"
        },
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5200/"
          }
        }
      },
      "web-ui": {
        "HttpRequest": {
          "ActivityTimeout": "00:10:00"
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Metadata": {
          "TransportFailureRateHealthPolicy.RateLimit": "0.5",
          "TransportFailureRateHealthPolicy.DetectionWindowSize": "00:01:00",
          "TransportFailureRateHealthPolicy.MinimalTotalCountThreshold": "5"
        },
        "Destinations": {
          "primary": {
            "Address": "http://127.0.0.1:5266/"
          }
        }
      }
    }
  }
}
