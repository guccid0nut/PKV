<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Kongor.Modding</RootNamespace>
    <AssemblyName>Kongor.Modding</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>ProjectKongor HoN Modding Engine Library</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="System.IO.Hashing"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\contracts\NEXUS.Contracts.csproj"/>
    <ProjectReference Include="..\..\libs\protocol-core\Kongor.Core.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kongor.Modding.Tests" />
    <InternalsVisibleTo Include="Kongor.Mcp.Tests" />
    <InternalsVisibleTo Include="ASPIRE.Integration.Tests" />
  </ItemGroup>

</Project>
