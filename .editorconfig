root = true

[*.cs]
# Core formatting
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# Language Standards
file_header_template = SPDX-License-Identifier: AGPL-3.0-or-later\nSPDX-FileCopyrightText: 2026 guccidonut and Project KONGOR V Contributors\nProject KONGOR V (https://github.com/guccidonut/PKV)
dotnet_diagnostic.IDE0073.severity = none
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_collection_expression = true:suggestion
csharp_style_prefer_readonly_struct = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_unused_value_assignment_preference = discard_variable:suggestion

# Performance Analyzers (Enforced)
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
dotnet_diagnostic.IDE0130.severity = none
dotnet_diagnostic.IDE0011.severity = suggestion
dotnet_diagnostic.IDE0045.severity = suggestion
dotnet_diagnostic.IDE0046.severity = suggestion
dotnet_diagnostic.IDE0053.severity = suggestion
dotnet_diagnostic.IDE0058.severity = none
dotnet_diagnostic.IDE0059.severity = suggestion
dotnet_diagnostic.IDE0060.severity = suggestion
dotnet_diagnostic.IDE0063.severity = suggestion
dotnet_diagnostic.IDE0290.severity = suggestion
